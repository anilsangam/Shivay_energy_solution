<%- include('partials/admin-head') %>

<!-- Quick Action Alert / Status Toast -->
<div id="statusToast" class="alert alert-success alert-dismissible fade show d-none" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="statusToastMsg">Operation completed successfully.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('statusToast').classList.add('d-none')"></button>
</div>

<!-- Header Welcome Banner -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            Shivay Energy Solutions Enterprise Command Center
        </h2>
        <p class="text-muted small mb-0">
            Authorized Turnkey Solar EPC • Raisen Central (M.P.) • Headed by Deepak Kushwaha & Rahul Saini
        </p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a href="/admin/employees" class="btn btn-sm btn-outline-primary" style="border-radius: 8px;">
            <i class="icofont-users-alt-2 me-1"></i> Manage Staff
        </a>
        <a href="/admin/quotations" class="btn btn-sm btn-warning font-weight-bold text-dark" style="border-radius: 8px;">
            <i class="icofont-calculator-alt-2 me-1"></i> New Quotation
        </a>
        <a href="/admin/activity-logs" class="btn btn-sm btn-dark" style="border-radius: 8px; background: var(--admin-navy-primary);">
            <i class="icofont-history me-1"></i> Audit Logs
        </a>
    </div>
</div>

<!-- Key Metric KPI Cards (REAL DATA ONLY - NO STATIC NUMBERS) -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="admin-metric-card">
            <div class="admin-metric-info">
                <small>Field Employees</small>
                <h3><%= stats.totalEmployees %></h3>
                <div class="admin-metric-subtext text-success">
                    <i class="icofont-check-circled"></i> Active installation staff
                </div>
            </div>
            <div class="admin-metric-icon icon-navy">
                <i class="icofont-users-alt-4"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="admin-metric-card">
            <div class="admin-metric-info">
                <small>Branch Managers</small>
                <h3><%= stats.totalManagers %></h3>
                <div class="admin-metric-subtext text-primary">
                    <i class="icofont-business-man-alt-1"></i> Operations leadership
                </div>
            </div>
            <div class="admin-metric-icon icon-amber">
                <i class="icofont-business-man"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="admin-metric-card">
            <div class="admin-metric-info">
                <small>Active Accounts</small>
                <h3 class="text-success"><%= stats.activeUsers %></h3>
                <div class="admin-metric-subtext text-muted">
                    <i class="icofont-shield-alt text-success"></i> RBAC authenticated
                </div>
            </div>
            <div class="admin-metric-icon icon-green">
                <i class="icofont-badge"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="admin-metric-card">
            <div class="admin-metric-info">
                <small>Pending / Inactive</small>
                <h3 class="text-warning"><%= stats.inactiveUsers %></h3>
                <div class="admin-metric-subtext text-muted">
                    <i class="icofont-clock-time"></i> Verification queue
                </div>
            </div>
            <div class="admin-metric-icon icon-blue">
                <i class="icofont-sand-clock"></i>
            </div>
        </div>
    </div>
</div>

<!-- Employee-Manager Overview Table (Requirement: Step 8) -->
<div class="admin-card mb-4">
    <div class="admin-card-header">
        <div>
            <h5 class="admin-card-title">Employee - Manager Organization Overview</h5>
            <div class="admin-card-subtitle">Real-time organizational hierarchy, role assignments, and active reporting lines</div>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/employees" class="btn btn-sm btn-outline-primary" style="font-size: 12px; border-radius: 6px;">
                <i class="icofont-gear"></i> Manage Assignments
            </a>
        </div>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Staff Name</th>
                    <th>Employee ID</th>
                    <th>Role</th>
                    <th>Assigned Manager</th>
                    <th>Department / Designation</th>
                    <th>Status</th>
                    <th>Branch</th>
                </tr>
            </thead>
            <tbody>
                <% if (users && users.length > 0) { %>
                    <% users.forEach(u => { 
                        let roleClass = 'badge-role-employee';
                        let roleName = 'Employee';
                        if (u.role === 'SUPER_ADMIN') {
                            roleClass = 'badge-role-superadmin';
                            roleName = 'Super Admin';
                        } else if (u.role === 'MANAGER' || u.role === 'BRANCH_MANAGER') {
                            roleClass = 'badge-role-manager';
                            roleName = 'Manager';
                        }

                        let statusClass = 'badge-status-active';
                        if (u.status === 'PENDING') statusClass = 'badge-status-pending';
                        else if (u.status === 'SUSPENDED') statusClass = 'badge-status-suspended';
                        else if (u.status === 'INACTIVE') statusClass = 'badge-status-inactive';

                        const mgrName = (u.managerId && u.managerId.name) ? u.managerId.name : ((u.manager && u.manager.name) ? u.manager.name : (u.role === 'SUPER_ADMIN' ? 'Self / Executive Board' : (u.role === 'MANAGER' || u.role === 'BRANCH_MANAGER' ? 'Deepak Kushwaha (MD)' : 'Unassigned')));
                    %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="admin-avatar-circle" style="width: 30px; height: 30px; font-size: 11px;">
                                        <%= (u.name || 'U').split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase() %>
                                    </div>
                                    <div>
                                        <strong class="text-dark"><%= u.name %></strong>
                                        <small class="text-muted d-block" style="font-size: 11px;"><%= u.email %></small>
                                    </div>
                                </div>
                            </td>
                            <td><code><%= u.employeeId || 'N/A' %></code></td>
                            <td><span class="badge-role <%= roleClass %>"><%= roleName %></span></td>
                            <td>
                                <span class="d-inline-flex align-items-center gap-1 font-weight-bold" style="font-size: 12px; color: var(--admin-navy-primary);">
                                    <i class="icofont-business-man text-warning"></i> <%= mgrName %>
                                </span>
                            </td>
                            <td>
                                <div style="font-size: 12px;"><%= u.designation || 'Technical Staff' %></div>
                                <small class="text-muted" style="font-size: 10px;"><%= u.department || 'Operations' %></small>
                            </td>
                            <td><span class="badge-status <%= statusClass %>"><%= u.status %></span></td>
                            <td>
                                <span class="small text-muted">
                                    <%= (u.branchId && u.branchId.name) ? u.branchId.name : 'Raisen Central' %>
                                </span>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No personnel records found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Two Columns: Recent System Activities & Live CRM Leads -->
<div class="row g-4 mb-4">
    <!-- Live System Activity Audit Overview -->
    <div class="col-lg-5">
        <div class="admin-card h-100 mb-0">
            <div class="admin-card-header">
                <div>
                    <h5 class="admin-card-title">System Activity Overview</h5>
                    <div class="admin-card-subtitle">Verified audit logs & security access events</div>
                </div>
                <a href="/admin/activity-logs" class="small text-decoration-none text-primary font-weight-bold">View All</a>
            </div>

            <div class="admin-activity-list" style="max-height: 440px; overflow-y: auto;">
                <% if (recentActivities && recentActivities.length > 0) { %>
                    <% recentActivities.forEach(act => { 
                        let actColor = '#163563';
                        let actIcon = 'icofont-info-circle';
                        if (act.action.includes('LOGIN')) { actIcon = 'icofont-login'; actColor = '#10b981'; }
                        else if (act.action.includes('UNAUTHORIZED')) { actIcon = 'icofont-warning'; actColor = '#ef4444'; }
                        else if (act.action.includes('ROLE')) { actIcon = 'icofont-shield-alt'; actColor = '#f59e0b'; }
                        else if (act.action.includes('ATTENDANCE')) { actIcon = 'icofont-location-pin'; actColor = '#3b82f6'; }

                        const actorName = (act.user && act.user.name) ? act.user.name : (act.role || 'System');
                        const timeStr = act.createdAt ? new Date(act.createdAt).toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit' }) : 'Recent';
                    %>
                        <div class="d-flex align-items-start gap-3 p-2 mb-2 border-bottom">
                            <div style="width: 32px; height: 32px; border-radius: 8px; background: <%= actColor %>20; color: <%= actColor %>; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0;">
                                <i class="<%= actIcon %>"></i>
                            </div>
                            <div class="flex-grow-1" style="line-height: 1.3;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="text-dark" style="font-size: 12px;"><%= act.action.replace(/_/g, ' ') %></strong>
                                    <small class="text-muted" style="font-size: 10px;"><%= timeStr %></small>
                                </div>
                                <small class="text-muted d-block mt-1" style="font-size: 11px;">
                                    By: <strong><%= actorName %></strong> <%= act.ipAddress ? `• IP: ${act.ipAddress}` : '' %>
                                </small>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="text-center py-4 text-muted small">No recent activity events.</p>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Customer Leads CRM Table -->
    <div class="col-lg-7">
        <div class="admin-card h-100 mb-0">
            <div class="admin-card-header">
                <div>
                    <h5 class="admin-card-title">Live Madhya Pradesh Solar Enquiries</h5>
                    <div class="admin-card-subtitle">Real-time enquiries from website & solar calculator</div>
                </div>
                <span class="badge bg-light text-dark border">Raisen & Regional Leads</span>
            </div>

            <div class="admin-table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Lead ID</th>
                            <th>Customer</th>
                            <th>Requirement</th>
                            <th>Location</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentEnquiries && recentEnquiries.length > 0) { %>
                            <% recentEnquiries.slice(0, 6).forEach(e => { %>
                                <tr>
                                    <td><strong><%= e.id %></strong></td>
                                    <td>
                                        <div class="font-weight-bold text-dark"><%= e.name %></div>
                                        <small class="text-muted"><%= e.mobile %></small>
                                    </td>
                                    <td>
                                        <span class="small font-weight-bold text-primary"><%= e.requirement %></span>
                                    </td>
                                    <td><small class="text-muted"><%= e.district || 'Raisen (M.P.)' %></small></td>
                                    <td>
                                        <span class="badge bg-warning text-dark text-uppercase" style="font-size: 10px;">
                                            <%= e.status.replace(/_/g, ' ') %>
                                        </span>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No customer inquiries found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('partials/admin-footer') %>
