            <!-- Services horizontal auto-scroll rail -->
            <section class="home-services-section" aria-labelledby="homeServicesHeading">
                <div class="container">
                    <div class="home-projects-heading">
                        <h2 id="homeServicesHeading">Our Services</h2>
                    </div>
                    <% const homeServiceItems = data.services; %>
                    <div class="home-service-rail home-auto-rail" role="region" tabindex="0" aria-label="Solar and EV services">
                        <div class="home-project-track">
                            <% [false, true].forEach(isClone => { %>
                                <div class="home-service-group" <%= isClone ? 'aria-hidden="true"' : '' %>>
                                    <% homeServiceItems.forEach(service => { %>
                                        <article class="home-service-card" <%= isClone ? 'tabindex="-1"' : '' %>>
                                            <div class="home-service-image">
                                                <img src="/<%= service.image %>" alt="<%= isClone ? '' : service.title %>" loading="lazy">
                                            </div>
                                            <div class="home-service-card-body">
                                                <span class="home-service-icon"><i class="<%= service.icon %>" aria-hidden="true"></i></span>
                                                <h3><%= service.title %></h3>
                                                <p><%= service.shortDesc %></p>
                                                <div class="home-service-actions">
                                                    <a class="home-service-discuss" href="/contact#enquiry-form" <%= isClone ? 'tabindex="-1"' : '' %>>Discuss Service</a>
                                                    <a class="home-service-quote" href="/calculator" <%= isClone ? 'tabindex="-1"' : '' %>>Get Quote</a>
                                                </div>
                                            </div>
                                        </article>
                                    <% }); %>
