                                <span class="home-stat-label">Solar installations</span>
                            </div>
                        </div>
                        <div class="col-4 wow fadeInUp" data-wow-delay=".3s">
                            <div class="home-stat-card h-100">
                                <strong class="home-stat-value"><%= new Date().getFullYear() - data.company.establishedYear %>+</strong>
                                <span class="home-stat-label">Years of solar experience</span>
                            </div>
                        </div>
                        <div class="col-4 wow fadeInUp" data-wow-delay=".4s">
                            <div class="home-stat-card h-100">
                                <strong class="home-stat-value">16+</strong>
                                <span class="home-stat-label">Districts covered</span>
                            </div>
                        </div>
                    </div>
