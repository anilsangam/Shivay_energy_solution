                <div class="container z-2">
                    <div class="row g-4 align-items-center">
                        <div class="col-lg-8 col-md-8 text-start">
                            <h1 class="text-white font-weight-bold mb-3 wow fadeInUp" data-wow-delay=".2s" style="font-size: 52px; line-height: 1.15; letter-spacing: -0.5px;">
                                Clean Solar Power for a Brighter Tomorrow.
                            </h1>
                            <p class="text-white mb-4 wow fadeInUp" data-wow-delay=".4s" style="font-size: 18px; line-height: 1.6; max-width: 620px; opacity: 0.9;">
                                <%= company.name %> makes reliable solar simple, helping homes and businesses lower electricity bills with clean energy.
                            </p>
                        </div>
                        <div class="col-lg-4 col-md-4 d-flex justify-content-lg-center justify-content-md-center justify-content-start align-items-center wow fadeInUp" data-wow-delay=".6s" style="transform: translateX(-120px);">
                            <a href="/services" class="btn-main fx-slide" style="background: var(--primary-color, #c6ff7d); color: #000; border-radius: 30px; padding: 16px 42px; font-weight: 700; font-size: 17px; white-space: nowrap;">
                                <span>Explore Services</span>
                            </a>
                        </div>
                    </div>
                </div>
                <!-- Desktop Stats Cards (Hidden on mobile) -->
