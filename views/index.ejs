<script>
(() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.home-auto-rail').forEach(rail => {
        const track = rail.querySelector('.home-project-track');
        const firstGroup = track && track.firstElementChild;
        if (!track || !firstGroup || firstGroup.children.length < 2) return;

        let pauseUntil = 0;
        let hovered = false;
        let stepping = false;
        const cardCount = firstGroup.children.length;
        rail.addEventListener('pointerenter', () => { hovered = true; });
        rail.addEventListener('pointerleave', () => { hovered = false; });
        rail.addEventListener('touchstart', () => { pauseUntil = Date.now() + 3500; }, { passive: true });
        rail.addEventListener('wheel', () => { pauseUntil = Date.now() + 2500; }, { passive: true });

        const stepRail = () => {
            if (hovered || Date.now() < pauseUntil || stepping) return;
            const firstCard = firstGroup.querySelector('article');
            const gap = parseFloat(getComputedStyle(firstGroup).columnGap) || 0;
            const step = firstCard.getBoundingClientRect().width + gap;
            const groupWidth = firstGroup.getBoundingClientRect().width;
            if (!step || !groupWidth) return;

            const currentIndex = Math.min(cardCount - 1, Math.round((rail.scrollLeft % groupWidth) / step));
            stepping = true;
            if (currentIndex >= cardCount - 1) {
                rail.scrollTo({ left: groupWidth, behavior: 'smooth' });
                window.setTimeout(() => { rail.scrollLeft = 0; stepping = false; }, 650);
            } else {
                rail.scrollTo({ left: (currentIndex + 1) * step, behavior: 'smooth' });
                window.setTimeout(() => { stepping = false; }, 650);
            }
        };
        window.setInterval(stepRail, 3200);
    });
})();
</script>
