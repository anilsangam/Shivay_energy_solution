<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <section class="py-5" style="background: linear-gradient(135deg, #163563 0%, #0d284e 100%); min-height: 80vh; display: flex; align-items: center;">
        <div class="container py-4">
            <div class="row justify-content-center">
                <div class="col-md-5 col-lg-4">
                    <div class="card p-4 p-md-5 border-0 shadow-lg rounded-4 bg-white" style="border-top: 6px solid var(--primary-color) !important;">
                        <div class="text-center mb-4">
                            <span class="badge px-3 py-2 text-dark font-weight-bold mb-2" style="background: var(--primary-color);">EMPLOYEE PORTAL</span>
                            <h3 class="font-weight-bold text-dark mb-1">Staff Sign In</h3>
                            <small class="text-muted"><%= company.name %> • Field & Technical Staff</small>
                        </div>

                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger py-2 px-3 small rounded-3" role="alert">
                                <i class="icofont-warning me-1"></i> <%= error %>
                            </div>
                        <% } %>

                        <form action="/employee/login" method="POST" autocomplete="off">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <input type="hidden" name="returnUrl" value="<%= typeof returnUrl !== 'undefined' ? returnUrl : '/employee/attendance' %>">

                            <div class="mb-3">
                                <label class="form-label small font-weight-bold text-dark">Employee ID or Email *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="icofont-badge text-muted"></i></span>
                                    <input type="text" name="identifier" class="form-control bg-light border-start-0" placeholder="e.g. SES-EMP-01 or email" required autofocus>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label small font-weight-bold text-dark">Password *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="icofont-lock text-muted"></i></span>
                                    <input type="password" id="empPassword" name="password" class="form-control bg-light border-start-0 border-end-0" placeholder="••••••••" required>
                                    <button class="btn btn-light border border-start-0 text-muted" type="button" onclick="togglePass('empPassword', this)">
                                        <i class="icofont-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <button type="submit" class="btn w-100 py-3 font-weight-bold text-white rounded-3 shadow-sm" style="background: #163563;">
                                <i class="icofont-login me-1"></i> Sign In to Portal
                            </button>
                        </form>

                        <div class="mt-4 pt-3 border-top text-center small text-muted">
                            <p class="mb-2">New field technician or staff member?</p>
                            <a href="/employee/register" class="btn btn-sm btn-outline-dark w-100 py-2">
                                <i class="icofont-user-male me-1"></i> Submit Registration Request
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
function togglePass(id, btn) {
    const el = document.getElementById(id);
    const icon = btn.querySelector('i');
    if (el.type === 'password') {
        el.type = 'text';
        icon.className = 'icofont-eye-blocked';
    } else {
        el.type = 'password';
        icon.className = 'icofont-eye';
    }
}
</script>
<style>
/* Page-specific responsive rules */
@media (max-width: 767.98px) {
    #content { width: 100%; max-width: 100%; overflow-x: clip; }
    #content .container, #content .container-fluid { max-width: 100%; }
    #content .row > [class*="col-"] { min-width: 0; }
    #content .card, #content .card-body { min-width: 0; max-width: 100%; box-sizing: border-box; }
    #content h1, #content h2, #content h3, #content h4, #content p,
    #content small, #content strong, #content a, #content label { overflow-wrap: anywhere; }
    #content img, #content video, #content iframe { max-width: 100%; }
    #content input, #content select, #content textarea, #content button { max-width: 100%; min-width: 0; }
    #content .table-responsive { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    #content table { min-width: 620px; }
    #content .btn-main, #content .btn { white-space: normal; text-align: center; }
}
</style>
<%- include('../partials/footer') %>
