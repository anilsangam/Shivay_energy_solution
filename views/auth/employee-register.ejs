<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <section class="py-5" style="background: linear-gradient(135deg, #163563 0%, #0d284e 100%); min-height: 80vh; display: flex; align-items: center;">
        <div class="container py-4">
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-5">
                    <div class="card p-4 p-md-5 border-0 shadow-lg rounded-4 bg-white" style="border-top: 6px solid var(--primary-color) !important;">
                        <div class="text-center mb-4">
                            <span class="badge px-3 py-2 text-dark font-weight-bold mb-2" style="background: var(--primary-color);">STAFF ONBOARDING</span>
                            <h3 class="font-weight-bold text-dark mb-1">Employee Registration</h3>
                            <small class="text-muted"><%= company.name %> • Raisen Central & Field Staff</small>
                        </div>

                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger py-2 px-3 small rounded-3" role="alert">
                                <i class="icofont-warning me-1"></i> <%= error %>
                            </div>
                        <% } %>

                        <% if (typeof success !== 'undefined' && success) { %>
                            <div class="alert alert-success py-3 px-3 small rounded-3" role="alert">
                                <i class="icofont-check-circled me-1 fs-16"></i> <%= success %>
                                <div class="mt-3 text-center">
                                    <a href="/employee/login" class="btn btn-sm btn-dark px-3 py-1">Back to Login</a>
                                </div>
                            </div>
                        <% } else { %>
                            <form action="/employee/register" method="POST" autocomplete="off">
                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

                                <div class="mb-3">
                                    <label class="form-label small font-weight-bold text-dark">Full Legal Name *</label>
                                    <input type="text" name="name" class="form-control bg-light" placeholder="e.g. Ramesh Kumar Patel" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small font-weight-bold text-dark">Official Email Address *</label>
                                    <input type="email" name="email" class="form-control bg-light" placeholder="ramesh@gmail.com" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small font-weight-bold text-dark">10-Digit Mobile Number *</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted">+91</span>
                                        <input type="tel" name="mobile" class="form-control bg-light" placeholder="98260XXXXX" required pattern="[0-9]{10}">
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="form-label small font-weight-bold text-dark">Password (min 8) *</label>
                                        <input type="password" name="password" class="form-control bg-light" placeholder="••••••••" minlength="8" required>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small font-weight-bold text-dark">Confirm Password *</label>
                                        <input type="password" name="confirmPassword" class="form-control bg-light" placeholder="••••••••" minlength="8" required>
                                    </div>
                                </div>

                                <div class="p-3 bg-light rounded-3 mb-4 small border">
                                    <i class="icofont-info-circle text-primary me-1"></i>
                                    <strong>Approval Notice:</strong> Submitted registrations enter <strong>PENDING</strong> status. An administrator must verify and activate your staff access before login is permitted.
                                </div>

                                <button type="submit" class="btn w-100 py-3 font-weight-bold text-dark rounded-3 shadow-sm" style="background: var(--primary-color);">
                                    <i class="icofont-paper me-1"></i> Submit Registration Request
                                </button>
                            </form>
                        <% } %>

                        <div class="mt-4 pt-3 border-top text-center small text-muted">
                            <p class="mb-1">Already have an approved account?</p>
                            <a href="/employee/login" class="font-weight-bold text-dark">Sign in to Employee Portal →</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<%- include('../partials/footer') %>
