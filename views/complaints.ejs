<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <!-- Subheader -->
    <section id="subheader" class="bg-dark text-light relative" style="background: linear-gradient(rgba(22, 53, 99, 0.85), rgba(15, 38, 71, 0.9)), url('/images/background/3.webp') center/cover no-repeat; padding: 110px 0 60px 0;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1 class="text-white font-weight-bold mt-2 mb-2" style="font-size: 44px; line-height: 1.2;">Register &amp; Track Complaints</h1>
                    <p class="text-white-50 mb-0" style="font-size: 17px;">Prompt on-site technical resolution within 24 to 48 hours across Raisen and Madhya Pradesh.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Support Content -->
    <section class="py-5 bg-white">
        <div class="container py-4">
            <div class="row g-5">
                <!-- Register Complaint Form -->
                <div class="col-lg-7">
                    <div class="card p-4 border-0 shadow-sm rounded-3 bg-light">
                        <h4 class="font-weight-bold text-dark mb-1">File a Service / Breakdown Request</h4>
                        <p class="text-muted small mb-4">Please provide accurate details so our local service engineer can assist you promptly.</p>

                        <form id="complaintForm" onsubmit="handleComplaintSubmit(event)">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small font-weight-bold">Customer Name *</label>
                                    <input type="text" name="customerName" class="form-control" required placeholder="Full Name">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small font-weight-bold">10-Digit Mobile *</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white">+91</span>
                                        <input type="tel" name="mobile" pattern="[6-9][0-9]{9}" maxlength="10" class="form-control" required placeholder="98XXXXXXXX">
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small font-weight-bold">Installed System Capacity</label>
                                    <input type="text" name="systemCapacity" class="form-control" placeholder="e.g. 3 kW On-Grid / 5 HP Pump">
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small font-weight-bold">Complaint Category *</label>
                                    <select name="category" class="form-select" required>
                                        <option value="inverter_error">Inverter Red Light / Error Code</option>
                                        <option value="generation_drop">Sudden Drop in Solar Generation</option>
                                        <option value="panel_physical_damage">Panel Dust / Physical Damage</option>
                                        <option value="metering_issue">Net Meter Reading Discrepancy</option>
                                        <option value="wiring_loose">Wiring / Earthing / MCB Tripping</option>
                                        <option value="general_service">Routine AMC & Cleaning Request</option>
                                    </select>
                                </div>

                                <div class="col-12">
                                    <label class="form-label small font-weight-bold">Problem Description *</label>
                                    <textarea name="description" class="form-control" rows="3" required placeholder="Describe what error is showing on the inverter display or what issue you are experiencing..."></textarea>
                                </div>

                                <div class="col-12">
                                    <button type="submit" id="complaintBtn" class="btn-main w-100 py-3" style="background: #163563; color: #fff;">
                                        <span>Submit Complaint Ticket</span>
                                    </button>
                                </div>
                            </div>
                            <div id="complaintMsg" class="mt-3" style="display: none;"></div>
                        </form>
                    </div>
                </div>

                <!-- Track Complaint & Emergency Contacts -->
                <div class="col-lg-5">
                    <!-- Ticket Tracking Widget -->
                    <div class="card p-4 border-0 shadow rounded-3 text-white mb-4" style="background: #163563;">
                        <h5 class="font-weight-bold mb-3" style="color: var(--primary-color);"><i class="icofont-search-job me-2"></i> Track Complaint Status</h5>
                        
                        <div class="mb-3">
                            <label class="form-label small text-white-50">Ticket ID *</label>
                            <input type="text" id="trackTicket" class="form-control bg-dark text-white border-secondary" placeholder="e.g. SHIVAY-10492">
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-white-50">Registered Mobile *</label>
                            <input type="tel" id="trackMobile" class="form-control bg-dark text-white border-secondary" placeholder="10-digit Mobile">
                        </div>

                        <button onclick="trackTicket()" class="btn-main w-100 py-2" style="background: var(--primary-color); color: #000; font-weight: bold;">
                            <span>Track Live Status</span>
                        </button>

                        <div id="trackResult" class="mt-3 p-3 rounded-2 bg-dark text-white small" style="display: none;"></div>
                    </div>

                    <!-- Direct Technical Helpline -->
                    <div class="card p-4 border-0 bg-light rounded-3">
                        <h6 class="font-weight-bold text-dark mb-2">Emergency Breakdown Helpline</h6>
                        <p class="text-muted small mb-3">For urgent grid failure or inverter sparking, call our technical director directly:</p>
                        
                        <div class="d-flex align-items-center mb-2">
                            <i class="icofont-phone text-danger fs-20 me-2"></i>
                            <div>
                                <strong class="d-block text-dark">Deepak Kushwaha (Technical Head)</strong>
                                <a href="tel:+917000575496" class="text-dark small">+91 70005 75496</a>
                            </div>
                        </div>

                        <div class="d-flex align-items-center">
                            <i class="icofont-phone text-warning fs-20 me-2"></i>
                            <div>
                                <strong class="d-block text-dark">Rahul Saini (Operations Head)</strong>
                                <a href="tel:+919399761750" class="text-dark small">+91 93997 61750</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
function handleComplaintSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('complaintBtn');
    const msg = document.getElementById('complaintMsg');
    btn.disabled = true;
    btn.innerHTML = '<span>Submitting ticket...</span>';

    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    fetch('/api/complaints', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(r => r.json())
    .then(res => {
        msg.style.display = 'block';
        if (res.success) {
            msg.className = 'alert alert-success p-3 small';
            msg.innerHTML = `<strong>Ticket Generated!</strong> ${res.message}<br>Aapka Ticket ID: <strong>${res.ticketId}</strong> (Ise save rakhein).`;
            e.target.reset();
        } else {
            msg.className = 'alert alert-danger p-3 small';
            msg.innerText = res.message || 'Error occurred';
        }
        btn.disabled = false;
        btn.innerHTML = '<span>Submit Complaint Ticket</span>';
    });
}

function trackTicket() {
    const ticketId = document.getElementById('trackTicket').value.trim();
    const mobile = document.getElementById('trackMobile').value.trim();
    const resultBox = document.getElementById('trackResult');

    if (!ticketId || !mobile) {
        alert('Please enter both Ticket ID and Mobile number.');
        return;
    }

    fetch(`/api/complaints/track?ticketId=${encodeURIComponent(ticketId)}&mobile=${encodeURIComponent(mobile)}`)
    .then(r => r.json())
    .then(res => {
        resultBox.style.display = 'block';
        if (res.success && res.complaint) {
            const c = res.complaint;
            resultBox.innerHTML = `
                <div class="d-flex justify-content-between mb-1">
                    <span>Ticket: <strong>${c.ticketId}</strong></span>
                    <span class="badge bg-warning text-dark text-uppercase">${c.status.replace('_', ' ')}</span>
                </div>
                <div>Issue: <strong>${c.category.replace('_', ' ')}</strong></div>
                <div class="mt-1 text-white-50">Updates: ${c.resolutionNotes || 'Technician assigned. Under review.'}</div>
            `;
        } else {
            resultBox.innerHTML = '<span class="text-danger">Ticket nahi mila. Kripya Ticket ID aur Mobile number check karein.</span>';
        }
    });
}
</script>

<style>
/* Page-specific responsive rules */
@media (min-width: 768px) {
    #content #subheader > .container { margin-top: 36px; }
}
@media (max-width: 767.98px) {
    #content { width: 100%; max-width: 100%; overflow-x: clip; }
    #content .container, #content .container-fluid { max-width: 100%; }
    #content .row > [class*="col-"] { min-width: 0; }
    #content .card, #content .card-body { min-width: 0; max-width: 100%; box-sizing: border-box; }
    #content h1, #content h2, #content h3, #content h4, #content p,
    #content small, #content strong, #content a, #content label { overflow-wrap: anywhere; }
    #content img, #content video, #content iframe { max-width: 100%; }
    #content input, #content select, #content textarea, #content button { max-width: 100%; min-width: 0; }
    #content .table-responsive { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    #content table { min-width: 620px; }
    #content .btn-main, #content .btn { white-space: normal; text-align: center; }
}
</style>
<%- include('partials/footer') %>
