        <% const navActivePage = typeof activePage !== 'undefined' ? activePage : ''; %>
        <!-- header begin -->
        <header class="transparent">
            <div id="topbar">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="d-flex justify-content-between xs-hide align-items-center">
                                <div class="d-flex align-items-center">
                                    <div class="topbar-widget me-4">
                                        <a href="/contact" title="Visit us in Raisen, MP">
                                            <i class="icofont-location-pin"></i>Arjun Nagar, Raisen (M.P.)
                                        </a>
                                    </div>
                                    <div class="topbar-widget me-4">
                                        <a href="tel:+917000575496" title="Call Deepak Kushwaha">
                                            <i class="icofont-phone"></i>+91 70005 75496
                                        </a>
                                    </div>
                                    <div class="topbar-widget">
                                        <a href="mailto:<%= company.email %>" title="Email Shivay Energy">
                                            <i class="icofont-envelope"></i><%= company.email %>
                                        </a>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center">
                                    <div class="social-icons">
                                        <a href="<%= company.social.whatsapp %>" target="_blank" title="Chat on WhatsApp" class="text-success"><i class="fa-brands fa-whatsapp fa-lg"></i></a>
                                        <a href="<%= company.social.facebook %>" target="_blank" title="Facebook"><i class="fa-brands fa-facebook fa-lg"></i></a>
                                        <a href="<%= company.social.instagram %>" target="_blank" title="Instagram"><i class="fa-brands fa-instagram fa-lg"></i></a>
                                        <a href="<%= company.social.youtube %>" target="_blank" title="YouTube"><i class="fa-brands fa-youtube fa-lg"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>

            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="de-flex sm-pt10 align-items-center">
                            <div class="de-flex-col">
                                <!-- logo begin -->
                                <div id="logo">
                                    <a href="/" class="d-flex align-items-center text-decoration-none">
                                        <img class="logo-main" src="/images/logo-icon.webp" alt="Shivay Energy" style="height: 38px; margin-right: 8px;">
                                        <span style="font-weight: 700; font-size: 24px; letter-spacing: -0.3px; color: #ffffff;">shivay</span>
                                    </a>
                                </div>
                                <!-- logo end -->
                            </div>
                            <div class="de-flex-col header-col-mid">
                                <!-- mainmenu begin -->
                                <ul id="mainmenu">
                                    <li><a class="menu-item <%= navActivePage === 'home' ? 'active' : '' %>" href="/">Home</a></li>
                                    <li><a class="menu-item <%= navActivePage === 'services' ? 'active' : '' %>" href="/services">Services</a></li>
                                    <li><a class="menu-item <%= navActivePage === 'projects' ? 'active' : '' %>" href="/projects">Recent Projects</a></li>
                                    <li><a class="menu-item <%= navActivePage === 'about' ? 'active' : '' %>" href="/about">About Us</a></li>
                                    <li><a class="menu-item <%= navActivePage === 'contact' ? 'active' : '' %>" href="/contact">Contact</a></li>
                                    <li><a class="menu-item <%= navActivePage === 'franchise' ? 'active' : '' %>" href="/franchise">Channel Partner</a></li>
                                </ul>
                                <!-- mainmenu end -->
                            </div>
                            <div class="de-flex-col">
                                <div class="menu_side_area d-flex align-items-center">
                                    <a href="/calculator" class="btn-main btn-line fx-slide hover-white navbar-quote-btn"><span>Get a Quote</span></a>
                                    <a href="/contact#enquiry-form" class="btn-main btn-line fx-slide hover-white ms-2 navbar-enquiry-btn"><span>Enquiry</span></a>
                                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                                        <a href="<%= currentUser.role === 'SUPER_ADMIN' ? '/admin' : (currentUser.role === 'BRANCH_MANAGER' ? '/manager/dashboard' : '/employee/dashboard') %>" class="btn btn-sm btn-outline-light ms-2 d-none d-lg-inline-flex align-items-center" title="Go to <%= currentUser.role %> Portal">
                                            <i class="icofont-ui-user me-1 text-warning"></i> <%= currentUser.name.split(' ')[0] %>
                                        </a>
                                        <a href="/auth/logout" class="btn btn-sm btn-outline-danger ms-1 d-none d-lg-inline-flex" title="Sign Out">
                                            <i class="icofont-logout"></i>
                                        </a>
                                    <% } %>
                                    <span id="menu-btn"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <!-- header end -->
