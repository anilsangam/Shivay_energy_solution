<div class="solar-input-card contact-enquiry-card text-dark">
    <div class="text-center mb-3">
        <h4 class="solar-input-heading mb-1">Request a Free Solar Site Survey</h4>
        <p class="text-muted small">Avail up to ₹78,000 PM Surya Ghar Govt Subsidy in Madhya Pradesh</p>
    </div>

    <form id="solarEnquiryForm" onsubmit="handleEnquirySubmit(event)">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small font-weight-bold">Full Name *</label>
                <input type="text" name="name" class="form-control" placeholder="e.g. Ramesh Kumar" required>
            </div>
            <div class="col-md-6">
                <label class="form-label small font-weight-bold">10-Digit Mobile Number *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light">+91</span>
                    <input type="tel" name="mobile" pattern="[6-9][0-9]{9}" maxlength="10" class="form-control" placeholder="98XXXXXXXX" required>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label small font-weight-bold">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="name@example.com">
            </div>

            <div class="col-md-6">
                <label class="form-label small font-weight-bold">State *</label>
                <select name="state" id="enquiryState" class="form-select" required>
                    <% data.regions.states.forEach(st => { %>
                        <option value="<%= st %>" <%= st === 'Madhya Pradesh' ? 'selected' : '' %>><%= st %></option>
                    <% }); %>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label small font-weight-bold">District *</label>
                <select name="district" id="enquiryMpDistrict" class="form-select" required>
                    <% data.regions.mpDistricts.forEach(dst => { %>
                        <option value="<%= dst %>" <%= dst === 'Raisen' ? 'selected' : '' %>><%= dst %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-6" id="enquiryOtherDistrictField" hidden>
                <label class="form-label small font-weight-bold" for="enquiryOtherDistrict">District *</label>
                <input type="text" name="district" id="enquiryOtherDistrict" class="form-control" placeholder="Enter your district" disabled>
            </div>

            <div class="col-md-6">
                <label class="form-label small font-weight-bold">PIN Code *</label>
                <input type="text" name="pincode" pattern="[0-9]{6}" maxlength="6" class="form-control" placeholder="464551" required>
            </div>

            <div class="col-md-6">
                <label class="form-label small font-weight-bold">Solar Requirement *</label>
                <select name="solarRequirement" class="form-select" required>
                    <option value="Residential Rooftop (PM Surya Ghar Subsidy)">Residential Rooftop (PM Surya Ghar Subsidy)</option>
                    <option value="Commercial & Industrial On-Grid Plant">Commercial & Industrial On-Grid Plant</option>
                    <option value="Agricultural Solar Pump (KUSUM)">Agricultural Solar Pump (KUSUM)</option>
                    <option value="Hybrid / Battery Storage System">Hybrid / Battery Storage System</option>
                    <option value="Solar Maintenance & AMC">Solar Maintenance & AMC</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label small font-weight-bold">Avg. Monthly Electricity Bill (₹) *</label>
                <select name="monthlyBill" class="form-select" required>
                    <option value="1500">Below ₹1,500 / month (1 - 2 kW)</option>
                    <option value="3000" selected>₹1,500 - ₹3,500 / month (2 - 3 kW)</option>
                    <option value="6000">₹3,500 - ₹8,000 / month (3 - 5 kW)</option>
                    <option value="15000">₹8,000 - ₹20,000 / month (5 - 10 kW)</option>
                    <option value="50000">Above ₹20,000 / month (Commercial / 15kW+)</option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label small font-weight-bold">Rooftop / Site Address or Message</label>
                <textarea name="message" class="form-control" rows="2" placeholder="Tell us about your rooftop area, village/colony or specific query..."></textarea>
            </div>

            <div class="col-12 text-center mt-3">
                <button type="submit" id="enquirySubmitBtn" class="btn-main w-100 py-3 font-weight-bold" style="background: var(--primary-color); color: #000; border: none; font-size: 16px;">
                    <span>⚡ Get Free Consultation & Solar Quote</span>
                </button>
            </div>
        </div>
        <div id="enquiryAlert" class="mt-3" style="display: none;"></div>
    </form>
</div>

<script>
(() => {
    const state = document.getElementById('enquiryState');
    const mpDistrict = document.getElementById('enquiryMpDistrict');
    const otherField = document.getElementById('enquiryOtherDistrictField');
    const otherDistrict = document.getElementById('enquiryOtherDistrict');
    if (!state || !mpDistrict || !otherField || !otherDistrict) return;

    const syncDistrictField = () => {
        const isMp = state.value === 'Madhya Pradesh';
        mpDistrict.disabled = !isMp;
        mpDistrict.required = isMp;
        mpDistrict.closest('.col-md-6').hidden = !isMp;
        otherField.hidden = isMp;
        otherDistrict.disabled = isMp;
        otherDistrict.required = !isMp;
    };
    state.addEventListener('change', syncDistrictField);
    syncDistrictField();
})();

function handleEnquirySubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('enquirySubmitBtn');
    const alertBox = document.getElementById('enquiryAlert');
    btn.disabled = true;
    btn.innerHTML = '<span>Submitting enquiry...</span>';

    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    fetch('/api/enquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(r => r.json())
    .then(res => {
        alertBox.style.display = 'block';
        if (res.success) {
            alertBox.className = 'alert alert-success p-3 small';
            alertBox.innerHTML = `<strong>Dhanyawad!</strong> ${res.message} <br><a href="${res.whatsappRedirect}" target="_blank" class="btn btn-sm btn-success mt-2 text-white"><i class="fa-brands fa-whatsapp me-1"></i> Connect on WhatsApp Now</a>`;
            e.target.reset();
        } else {
            alertBox.className = 'alert alert-danger p-3 small';
            alertBox.innerText = res.message || 'Please check your inputs.';
        }
        btn.disabled = false;
        btn.innerHTML = '<span>⚡ Get Free Consultation & Solar Quote</span>';
    })
    .catch(err => {
        alertBox.style.display = 'block';
        alertBox.className = 'alert alert-danger p-3 small';
        alertBox.innerText = 'Network issue. Please call Deepak Kushwaha directly at +91 70005 75496.';
        btn.disabled = false;
        btn.innerHTML = '<span>⚡ Get Free Consultation & Solar Quote</span>';
    });
}
</script>
