<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <!-- Subheader -->
    <section id="subheader" class="bg-dark text-light relative projects-hero" style="background: linear-gradient(rgba(22, 53, 99, 0.85), rgba(15, 38, 71, 0.9)), url('/images/background/w2.webp') center/cover no-repeat;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8 projects-hero-copy">
                    <h1 class="text-white font-weight-bold">Recent Solar Projects</h1>
                    <p class="text-white-50 mb-0">Explore solar installations for homes, businesses, and farms across Madhya Pradesh.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- All Installations Detailed Grid -->
    <section class="projects-list bg-white">
        <div class="container">
            <span class="projects-eyebrow projects-list-eyebrow">Our Work</span>
            <div class="row g-4 projects-grid">
                <% data.projects.forEach((project, idx) => { %>
                    <div class="col-lg-4 col-md-6 project-column wow fadeInUp" data-wow-delay="<%= 0.1 * (idx + 1) %>s">
                        <article class="card project-card h-100 border-0 shadow-sm overflow-hidden bg-white">
                            <div class="project-card-image position-relative">
                                <img src="<%= project.image %>" class="img-fluid w-100 h-100 object-fit-cover" alt="<%= project.title %>">
                                <span class="badge project-capacity position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill">
                                    <%= project.capacity %>
                                </span>
                            </div>
                            <div class="card-body project-card-body d-flex flex-column" style="min-width: 0;">
                                <div class="project-card-copy">
                                    <span class="badge project-category mb-2 px-3 py-1 rounded-pill">
                                        <%= project.category %>
                                    </span>
                                    <h2 class="font-weight-bold text-dark project-card-title"><%= project.title %></h2>
                                    <p class="project-location"><i class="icofont-location-pin me-1"></i><%= project.location %></p>
                                    <p class="project-description"><%= project.description %></p>
                                </div>
                                <div class="project-card-meta border-top small text-muted d-flex justify-content-between">
                                    <span>Panels: <strong><%= project.panels.split(' ')[0] %> Mono PERC</strong></span>
                                    <span>Year: <strong><%= project.year %></strong></span>
                                </div>
                            </div>
                        </article>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Consultation CTA -->
    <section class="py-5 text-white" style="background: #0f2647;">
        <div class="container text-center py-3">
            <h2 class="text-white font-weight-bold mb-2" style="font-size: 32px;">Ready to Power Your Rooftop with Solar?</h2>
            <p class="text-white-50 mb-4">Contact Deepak Kushwaha (+91 70005 75496) &amp; Rahul Saini (+91 93997 61750) for a free site assessment.</p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a href="/calculator" class="btn-main fx-slide" style="background: var(--primary-color); color: #000; border-radius: 30px; padding: 12px 30px; font-weight: 700;">
                    <span>Calculate Solar Savings</span>
                </a>
                <a href="/contact" class="btn-main btn-line fx-slide hover-white" style="color: #fff !important; border: 1px solid rgba(255,255,255,.85); border-radius: 30px; padding: 12px 30px; font-weight: 700;">
                    <span style="color: #fff !important;">Contact Us</span>
                </a>
            </div>
        </div>
    </section>
</div>

<style>
/* Page-specific responsive rules */
#content #subheader.projects-hero { min-height: 310px !important; padding: 110px 0 64px !important; }
.projects-hero .container { margin-top: 0; }
.projects-eyebrow { display: block; margin-bottom: 9px; color: var(--primary-color, #FBEC6B); font-size: 12px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; }
.projects-list-eyebrow { margin-bottom: 18px; color: #163563; }
#content #subheader.projects-hero h1 { max-width: 780px; margin: 10px 0 !important; font-size: clamp(34px, 5vw, 54px) !important; font-weight: 800; line-height: 1.1 !important; text-transform: none; }
.projects-hero p { max-width: 620px; margin: 0; color: rgba(255,255,255,.78); font-size: clamp(15px, 2vw, 18px); line-height: 1.55; }
.projects-list { padding: 42px 0 58px; }
.projects-grid { row-gap: 22px; }
.project-card { border-radius: 16px; transition: transform .22s ease, box-shadow .22s ease; }
.project-card:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(16, 36, 68, .12) !important; }
.project-card-image { height: 210px; overflow: hidden; background: #edf2f7; }
.project-card-image img { display: block; object-fit: cover; }
.project-capacity { background: #163563; color: var(--primary-color, #FBEC6B); font-size: 12px; font-weight: 750; }
.project-card-body { min-width: 0; gap: 12px; padding: 20px; overflow-wrap: anywhere; }
.project-card-copy, .project-card-copy * { min-width: 0; max-width: 100%; }
.project-category { background: rgba(22, 53, 99, .08); color: #163563; font-size: 11px; font-weight: 700; }
.project-card-title { margin: 0 0 7px; font-size: 19px; line-height: 1.3; overflow-wrap: anywhere; }
.project-location { margin: 0 0 9px; color: #67778c; font-size: 13px; }
.project-location i { color: #bd4650; }
.project-description { display: -webkit-box; width: 100%; margin: 0; overflow: hidden; color: #536276; font-size: 13px; line-height: 1.55; white-space: normal !important; overflow-wrap: anywhere; word-break: normal; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
.project-card-meta { min-width: 0; gap: 10px; margin-top: auto; padding-top: 12px; font-size: 11px; flex-wrap: wrap; }
.project-card-meta span { min-width: 0; overflow-wrap: anywhere; }
.project-card-meta strong { color: #33465e; overflow-wrap: anywhere; }
@media (min-width: 768px) {
    #content #subheader > .container { margin-top: 0; }
}
@media (max-width: 767.98px) {
    #content { width: 100%; max-width: 100%; overflow-x: clip; }
    #content .container, #content .container-fluid { max-width: 100%; }
    #content .row > [class*="col-"] { min-width: 0; }
    #content .card, #content .card-body { min-width: 0; max-width: 100%; box-sizing: border-box; }
    #content h1, #content h2, #content h3, #content h4, #content p,
    #content small, #content strong, #content a, #content label { overflow-wrap: anywhere; }
    #content img, #content video, #content iframe { max-width: 100%; }
    #content input, #content select, #content textarea, #content button { max-width: 100%; min-width: 0; }
    #content .table-responsive { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    #content table { min-width: 620px; }
    #content .btn-main, #content .btn { white-space: normal; text-align: center; }
    #content #subheader .container { margin-top: 0 !important; }
    #content #subheader.projects-hero { min-height: 300px !important; padding: 122px 0 48px !important; }
    #content .projects-list { padding: 24px 0 38px; }
    #content .projects-list > .container { padding-left: 16px; padding-right: 16px; }
    #content .projects-grid { margin-left: 0; margin-right: 0; row-gap: 16px; }
    #content .project-column { padding-left: 0; padding-right: 0; }
    #content .project-card-image { height: 190px; }
    #content .project-card-body { gap: 10px; padding: 16px; }
    #content .project-card-title { font-size: 17px; }
    #content .project-description { white-space: normal !important; overflow-wrap: anywhere; word-break: normal; }
    #content .project-card-meta { font-size: 10px; }
    #content .text-center > .d-flex.flex-wrap { gap: 10px !important; }
    #content .text-center > .d-flex.flex-wrap > a { min-height: 44px; }
}
@media (max-width: 575.98px) {
    #content #subheader.projects-hero { min-height: 286px !important; padding: 116px 0 42px !important; }
}
</style>
<%- include('partials/footer') %>
