<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="catalog-page" id="content">
    <section class="catalog-hero" style="--hero-image: url('/images/background/3.webp')">
        <div class="container">
            <h1>Solar &amp; EV Services</h1>
            <p>Solar installation, EV charging and maintenance in Madhya Pradesh.</p>
        </div>
    </section>

    <section class="catalog-section">
        <div class="container">
            <div class="catalog-grid services-grid">
                <% data.services.forEach((service, index) => { %>
                    <article class="catalog-card service-tile" id="<%= service.id %>" style="--card-delay: <%= index * 45 %>ms">
                        <div class="service-tile-image"><img src="/<%= service.image %>" alt="<%= service.title %>" loading="lazy"></div>
                        <div class="catalog-card-top">
                            <span class="catalog-icon"><i class="<%= service.icon %>"></i></span>
                            <span class="catalog-number"><%= String(index + 1).padStart(2, '0') %></span>
                        </div>
                        <h3><%= service.title %></h3>
                        <p><%= service.shortDesc %></p>
                        <ul class="catalog-points">
                            <% service.highlights.slice(0, 2).forEach(point => { %>
                                <li><i class="icofont-check-circled"></i><span><%= point %></span></li>
                            <% }); %>
                        </ul>
                        <div class="catalog-actions">
                            <a class="catalog-action-button catalog-action-outline" href="/contact#enquiry-form">Discuss service <i class="icofont-arrow-right"></i></a>
                            <a class="catalog-action-button catalog-action-primary" href="/calculator#solar-calculator">Get Quote</a>
                        </div>
                    </article>
                <% }); %>
            </div>
        </div>
    </section>

    <section class="catalog-cta">
        <div class="container catalog-cta-inner">
            <div><span class="catalog-eyebrow">Your next step</span><h2>Need a solution for your site?</h2><p>Tell us what you are planning and our team will help you get started.</p></div>
            <a href="/contact#enquiry-form" class="catalog-button">Request a consultation <i class="icofont-arrow-right"></i></a>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
