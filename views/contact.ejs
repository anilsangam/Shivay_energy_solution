<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <!-- Subheader -->
    <section id="subheader" class="bg-dark text-light relative contact-hero" style="background: linear-gradient(rgba(22, 53, 99, 0.85), rgba(15, 38, 71, 0.9)), url('/images/background/2.webp') center/cover no-repeat;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1 class="text-white font-weight-bold"><%= company.name %></h1>
                    <p class="text-white-50 mb-0">Headquartered in Raisen, Madhya Pradesh. Reach our founders and technical team directly.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact & Enquiry Section -->
    <section class="contact-content bg-white">
        <div class="container">
            <div class="row g-5 contact-grid">
                <!-- Contact Details Cards -->
                <div class="col-lg-5">
                    <h3 class="font-weight-bold text-dark mb-4">Registered Office & Details</h3>

                    <div class="card contact-details-card border-0 shadow-sm mb-4">
                        <div class="d-flex align-items-start mb-3 contact-detail-row">
                            <div class="contact-detail-icon"><i class="icofont-location-pin"></i></div>
                            <div class="contact-detail-copy">
                                <h6 class="font-weight-bold text-dark mb-1">Office Address:</h6>
                                <a class="contact-address-link small" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(company.address.full) %>" target="_blank" rel="noopener noreferrer"><%= company.address.full %></a>
                            </div>
                        </div>

                        <div class="d-flex align-items-start mb-3 contact-detail-row">
                            <div class="contact-detail-icon contact-hours-icon"><i class="icofont-clock-time"></i></div>
                            <div class="contact-detail-copy">
                                <h6 class="font-weight-bold text-dark mb-1">Working Hours:</h6>
                                <p class="text-secondary small mb-0"><%= company.workingHours.days %><br><%= company.workingHours.time %></p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start contact-detail-row">
                            <div class="contact-detail-icon contact-email-icon"><i class="icofont-envelope"></i></div>
                            <div class="contact-detail-copy">
                                <h6 class="font-weight-bold text-dark mb-1">Email Address:</h6>
                                <a href="mailto:<%= company.email %>" class="contact-email-link small"><%= company.email %></a>
                            </div>
                        </div>
                    </div>

                    <h5 class="font-weight-bold text-dark mb-3">Direct Contact Persons</h5>
                    <div class="row g-3">
                        <% company.contacts.forEach(c => { %>
                            <div class="col-12">
                                <div class="card contact-person-card p-3 border-0 shadow-sm bg-white">
                                    <div class="d-flex justify-content-between align-items-center contact-person-layout">
                                        <div class="contact-person-copy">
                                            <h6 class="font-weight-bold mb-0 text-dark"><%= c.name %></h6>
                                            <small class="text-muted d-block"><%= c.designation %></small>
                                            <a href="tel:<%= c.mobile.replace(/[^0-9+]/g, '') %>" class="contact-person-phone font-weight-bold text-dark text-decoration-none small"><i class="icofont-phone"></i> <%= c.mobile %></a>
                                        </div>
                                        <div class="contact-person-action">
                                            <a href="<%= c.whatsapp %>" target="_blank" rel="noopener noreferrer" class="contact-whatsapp-button" aria-label="Chat with <%= c.name %> on WhatsApp">
                                                <i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span>WhatsApp</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <!-- Enquiry Form -->
                <div class="col-lg-7 contact-form-column" id="enquiry-form">
                    <%- include('partials/enquiryForm') %>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
/* Page-specific responsive rules */
#content #subheader.contact-hero { min-height: 310px !important; padding: 130px 0 64px !important; }
#content #subheader.contact-hero > .container { margin-top: 0; }
#content #subheader.contact-hero h1 { max-width: 780px; margin: 10px 0 !important; font-size: clamp(34px, 5vw, 54px) !important; font-weight: 800; line-height: 1.1 !important; text-transform: none; }
#content #subheader.contact-hero p { max-width: 620px; margin: 0; font-size: clamp(15px, 2vw, 18px) !important; line-height: 1.55; }
.contact-content { padding: 54px 0 68px; }
.contact-content > .container { max-width: 1240px; }
.contact-grid { align-items: start; }
.contact-content h3, .contact-content h5 { color: #102444; }
.contact-details-card { min-width: 0; padding: 24px; border-radius: 16px; background: #f5f8fc; }
.contact-detail-row { min-width: 0; gap: 13px; }
.contact-detail-icon { display: grid; flex: 0 0 38px; width: 38px; height: 38px; place-items: center; border-radius: 11px; background: #fff3be; color: #163563; font-size: 19px; }
.contact-hours-icon { background: #eaf1fb; }
.contact-email-icon { background: #e9f5f2; }
.contact-detail-copy, .contact-person-copy { flex: 1 1 0%; width: 0; min-width: 0; overflow-wrap: anywhere; }
.contact-detail-copy h6 { line-height: 1.35; }
.contact-detail-copy p, .contact-detail-copy a, .contact-person-copy h6, .contact-person-copy small, .contact-person-copy a { max-width: 100%; white-space: normal; overflow-wrap: anywhere; word-break: break-word; }
.contact-address-link, .contact-email-link { color: #1b3b68 !important; text-decoration: underline; text-decoration-color: rgba(27,59,104,.5); text-underline-offset: 3px; }
.contact-address-link { display: block; line-height: 1.55; }
.contact-address-link:hover, .contact-email-link:hover { color: #0d2748 !important; text-decoration-color: currentColor; }
.contact-person-phone { display: inline-block; margin-top: 4px; }
.contact-person-phone i { color: #167a59; }
.contact-whatsapp-button { display: inline-flex; min-height: 40px; align-items: center; justify-content: center; gap: 7px; padding: 8px 13px; border-radius: 10px; background: #16845b; color: #fff; font-size: 12px; font-weight: 700; line-height: 1; text-decoration: none; white-space: nowrap; }
.contact-whatsapp-button:hover { background: #116a49; color: #fff; }
.contact-whatsapp-button i { font-size: 18px; }
.contact-person-card { min-width: 0; border-radius: 14px; border-left: 4px solid #163563 !important; }
.contact-person-layout { min-width: 0; gap: 12px; flex-wrap: wrap; }
.contact-person-action { flex: 0 0 auto; }
.contact-form-column { min-width: 0; scroll-margin-top: 110px; }
#enquiry-form > .contact-enquiry-card { width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; border-radius: 16px; background: #f7f9fc; }
#enquiry-form .solar-input-heading { margin-bottom: 8px !important; }
#enquiry-form .row, #enquiry-form .col-12, #enquiry-form [class*="col-"] { min-width: 0; }
#enquiry-form input, #enquiry-form select, #enquiry-form textarea, #enquiry-form button { width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; }
#enquiry-form .input-group { min-width: 0; flex-wrap: nowrap; }
#enquiry-form .input-group > * { min-width: 0; }
#enquiry-form .form-control, #enquiry-form .form-select { border-radius: 9px; }
#enquiry-form textarea { resize: vertical; }
@media (min-width: 768px) {
    #content #subheader.contact-hero > .container { margin-top: 0; }
}
@media (max-width: 767.98px) {
    #content #subheader.contact-hero { height: auto !important; min-height: 0 !important; padding: 100px 0 32px !important; }
    #content { width: 100%; max-width: 100%; overflow-x: clip; }
    #content .container, #content .container-fluid { max-width: 100%; }
    #content .row > [class*="col-"] { min-width: 0; }
    #content .card, #content .card-body { min-width: 0; max-width: 100%; box-sizing: border-box; }
    #content h1, #content h2, #content h3, #content h4, #content p,
    #content small, #content strong, #content a, #content label { overflow-wrap: anywhere; }
    #content img, #content video, #content iframe { max-width: 100%; }
    #content input, #content select, #content textarea, #content button { max-width: 100%; min-width: 0; }
    #content .table-responsive { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    #content table { min-width: 620px; }
    #content .btn-main, #content .btn { white-space: normal; text-align: center; }
    #content .contact-content { padding: 30px 0 42px; }
    #content .contact-content > .container { padding-left: 16px; padding-right: 16px; }
    #content .contact-grid { --bs-gutter-x: 1rem; --bs-gutter-y: 1.5rem; margin-top: 0; }
    #content .contact-content h3 { margin-bottom: 18px !important; font-size: 22px; }
    #content .contact-details-card { padding: 18px; }
    #content .contact-person-card { padding: 14px !important; }
    #content .contact-person-layout { align-items: flex-start !important; }
    #content .contact-person-action { flex: 0 0 auto; }
    #content .contact-whatsapp-button { min-width: 42px; min-height: 42px; gap: 5px; padding: 9px 10px; border-radius: 11px; }
    #content .contact-whatsapp-button i { font-size: 21px; }
    #content .contact-form-column { padding: 0; }
    #enquiry-form > .contact-enquiry-card { padding: 18px; box-shadow: 0 8px 24px rgba(22,53,99,.08); }
    #enquiry-form h4 { font-size: 20px; line-height: 1.3; }
    #enquiry-form .row { --bs-gutter-x: .75rem; --bs-gutter-y: .85rem; }
    #enquiry-form .input-group-text { flex: 0 0 auto; padding: .375rem .55rem; }
    #enquiry-form .form-control, #enquiry-form .form-select { min-height: 44px; font-size: 14px; }
    #enquiry-form textarea.form-control { min-height: 84px; }
}
@media (max-width: 575.98px) {
    #content #subheader.contact-hero { height: auto !important; min-height: 0 !important; padding: 92px 0 26px !important; }
}
</style>
<%- include('partials/footer') %>
