<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <!-- Subheader -->
    <section id="subheader" class="bg-dark text-light relative" style="background: linear-gradient(rgba(22, 53, 99, 0.85), rgba(15, 38, 71, 0.9)), url('/images/background/2.webp') center/cover no-repeat; padding: 110px 0 60px 0;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1 class="text-white font-weight-bold mt-2 mb-2" style="font-size: 44px; line-height: 1.2;">Contact <%= company.name %></h1>
                    <p class="text-white-50 mb-0" style="font-size: 17px;">Headquartered in Raisen, Madhya Pradesh. Reach our founders and technical team directly.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact & Enquiry Section -->
    <section class="py-5 bg-white">
        <div class="container py-4">
            <div class="row g-5">
                <!-- Contact Details Cards -->
                <div class="col-lg-5">
                    <h3 class="font-weight-bold text-dark mb-4">Registered Office & Details</h3>

                    <div class="card p-4 border-0 shadow-sm rounded-3 mb-4 bg-light">
                        <div class="d-flex align-items-start mb-3">
                            <div class="me-3 fs-30 text-primary"><i class="icofont-location-pin text-danger"></i></div>
                            <div>
                                <h6 class="font-weight-bold text-dark mb-1">Office Address:</h6>
                                <p class="text-secondary small mb-0"><%= company.address.full %></p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start mb-3">
                            <div class="me-3 fs-30 text-primary"><i class="icofont-clock-time text-warning"></i></div>
                            <div>
                                <h6 class="font-weight-bold text-dark mb-1">Working Hours:</h6>
                                <p class="text-secondary small mb-0"><%= company.workingHours.days %><br><%= company.workingHours.time %></p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start">
                            <div class="me-3 fs-30 text-primary"><i class="icofont-envelope text-info"></i></div>
                            <div>
                                <h6 class="font-weight-bold text-dark mb-1">Email Address:</h6>
                                <a href="mailto:<%= company.email %>" class="text-secondary small text-decoration-none"><%= company.email %></a>
                            </div>
                        </div>
                    </div>

                    <h5 class="font-weight-bold text-dark mb-3">Direct Contact Persons</h5>
                    <div class="row g-3">
                        <% company.contacts.forEach(c => { %>
                            <div class="col-12">
                                <div class="card p-3 border-0 shadow-sm rounded-3 bg-white border-start border-4 border-primary">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="font-weight-bold mb-0 text-dark"><%= c.name %></h6>
                                            <small class="text-muted d-block"><%= c.designation %></small>
                                            <a href="tel:<%= c.mobile %>" class="font-weight-bold text-dark text-decoration-none small"><i class="icofont-phone text-success"></i> <%= c.mobile %></a>
                                        </div>
                                        <div>
                                            <a href="<%= c.whatsapp %>" target="_blank" class="btn btn-sm btn-success text-white">
                                                <i class="fa-brands fa-whatsapp"></i> Chat
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <!-- Enquiry Form -->
                <div class="col-lg-7" id="enquiry-form">
                    <%- include('partials/enquiryForm') %>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
/* Page-specific responsive rules */
@media (min-width: 768px) {
    #content #subheader > .container { margin-top: 36px; }
}
@media (max-width: 767.98px) {
    #content { width: 100%; max-width: 100%; overflow-x: clip; }
    #content .container, #content .container-fluid { max-width: 100%; }
    #content .row > [class*="col-"] { min-width: 0; }
    #content .card, #content .card-body { min-width: 0; max-width: 100%; box-sizing: border-box; }
    #content h1, #content h2, #content h3, #content h4, #content p,
    #content small, #content strong, #content a, #content label { overflow-wrap: anywhere; }
    #content img, #content video, #content iframe { max-width: 100%; }
    #content input, #content select, #content textarea, #content button { max-width: 100%; min-width: 0; }
    #content .table-responsive { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    #content table { min-width: 620px; }
    #content .btn-main, #content .btn { white-space: normal; text-align: center; }
}
</style>
<%- include('partials/footer') %>
