<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <!-- Subheader -->
    <section id="subheader" class="bg-dark text-light relative" style="background: linear-gradient(rgba(22, 53, 99, 0.85), rgba(15, 38, 71, 0.9)), url('/images/background/3.webp') center/cover no-repeat; padding: 110px 0 60px 0;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1 class="text-white font-weight-bold mt-2 mb-2" style="font-size: 44px; line-height: 1.2;">Energy Calculators</h1>
                    <p class="text-white-50 mb-0" style="font-size: 17px;">Estimate solar savings or calculate your home backup load.</p>
                </div>
            </div>
        </div>
    </section>

    <div id="connectedCalculator" class="calculator-connected-shell">
    <svg class="calculator-connected-outline" aria-hidden="true" focusable="false">
        <path id="calculatorOutlinePath"></path>
    </svg>
    <section class="calculator-picker-section" aria-label="Choose a calculator">
        <div class="container">
            <div class="calculator-switcher" role="group" aria-label="Choose a calculator">
                <button type="button" class="calculator-picker active" data-calculator-target="solar-calculator" aria-controls="solar-calculator" aria-pressed="true">
                    <i class="icofont-sun"></i><span>Solar Calculator</span>
                </button>
                <button type="button" class="calculator-picker" data-calculator-target="load-calculator" aria-controls="load-calculator" aria-pressed="false">
                    <i class="icofont-light-bulb"></i><span>Load Calculator</span>
                </button>
            </div>
        </div>
    </section>

    <!-- Solar Calculator -->
    <section id="solar-calculator" class="calculator-content-panel calculator-workspace">
        <div class="container py-4">
            <div class="row g-4 g-lg-5 calculator-layout">
                <!-- Calculator Inputs -->
                <div class="col-lg-5">
                    <div class="solar-input-card">
                        <h4 class="solar-input-heading">Enter Electricity Details</h4>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold small">Monthly Electricity Bill (₹):</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white">₹</span>
                                <input type="number" id="calcBill" class="form-control" value="3000" min="500" step="100" oninput="runCalculator()">
                            </div>
                            <input type="range" class="form-range mt-2" id="calcBillRange" min="500" max="25000" step="100" value="3000" oninput="syncBillInput(this.value)">
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold small">Estimated Monthly Units (kWh):</label>
                            <input type="number" id="calcUnits" class="form-control" value="400" min="50" step="10" oninput="runCalculator(true)">
                            <small class="text-muted">Auto-calculated based on tariff or enter manually.</small>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label font-weight-bold small">Tariff (₹ / unit):</label>
                                <input type="number" id="calcTariff" class="form-control" value="7.5" step="0.5" oninput="runCalculator()">
                            </div>
                            <div class="col-6">
                                <label class="form-label font-weight-bold small">Property Type:</label>
                                <select id="calcProperty" class="form-select" onchange="runCalculator()">
                                    <option value="residential" selected>Residential (Subsidized)</option>
                                    <option value="commercial">Commercial / Factory</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label font-weight-bold small">State:</label>
                                <select class="form-select" id="calcState" onchange="syncCalculatorDistrict()">
                                    <% data.regions.states.forEach(st => { %>
                                        <option value="<%= st %>" <%= st === 'Madhya Pradesh' ? 'selected' : '' %>><%= st %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="col-6" id="calcMpDistrictField">
                                <label class="form-label font-weight-bold small">District:</label>
                                <select class="form-select" id="calcDistrict">
                                    <% data.regions.mpDistricts.forEach(d => { %>
                                        <option value="<%= d %>" <%= d === 'Raisen' ? 'selected' : '' %>><%= d %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="col-6" id="calcOtherDistrictField" hidden>
                                <label class="form-label font-weight-bold small" for="calcOtherDistrict">District:</label>
                                <input class="form-control" id="calcOtherDistrict" type="text" placeholder="Enter your district" disabled>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold small">Available Rooftop Area (sq ft):</label>
                            <input type="number" id="calcArea" class="form-control" value="400" min="50" step="50">
                            <small class="text-muted">Approx 100 sq ft required per 1 kW.</small>
                        </div>
                    </div>
                </div>

                <!-- Calculator Results Display -->
                <div class="col-lg-7">
                    <div class="solar-results-card calculator-results-card">
                        <span class="solar-results-badge">
                            ☀️ Calculated Estimation for Central India
                        </span>

                        <div class="row g-3 text-center mb-4">
                            <div class="col-sm-4">
                                <div class="solar-metric-card">
                                    <small class="text-white-50 d-block">Recommended Capacity</small>
                                    <h2 class="font-weight-bold mb-0 solar-capacity-value"><span id="outKw">3.0</span> kW</h2>
                                    <small class="text-white-50"><span id="outPanels">6</span> Panels (540W)</small>
                                </div>
                            </div>

                            <div class="col-sm-4">
                                <div class="solar-metric-card">
                                    <small class="text-white-50 d-block">Monthly Generation</small>
                                    <h2 class="font-weight-bold mb-0 text-white"><span id="outGen">360</span></h2>
                                    <small class="text-white-50">Units (kWh) / Month</small>
                                </div>
                            </div>

                            <div class="col-sm-4">
                                <div class="solar-metric-card">
                                    <small class="text-white-50 d-block">Monthly Savings</small>
                                    <h2 class="font-weight-bold mb-0 solar-savings-value"><span id="outSavings">₹2,700</span></h2>
                                    <small class="text-white-50"><span id="outAnnualSavings">₹32,400</span> / Year</small>
                                </div>
                            </div>
                        </div>

                        <!-- Financial & Subsidy Breakdown -->
                        <div class="solar-investment-breakdown calculator-investment-breakdown">
                            <h5 class="font-weight-bold text-white mb-3 border-bottom pb-2 border-secondary">Investment & Subsidy Breakdown</h5>
                            
                            <div class="d-flex justify-content-between py-2 border-bottom border-secondary small investment-breakdown-row">
                                <span class="text-white-50 investment-breakdown-label">Estimated System Cost (Approx):</span>
                                <strong class="text-white" id="outGrossCost">₹1,74,000</strong>
                            </div>

                            <div class="d-flex justify-content-between py-2 border-bottom border-secondary small investment-breakdown-row">
                                <span class="investment-breakdown-label solar-subsidy-label">PM Surya Ghar Direct Govt. Subsidy:</span>
                                <strong class="solar-subsidy-value" id="outSubsidy">- ₹78,000</strong>
                            </div>

                            <div class="d-flex justify-content-between py-2 border-bottom border-secondary investment-breakdown-row">
                                <span class="text-white font-weight-bold investment-breakdown-label">Net Customer Investment:</span>
                                <strong class="text-white font-weight-bold fs-20" id="outNetCost">₹96,000</strong>
                            </div>

                            <div class="d-flex justify-content-between py-2 small investment-breakdown-row">
                                <span class="text-white-50 investment-breakdown-label">Estimated Payback Period:</span>
                                <strong class="solar-payback-value" id="outPayback">~ 3.0 Years</strong>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between">
                            <div>
                                <small class="text-white-50 d-block">Rooftop Area Required: <strong class="text-white"><span id="outArea">300</span> sq ft</strong></small>
                                <small class="text-white-50 d-block">CO2 Offset: <strong class="solar-savings-value"><span id="outCo2">3.9</span> Tonnes / year</strong></small>
                            </div>

                            <a href="https://wa.me/917000575496?text=Namaste,%20my%20solar%20calculator%20result%20is%203%20kW.%20Please%20send%20detailed%20quotation." id="calcQuoteBtn" target="_blank" class="solar-quote-button">
                                <span>Get Detailed Quotation on WhatsApp</span>
                            </a>
                        </div>
                    </div>

                    <div class="solar-disclaimer">
                        <strong>Disclaimer:</strong> <%= data.calculator.disclaimer %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="load-calculator" class="load-calculator-section calculator-content-panel calculator-workspace" hidden>
        <div class="load-calculator-shell">
            <div class="load-calculator-main">
                <div class="load-calculator-heading">
                    <div><h2>Load Calculator</h2></div>
                </div>
                <div class="property-selection">
                    <span>Choose Your Property Type</span>
                    <div class="property-presets" role="group" aria-label="Choose property size">
                        <button type="button" data-preset="2">2 BHK</button><button type="button" data-preset="3">3 BHK</button><button type="button" data-preset="4">4 BHK</button><button type="button" class="selected" data-preset="custom">Custom</button>
                    </div>
                </div>
                <div class="load-filter-row">
                    <div class="load-type-tabs" role="tablist" aria-label="Filter appliance type">
                        <button class="selected" type="button" data-load-filter="all">All devices</button><button type="button" data-load-filter="essential">Essential load</button><button type="button" data-load-filter="heavy">Heavy load</button>
                    </div>
                    <div class="appliance-category-tabs" role="tablist" aria-label="Appliance categories">
                        <button class="selected" type="button" data-appliance-category="all"><i class="icofont-listine-dots"></i><span>All</span></button>
                        <button type="button" data-appliance-category="lights"><i class="icofont-light-bulb"></i><span>Lights</span><small data-category-total="lights">0 W</small></button>
                        <button type="button" data-appliance-category="home"><i class="icofont-home"></i><span>Home Appliances</span><small data-category-total="home">0 W</small></button>
                        <button type="button" data-appliance-category="kitchen"><i class="icofont-spoon-and-fork"></i><span>Kitchen</span><small data-category-total="kitchen">0 W</small></button>
                        <button type="button" data-appliance-category="heavy"><i class="icofont-air-conditioner"></i><span>Heavy Load</span><small data-category-total="heavy">0 W</small></button>
                        <button type="button" data-appliance-category="accessories"><i class="icofont-plug"></i><span>Accessories</span><small data-category-total="accessories">0 W</small></button>
                    </div>
                </div>
                <div id="applianceGrid" class="appliance-grid" data-lenis-prevent-wheel></div>
                <p class="load-disclaimer">*Wattage is approximate. Check appliance labels before choosing an inverter or battery.</p>
            </div>
            <aside class="load-calculator-summary">
                <span class="load-eyebrow">Your estimate</span>
                <h3>Your Total Running Load</h3>
                <div class="load-total"><strong id="totalRunningLoad">0</strong><span>Watts</span></div>
                <p>Choose appliances and quantities to see inverter, battery and solar sizing suggestions.</p>
                <label class="backup-hours-label" for="backupHours"><span>Average Daily Backup (Hrs)</span><strong><span id="backupHoursValue">5</span> hr</strong></label>
                <input id="backupHours" type="range" min="1" max="10" value="5">
                <div class="range-labels"><span>1 hr</span><span>10 hr</span></div>
                <button type="button" id="findLoadSolution" class="load-solution-button">Find Solution</button>
                <div id="loadSolution" class="load-solution" aria-live="polite" hidden>
                    <h4>Recommended energy solution</h4>
                    <div class="load-recommendation-grid">
                        <article class="load-recommendation-card"><span class="recommendation-icon"><i class="icofont-flash"></i></span><div><span>Inverter recommendation</span><strong id="suggestedInverter">—</strong><small>Pure sine wave, sized with surge headroom</small></div></article>
                        <article class="load-recommendation-card"><span class="recommendation-icon"><i class="icofont-battery-full"></i></span><div><span>Battery bank</span><strong id="suggestedBatteries">—</strong><small id="suggestedBatteryEnergy">Sized for selected backup time</small></div></article>
                        <article class="load-recommendation-card solar-recommendation"><span class="recommendation-icon"><i class="icofont-sun"></i></span><div><span>Grid-connected solar PV</span><strong id="suggestedSolarKw">—</strong><small><span id="suggestedSolarEnergy">—</span> estimated units per day</small></div></article>
                    </div>
                    <small class="load-sizing-note">Estimates assume selected backup hours equal daily use, 4.5 peak-sun-hours and 80% PV yield. Actual selection depends on starting surge, phase, roof conditions and product availability. Have an installer confirm the design before purchase.</small>
                    <a href="/contact#enquiry-form" class="load-products-link">Ask us to size this system <i class="icofont-arrow-right"></i></a>
                    <button type="button" id="editLoadDetails" class="edit-load-details">Edit appliance selection</button>
                </div>
            </aside>
        </div>
    </section>
    </div>
</div>

<script>
function syncBillInput(val) {
    document.getElementById('calcBill').value = val;
    runCalculator();
}

function syncCalculatorDistrict() {
    const isMp = document.getElementById('calcState').value === 'Madhya Pradesh';
    const mpField = document.getElementById('calcMpDistrictField');
    const otherField = document.getElementById('calcOtherDistrictField');
    const mpDistrict = document.getElementById('calcDistrict');
    const otherDistrict = document.getElementById('calcOtherDistrict');
    mpField.hidden = !isMp;
    otherField.hidden = isMp;
    mpDistrict.disabled = !isMp;
    otherDistrict.disabled = isMp;
}

function runCalculator(manualUnits = false) {
    const bill = parseFloat(document.getElementById('calcBill').value) || 0;
    const tariff = parseFloat(document.getElementById('calcTariff').value) || 7.5;
    const propType = document.getElementById('calcProperty').value;
    
    let units = parseFloat(document.getElementById('calcUnits').value) || 0;
    if (!manualUnits) {
        units = Math.round(bill / tariff);
        document.getElementById('calcUnits').value = units;
    }

    fetch('/api/calculate-solar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ monthlyBill: bill, tariff: tariff, monthlyUnits: units })
    })
    .then(r => r.json())
    .then(res => {
        if (!res.success) return;

        let subsidy = propType === 'residential' ? res.subsidy : 0;
        let netCost = res.estGrossCost - subsidy;
        let payback = (netCost / res.estAnnualSavings).toFixed(1);

        document.getElementById('outKw').innerText = res.recommendedKw.toFixed(1);
        document.getElementById('outPanels').innerText = Math.ceil(res.recommendedKw * 1000 / 540);
        document.getElementById('outGen').innerText = res.estMonthlyGeneration.toLocaleString('en-IN');
        document.getElementById('outSavings').innerText = '₹' + res.estMonthlySavings.toLocaleString('en-IN');
        document.getElementById('outAnnualSavings').innerText = '₹' + res.estAnnualSavings.toLocaleString('en-IN');
        document.getElementById('outGrossCost').innerText = '₹' + res.estGrossCost.toLocaleString('en-IN');
        document.getElementById('outSubsidy').innerText = subsidy > 0 ? '- ₹' + subsidy.toLocaleString('en-IN') : '₹0 (Commercial)';
        document.getElementById('outNetCost').innerText = '₹' + netCost.toLocaleString('en-IN');
        document.getElementById('outPayback').innerText = '~ ' + payback + ' Years';
        document.getElementById('outArea').innerText = res.rooftopAreaSqFt;
        document.getElementById('outCo2').innerText = res.co2SavedTonnes;

        const waText = `Namaste Shivay Energy, I calculated solar requirement on your website:\n- Recommended Plant: ${res.recommendedKw} kW\n- Monthly Bill: ₹${bill}\n- Estimated Net Cost: ₹${netCost.toLocaleString('en-IN')}\nPlease send a formal quote.`;
        document.getElementById('calcQuoteBtn').href = `https://wa.me/917000575496?text=${encodeURIComponent(waText)}`;
    });
}

document.addEventListener('DOMContentLoaded', () => {
    runCalculator();
});
</script>

