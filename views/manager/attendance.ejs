<%- include('../admin/partials/admin-head') %>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            Branch Field Attendance & GPS Logs
        </h2>
        <p class="text-muted small mb-0">
            Real-time verified GPS check-in logs for rooftop installation and survey personnel
        </p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a href="/manager/employees" class="btn btn-outline-primary" style="border-radius: 8px;">
            <i class="icofont-users-alt-2 me-1"></i> Staff Directory
        </a>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <div>
            <h5 class="admin-card-title">Today's Geo-Tagged Records (<%= attendance ? attendance.length : 0 %>)</h5>
            <div class="admin-card-subtitle">Session-verified attendance entries</div>
        </div>
        <span class="badge bg-success text-white">Live System</span>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Staff Name</th>
                    <th>Employee ID</th>
                    <th>Punch Type</th>
                    <th>Time (IST)</th>
                    <th>GPS Coordinates</th>
                    <th>Accuracy</th>
                    <th>Map Verification</th>
                </tr>
            </thead>
            <tbody>
                <% if (attendance && attendance.length > 0) { %>
                    <% attendance.forEach(a => { %>
                        <tr>
                            <td><strong><%= a.employeeName %></strong></td>
                            <td><code><%= a.employeeId %></code></td>
                            <td>
                                <span class="badge <%= a.type === 'check_in' ? 'bg-success' : 'bg-secondary' %>">
                                    <%= a.type.replace('_', ' ').toUpperCase() %>
                                </span>
                            </td>
                            <td><strong><%= a.timestamp %></strong></td>
                            <td><small class="text-muted"><%= a.latitude %>, <%= a.longitude %></small></td>
                            <td><small class="text-muted">±<%= a.accuracy %>m</small></td>
                            <td>
                                <a href="https://www.google.com/maps?q=<%= a.latitude %>,<%= a.longitude %>" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 11px;">
                                    <i class="icofont-google-map"></i> View Map
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">No attendance logs available for today.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../admin/partials/admin-footer') %>
