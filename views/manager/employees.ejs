<%- include('../admin/partials/admin-head') %>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            Assigned Branch Personnel
        </h2>
        <p class="text-muted small mb-0">
            Employees supervised by <strong><%= currentUser ? currentUser.name : 'Branch Manager' %></strong>
        </p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a href="/manager/attendance" class="btn btn-warning font-weight-bold text-dark" style="border-radius: 8px;">
            <i class="icofont-location-pin me-1"></i> Attendance Logs
        </a>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <div>
            <h5 class="admin-card-title">Staff Members (<%= employees ? employees.length : 0 %>)</h5>
            <div class="admin-card-subtitle">Technicians and site survey specialists assigned to this branch</div>
        </div>
        <span class="badge bg-light text-dark border">Raisen Operations</span>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Staff Name</th>
                    <th>Employee ID</th>
                    <th>Email</th>
                    <th>Mobile</th>
                    <th>Designation</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (employees && employees.length > 0) { %>
                    <% employees.forEach(e => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="admin-avatar-circle" style="width: 32px; height: 32px; font-size: 11px;">
                                        <%= (e.name || 'E').split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase() %>
                                    </div>
                                    <div>
                                        <strong class="text-dark"><%= e.name %></strong>
                                    </div>
                                </div>
                            </td>
                            <td><code><%= e.employeeId || 'N/A' %></code></td>
                            <td><%= e.email %></td>
                            <td><strong><%= e.mobile %></strong></td>
                            <td><%= e.designation || 'Technical Personnel' %></td>
                            <td>
                                <span class="badge-status <%= e.status === 'ACTIVE' ? 'badge-status-active' : 'badge-status-inactive' %>">
                                    <%= e.status %>
                                </span>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">No employees registered under this branch yet.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../admin/partials/admin-footer') %>
