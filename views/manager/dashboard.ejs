<%- include('../admin/partials/admin-head') %>

<!-- Header Welcome Banner -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            <%= stats.branchName %> (<%= stats.branchCode %>)
        </h2>
        <p class="text-muted small mb-0">
            Manager: <strong><%= currentUser ? currentUser.name : 'Branch Manager' %></strong> • <%= company.name %> Operations & Field Coordination
        </p>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-2 mt-3 mt-md-0">
        <a href="/manager/employees" class="btn btn-sm btn-outline-primary" style="border-radius: 8px;">
            <i class="icofont-users-alt-2 me-1"></i> My Team (<%= stats.totalAssigned %>)
        </a>
        <a href="/manager/attendance" class="btn btn-sm btn-warning font-weight-bold text-dark" style="border-radius: 8px;">
            <i class="icofont-location-pin me-1"></i> Staff GPS Logs
        </a>
        <a href="/manager/quotations" class="btn btn-sm btn-dark" style="border-radius: 8px; background: var(--admin-navy-primary);">
            <i class="icofont-paper me-1"></i> Quotation Requests
        </a>
    </div>
</div>

<!-- Manager KPI Metrics Cards (REAL DATA) -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="admin-metric-card">
            <div class="admin-metric-info">
                <small>Assigned Team Members</small>
                <h3><%= stats.totalAssigned %></h3>
                <div class="admin-metric-subtext text-success">
                    <i class="icofont-check-circled"></i> <%= stats.activeStaff %> active in field
                </div>
            </div>
            <div class="admin-metric-icon icon-navy">
                <i class="icofont-users-alt-5"></i>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="admin-metric-card">
            <div class="admin-metric-info">
                <small>Today's GPS Attendance</small>
                <h3 class="text-primary"><%= stats.todayPunches %></h3>
                <div class="admin-metric-subtext text-muted">
                    <i class="icofont-location-pin text-primary"></i> Geo-tagged field check-ins
                </div>
            </div>
            <div class="admin-metric-icon icon-green">
                <i class="icofont-map-pins"></i>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="admin-metric-card">
            <div class="admin-metric-info">
                <small>Pending Customer Inquiries</small>
                <h3 class="text-warning"><%= stats.pendingEnquiries %></h3>
                <div class="admin-metric-subtext text-muted">
                    <i class="icofont-clock-time"></i> Under local site survey
                </div>
            </div>
            <div class="admin-metric-icon icon-amber">
                <i class="icofont-headphone-alt-1"></i>
            </div>
        </div>
    </div>
</div>

<!-- Assigned Employees List Table -->
<div class="admin-card mb-4">
    <div class="admin-card-header">
        <div>
            <h5 class="admin-card-title">Assigned Field Team Members (<%= employees ? employees.length : 0 %>)</h5>
            <div class="admin-card-subtitle">Personnel reporting directly to your branch management</div>
        </div>
        <a href="/manager/employees" class="btn btn-sm btn-outline-primary" style="font-size: 12px; border-radius: 6px;">
            View Detailed Directory
        </a>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Staff Name</th>
                    <th>Employee ID</th>
                    <th>Designation</th>
                    <th>Mobile</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (employees && employees.length > 0) { %>
                    <% employees.forEach(e => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="admin-avatar-circle" style="width: 32px; height: 32px; font-size: 11px;">
                                        <%= (e.name || 'E').split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase() %>
                                    </div>
                                    <div>
                                        <strong class="text-dark"><%= e.name %></strong>
                                        <div class="text-muted small" style="font-size: 11px;"><%= e.email %></div>
                                    </div>
                                </div>
                            </td>
                            <td><code><%= e.employeeId || 'N/A' %></code></td>
                            <td><%= e.designation || 'Solar Installation Technician' %></td>
                            <td><strong><%= e.mobile %></strong></td>
                            <td>
                                <span class="badge-status <%= e.status === 'ACTIVE' ? 'badge-status-active' : 'badge-status-inactive' %>">
                                    <%= e.status %>
                                </span>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No employees assigned to this branch yet.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Today's Attendance Logs Summary -->
<div class="admin-card">
    <div class="admin-card-header">
        <div>
            <h5 class="admin-card-title">Recent Field Attendance GPS Punches</h5>
            <div class="admin-card-subtitle">Verified on-site GPS check-ins from installation sites</div>
        </div>
        <a href="/manager/attendance" class="small text-decoration-none text-primary font-weight-bold">View Full Logs</a>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Staff Member</th>
                    <th>Punch Type</th>
                    <th>Time</th>
                    <th>Coordinates</th>
                    <th>Map Verification</th>
                </tr>
            </thead>
            <tbody>
                <% if (attendance && attendance.length > 0) { %>
                    <% attendance.slice(0, 5).forEach(a => { %>
                        <tr>
                            <td><strong><%= a.employeeName %></strong> (<%= a.employeeId %>)</td>
                            <td>
                                <span class="badge <%= a.type === 'check_in' ? 'bg-success' : 'bg-secondary' %>">
                                    <%= a.type.replace('_', ' ').toUpperCase() %>
                                </span>
                            </td>
                            <td><%= a.timestamp %></td>
                            <td><small class="text-muted"><%= a.latitude %>, <%= a.longitude %> (±<%= a.accuracy %>m)</small></td>
                            <td>
                                <a href="https://www.google.com/maps?q=<%= a.latitude %>,<%= a.longitude %>" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 11px;">
                                    <i class="icofont-google-map"></i> View Map
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No attendance punches recorded today.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../admin/partials/admin-footer') %>
