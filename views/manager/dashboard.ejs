<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <section id="subheader" class="bg-dark text-light relative py-4" style="background: #163563;">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <span class="badge" style="background: #20c997; color: #000;">BRANCH OPERATIONS</span>
                    <h3 class="text-white font-weight-bold mb-0 mt-1"><%= stats.branchName %> (<%= stats.branchCode %>)</h3>
                    <small class="text-white-50"><%= company.name %> • Manager: <%= currentUser ? currentUser.name : 'Branch Manager' %></small>
                </div>
                <div class="d-flex gap-2 mt-3 mt-md-0">
                    <a href="/manager/employees" class="btn btn-sm btn-outline-light"><i class="icofont-users-alt-2"></i> Staff</a>
                    <a href="/manager/quotations" class="btn btn-sm btn-outline-light"><i class="icofont-paper"></i> Quotations</a>
                    <a href="/manager/invoices" class="btn btn-sm btn-outline-light"><i class="icofont-bill"></i> Invoices</a>
                    <a href="/auth/logout" class="btn btn-sm btn-danger"><i class="icofont-logout"></i> Sign Out</a>
                </div>
            </div>
        </div>
    </section>

    <section class="py-4 bg-light">
        <div class="container">
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card p-3 border-0 shadow-sm rounded-3 bg-white">
                        <small class="text-muted text-uppercase font-weight-bold">Branch Field Staff</small>
                        <h2 class="font-weight-bold text-dark mb-0 mt-1"><%= stats.activeStaff %></h2>
                        <small class="text-success"><i class="icofont-check"></i> Assigned to this branch</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card p-3 border-0 shadow-sm rounded-3 bg-white">
                        <small class="text-muted text-uppercase font-weight-bold">Active Branch Enquiries</small>
                        <h2 class="font-weight-bold text-dark mb-0 mt-1"><%= stats.pendingEnquiries %></h2>
                        <small class="text-muted">Under local site survey</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card p-3 border-0 shadow-sm rounded-3 bg-white">
                        <small class="text-muted text-uppercase font-weight-bold">Branch Sanctioned Revenue</small>
                        <h2 class="font-weight-bold text-success mb-0 mt-1"><%= stats.branchRevenue %></h2>
                        <small class="text-muted">Local invoice receipts</small>
                    </div>
                </div>
            </div>

            <!-- Attendance logs card -->
            <div class="card border-0 shadow-sm rounded-3 bg-white p-4 mb-4">
                <h5 class="font-weight-bold text-dark mb-3">Branch Field Attendance Logs</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Staff Name</th>
                                <th>Type</th>
                                <th>Time</th>
                                <th>GPS Location</th>
                                <th>Map Link</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (attendance && attendance.length > 0) { %>
                                <% attendance.forEach(a => { %>
                                    <tr>
                                        <td><strong><%= a.employeeName %></strong> (<%= a.employeeId %>)</td>
                                        <td><span class="badge <%= a.type === 'check_in' ? 'bg-success' : 'bg-secondary' %>"><%= a.type %></span></td>
                                        <td><%= a.timestamp %></td>
                                        <td><%= a.latitude %>, <%= a.longitude %></td>
                                        <td>
                                            <a href="https://www.google.com/maps?q=<%= a.latitude %>,<%= a.longitude %>" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-2">Map</a>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="5" class="text-center py-3 text-muted">No attendance punches recorded yet today.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

<%- include('../partials/footer') %>
