<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="catalog-page" id="content">
    <section class="catalog-hero" style="--hero-image: url('/images/background/w1.webp')">
        <div class="container">
            <h1>Solar Products</h1>
            <p>Panels, inverters, batteries and EV chargers.</p>
        </div>
    </section>

    <section class="catalog-section">
        <div class="container">
            <div class="catalog-grid products-grid">
                <% data.products.forEach((product, index) => { %>
                    <article class="catalog-card product-tile" style="--card-delay: <%= index * 45 %>ms">
                        <div class="product-tile-image">
                            <img src="<%= product.image || '/images/slider/4.webp' %>" alt="<%= product.name %>" loading="lazy">
                            <span><%= product.category %></span>
                        </div>
                        <div class="product-tile-body">
                            <div class="product-tile-meta"><span><i class="icofont-shield-alt"></i> <%= product.warranty %></span></div>
                            <h3><%= product.name %></h3>
                            <p><%= product.description %></p>
                            <div class="product-specs"><span><small>Capacity</small><strong><%= product.capacityRange %></strong></span><span><small>Efficiency</small><strong><%= product.efficiency %></strong></span></div>
                            <div class="product-features">
                                <% product.features.slice(0, 2).forEach(feature => { %><span><i class="icofont-check"></i> <%= feature %></span><% }); %>
                            </div>
                            <div class="catalog-actions">
                                <a class="catalog-action-button catalog-action-outline" href="/contact#enquiry-form">Ask about product <i class="icofont-arrow-right"></i></a>
                                <a class="catalog-action-button catalog-action-primary" href="/calculator#solar-calculator">Get Quote</a>
                            </div>
                        </div>
                    </article>
                <% }); %>
            </div>
        </div>
    </section>

    <section class="catalog-cta">
        <div class="container catalog-cta-inner">
            <div><span class="catalog-eyebrow">Need help choosing?</span><h2>We can help size your system.</h2><p>Share your requirements and get a product recommendation.</p></div>
            <a href="/calculator#solar-calculator" class="catalog-button">Calculate your system <i class="icofont-arrow-right"></i></a>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
