<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Enterprise Sign In | Shivay Energy Solutions' %></title>
    <link rel="icon" href="/images/brandlogo2.webp" type="image/webp" sizes="16x16">
    <meta name="description" content="Shivay Energy Solutions Enterprise Single Sign-On Portal for Administrators, Managers, and Employees.">
    
    <!-- Core Fonts & Icons -->
    <link href="/fonts/icofont/icofont.min.css" rel="stylesheet" type="text/css">
    
    <link rel="stylesheet" href="/css/private/admin-login.css">
</head>
<body>

    <div class="login-wrapper">
        <div class="login-card">
            <!-- Brand Header -->
            <div class="login-brand-header">
                <img src="/images/brandlogo2.webp" alt="Shivay Energy Solutions" class="login-brand-logo">
                <h1 class="login-brand-title">Shivay Energy Solutions</h1>
                <p class="login-brand-subtitle">Enterprise Unified Portal</p>
                <div class="role-badges-pill">
                    <span class="role-dot"></span>
                    <span>Admin • Manager • Employee</span>
                </div>
            </div>

            <!-- Error Feedback -->
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="login-alert-error" role="alert">
                    <i class="icofont-warning-alt"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <!-- Unified Authentication Form -->
            <form action="/admin/login" method="POST" autocomplete="off">
                <input type="hidden" name="returnUrl" value="<%= typeof returnUrl !== 'undefined' ? returnUrl : '' %>">

                <!-- Identifier Field -->
                <div class="form-group">
                    <label class="form-label" for="loginIdentifier">Email or Employee ID</label>
                    <div class="input-wrapper">
                        <i class="icofont-ui-user input-icon"></i>
                        <input 
                            type="text" 
                            id="loginIdentifier" 
                            name="identifier" 
                            class="form-input" 
                            placeholder="admin@shivayenergy.com or EMP ID" 
                            required 
                            autofocus
                        >
                    </div>
                </div>

                <!-- Password Field -->
                <div class="form-group">
                    <label class="form-label" for="loginPassword">Password</label>
                    <div class="input-wrapper">
                        <i class="icofont-lock input-icon"></i>
                        <input 
                            type="password" 
                            id="loginPassword" 
                            name="password" 
                            class="form-input" 
                            placeholder="••••••••••••" 
                            style="padding-right: 44px;" 
                            required
                        >
                        <button type="button" class="pass-toggle-btn" id="passToggleBtn" title="Toggle password visibility" aria-label="Toggle password visibility">
                            <i class="icofont-eye" id="passToggleIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="submit-btn" id="loginSubmitBtn">
                    <i class="icofont-login"></i>
                    <span>Sign In to Portal</span>
                </button>
            </form>

            <!-- Card Footer -->
            <div class="login-card-footer">
                <a href="/" class="back-home-link">
                    <i class="icofont-arrow-left"></i>
                    <span>Return to Public Website</span>
                </a>
                <div class="security-badge-text">
                    <i class="icofont-shield-alt"></i>
                    <span>256-Bit Encrypted Session • RBAC Protected</span>
                </div>
            </div>
        </div>

        <div class="login-portal-copyright">
            &copy; <%= new Date().getFullYear() %> Shivay Energy Solutions. Raisen Central, M.P.
        </div>
    </div>

    <!-- Standalone Interactions Script -->
    <script>
        (function() {
            const passInput = document.getElementById('loginPassword');
            const toggleBtn = document.getElementById('passToggleBtn');
            const toggleIcon = document.getElementById('passToggleIcon');

            if (toggleBtn && passInput && toggleIcon) {
                toggleBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (passInput.type === 'password') {
                        passInput.type = 'text';
                        toggleIcon.className = 'icofont-eye-blocked';
                    } else {
                        passInput.type = 'password';
                        toggleIcon.className = 'icofont-eye';
                    }
                });
            }
        })();
    </script>
</body>
</html>
