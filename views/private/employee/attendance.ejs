<%- include('../admin/partials/admin-head') %>

<%
    const policy = (typeof geofencePolicy !== 'undefined' && geofencePolicy) ? geofencePolicy : {
        enforceGeofence: true,
        attendanceTimeEnabled: true,
        attendanceStartTime: '09:00',
        attendanceEndTime: '17:00',
        checkInEarlyMinutes: 10,
        checkOutEarlyMinutes: 5,
        allowLateCheckOut: true,
        attendanceStartDisplay: '09:00 AM',
        attendanceEndDisplay: '05:00 PM',
        checkInOpenDisplay: '08:50 AM',
        checkOutOpenDisplay: '04:55 PM',
        branchName: 'Raisen Central Branch',
        latitude: 23.3315,
        longitude: 77.7807,
        radiusMeters: 500
    };
    const safePunches = Array.isArray(userPunches) ? userPunches : [];
    const hasCheckedIn = safePunches.some(p => p.type === 'check_in');
    const hasCheckedOut = safePunches.some(p => p.type === 'check_out');
%>

<div class="row justify-content-center py-2">
    <div class="col-md-7 col-lg-6">
        <div class="card p-4 border-0 shadow-sm rounded-3 bg-white text-center">
            <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 66px; height: 66px; background: rgba(22, 53, 99, 0.1); color: #163563; font-size: 30px;">
                <i class="icofont-location-pin"></i>
            </div>

            <h4 class="font-weight-bold text-dark mb-1">Mark Today's Attendance</h4>
            <p class="text-muted small mb-3">Date: <strong id="currentDate"><%= today %></strong> | Time: <strong id="liveClock">Loading...</strong> (IST)</p>

            <!-- Authenticated Identity -->
            <div class="p-3 bg-light rounded-3 mb-3 text-start border">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small text-muted font-weight-bold text-uppercase d-block">Authenticated Staff Identity</span>
                        <h6 class="font-weight-bold text-dark mb-0 mt-1"><%= currentUser ? currentUser.name : 'Authorized Staff' %></h6>
                    </div>
                    <span class="badge bg-dark"><%= currentUser ? currentUser.employeeId : 'SES-EMP' %></span>
                </div>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 pt-2 border-top small text-muted">
                    <span><i class="icofont-shield-alt text-success me-1"></i>Role: <strong class="text-dark"><%= currentUser ? currentUser.role : 'EMPLOYEE' %></strong></span>
                    <span><i class="icofont-building-alt text-primary me-1"></i>Branch: <strong class="text-dark"><%= policy.branchName %></strong></span>
                </div>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 pt-2 border-top small text-muted">
                    <span>
                        <i class="icofont-clock-time text-warning me-1"></i>
                        Timing: <strong class="text-dark"><%= policy.attendanceTimeEnabled !== false ? `${policy.attendanceStartDisplay || '09:00 AM'} – ${policy.attendanceEndDisplay || '05:00 PM'} (IST)` : 'Flexible Hours' %></strong>
                        <% if (policy.attendanceTimeEnabled !== false) { %>
                            <span class="d-block" style="font-size: 11px;">
                                Check-In opens <strong><%= policy.checkInOpenDisplay || '08:50 AM' %></strong> (<%= policy.checkInEarlyMinutes !== undefined ? policy.checkInEarlyMinutes : 10 %>m early) &bull; Check-Out from <strong><%= policy.checkOutOpenDisplay || '04:55 PM' %></strong><%= policy.allowLateCheckOut !== false ? ' (Late evening allowed)' : '' %>
                            </span>
                        <% } %>
                    </span>
                    <span id="timeWindowBadge" class="badge <%= policy.attendanceTimeEnabled !== false ? 'bg-secondary' : 'bg-success-subtle text-success' %>">
                        <%= policy.attendanceTimeEnabled !== false ? 'Checking...' : 'Open' %>
                    </span>
                </div>
            </div>

            <!-- Simple Live GPS & Distance Status -->
            <div class="p-3 bg-light rounded-3 mb-4 text-start small border">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                    <span class="font-weight-bold text-dark"><i class="icofont-location-pin text-danger me-1"></i> GPS Location Status</span>
                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" onclick="fetchLocation(true)">
                        <i class="icofont-refresh me-1"></i> Refresh GPS
                    </button>
                </div>
                <div class="mb-1" id="geoStatus">
                    <span class="text-primary">Checking your location...</span>
                </div>
                <div id="geoDistanceBox" class="mt-2 pt-2 border-top d-none"></div>
            </div>

            <!-- Time Window Closed Notice (Shown outside allowed Check-In / Check-Out window) -->
            <div id="timeClosedBanner" class="alert alert-danger border border-danger rounded-3 p-3 mb-3 text-start small d-none">
                <div class="font-weight-bold mb-1">
                    <i class="icofont-clock-time me-1"></i> <span id="timeClosedTitle">Attendance Time Window Notice</span>
                </div>
                <div id="timeClosedDesc">
                    Attendance for <strong><%= policy.branchName %></strong> follows branch shift timings.
                </div>
            </div>

            <!-- Prominent Location Turn-On Prompt (Shown when GPS permission is denied / off) -->
            <div id="locationPromptBanner" class="alert alert-warning border border-warning rounded-3 p-3 mb-3 text-start small d-none">
                <div class="font-weight-bold text-dark mb-1">
                    <i class="icofont-warning-alt text-danger me-1"></i> Location Permission Required
                </div>
                <div id="locationPromptText" class="text-dark">
                    Attendance cannot be marked without location access. Please turn on your device GPS and allow Location permission in your browser.
                </div>
                <div class="mt-2 d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-warning font-weight-bold text-dark" onclick="fetchLocation(true)">
                        <i class="icofont-location-arrow me-1"></i> Turn On / Allow Location
                    </button>
                </div>
                <div id="locationDeniedHint" class="text-muted mt-2 d-none" style="font-size: 11px;">
                    If blocked in browser: click the <strong>Lock / Site Settings</strong> icon in the address bar &rarr; set <strong>Location</strong> to <strong>Allow</strong>, then click <strong>Turn On / Allow Location</strong>.
                </div>
            </div>

            <!-- Check In / Check Out Buttons -->
            <div class="d-grid gap-2">
                <button onclick="recordAttendance('check_in')" id="btnCheckIn" class="btn btn-success py-3 font-weight-bold shadow-sm" disabled>
                    <i class="icofont-login me-1"></i> <%= hasCheckedIn ? 'Checked-In Today' : 'Check-In (Punch In)' %>
                </button>
                <button onclick="recordAttendance('check_out')" id="btnCheckOut" class="btn btn-outline-danger py-2 font-weight-bold" disabled>
                    <i class="icofont-logout me-1"></i> <%= hasCheckedOut ? 'Checked-Out Today' : 'Check-Out (Punch Out)' %>
                </button>
            </div>

            <div id="attAlert" class="mt-3 text-start" style="display: none;"></div>

            <% if (safePunches.length > 0) { %>
                <div class="mt-4 pt-3 border-top text-start">
                    <h6 class="font-weight-bold text-dark mb-2 small text-uppercase">Today's Punches (<%= today %>)</h6>
                    <div class="list-group list-group-flush small">
                        <% safePunches.forEach(p => { %>
                            <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge <%= p.type === 'check_in' ? 'bg-success' : 'bg-secondary' %> me-2"><%= p.type.replace('_', ' ').toUpperCase() %></span>
                                    <strong><%= p.timestamp %></strong>
                                </div>
                                <span class="badge <%= p.isWithinGeofence !== false ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-dark' %>">
                                    <%= p.isWithinGeofence !== false ? 'Verified' : 'Outside Area' %>
                                </span>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
const POLICY = <%- JSON.stringify(policy).replace(/</g, '\\u003c') %>;
let hasCheckedInToday = <%= hasCheckedIn ? 'true' : 'false' %>;
let hasCheckedOutToday = <%= hasCheckedOut ? 'true' : 'false' %>;
let currentLat = null;
let currentLng = null;
let currentAcc = null;
let geoWatchId = null;

function getCurrentIstMinutes() {
    const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Kolkata',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
    }).format(new Date()).split(':');
    return ((parseInt(parts[0], 10) % 24) * 60) + parseInt(parts[1], 10);
}

function parseHHMMToMins(hhmm, fallback) {
    const m = String(hhmm || '').match(/^(\d{1,2}):(\d{2})$/);
    if (!m) return fallback;
    return (parseInt(m[1], 10) * 60) + parseInt(m[2], 10);
}

function checkPunchTimeState() {
    if (POLICY.attendanceTimeEnabled === false) {
        return { checkInAllowed: true, checkOutAllowed: true };
    }
    const nowM = getCurrentIstMinutes();
    const startM = parseHHMMToMins(POLICY.attendanceStartTime, 9 * 60);
    const endM = parseHHMMToMins(POLICY.attendanceEndTime, 17 * 60);
    const inEarly = Math.max(0, parseInt(POLICY.checkInEarlyMinutes, 10) || 0);
    const outEarly = Math.max(0, parseInt(POLICY.checkOutEarlyMinutes, 10) || 0);
    const allowLate = POLICY.allowLateCheckOut !== false;

    if (startM <= endM) {
        const inOpenM = Math.max(0, startM - inEarly);
        const outOpenM = Math.max(startM, endM - outEarly);
        return {
            checkInAllowed: nowM >= inOpenM && nowM <= endM,
            checkOutAllowed: allowLate ? (nowM >= outOpenM) : (nowM >= outOpenM && nowM <= endM)
        };
    }
    const inOpenM = (startM - inEarly + 1440) % 1440;
    const outOpenM = (endM - outEarly + 1440) % 1440;
    return {
        checkInAllowed: (nowM >= inOpenM || nowM <= endM),
        checkOutAllowed: allowLate ? true : (nowM >= outOpenM && nowM <= endM)
    };
}

function syncPunchButtons() {
    const timeState = checkPunchTimeState();
    const badge = document.getElementById('timeWindowBadge');
    const needPunchType = !hasCheckedInToday ? 'check_in' : (!hasCheckedOutToday ? 'check_out' : 'done');
    const activeTimeAllowed = needPunchType === 'check_in'
        ? timeState.checkInAllowed
        : (needPunchType === 'check_out' ? timeState.checkOutAllowed : true);

    if (badge) {
        if (POLICY.attendanceTimeEnabled === false) {
            badge.className = 'badge bg-success-subtle text-success';
            badge.innerText = 'Flexible';
        } else if (needPunchType === 'done') {
            badge.className = 'badge bg-success-subtle text-success';
            badge.innerText = 'Completed';
        } else if (activeTimeAllowed) {
            badge.className = 'badge bg-success';
            badge.innerText = (needPunchType === 'check_out' && getCurrentIstMinutes() > parseHHMMToMins(POLICY.attendanceEndTime, 17 * 60))
                ? 'Late Check-Out Open'
                : 'Open Now';
        } else {
            badge.className = 'badge bg-danger';
            badge.innerText = 'Closed';
        }
    }

    const timeBanner = document.getElementById('timeClosedBanner');
    const timeTitle = document.getElementById('timeClosedTitle');
    const timeDesc = document.getElementById('timeClosedDesc');
    if (timeBanner && timeTitle && timeDesc) {
        const showBanner = POLICY.attendanceTimeEnabled !== false && needPunchType !== 'done' && !activeTimeAllowed;
        timeBanner.classList.toggle('d-none', !showBanner);
        if (showBanner) {
            if (needPunchType === 'check_in') {
                timeTitle.innerText = 'Check-In Window Closed';
                timeDesc.innerHTML = `Check-In for <strong>${POLICY.branchName}</strong> is allowed between <strong>${POLICY.checkInOpenDisplay || '08:50 AM'}</strong> and <strong>${POLICY.attendanceEndDisplay || '05:00 PM'} (IST)</strong>.`;
            } else {
                timeTitle.innerText = 'Check-Out Window Not Open Yet';
                timeDesc.innerHTML = `Check-Out opens at <strong>${POLICY.checkOutOpenDisplay || '04:55 PM'} IST</strong> (${POLICY.checkOutEarlyMinutes || 5} min before ${POLICY.attendanceEndDisplay || '05:00 PM'})${POLICY.allowLateCheckOut !== false ? ' and remains open late evening if working overtime.' : '.'}`;
            }
        }
    }

    const gpsReady = currentLat !== null && currentLng !== null;
    let geoOk = false;
    if (gpsReady) {
        const dist = haversineMeters(currentLat, currentLng, POLICY.latitude, POLICY.longitude);
        geoOk = POLICY.enforceGeofence ? (dist <= POLICY.radiusMeters) : true;
    }

    document.getElementById('btnCheckIn').disabled = !(timeState.checkInAllowed && gpsReady && geoOk) || hasCheckedInToday;
    document.getElementById('btnCheckOut').disabled = !(timeState.checkOutAllowed && gpsReady && geoOk) || !hasCheckedInToday || hasCheckedOutToday;
}

function updateClock() {
    const now = new Date();
    const el = document.getElementById('liveClock');
    if (el) el.innerText = now.toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata' });
    syncPunchButtons();
}
setInterval(updateClock, 1000);
updateClock();

function haversineMeters(lat1, lng1, lat2, lng2) {
    const toRad = (deg) => (deg * Math.PI) / 180;
    const dLat = toRad(lat2 - lat1);
    const dLng = toRad(lng2 - lng1);
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
    return Math.round(6371000 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
}

function formatDistanceText(meters) {
    if (meters >= 1000) {
        return `${(meters / 1000).toFixed(2)} km (${meters}m)`;
    }
    return `${meters}m`;
}

function updateGpsUi(lat, lng, accuracy) {
    currentLat = lat;
    currentLng = lng;
    currentAcc = Math.round(accuracy || 15);

    const promptBanner = document.getElementById('locationPromptBanner');
    if (promptBanner) promptBanner.classList.add('d-none');
    const deniedHint = document.getElementById('locationDeniedHint');
    if (deniedHint) deniedHint.classList.add('d-none');

    const dist = haversineMeters(lat, lng, POLICY.latitude, POLICY.longitude);
    const inside = dist <= POLICY.radiusMeters;

    const statusEl = document.getElementById('geoStatus');
    const distBox = document.getElementById('geoDistanceBox');

    if (inside) {
        statusEl.innerHTML = `<span class="text-success fw-bold"><i class="icofont-check-circled"></i> Location Verified — Inside ${POLICY.branchName}</span>`;
        distBox.className = 'mt-2 pt-2 border-top text-success small d-block';
        distBox.innerHTML = `<i class="icofont-verification-check me-1"></i> You are within branch area (Allowed radius: ${POLICY.radiusMeters}m).`;
    } else if (POLICY.enforceGeofence) {
        const extraDist = Math.max(0, dist - POLICY.radiusMeters);
        statusEl.innerHTML = `<span class="text-danger fw-bold"><i class="icofont-warning"></i> Outside ${POLICY.branchName} Area</span>`;
        distBox.className = 'mt-2 pt-2 border-top text-danger fw-bold small d-block';
        distBox.innerHTML = `<i class="icofont-location-arrow me-1"></i> You are <strong>${formatDistanceText(dist)}</strong> away from branch (${formatDistanceText(extraDist)} outside ${POLICY.radiusMeters}m limit). Move closer to mark attendance.`;
    } else {
        statusEl.innerHTML = `<span class="text-success fw-bold"><i class="icofont-check-circled"></i> GPS Location Acquired</span>`;
        distBox.className = 'mt-2 pt-2 border-top text-muted small d-block';
        distBox.innerText = `Distance from branch: ${formatDistanceText(dist)}`;
    }

    syncPunchButtons();
}

function handleGpsError(err) {
    currentLat = null;
    currentLng = null;
    currentAcc = null;
    const isDenied = Boolean(err && err.code === 1);
    const msg = isDenied
        ? 'Location permission is blocked. Turn on Location permission to mark attendance.'
        : 'Device GPS is turned off or unavailable. Please turn on Location and retry.';
    document.getElementById('geoStatus').innerHTML = `<span class="text-danger fw-bold"><i class="icofont-warning"></i> ${msg}</span>`;
    document.getElementById('geoDistanceBox').className = 'mt-2 pt-2 border-top d-none';

    const promptBanner = document.getElementById('locationPromptBanner');
    const promptText = document.getElementById('locationPromptText');
    const deniedHint = document.getElementById('locationDeniedHint');
    if (promptBanner && promptText) {
        promptText.innerText = isDenied
            ? 'You denied location permission. Attendance cannot be marked until Location is enabled.'
            : 'Please turn on your device GPS / Location services so we can verify your branch attendance.';
        promptBanner.classList.remove('d-none');
    }
    if (deniedHint) {
        deniedHint.classList.toggle('d-none', !isDenied);
    }

    document.getElementById('btnCheckIn').disabled = true;
    document.getElementById('btnCheckOut').disabled = true;
}

function initPermissionWatcher() {
    if (!navigator.permissions || typeof navigator.permissions.query !== 'function') return;
    navigator.permissions.query({ name: 'geolocation' }).then((permStatus) => {
        if (permStatus.state === 'denied') {
            handleGpsError({ code: 1 });
        }
        permStatus.onchange = () => {
            if (permStatus.state === 'granted') {
                fetchLocation(true);
            } else if (permStatus.state === 'denied') {
                handleGpsError({ code: 1 });
            }
        };
    }).catch(() => {});
}

function fetchLocation(forceRestart = false) {
    if (!navigator.geolocation) {
        handleGpsError({ message: 'Geolocation not supported' });
        return;
    }
    if (forceRestart && geoWatchId !== null) {
        navigator.geolocation.clearWatch(geoWatchId);
        geoWatchId = null;
    }
    navigator.geolocation.getCurrentPosition(
        (pos) => updateGpsUi(pos.coords.latitude, pos.coords.longitude, pos.coords.accuracy),
        (err) => {
            if (err && err.code === 1) {
                handleGpsError(err);
                return;
            }
            navigator.geolocation.getCurrentPosition(
                (pos) => updateGpsUi(pos.coords.latitude, pos.coords.longitude, pos.coords.accuracy),
                (fallbackErr) => handleGpsError(fallbackErr),
                { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 }
            );
        },
        { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
    );
    if (geoWatchId === null) {
        geoWatchId = navigator.geolocation.watchPosition(
            (pos) => updateGpsUi(pos.coords.latitude, pos.coords.longitude, pos.coords.accuracy),
            (watchErr) => {
                if (watchErr && (watchErr.code === 1 || watchErr.code === 2)) {
                    handleGpsError(watchErr);
                }
            },
            { enableHighAccuracy: true, timeout: 15000, maximumAge: 5000 }
        );
    }
}

document.addEventListener('DOMContentLoaded', () => {
    initPermissionWatcher();
    fetchLocation();
});

async function recordAttendance(type) {
    const alertBox = document.getElementById('attAlert');
    if (currentLat === null || currentLng === null) {
        alertBox.style.display = 'block';
        alertBox.className = 'alert alert-danger p-3 small';
        alertBox.innerHTML = '<strong>GPS Required:</strong> Please enable location access on your device before marking attendance.';
        return;
    }

    const activeBtn = document.getElementById(type === 'check_out' ? 'btnCheckOut' : 'btnCheckIn');
    activeBtn.disabled = true;

    try {
        const res = await fetch('/api/attendance', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
            },
            body: JSON.stringify({
                _csrf: '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>',
                type,
                latitude: currentLat,
                longitude: currentLng,
                accuracy: currentAcc || 15
            })
        });
        const data = await res.json();
        alertBox.style.display = 'block';
        if (data.success) {
            alertBox.className = 'alert alert-success p-3 small';
            alertBox.innerHTML = `<strong>Success!</strong> ${data.message}`;
            if (type === 'check_in') hasCheckedInToday = true;
            if (type === 'check_out') hasCheckedOutToday = true;
            setTimeout(() => location.reload(), 900);
        } else {
            alertBox.className = 'alert alert-danger p-3 small';
            alertBox.innerHTML = `<strong>Blocked:</strong> ${data.message}`;
            updateGpsUi(currentLat, currentLng, currentAcc);
        }
    } catch (err) {
        alertBox.style.display = 'block';
        alertBox.className = 'alert alert-danger p-3 small';
        alertBox.innerText = 'Network error recording attendance.';
        updateGpsUi(currentLat, currentLng, currentAcc);
    }
}
</script>

<%- include('../admin/partials/admin-footer') %>
