<%- include('../admin/partials/admin-head') %>

<link rel="stylesheet" href="/css/private/quotation-request-new.css">

<div class="row justify-content-center">
    <div class="col-xl-10">
        <!-- Page Title & Header Banner (Responsive for Super Admin, Manager & Employee) -->
        <div class="req-header-banner">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div class="req-header-content">
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <h3 class="font-weight-bold mb-0 text-dark" style="color: var(--admin-navy-primary); font-size: 20px;">
                            <i class="icofont-paper-plane me-1 text-warning"></i> New Solar Quotation Request
                        </h3>
                        <% if (currentUser && currentUser.role === 'SUPER_ADMIN') { %>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="font-size: 11px;">Super Admin Desk</span>
                        <% } else if (currentUser && (currentUser.role === 'MANAGER' || currentUser.role === 'BRANCH_MANAGER')) { %>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle font-monospace" style="font-size: 11px;">Branch Management</span>
                        <% } else { %>
                            <span class="badge bg-info-subtle text-info border border-info-subtle font-monospace" style="font-size: 11px;">Field Officer Desk</span>
                        <% } %>
                    </div>
                    <p class="text-muted small mb-0 req-header-step-text">
                    Enter customer premises, electrical requirements & technical specifications to create an authoritative quotation.
                    </p>
                </div>
                <div class="d-flex justify-content-end flex-shrink-0">
                    <a href="/employee/quotations/generate" class="btn btn-sm btn-outline-primary py-1 px-3 fw-bold" style="border-radius: 8px; font-size: 12px;">
                        <i class="icofont-arrow-left me-1"></i> Quotation Generate
                    </a>
                </div>
            </div>
        </div>

        <form id="quotationRequestForm" class="req-form" onsubmit="handleRequestSubmit(event)">
            <input type="hidden" name="_csrf" id="csrfTokenInput" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            
            <!-- ==========================================
                 SECTION 1: CUSTOMER INFORMATION & SEARCH
                 ========================================== -->
            <div class="req-card">
                <div class="req-card-header">
                    <div>
                        <h5 class="req-card-title">
                            <i class="icofont-user text-primary"></i> 1. Customer Information & Verification
                        </h5>
                        <div class="req-card-subtitle">Search by 10-digit mobile number to link existing client or create a new profile</div>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="font-size: 11px;">Customer CRM</span>
                </div>

                <div class="req-card-body">
                    <!-- Customer Search Bar with Standardized 38px Height -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="icofont-search-user text-primary me-1"></i> Quick Mobile Search (Auto-Fill Existing Client)
                        </label>
                        <div class="input-group search-mobile-group">
                            <span class="input-group-text bg-white border-end-0"><i class="icofont-search-user text-muted"></i></span>
                            <input type="tel" id="searchMobileInput" class="form-control border-start-0 ps-1" placeholder="Enter 10-digit customer mobile..." maxlength="10">
                            <button type="button" class="btn btn-primary fw-bold" onclick="searchCustomerByMobile()" style="background: var(--admin-navy-primary); border-color: var(--admin-navy-primary);">
                                <i class="icofont-search me-1"></i> <span class="d-none d-sm-inline">Check Existing</span><span class="d-inline d-sm-none">Search</span>
                            </button>
                        </div>
                        <div id="customerSearchFeedback" class="small mt-2 d-none"></div>
                    </div>

                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Customer Name <span class="text-danger">*</span></label>
                            <input type="text" id="custName" name="customerName" class="form-control" required placeholder="e.g. Ramesh Patel">
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label">Mobile Number <span class="text-danger">*</span></label>
                            <input type="tel" id="custMobile" name="customerMobile" class="form-control" required placeholder="10-digit" maxlength="10">
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label">Alt. Mobile</label>
                            <input type="tel" id="custAltMobile" name="customerAlternateMobile" class="form-control" placeholder="Optional">
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Email Address</label>
                            <input type="email" id="custEmail" name="customerEmail" class="form-control" placeholder="Optional (client@gmail.com)">
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Site Address <span class="text-danger">*</span></label>
                            <input type="text" id="siteAddress" name="siteAddress" class="form-control" required placeholder="House/Plot No., Street, Locality">
                        </div>

                        <div class="col-4 col-md-3">
                            <label class="form-label">City <span class="text-danger">*</span></label>
                            <input type="text" id="siteCity" name="city" class="form-control" value="Raisen" required>
                        </div>

                        <div class="col-4 col-md-3">
                            <label class="form-label">District <span class="text-danger">*</span></label>
                            <input type="text" id="siteDistrict" name="district" class="form-control" value="Raisen" required>
                        </div>

                        <div class="col-4 col-md-2">
                            <label class="form-label">PIN Code <span class="text-danger">*</span></label>
                            <input type="text" id="sitePincode" name="pincode" class="form-control" placeholder="464551" maxlength="6" required>
                        </div>

                        <div class="col-6 col-md-2">
                            <label class="form-label">Category <span class="text-danger">*</span></label>
                            <select id="custType" name="customerType" class="form-select" onchange="handleCustomerTypeChange()">
                                <option value="RESIDENTIAL" selected>Residential (DCR)</option>
                                <option value="COMMERCIAL">Commercial</option>
                                <option value="INDUSTRIAL">Industrial</option>
                                <option value="AGRICULTURAL">Agricultural</option>
                            </select>
                        </div>

                        <div class="col-6 col-md-2">
                            <label class="form-label">IVRS / Consumer #</label>
                            <input type="text" id="consumerNumber" name="consumerNumber" class="form-control" placeholder="Optional">
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 SECTION 2: SOLAR SYSTEM REQUIREMENTS
                 ========================================== -->
            <div class="req-card">
                <div class="req-card-header">
                    <div>
                        <h5 class="req-card-title">
                            <i class="icofont-solar-panel text-warning"></i> 2. Solar Configuration &amp; Brand Selection
                        </h5>
                        <div class="req-card-subtitle">Select capacity, panel company, module wattage and site conditions</div>
                    </div>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle font-monospace" style="font-size: 11px;">Technical Specs</span>
                </div>

                <div class="req-card-body">
                    <div class="row g-2">
                        <div class="col-6 col-md-4">
                            <label class="form-label text-primary">Plant Capacity <span class="text-danger">*</span></label>
                            <select id="kwPresetSelect" class="form-select fw-bold" onchange="onCapacityPresetChange(this.value)">
                                <option value="2">2 kW</option>
                                <option value="3" selected>3 kW (Popular)</option>
                                <option value="3.5">3.5 kW (Tata)</option>
                                <option value="5">5 kW</option>
                                <option value="5.2">5.2 kW (Tata)</option>
                                <option value="6">6 kW</option>
                                <option value="8">8 kW</option>
                                <option value="10">10 kW</option>
                                <option value="15">15 kW</option>
                                <option value="CUSTOM">Custom kW...</option>
                            </select>
                            <div id="customKwInputWrap" class="input-group mt-2 d-none">
                                <input type="number" id="proposedKw" name="proposedCapacityKw" class="form-control fw-bold font-monospace" min="0.5" max="500" step="0.5" value="3" required oninput="onCustomKwInput()">
                                <span class="input-group-text bg-light fw-bold font-monospace">kW</span>
                            </div>
                        </div>

                        <div class="col-6 col-md-4">
                            <label class="form-label">Solar Company <span class="text-danger">*</span></label>
                            <select id="preferredBrand" class="form-select fw-bold" onchange="syncBrandAndSpecsToEquipment()">
                                <option value="Waaree" selected>Waaree Energies</option>
                                <option value="Adani">Adani Solar</option>
                                <option value="Tata Power Solar">Tata Power Solar</option>
                                <option value="Kosol">Kosol Energie</option>
                                <option value="Havells">Havells Solar</option>
                                <option value="Oswal">Oswal Solar</option>
                                <option value="Premier Energy">Premier Energies</option>
                                <option value="Microtek">Microtek Solar</option>
                                <option value="Rayzon Solar">Rayzon Solar</option>
                                <option value="Any Tier-1 Brand">Any Tier-1 Brand</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4 d-flex align-items-end" id="subsidyContainer" style="display: block;">
                            <div id="subsidyHint" class="d-inline-flex align-items-center justify-content-center gap-1 rounded-2 bg-success-subtle text-success border border-success-subtle fw-bold w-100" style="font-size: 11px; height: 38px; padding: 0 10px;">
                                <i class="icofont-check-circled"></i>
                                <span>Govt Subsidy: ₹78,000</span>
                            </div>
                        </div>

                        <div class="col-6 col-md-4">
                            <label class="form-label mb-1">Module Wattage</label>
                            <select id="preferredModuleSpec" class="form-select" onchange="syncBrandAndSpecsToEquipment()">
                                <option value="540W Mono PERC (DCR)" selected>540W Mono PERC (DCR)</option>
                                <option value="545W Mono PERC (DCR)">545W Mono PERC (DCR)</option>
                                <option value="550W Mono PERC (DCR)">550W Mono PERC (DCR)</option>
                                <option value="580W Bifacial (DCR)">580W Bifacial (DCR)</option>
                                <option value="600W NDCR TOPCon">600W NDCR TOPCon</option>
                                <option value="620W NDCR TOPCon">620W NDCR TOPCon</option>
                            </select>
                        </div>

                        <div class="col-6 col-md-4">
                            <label class="form-label mb-1">System Type <span class="text-danger fw-bold">*</span></label>
                            <select name="systemType" class="form-select" onchange="updateSubsidyIndicator()">
                                <option value="ON_GRID" selected>On-Grid (Net Metering)</option>
                                <option value="HYBRID">Hybrid (With Battery)</option>
                                <option value="OFF_GRID">Off-Grid (Standalone)</option>
                                <option value="SOLAR_PUMP">Solar Agricultural Pump</option>
                            </select>
                        </div>

                        <div class="col-6 col-md-4">
                            <label class="form-label mb-1">Roof Type <span class="text-danger fw-bold">*</span></label>
                            <select name="roofType" class="form-select">
                                <option value="RCC_FLAT" selected>RCC Flat Roof</option>
                                <option value="TIN_SHED">Metal / Tin Shed</option>
                                <option value="TILED">Slanted Tile Roof</option>
                                <option value="GROUND_MOUNT">Ground Mounted</option>
                                <option value="OTHER">Other / Elevated</option>
                            </select>
                        </div>

                        <div class="col-6 col-md-4">
                            <label class="form-label mb-1">Inverter Brand</label>
                            <select id="preferredInverter" class="form-select" onchange="syncBrandAndSpecsToEquipment()">
                                <option value="Polycab / Similar" selected>Polycab / Similar</option>
                                <option value="GoodWe / Similar">GoodWe / Similar</option>
                                <option value="Havells / Similar">Havells / Similar</option>
                                <option value="Microtek / Polycab">Microtek / Polycab</option>
                                <option value="Growatt / Solis">Growatt / Solis</option>
                            </select>
                        </div>

                        <div class="col-4 col-md-4">
                            <label class="form-label mb-1">Area (Sq.Ft)</label>
                            <input type="number" name="roofAreaSqFt" class="form-control" placeholder="e.g. 300" min="50">
                        </div>

                        <div class="col-4 col-md-4">
                            <label class="form-label mb-1">Avg Bill (₹)</label>
                            <input type="number" name="monthlyElectricityBill" class="form-control" placeholder="e.g. 4500" min="0">
                        </div>

                        <div class="col-4 col-md-4">
                            <label class="form-label mb-1">Units / Mo</label>
                            <input type="number" name="monthlyUnitsKwh" class="form-control" placeholder="e.g. 400" min="0">
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Existing Solar Already Installed?</label>
                            <div class="d-flex align-items-center gap-4 mt-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="existingSolar" id="solarNo" value="false" checked>
                                    <label class="form-check-label small" for="solarNo">No (Fresh Setup)</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="existingSolar" id="solarYes" value="true">
                                    <label class="form-check-label small" for="solarYes">Yes (Upgrade)</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label mb-1">Installation Floor / Note</label>
                            <input type="text" name="installationLocation" class="form-control" placeholder="e.g. 2nd Floor Terrace">
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 SECTION 3: REQUESTED EQUIPMENT & MATERIALS (MOBILE FRIENDLY CARDS)
                 ========================================== -->
            <div class="req-card">
                <div class="req-card-header">
                    <div>
                        <h5 class="req-card-title">
                            <i class="icofont-tools-alt-2 text-info"></i> 3. Materials &amp; BoS Components
                        </h5>
                        <div class="req-card-subtitle">Select brand, component specs &amp; quantities (or tap chips to add)</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary fw-bold" onclick="addEquipmentRow()" style="border-radius: 8px;">
                        <i class="icofont-plus-circle me-1"></i> Add Material
                    </button>
                </div>

                <div class="req-card-body">
                    <!-- Quick Add BoS Material Chips -->
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        <button type="button" class="btn btn-sm btn-light border py-1 px-2" style="font-size: 11px;" onclick="addPresetEquipment('HDG Mounting Structure', 1, 'Hot Dip Galvanized Elevated 8x6ft', 'JSW / Standard')">+ HDG Structure</button>
                        <button type="button" class="btn btn-sm btn-light border py-1 px-2" style="font-size: 11px;" onclick="addPresetEquipment('ACDB / DCDB Box', 1, 'IP65 SPD + MCB Protection', 'Havells / Polycab')">+ ACDB / DCDB</button>
                        <button type="button" class="btn btn-sm btn-light border py-1 px-2" style="font-size: 11px;" onclick="addPresetEquipment('DC Solar Cable (4 sq.mm)', 30, 'UV Resistant Tinned Copper (Mtr)', 'Polycab / Havells')">+ DC Cable</button>
                        <button type="button" class="btn btn-sm btn-light border py-1 px-2" style="font-size: 11px;" onclick="addPresetEquipment('AC Cable (4 sq.mm)', 20, 'Armoured / Copper Wire (Mtr)', 'Polycab / Microtek')">+ AC Cable</button>
                        <button type="button" class="btn btn-sm btn-light border py-1 px-2" style="font-size: 11px;" onclick="addPresetEquipment('Earthing & Lightning Arrester', 3, 'Copper LA + GI Chemical Earthing Pits', 'Standard IS Approved')">+ Earthing &amp; LA</button>
                    </div>

                    <div id="equipmentRowsContainer" class="d-flex flex-column gap-2 mb-3"></div>

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label mb-1 fw-bold small">Additional Requirements <span class="badge-optional">Optional</span></label>
                            <textarea name="additionalRequirements" class="form-control form-control-sm" rows="2" placeholder="e.g. Elevated structure 8 ft clearance, net-meter urgency..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-1 fw-bold small">Internal Staff Notes <span class="badge-optional">Optional</span></label>
                            <textarea name="employeeNotes" class="form-control form-control-sm" rows="2" placeholder="Manager notes / advance commitment..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 SECTION 4: SUPPORTING ATTACHMENTS
                 ========================================== -->
            <div class="req-card">
                <div class="req-card-header">
                    <div>
                        <h5 class="req-card-title">
                            <i class="icofont-attachment text-secondary"></i> 4. Site Photographs & Electricity Bill Attachments
                        </h5>
                        <div class="req-card-subtitle">Attach electricity bill, roof photos, or site survey sheets (Max 5 files, 5 MB each: JPG, PNG, PDF)</div>
                    </div>
                    <span class="badge-optional">Optional Files</span>
                </div>

                <div class="req-card-body">
                    <div class="p-3 bg-light rounded-3 border">
                        <input type="file" id="fileAttachmentInput" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp,.pdf" onchange="handleFileSelection(event)">

                        <!-- Preview of Selected Files -->
                        <div id="fileListContainer" class="mt-3 d-none">
                            <h6 class="font-weight-bold text-dark small mb-2">Files Selected for Upload:</h6>
                            <ul class="list-group small" id="fileListUl"></ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit Button Error / Success Alert Box -->
            <div id="submitBtnAlert" class="alert d-none py-3 px-3 rounded-3 mb-3 border shadow-sm" role="alert">
                <div class="d-flex align-items-start gap-2">
                    <i id="submitBtnAlertIcon" class="icofont-warning fs-5 mt-1"></i>
                    <div class="flex-grow-1">
                        <div id="submitBtnAlertTitle" class="fw-bold mb-1"></div>
                        <div id="submitBtnAlertMsg" class="small"></div>
                    </div>
                </div>
            </div>

            <!-- Submit Action Footer (Responsive Full Width Card) -->
            <div class="req-footer-box mb-5">
                <div class="req-footer-btn-wrap d-flex gap-2 align-items-center justify-content-end w-100">
                    <a href="<%= (typeof parentUrl !== 'undefined') ? parentUrl : ((currentUser && currentUser.role === 'SUPER_ADMIN') ? '/admin/quotations' : ((currentUser && (currentUser.role === 'MANAGER' || currentUser.role === 'BRANCH_MANAGER')) ? '/manager/quotations' : '/employee/quotations')) %>" class="btn btn-outline-secondary px-3 px-md-4 py-2 font-weight-bold" style="border-radius: 8px;">Cancel</a>
                    <button type="submit" class="btn btn-primary px-3 px-md-4 py-2 font-weight-bold shadow-sm" id="submitBtn" style="background: var(--admin-navy-primary); border-color: var(--admin-navy-primary); border-radius: 8px;">
                        <i class="icofont-paper-plane me-1"></i><span>Submit Request</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
let uploadedFilesPayload = [];
let equipmentIndex = 2;

// Auto-update PM Surya Ghar subsidy estimate
// STRICT RULE: Subsidy line is ONLY visible for eligible residential rooftop quotes. Industrial, Commercial & Agricultural are hidden.
function updateSubsidyIndicator() {
    const kwInput = document.getElementById('proposedKw');
    const custTypeSelect = document.getElementById('custType');
    const systemTypeSelect = document.querySelector('select[name="systemType"]');
    const container = document.getElementById('subsidyContainer');
    const hint = document.getElementById('subsidyHint');
    
    if (!kwInput || !custTypeSelect || !container || !hint) return;

    const custType = custTypeSelect.value;
    const systemType = systemTypeSelect ? systemTypeSelect.value : 'ON_GRID';
    const kw = parseFloat(kwInput.value) || 0;

    // PM Surya Ghar Muft Bijli Yojana is strictly for RESIDENTIAL rooftop consumers with Grid-Tied systems
    const isResidential = (custType === 'RESIDENTIAL');
    const isEligibleSystem = (systemType === 'ON_GRID' || systemType === 'HYBRID');

    if (!isResidential || !isEligibleSystem) {
        // Completely hide the subsidy line for Industrial, Commercial, Agricultural, Off-Grid
        container.style.display = 'none';
        container.classList.add('d-none');
        return;
    }

    // Eligible: Show subsidy estimate
    container.style.display = 'block';
    container.classList.remove('d-none');

    let subsidy = 0;
    if (kw <= 0) subsidy = 0;
    else if (kw < 1.5) subsidy = 30000;
    else if (kw < 2.5) subsidy = 60000;
    else subsidy = 78000;

    hint.innerHTML = `<i class="icofont-check-circled fs-6"></i> <span>Estimated PM Surya Ghar Subsidy: ₹${subsidy.toLocaleString('en-IN')}</span>`;
}

function handleCustomerTypeChange() {
    updateSubsidyIndicator();
}

// Live Search Customer by Mobile
async function searchCustomerByMobile() {
    const mobile = document.getElementById('searchMobileInput').value.trim();
    const feedback = document.getElementById('customerSearchFeedback');

    if (!mobile || mobile.length < 10) {
        feedback.className = 'small mt-2 text-danger';
        feedback.innerHTML = '<i class="icofont-warning"></i> Please enter a valid 10-digit mobile number.';
        feedback.classList.remove('d-none');
        return;
    }

    try {
        const res = await fetch(`/api/customers/search?mobile=${encodeURIComponent(mobile)}`);
        const data = await res.json();

        if (data.found && data.customer) {
            const c = data.customer;
            feedback.className = 'small mt-2 text-success font-weight-bold';
            feedback.innerHTML = `<i class="icofont-check-circled"></i> Existing customer found: <strong>${c.name}</strong> (${c.city || 'Raisen'}). Fields auto-filled.`;
            feedback.classList.remove('d-none');

            document.getElementById('custName').value = c.name || '';
            document.getElementById('custMobile').value = (c.mobile || '').replace(/[^0-9]/g, '').slice(-10);
            if (c.alternateMobile) document.getElementById('custAltMobile').value = c.alternateMobile;
            if (c.email) document.getElementById('custEmail').value = c.email;
            if (c.address) document.getElementById('siteAddress').value = c.address;
            if (c.city) document.getElementById('siteCity').value = c.city;
            if (c.district) document.getElementById('siteDistrict').value = c.district;
            if (c.pincode) document.getElementById('sitePincode').value = c.pincode;
            if (c.consumerNumber) document.getElementById('consumerNumber').value = c.consumerNumber;
            if (c.customerType) {
                document.getElementById('custType').value = c.customerType;
                updateSubsidyIndicator();
            }
        } else {
            feedback.className = 'small mt-2 text-primary';
            feedback.innerHTML = `<i class="icofont-plus-circle"></i> No existing customer with this mobile. New profile will be registered automatically upon submission.`;
            feedback.classList.remove('d-none');
            document.getElementById('custMobile').value = mobile;
        }
    } catch (err) {
        console.error('Search error:', err);
    }
}

const EQUIPMENT_CATALOG = [
    'Solar PV Modules',
    'On-Grid Solar Inverter',
    'Hybrid Solar Inverter',
    'HDG Mounting Structure',
    'ACDB / DCDB Box',
    'DC Solar Cable (4 sq.mm)',
    'AC Cable (4 sq.mm)',
    'Earthing & Lightning Arrester',
    'Net Meter & DISCOM Kit',
    'Custom Material'
];

const BRAND_CATALOG = [
    'Waaree', 'Adani', 'Tata Power Solar', 'Kosol', 'Havells',
    'Oswal', 'Premier Energy', 'Microtek', 'Rayzon Solar',
    'Polycab', 'GoodWe', 'Growatt / Solis', 'Standard IS Approved'
];

let reqEquipmentList = [
    { itemName: 'Solar PV Modules', quantity: 6, specs: '540W Mono PERC (DCR)', brand: 'Waaree' },
    { itemName: 'On-Grid Solar Inverter', quantity: 1, specs: '3 kW Dual MPPT, IP65', brand: 'Polycab' },
    { itemName: 'HDG Mounting Structure', quantity: 1, specs: 'Hot Dip Galvanized Elevated 8x6ft', brand: 'Standard IS Approved' },
    { itemName: 'ACDB / DCDB Box', quantity: 1, specs: 'IP65 SPD + MCB Protection', brand: 'Havells' }
];

function renderEquipmentCards() {
    const container = document.getElementById('equipmentRowsContainer');
    if (!container) return;
    container.innerHTML = reqEquipmentList.map((eq, idx) => {
        const itemOpts = EQUIPMENT_CATALOG.map(n =>
            `<option value="${n}" ${eq.itemName === n ? 'selected' : ''}>${n}</option>`
        ).join('');
        const isCustomItem = !EQUIPMENT_CATALOG.includes(eq.itemName);
        const brandOpts = BRAND_CATALOG.map(b =>
            `<option value="${b}" ${(eq.brand || '').includes(b) || b === eq.brand ? 'selected' : ''}>${b}</option>`
        ).join('');

        return `
            <div class="p-2 bg-light rounded border" data-eq-row="${idx}">
                <div class="row g-2 align-items-end">
                    <div class="col-8 col-md-4">
                        <label class="form-label mb-1" style="font-size: 10.5px;">Material *</label>
                        <select class="form-select form-select-sm eq-item-select" onchange="onEqItemSelect(${idx}, this.value)">
                            ${itemOpts}
                            ${isCustomItem ? `<option value="${String(eq.itemName).replace(/"/g, '&quot;')}" selected>${eq.itemName}</option>` : ''}
                        </select>
                        <input type="text" class="form-control form-control-sm mt-1 eq-custom-name ${eq.itemName === 'Custom Material' || isCustomItem ? '' : 'd-none'}"
                               value="${isCustomItem ? String(eq.itemName).replace(/"/g, '&quot;') : ''}"
                               placeholder="Enter custom material..."
                               oninput="reqEquipmentList[${idx}].itemName = this.value">
                    </div>
                    <div class="col-4 col-md-2">
                        <label class="form-label mb-1" style="font-size: 10.5px;">Qty *</label>
                        <input type="number" class="form-control form-control-sm" value="${eq.quantity || 1}" min="1"
                               oninput="reqEquipmentList[${idx}].quantity = parseFloat(this.value) || 1">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label mb-1" style="font-size: 10.5px;">Specs</label>
                        <input type="text" class="form-control form-control-sm" value="${String(eq.specs || '').replace(/"/g, '&quot;')}"
                               placeholder="Wattage / Rating"
                               oninput="reqEquipmentList[${idx}].specs = this.value">
                    </div>
                    <div class="col-4 col-md-2">
                        <label class="form-label mb-1" style="font-size: 10.5px;">Company</label>
                        <select class="form-select form-select-sm" onchange="reqEquipmentList[${idx}].brand = this.value">
                            ${brandOpts}
                        </select>
                    </div>
                    <div class="col-2 col-md-1 text-end">
                        <button type="button" class="btn btn-sm btn-outline-danger w-100 d-inline-flex align-items-center justify-content-center" style="height: 34px;" onclick="removeEquipmentRow(${idx})" title="Remove">
                            <i class="icofont-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        `;
    }).join('');
}

function onEqItemSelect(idx, val) {
    if (!reqEquipmentList[idx]) return;
    reqEquipmentList[idx].itemName = val;
    if (val === 'Custom Material') {
        renderEquipmentCards();
    }
}

function addEquipmentRow() {
    reqEquipmentList.push({ itemName: 'Custom Material', quantity: 1, specs: '', brand: document.getElementById('preferredBrand')?.value || 'Standard IS Approved' });
    renderEquipmentCards();
}

function addPresetEquipment(itemName, quantity, specs, brand) {
    reqEquipmentList.push({ itemName, quantity, specs, brand });
    renderEquipmentCards();
}

function removeEquipmentRow(idx) {
    if (reqEquipmentList.length > 1) {
        reqEquipmentList.splice(idx, 1);
        renderEquipmentCards();
    } else {
        alert('At least one equipment item is recommended.');
    }
}

function onCapacityPresetChange(val) {
    const customWrap = document.getElementById('customKwInputWrap');
    const kwInput = document.getElementById('proposedKw');
    if (val === 'CUSTOM') {
        customWrap.classList.remove('d-none');
    } else {
        customWrap.classList.add('d-none');
        kwInput.value = val;
    }
    syncBrandAndSpecsToEquipment();
    updateSubsidyIndicator();
}

function onCustomKwInput() {
    syncBrandAndSpecsToEquipment();
    updateSubsidyIndicator();
}

function syncBrandAndSpecsToEquipment() {
    const kw = parseFloat(document.getElementById('proposedKw')?.value) || 3;
    const brand = document.getElementById('preferredBrand')?.value || 'Waaree';
    const modSpec = document.getElementById('preferredModuleSpec')?.value || '540W Mono PERC (DCR)';
    const invBrand = (document.getElementById('preferredInverter')?.value || 'Polycab / Similar').split('/')[0].trim();

    const wattMatch = modSpec.match(/(\d{3})/);
    const watts = wattMatch ? parseInt(wattMatch[1], 10) : 540;
    const panelQty = Math.max(1, Math.ceil((kw * 1000) / watts));

    if (reqEquipmentList[0] && reqEquipmentList[0].itemName.includes('Module')) {
        reqEquipmentList[0].quantity = panelQty;
        reqEquipmentList[0].specs = modSpec;
        reqEquipmentList[0].brand = brand === 'Any Tier-1 Brand' ? 'Waaree' : brand;
    }
    if (reqEquipmentList[1] && reqEquipmentList[1].itemName.includes('Inverter')) {
        reqEquipmentList[1].specs = `${kw} kW Dual MPPT, IP65`;
        reqEquipmentList[1].brand = invBrand;
    }
    renderEquipmentCards();
}

// Handle Attachments via FileReader (Base64)
function handleFileSelection(event) {
    const files = event.target.files;
    const container = document.getElementById('fileListContainer');
    const list = document.getElementById('fileListUl');
    list.innerHTML = '';
    uploadedFilesPayload = [];

    if (!files || files.length === 0) {
        container.classList.add('d-none');
        return;
    }

    if (files.length > 5) {
        alert('Maximum 5 files allowed.');
        event.target.value = '';
        container.classList.add('d-none');
        return;
    }

    container.classList.remove('d-none');

    Array.from(files).forEach((file, idx) => {
        if (file.size > 5 * 1024 * 1024) {
            alert(`File "${file.name}" exceeds 5 MB limit.`);
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            uploadedFilesPayload.push({
                name: file.name,
                type: file.type || 'application/octet-stream',
                data: e.target.result,
                category: file.name.toLowerCase().includes('bill') ? 'ELECTRICITY_BILL' : 'SITE_PHOTO'
            });

            const li = document.createElement('li');
            li.className = 'list-group-item d-flex justify-content-between align-items-center py-2';
            li.innerHTML = `
                <div>
                    <i class="icofont-file-document text-primary me-2"></i>
                    <strong>${file.name}</strong> (${(file.size / 1024).toFixed(1)} KB)
                </div>
                <span class="badge bg-success">Ready</span>
            `;
            list.appendChild(li);
        };
        reader.readAsDataURL(file);
    });
}

// Error & Success Feedback Display Helpers
function showSubmissionError(msg, title = 'Validation Error', focusElementId = null) {
    const bottomAlert = document.getElementById('submitBtnAlert');
    const bottomTitle = document.getElementById('submitBtnAlertTitle');
    const bottomMsg = document.getElementById('submitBtnAlertMsg');
    const bottomIcon = document.getElementById('submitBtnAlertIcon');
    const btn = document.getElementById('submitBtn');

    if (bottomAlert) {
        bottomAlert.className = 'alert alert-danger py-3 px-3 rounded-3 mb-3 border-danger shadow-sm d-block';
        if (bottomTitle) bottomTitle.textContent = title;
        if (bottomMsg) bottomMsg.textContent = msg;
        if (bottomIcon) bottomIcon.className = 'icofont-warning fs-5 text-danger mt-1';
        bottomAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<i class="icofont-paper-plane me-1"></i><span>Submit Request</span>';
    }

    if (focusElementId) {
        const el = document.getElementById(focusElementId);
        if (el) {
            el.classList.add('is-invalid');
            setTimeout(() => el.classList.remove('is-invalid'), 6000);
        }
    }
}

function showSubmissionSuccess(requestNumber, redirectUrl) {
    const bottomAlert = document.getElementById('submitBtnAlert');
    const bottomTitle = document.getElementById('submitBtnAlertTitle');
    const bottomMsg = document.getElementById('submitBtnAlertMsg');
    const bottomIcon = document.getElementById('submitBtnAlertIcon');
    const btn = document.getElementById('submitBtn');

    if (bottomAlert) {
        bottomAlert.className = 'alert alert-success py-3 px-3 rounded-3 mb-3 border-success shadow-sm d-block';
        if (bottomTitle) bottomTitle.textContent = 'Quotation Request Submitted Successfully!';
        if (bottomMsg) bottomMsg.innerHTML = `Request <strong>${requestNumber}</strong> has been logged. Redirecting to your workspace...`;
        if (bottomIcon) bottomIcon.className = 'icofont-check-circled fs-5 text-success mt-1';
        bottomAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="icofont-check-circled me-1"></i> Request Submitted!';
    }

    setTimeout(() => {
        window.location.href = redirectUrl || '/employee/quotations';
    }, 1200);
}

// Handle Submit Form
async function handleRequestSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('submitBtn');
    const bottomAlert = document.getElementById('submitBtnAlert');

    if (bottomAlert) bottomAlert.classList.add('d-none');

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span>Submitting...</span>';

    const form = document.getElementById('quotationRequestForm');
    const formData = new FormData(form);

    // Client-side Validation Checks
    const customerName = (formData.get('customerName') || '').trim();
    if (!customerName) {
        showSubmissionError('Please enter the customer full name.', 'Missing Customer Name', 'custName');
        return;
    }

    const rawMobile = formData.get('customerMobile') || '';
    const cleanMobile = rawMobile.replace(/[^0-9]/g, '').slice(-10);
    if (cleanMobile.length !== 10) {
        showSubmissionError('Please provide a valid 10-digit mobile number (e.g. 9826012345).', 'Invalid Mobile Number', 'custMobile');
        return;
    }

    const kw = parseFloat(formData.get('proposedCapacityKw')) || 0;
    if (kw < 0.5) {
        showSubmissionError('Please enter a valid solar capacity (minimum 0.5 kW).', 'Invalid Solar Capacity', 'proposedKw');
        return;
    }

    const siteAddress = (formData.get('siteAddress') || '').trim();
    if (!siteAddress) {
        showSubmissionError('Please enter the complete premises / site address.', 'Missing Site Address', 'siteAddress');
        return;
    }

    const pincode = (formData.get('pincode') || '').trim();
    if (!pincode || pincode.length !== 6) {
        showSubmissionError('Please enter a valid 6-digit postal PIN code (e.g. 464551).', 'Invalid PIN Code', 'sitePincode');
        return;
    }

    const csrfToken = document.getElementById('csrfTokenInput')?.value || '';

    // Build Payload
    const payload = {
        _csrf: csrfToken,
        customerName: customerName,
        customerMobile: cleanMobile,
        customerAlternateMobile: formData.get('customerAlternateMobile') || '',
        customerEmail: (formData.get('customerEmail') || '').trim(),
        siteAddress: siteAddress,
        city: formData.get('city') || 'Raisen',
        district: formData.get('district') || 'Raisen',
        state: formData.get('state') || 'Madhya Pradesh',
        pincode: pincode,
        customerType: formData.get('customerType') || 'RESIDENTIAL',
        discom: 'MPPKVVCL',
        consumerNumber: (formData.get('consumerNumber') || '').trim(),
        proposedCapacityKw: kw,
        systemType: formData.get('systemType') || 'ON_GRID',
        roofType: formData.get('roofType') || 'RCC_FLAT',
        roofAreaSqFt: parseFloat(formData.get('roofAreaSqFt')) || 0,
        monthlyElectricityBill: parseFloat(formData.get('monthlyElectricityBill')) || 0,
        monthlyUnitsKwh: parseFloat(formData.get('monthlyUnitsKwh')) || 0,
        expectedBudget: 0,
        existingSolar: formData.get('existingSolar') === 'true' || formData.get('existingSolar') === true,
        installationLocation: formData.get('installationLocation') || siteAddress,
        additionalRequirements: formData.get('additionalRequirements') || '',
        employeeNotes: formData.get('employeeNotes') || '',
        equipment: reqEquipmentList
            .filter(eq => eq && eq.itemName && eq.itemName !== 'Custom Material' && String(eq.itemName).trim())
            .map(eq => ({
                itemName: String(eq.itemName).trim(),
                quantity: parseFloat(eq.quantity) || 1,
                specs: String(eq.specs || '').trim(),
                remarks: String(eq.brand || '').trim()
            })),
        attachments: uploadedFilesPayload || []
    };

    try {
        const res = await fetch('/api/quotations/request', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken,
                'CSRF-Token': csrfToken
            },
            body: JSON.stringify(payload)
        });

        const rawText = await res.text();
        let result;
        try {
            result = JSON.parse(rawText);
        } catch (parseErr) {
            showSubmissionError(`Server returned HTTP ${res.status}: ${rawText.substring(0, 120)}`, 'Server Error');
            return;
        }

        if (result && result.success) {
            showSubmissionSuccess(result.requestNumber, result.redirectUrl);
        } else {
            showSubmissionError(result.message || 'Error saving quotation request. Please check input details.', 'Submission Rejected');
        }
    } catch (err) {
        console.error('Submit network error:', err);
        showSubmissionError(err.message || 'Network connection failed. Please ensure the server is running and retry.', 'Network Communication Error');
    }
}

// Initialize on DOM load
document.addEventListener('DOMContentLoaded', () => {
    renderEquipmentCards();
    updateSubsidyIndicator();
});
</script>

