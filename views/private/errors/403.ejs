<%- include('../admin/partials/admin-head') %>

<section class="admin-card admin-error-card" role="alert">
    <div class="admin-error-icon" aria-hidden="true"><i class="icofont-shield-alt"></i></div>
    <p class="admin-error-code">403</p>
    <h2>Access denied</h2>
    <p class="admin-error-message"><%= typeof message !== 'undefined' ? message : 'You do not have permission to access this dashboard resource.' %></p>
    <div class="admin-error-actions">
        <a href="/" class="btn btn-outline-secondary">Public website</a>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <form action="/logout" method="POST" style="display: inline;">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <button type="submit" class="btn btn-danger">Sign out</button>
            </form>
        <% } else { %>
            <a href="/admin/login" class="btn btn-primary">Portal sign in</a>
        <% } %>
    </div>
</section>

<link rel="stylesheet" href="/css/private/403.css">
<%- include('../admin/partials/admin-footer') %>
