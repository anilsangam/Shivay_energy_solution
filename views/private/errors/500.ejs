<%- include('../admin/partials/admin-head') %>

<section class="admin-card admin-error-card" role="alert">
    <div class="admin-error-icon" aria-hidden="true" style="background: rgba(220, 53, 69, .1); color: #dc3545;">
        <i class="icofont-warning-alt"></i>
    </div>
    <p class="admin-error-code" style="color: #dc3545;">500</p>
    <h2>Internal Server Error</h2>
    <p class="admin-error-message"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred while processing your request. Please contact technical support or check activity logs.' %></p>
    <div class="admin-error-actions">
        <a href="javascript:location.reload()" class="btn btn-warning"><i class="icofont-refresh me-1"></i> Retry Page</a>
        <a href="/admin" class="btn btn-outline-primary"><i class="icofont-speed-meter me-1"></i> Back to Dashboard</a>
    </div>
</section>

<link rel="stylesheet" href="/css/private/500.css">
<%- include('../admin/partials/admin-footer') %>
