<%- include('../admin/partials/admin-head') %>

<link rel="stylesheet" href="/css/private/manager-quotations.css">

<!-- TOP ROW: LEFT 50% STATS & SEARCH / RIGHT 50% COMPACT REQUESTS UNDER REVIEW -->
<div class="row g-2 mb-2 align-items-stretch">
    <!-- LEFT 50%: COMPACT STATS CARDS (2x2 GRID) + COMPACT SEARCH BAR DIRECTLY UNDERNEATH -->
    <div class="col-12 col-lg-6 stats-col-50 d-flex flex-column justify-content-between">
        <!-- 2x2 COMPACT STATS CARDS -->
        <div class="row g-2 mb-2">
            <div class="col-6">
                <div class="compact-metric-card">
                    <div class="metric-header">
                        <span class="metric-label text-muted">Branch Requests</span>
                        <div class="metric-icon icon-blue">
                            <i class="icofont-inbox"></i>
                        </div>
                    </div>
                    <div>
                        <div class="metric-val text-dark"><%= stats.totalRequests %></div>
                        <div class="metric-sub text-muted">All branch submissions</div>
                    </div>
                </div>
            </div>

            <div class="col-6">
                <div class="compact-metric-card">
                    <div class="metric-header">
                        <span class="metric-label text-primary">Pending Reviews</span>
                        <div class="metric-icon icon-cyan">
                            <i class="icofont-clock-time"></i>
                        </div>
                    </div>
                    <div>
                        <div class="metric-val text-primary"><%= stats.pendingReviews %></div>
                        <div class="metric-sub text-primary">Needs manager pricing</div>
                    </div>
                </div>
            </div>

            <div class="col-6">
                <div class="compact-metric-card">
                    <div class="metric-header">
                        <span class="metric-label text-warning">Field Revision</span>
                        <div class="metric-icon" style="background: rgba(245, 158, 11, 0.15); color: #d97706;">
                            <i class="icofont-refresh"></i>
                        </div>
                    </div>
                    <div>
                        <div class="metric-val text-warning"><%= stats.inRevision %></div>
                        <div class="metric-sub text-warning">Awaiting staff update</div>
                    </div>
                </div>
            </div>

            <div class="col-6">
                <div class="compact-metric-card">
                    <div class="metric-header">
                        <span class="metric-label text-success">Approved Value</span>
                        <div class="metric-icon icon-green">
                            <i class="icofont-money-bag"></i>
                        </div>
                    </div>
                    <div>
                        <div class="metric-val text-success">₹ <%= (stats.approvedValue / 100000).toFixed(1) %>L</div>
                        <div class="metric-sub text-success"><%= stats.approvedCount %> proposals active</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- COMPACT SEARCH & FILTERS BAR (FIXED HEIGHT, SINGLE SEARCH BUTTON, EXACT STATS WIDTH) -->
        <div class="compact-filter-card shadow-sm mt-auto">
            <form method="GET" action="/manager/quotations" class="row g-1 align-items-center w-100 m-0">
                <div class="col-6 p-0 pe-1">
                    <div class="input-group input-group-sm" style="height: 32px;">
                        <input type="text" name="search" class="form-control form-control-sm" placeholder="Search customer, mobile, ID..." value="<%= search %>" style="height: 32px; font-size: 11.5px; border-radius: 6px 0 0 6px; border: 1px solid #cbd5e1;">
                        <button class="btn btn-sm px-2 d-flex align-items-center justify-content-center" type="submit" title="Search" style="height: 32px; border-radius: 0 6px 6px 0; background: var(--admin-navy-primary); border-color: var(--admin-navy-primary); color: #fff;">
                            <i class="icofont-search" style="font-size: 13px;"></i>
                        </button>
                    </div>
                </div>
                <div class="col-3 p-0 px-1">
                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()" style="height: 32px; font-size: 11px; padding-top: 3px; padding-bottom: 3px; border-radius: 6px; border: 1px solid #cbd5e1;">
                        <option value="ALL" <%= statusFilter === 'ALL' ? 'selected' : '' %>>All Statuses</option>
                        <option value="SUBMITTED" <%= statusFilter === 'SUBMITTED' ? 'selected' : '' %>>Submitted</option>
                        <option value="UNDER_REVIEW" <%= statusFilter === 'UNDER_REVIEW' ? 'selected' : '' %>>Under Review</option>
                        <option value="REVISION_REQUESTED" <%= statusFilter === 'REVISION_REQUESTED' ? 'selected' : '' %>>Revision</option>
                        <option value="RESUBMITTED" <%= statusFilter === 'RESUBMITTED' ? 'selected' : '' %>>Resubmitted</option>
                        <option value="QUOTATION_PREPARED" <%= statusFilter === 'QUOTATION_PREPARED' ? 'selected' : '' %>>Prepared</option>
                        <option value="REJECTED" <%= statusFilter === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
                    </select>
                </div>
                <div class="col-3 p-0 ps-1">
                    <div class="d-flex gap-1" style="height: 32px;">
                        <select name="employee" class="form-select form-select-sm" onchange="this.form.submit()" style="height: 32px; font-size: 11px; padding-top: 3px; padding-bottom: 3px; border-radius: 6px; border: 1px solid #cbd5e1;">
                            <option value="ALL" <%= employeeFilter === 'ALL' ? 'selected' : '' %>>All Staff</option>
                            <% if (teamEmployees && teamEmployees.length > 0) { %>
                                <% teamEmployees.forEach(emp => { %>
                                    <option value="<%= emp._id %>" <%= String(employeeFilter) === String(emp._id) ? 'selected' : '' %>><%= emp.name.split(' ')[0] %></option>
                                <% }) %>
                            <% } %>
                        </select>
                        <a href="/manager/quotations" class="btn btn-sm btn-outline-secondary px-2 d-flex align-items-center justify-content-center" title="Reset Filters" style="height: 32px; width: 32px; border-radius: 6px; border: 1px solid #cbd5e1; flex-shrink: 0;">
                            <i class="icofont-close" style="font-size: 12px;"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- RIGHT 50%: COMPACT REQUESTS UNDER REVIEW (EXACT MATCHING HEIGHT WITH LEFT SIDE) -->
    <div class="col-12 col-lg-6 requests-col-50 d-flex flex-column">
        <div class="compact-requests-box shadow-sm">
            <div class="compact-requests-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="icofont-clock-time text-primary fs-6"></i>
                    <span class="fw-bold text-dark" style="font-size: 12px;">Requests Under Review</span>
                    <span class="badge bg-primary text-white fw-bold rounded-pill" style="font-size: 10px; padding: 2px 6px;"><%= requests.length %></span>
                </div>
                <a href="/manager/quotations/new" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold" style="font-size: 10px; border-radius: 4px; height: 24px; line-height: 22px;">
                    <i class="icofont-plus-circle me-1"></i> New
                </a>
            </div>

            <div class="compact-requests-scroll flex-grow-1">
                <table class="table table-sm align-middle mb-0 compact-requests-table">
                    <thead>
                        <tr>
                            <th class="ps-3">Req #</th>
                            <th>Client</th>
                            <th>kW</th>
                            <th>Staff</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (requests && requests.length > 0) { %>
                            <% requests.forEach(r => { %>
                                <tr>
                                    <td class="ps-3">
                                        <a href="/manager/quotations/request/<%= r._id %>" class="fw-bold text-primary font-monospace" style="font-size: 11px;">
                                             <%= r.requestNumber %>
                                        </a>
                                        <% if (r.attachments && r.attachments.length > 0) { %>
                                            <span class="badge bg-light text-muted border ms-1" title="<%= r.attachments.length %> Attachments" style="font-size: 9px; padding: 1px 3px;">
                                                <i class="icofont-paperclip"></i> <%= r.attachments.length %>
                                            </span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <strong class="text-dark d-inline-block text-truncate" style="max-width: 95px;" title="<%= (r.customerSnapshot && r.customerSnapshot.name) || r.customerName || (r.customer && r.customer.name) || 'Unknown' %>">
                                            <%= (r.customerSnapshot && r.customerSnapshot.name) || r.customerName || (r.customer && r.customer.name) || 'Client' %>
                                        </strong>
                                    </td>
                                    <td class="fw-semibold text-nowrap"><%= (r.solarRequirements && r.solarRequirements.proposedCapacityKw) || r.proposedCapacityKw || '-' %> kW</td>
                                    <td class="text-muted text-nowrap" style="font-size: 10.5px;">
                                        <%= r.assignedEmployee ? r.assignedEmployee.name.split(' ')[0] : 'Staff' %>
                                    </td>
                                    <td>
                                        <span class="badge <%= r.status === 'SUBMITTED' ? 'bg-primary' : (r.status === 'UNDER_REVIEW' ? 'bg-info text-dark' : (r.status === 'RESUBMITTED' ? 'bg-warning text-dark' : (r.status === 'REVISION_REQUESTED' ? 'bg-danger' : (r.status === 'QUOTATION_PREPARED' ? 'bg-success' : (r.status === 'REJECTED' ? 'bg-secondary' : 'bg-light text-dark border'))))) %>" style="font-size: 9px; padding: 2px 5px;">
                                            <%= r.status === 'REVISION_REQUESTED' ? 'REVISION' : r.status %>
                                        </span>
                                    </td>
                                    <td class="text-end pe-3 text-nowrap">
                                        <a href="/manager/quotations/request/<%= r._id %>" class="btn btn-sm btn-outline-primary py-0 px-1" title="Review Full Technical Details" style="font-size: 11px; border-radius: 4px;">
                                            <i class="icofont-eye"></i>
                                        </a>
                                        <% if (r.status !== 'QUOTATION_PREPARED' && r.status !== 'REJECTED') { %>
                                            <a href="/manager/quotations/prepare/<%= r._id %>" class="btn btn-sm btn-success py-0 px-1 text-white ms-1" title="Prepare & Approve Official Quotation" style="font-size: 11px; border-radius: 4px;">
                                                <i class="icofont-check-circled"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-warning py-0 px-1 ms-1" onclick="openRevisionModal('<%= r._id %>', '<%= r.requestNumber %>')" title="Request Survey Revision" style="font-size: 11px; border-radius: 4px;">
                                                <i class="icofont-refresh"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 ms-1" onclick="openRejectModal('<%= r._id %>', '<%= r.requestNumber %>')" title="Reject Request" style="font-size: 11px; border-radius: 4px;">
                                                <i class="icofont-close-circled"></i>
                                            </button>
                                        <% } else if (r.linkedQuotation) { %>
                                            <a href="/manager/quotations/<%= r.linkedQuotation._id || r.linkedQuotation %>" class="btn btn-sm btn-outline-success py-0 px-1 ms-1" title="View Quote" style="font-size: 11px; border-radius: 4px;">
                                                <i class="icofont-file-document"></i>
                                            </a>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted small">
                                    No quotation requests under review.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- BOTTOM: OFFICIAL COMMERCIAL QUOTATIONS (FULL-WIDTH 100%) -->
<!-- ========================================================================= -->
<% if (typeof quotations !== 'undefined' && quotations && quotations.length > 0) { %>
<div class="w-100">
    <div class="admin-card mb-4 border-0 shadow-sm" style="border-radius: 12px; overflow: hidden; border: 1px solid var(--admin-border, #cbd5e1) !important;">
        <div class="admin-card-header bg-white d-flex flex-wrap align-items-center justify-content-between py-2 px-3 border-bottom">
            <div>
                <h5 class="admin-card-title mb-0 d-flex align-items-center gap-2" style="font-size: 14.5px; font-weight: 700;">
                    <i class="icofont-certificate-alt-1 text-success fs-5"></i>
                    Commercial Solar Quotations (<%= quotations.length %>)
                </h5>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold" style="font-size: 11px;">
                    <i class="icofont-check-circled me-1"></i> Commercial Pipeline
                </span>
            </div>
        </div>

        <div class="admin-table-container approved-table-wrap">
            <table class="admin-table table approved-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 15%;">Quotation # & Date</th>
                        <th style="width: 18%;">Customer Details</th>
                        <th style="width: 12%;">Capacity & System</th>
                        <th style="width: 13%;">Gross Total</th>
                        <th style="width: 14%;">Net Payable</th>
                        <th style="width: 10%;">Field Staff</th>
                        <th style="width: 8%;">Status</th>
                        <th style="width: 18%;" class="text-end approved-actions-cell">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% quotations.forEach(q => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <a href="/manager/quotations/<%= q._id %>" class="fw-bold text-primary font-monospace" style="font-size: 13px;">
                                        <%= q.quotationNumber %>
                                    </a>
                                    <span class="badge bg-light text-muted border" style="font-size: 9.5px;">v<%= q.version %></span>
                                </div>
                                <div class="text-muted small mt-1" style="font-size: 10.5px;">
                                    <i class="icofont-calendar me-1"></i><%= new Date(q.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %>
                                </div>
                                <% const reqNum = (q.quotationRequestId && q.quotationRequestId.requestNumber) ? q.quotationRequestId.requestNumber : (typeof q.quotationRequestId === 'string' ? q.quotationRequestId : null); %>
                                <% if (reqNum) { %>
                                    <div class="small text-muted mt-1" style="font-size: 10.5px;">
                                        <i class="icofont-link-alt text-primary"></i> Req: <strong><%= reqNum %></strong>
                                    </div>
                                <% } %>
                            </td>
                            <td>
                                <div class="fw-bold text-dark text-truncate" title="<%= q.customerName %>"><%= q.customerName %></div>
                                <div class="text-muted small text-truncate" style="font-size: 11px;">
                                    <i class="icofont-phone text-secondary me-1"></i><%= q.customerMobile %>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1 fw-bold"><%= q.plantCapacityKw %> kW</span>
                                <div class="text-muted small mt-1 text-truncate" style="font-size: 10.5px;"><%= q.systemType %></div>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark text-nowrap">₹ <%= Number(q.grandTotal).toLocaleString('en-IN') %></span>
                            </td>
                            <td>
                                <div class="fw-bold text-success text-nowrap" style="font-size: 13.5px;">₹ <%= Number(q.netPayableAfterSubsidy).toLocaleString('en-IN') %></div>
                                <div class="small text-muted text-nowrap" style="font-size: 10.5px;">Subsidy: ₹<%= Number(q.estimatedSubsidy).toLocaleString('en-IN') %></div>
                            </td>
                            <td>
                                <% const staff = q.assignedEmployee || (q.quotationRequestId && q.quotationRequestId.assignedEmployee) || null; %>
                                <% if (staff) { %>
                                    <strong class="text-dark d-block text-truncate" style="font-size: 11.5px;"><%= staff.name %></strong>
                                    <div class="small text-muted" style="font-size: 10px;"><%= staff.employeeId || 'Staff' %></div>
                                <% } else { %>
                                    <span class="small font-weight-bold text-truncate d-block"><%= q.preparedBy ? q.preparedBy.name : 'Staff' %></span>
                                <% } %>
                            </td>
                            <td>
                                <% if (q.status === 'APPROVED' || q.status === 'SHARED') { %>
                                    <span class="badge bg-success" style="font-size: 9.5px;">APPROVED</span>
                                <% } else if (q.status === 'CUSTOMER_ACCEPTED') { %>
                                    <span class="badge bg-primary text-center px-1 py-1" style="font-size: 8.5px; line-height: 1.15; display: inline-block;">
                                        CLIENT<br>ACCEPTED
                                    </span>
                                <% } else if (q.status === 'CUSTOMER_REJECTED') { %>
                                    <span class="badge bg-danger" style="font-size: 9.5px;">DECLINED</span>
                                <% } else if (q.status === 'PENDING_APPROVAL') { %>
                                    <span class="badge bg-warning text-dark" style="font-size: 9.5px;">PENDING</span>
                                <% } else { %>
                                    <span class="badge bg-secondary" style="font-size: 9.5px;"><%= q.status %></span>
                                <% } %>
                            </td>
                            <td class="text-end approved-actions-cell">
                                <div class="approved-actions-grid">
                                    <!-- ROW 1: PDF & SHARE -->
                                    <a href="/quotations/<%= q._id %>/document" target="_blank" class="btn btn-outline-danger" title="Download & Print PDF">
                                        <i class="icofont-file-pdf"></i> PDF
                                    </a>

                                    <% if (['APPROVED', 'SHARED', 'CUSTOMER_ACCEPTED'].includes(q.status)) { %>
                                        <button type="button" class="btn btn-share btn-open-share-modal" data-quote="<%= JSON.stringify({
                                            id: q._id,
                                            quotationNumber: q.quotationNumber,
                                            customerName: q.customerName,
                                            customerMobile: q.customerMobile,
                                            capacity: q.plantCapacityKw,
                                            systemType: q.systemType,
                                            grandTotal: q.grandTotal,
                                            subsidy: q.estimatedSubsidy,
                                            netPayable: q.netPayableAfterSubsidy,
                                            token: q.customerResponse ? q.customerResponse.acceptanceToken : ""
                                        }) %>" title="Share via WhatsApp & Copy Link">
                                            <i class="icofont-share"></i> Share
                                        </button>
                                    <% } else { %>
                                        <span class="action-pill-badge bg-light text-muted border">
                                            <i class="icofont-lock"></i> Pending
                                        </span>
                                    <% } %>

                                    <!-- ROW 2: DETAILS & APPROVE -->
                                    <a href="/manager/quotations/<%= q._id %>" class="btn btn-outline-primary" title="View Proposal Details">
                                        <i class="icofont-eye"></i> Details
                                    </a>

                                    <% if (q.status === 'PENDING_APPROVAL') { %>
                                        <button type="button" class="btn btn-success text-white fw-bold" onclick="managerApproveQuote('<%= q._id %>', '<%= q.quotationNumber %>')" title="Authorize Proposal">
                                            <i class="icofont-check-circled"></i> Approve
                                        </button>
                                    <% } else if (q.status === 'APPROVED' || q.status === 'SHARED') { %>
                                        <button type="button" class="btn btn-outline-primary fw-bold" onclick="openCustomerResponseModal('<%= q._id %>', '<%= q.quotationNumber %>', '<%= q.status %>', '<%= (q.quotationRequestId && (q.quotationRequestId._id || q.quotationRequestId)) || '' %>')" title="Actions, Revision & Client Decision">
                                            <i class="icofont-navigation-menu"></i> Actions
                                        </button>
                                        <a href="/manager/quotations/<%= q._id %>/edit" class="btn btn-outline-warning" title="Revise Quotation Details & Pricing">
                                            <i class="icofont-edit"></i> Revise
                                        </a>
                                    <% } else if (q.status === 'CUSTOMER_ACCEPTED') { %>
                                        <span class="action-pill-badge bg-success-subtle text-success border border-success-subtle" title="Customer Accepted - Project Active">
                                            <i class="icofont-check"></i> Accepted
                                        </span>
                                    <% } else if (q.status === 'CUSTOMER_REJECTED') { %>
                                        <button type="button" class="btn btn-outline-warning" onclick="openCustomerResponseModal('<%= q._id %>', '<%= q.quotationNumber %>', '<%= q.status %>', '<%= (q.quotationRequestId && (q.quotationRequestId._id || q.quotationRequestId)) || '' %>')" title="Revise Declined Quotation">
                                            <i class="icofont-edit"></i> Revise
                                        </button>
                                        <span class="action-pill-badge bg-danger-subtle text-danger border border-danger-subtle" title="Customer Declined">
                                            <i class="icofont-close"></i> Declined
                                        </span>
                                    <% } else { %>
                                        <span class="action-pill-badge bg-light text-muted border">
                                            Issued
                                        </span>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<% } %>

<!-- Modal: Request Revision -->
<div class="modal fade" id="modalRevision" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fs-6">Request Field Survey Revision</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formRevision">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" id="revRequestId" name="requestId">
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Enter detailed instructions explaining what needs to be verified or updated by the field staff for request <strong id="revReqNum" class="text-dark"></strong>:
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Revision Instructions / Query *</label>
                        <textarea class="form-control" name="reason" rows="4" placeholder="e.g. Please capture high-resolution photo of main distribution board and recheck sanctioned load on consumer bill." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning btn-sm font-weight-bold" id="btnSubmitRevision">
                        Send Revision Request to Staff
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Reject Request -->
<div class="modal fade" id="modalReject" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fs-6">Decline / Reject Quotation Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formReject">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" id="rejRequestId" name="requestId">
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Please state the commercial or technical reason for declining request <strong id="rejReqNum" class="text-dark"></strong>:
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Rejection Reason *</label>
                        <textarea class="form-control" name="reason" rows="4" placeholder="e.g. Severe roof shadowing or customer opted out due to grid disconnection constraints." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm" id="btnSubmitReject">
                        Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../admin/partials/share-quotation-modal') %>
<%- include('../admin/partials/customer-response-modal') %>

<script>
function openRevisionModal(reqId, reqNum) {
    document.getElementById('revRequestId').value = reqId;
    document.getElementById('revReqNum').textContent = reqNum;
    new bootstrap.Modal(document.getElementById('modalRevision')).show();
}

function openRejectModal(reqId, reqNum) {
    document.getElementById('rejRequestId').value = reqId;
    document.getElementById('rejReqNum').textContent = reqNum;
    new bootstrap.Modal(document.getElementById('modalReject')).show();
}

async function managerApproveQuote(id, qNum) {
    const comments = prompt(`Enter authorization note for ${qNum}:`, 'Approved by Branch Management');
    if (comments === null) return;

    try {
        const res = await fetch(`/manager/quotations/${id}/approve`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': '<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>'
            },
            body: JSON.stringify({ comments })
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message);
            window.location.reload();
        } else {
            alert(data.message || 'Authorization failed.');
        }
    } catch (err) {
        alert('Server error.');
    }
}

document.getElementById('formRevision')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const reqId = document.getElementById('revRequestId').value;
    const btn = document.getElementById('btnSubmitRevision');
    btn.disabled = true;
    const formData = new FormData(this);
    const payload = {
        action: 'REVISION_REQUESTED',
        reason: formData.get('reason'),
        _csrf: formData.get('_csrf')
    };

    try {
        const res = await fetch(`/manager/quotations/request/${reqId}/status`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'CSRF-Token': payload._csrf },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            alert('Revision instructions sent to field staff.');
            window.location.reload();
        } else {
            alert(data.message || 'Error updating status.');
            btn.disabled = false;
        }
    } catch (err) {
        alert('Server connection error.');
        btn.disabled = false;
    }
});

