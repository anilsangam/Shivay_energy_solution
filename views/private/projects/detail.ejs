        </div>
    </div>
</div>

<!-- Client-side script for Base64 File Encoding in Document Upload -->
<script>
    (function() {
        const fileInput = document.getElementById('docFileInput');
        const submitBtn = document.getElementById('docUploadSubmitBtn');
        const b64Input = document.getElementById('fileDataBase64');
        const nameInput = document.getElementById('fileDataName');
        const mimeInput = document.getElementById('fileDataMime');

        if (fileInput) {
            fileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (!file) {
                    if (submitBtn) submitBtn.disabled = true;
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    alert('File exceeds maximum size limit of 5 MB.');
                    fileInput.value = '';
                    if (submitBtn) submitBtn.disabled = true;
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(evt) {
                    b64Input.value = evt.target.result;
                    nameInput.value = file.name;
                    mimeInput.value = file.type || 'application/octet-stream';
                    if (submitBtn) submitBtn.disabled = false;
                };
                reader.readAsDataURL(file);
            });
        }
    })();
</script>

