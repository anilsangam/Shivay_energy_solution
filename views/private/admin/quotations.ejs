<%- include('partials/admin-head') %>

<%
    const authUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : ((typeof user !== 'undefined' && user) ? user : null);
    const checkPerm = (typeof hasPermission === 'function') 
        ? hasPermission 
        : ((k) => authUser && (authUser.isPrimarySuperAdmin || (Array.isArray(authUser.permissions) && authUser.permissions.includes(k))));
    const checkField = (typeof hasFieldAccess === 'function')
        ? hasFieldAccess
        : ((f) => authUser && (authUser.isPrimarySuperAdmin || (Array.isArray(authUser.fieldPermissions) && authUser.fieldPermissions.includes(f))));

    const canApproveQuotation = checkPerm('quotations.approval.approve');
    const canCreateQuotation = checkPerm('quotations.preparation.create');
    const canViewQuotationDoc = checkPerm('quotations.document.view');
    const canViewCrm = checkPerm('crm.customers.view');
    const canRejectRequest = checkPerm('quotations.requests.reject');
    const canViewCostBreakdown = checkField('fields.quotation.cost_breakdown.view');
%>

<link rel="stylesheet" href="/css/private/quotations.css">

<!-- TOP ROW: LEFT 50% STATS & SEARCH / RIGHT 50% COMPACT INCOMING REQUESTS -->
<div class="row g-2 mb-2 align-items-stretch">
    <!-- LEFT 50%: COMPACT STATS CARDS (2x2 GRID) + COMPACT SEARCH BAR DIRECTLY UNDERNEATH -->
    <div class="col-12 col-lg-6 stats-col-50 d-flex flex-column justify-content-between">
        <!-- 2x2 COMPACT STATS CARDS -->
        <div class="row g-2 mb-2">
            <div class="col-6">
                <div class="compact-metric-card">
                    <div class="metric-header">
                        <span class="metric-label text-muted">Company Requests</span>
                        <div class="metric-icon icon-navy">
                            <i class="icofont-inbox"></i>
                        </div>
                    </div>
                    <div>
                        <div class="metric-val text-dark"><%= stats.totalRequests %></div>
                        <div class="metric-sub text-muted">All branches combined</div>
                    </div>
                </div>
            </div>

            <div class="col-6">
                <div class="compact-metric-card">
                    <div class="metric-header">
                        <span class="metric-label text-warning">Pending Approval</span>
                        <div class="metric-icon icon-amber">
                            <i class="icofont-shield-alt"></i>
                        </div>
                    </div>
                    <div>
                        <div class="metric-val text-warning"><%= stats.pendingApprovals %></div>
                        <div class="metric-sub text-warning">Maker-Checker queue</div>
                    </div>
                </div>
            </div>

            <div class="col-6">
                <div class="compact-metric-card">
                    <div class="metric-header">
                        <span class="metric-label text-primary">Authorized Proposals</span>
                        <div class="metric-icon icon-blue">
                            <i class="icofont-check-circled"></i>
                        </div>
                    </div>
                    <div>
                        <div class="metric-val text-primary"><%= stats.approvedCount %></div>
                        <div class="metric-sub text-muted">₹ <%= (stats.approvedQuotationValue / 100000).toFixed(1) %>L value</div>
                    </div>
                </div>
            </div>

            <div class="col-6">
                <div class="compact-metric-card">
                    <div class="metric-header">
                        <span class="metric-label text-success">Customer Accepted</span>
                        <div class="metric-icon icon-green">
                            <i class="icofont-badge"></i>
                        </div>
                    </div>
                    <div>
                        <div class="metric-val text-success"><%= stats.acceptedCount %></div>
                        <div class="metric-sub text-success">Ready for Phase 3</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- COMPACT SEARCH & FILTERS BAR (FIXED HEIGHT, SINGLE SEARCH BUTTON, EXACT STATS WIDTH) -->
        <div class="compact-filter-card shadow-sm mt-auto">
            <form method="GET" action="/admin/quotations" class="row g-2 align-items-center w-100 m-0">
                <div class="col-7 p-0 pe-1">
                    <div class="input-group input-group-sm" style="height: 32px;">
                        <input type="text" name="search" class="form-control form-control-sm" placeholder="Search quote #, customer, mobile..." value="<%= search %>" style="height: 32px; font-size: 11.5px; border-radius: 6px 0 0 6px; border: 1px solid #cbd5e1;">
                        <button class="btn btn-sm px-3 d-flex align-items-center justify-content-center" type="submit" title="Search" style="height: 32px; border-radius: 0 6px 6px 0; background: var(--admin-navy-primary); border-color: var(--admin-navy-primary); color: #fff;">
                            <i class="icofont-search" style="font-size: 13px;"></i>
                        </button>
                    </div>
                </div>
                <div class="col-5 p-0 ps-1">
                    <div class="d-flex gap-1" style="height: 32px;">
                        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()" style="height: 32px; font-size: 11px; padding-top: 3px; padding-bottom: 3px; border-radius: 6px; border: 1px solid #cbd5e1;">
                            <option value="ALL" <%= statusFilter === 'ALL' ? 'selected' : '' %>>All Statuses</option>
                            <option value="PENDING_APPROVAL" <%= statusFilter === 'PENDING_APPROVAL' ? 'selected' : '' %>>Pending Authorization</option>
                            <option value="APPROVED" <%= statusFilter === 'APPROVED' ? 'selected' : '' %>>Approved & Issued</option>
                            <option value="SHARED" <%= statusFilter === 'SHARED' ? 'selected' : '' %>>Shared with Client</option>
                            <option value="CUSTOMER_ACCEPTED" <%= statusFilter === 'CUSTOMER_ACCEPTED' ? 'selected' : '' %>>Customer Accepted</option>
                            <option value="CUSTOMER_REJECTED" <%= statusFilter === 'CUSTOMER_REJECTED' ? 'selected' : '' %>>Customer Declined</option>
                            <option value="REJECTED" <%= statusFilter === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
                        </select>
                        <a href="/admin/quotations" class="btn btn-sm btn-outline-secondary px-2 d-flex align-items-center justify-content-center" title="Reset Filters" style="height: 32px; width: 32px; border-radius: 6px; border: 1px solid #cbd5e1; flex-shrink: 0;">
                            <i class="icofont-close" style="font-size: 12px;"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- RIGHT 50%: COMPACT INCOMING REQUESTS (EXACT MATCHING HEIGHT WITH LEFT SIDE) -->
    <div class="col-12 col-lg-6 requests-col-50 d-flex flex-column">
        <div class="compact-requests-box shadow-sm">
            <div class="compact-requests-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="icofont-paper text-primary fs-6"></i>
                    <span class="fw-bold text-dark" style="font-size: 12px;">Incoming Requests</span>
                    <span class="badge bg-primary text-white fw-bold rounded-pill" style="font-size: 10px; padding: 2px 6px;"><%= (typeof requests !== 'undefined' && requests) ? requests.length : 0 %></span>
                </div>
                <div class="d-flex gap-1">
                    <% if (canViewCrm) { %>
                        <a href="/admin/customers" class="btn btn-sm btn-outline-secondary py-0 px-2 fw-semibold" style="font-size: 10px; border-radius: 4px; height: 24px; line-height: 22px;">
                            <i class="icofont-users-alt-2 me-1"></i> CRM
                        </a>
                    <% } %>
                    <% if (canCreateQuotation) { %>
                        <a href="/admin/quotations/new" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold" style="font-size: 10px; border-radius: 4px; height: 24px; line-height: 22px;">
                            <i class="icofont-plus-circle me-1"></i> New
                        </a>
                    <% } %>
                </div>
            </div>

            <div class="compact-requests-scroll flex-grow-1">
                <table class="table table-sm align-middle mb-0 compact-requests-table">
                    <thead>
                        <tr>
                            <th class="ps-3">Req #</th>
                            <th>Client</th>
                            <th>kW</th>
                            <th>Staff</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof requests !== 'undefined' && requests && requests.length > 0) { %>
                            <% requests.forEach(r => { %>
                                <tr>
                                    <td class="ps-3">
                                        <a href="/admin/quotations/request/<%= r._id %>" class="fw-bold text-primary font-monospace" style="font-size: 11px;">
                                            <%= r.requestNumber %>
                                        </a>
                                        <% if (r.attachments && r.attachments.length > 0) { %>
                                            <span class="badge bg-light text-muted border ms-1" title="<%= r.attachments.length %> Attachments" style="font-size: 9px; padding: 1px 3px;">
                                                <i class="icofont-paperclip"></i> <%= r.attachments.length %>
                                            </span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <strong class="text-dark d-inline-block text-truncate" style="max-width: 95px;" title="<%= (r.customerSnapshot && r.customerSnapshot.name) || r.customerName || (r.customer && r.customer.name) || 'Customer' %>">
                                            <%= (r.customerSnapshot && r.customerSnapshot.name) || r.customerName || (r.customer && r.customer.name) || 'Client' %>
                                        </strong>
                                    </td>
                                    <td class="fw-semibold text-nowrap"><%= (r.solarRequirements && r.solarRequirements.proposedCapacityKw) || r.proposedCapacityKw || '-' %> kW</td>
                                    <td class="text-muted text-nowrap" style="font-size: 10.5px;">
                                        <%= r.assignedEmployee ? r.assignedEmployee.name.split(' ')[0] : 'Staff' %>
                                    </td>
                                    <td>
                                        <span class="badge <%= r.status === 'SUBMITTED' ? 'bg-primary' : (r.status === 'UNDER_REVIEW' ? 'bg-info text-dark' : (r.status === 'RESUBMITTED' ? 'bg-warning text-dark' : (r.status === 'REVISION_REQUESTED' ? 'bg-danger' : (r.status === 'QUOTATION_PREPARED' ? 'bg-success' : (r.status === 'REJECTED' ? 'bg-secondary' : 'bg-light text-dark border'))))) %>" style="font-size: 9px; padding: 2px 5px;">
                                            <%= r.status === 'REVISION_REQUESTED' ? 'REVISION' : r.status %>
                                        </span>
                                    </td>
                                    <td class="text-end pe-3 text-nowrap">
                                        <a href="/admin/quotations/request/<%= r._id %>" class="btn btn-sm btn-outline-primary py-0 px-1" title="Review Full Technical Details" style="font-size: 11px; border-radius: 4px;">
                                            <i class="icofont-eye"></i>
                                        </a>
                                        <% if (r.status !== 'QUOTATION_PREPARED' && r.status !== 'REJECTED') { %>
                                            <% if (canCreateQuotation) { %>
                                                <a href="/admin/quotations/prepare/<%= r._id %>" class="btn btn-sm btn-success py-0 px-1 text-white ms-1" title="Prepare & Approve Official Quotation" style="font-size: 11px; border-radius: 4px;">
                                                    <i class="icofont-check-circled"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-warning py-0 px-1 ms-1" onclick="adminRequestRevision('<%= r._id %>', '<%= r.requestNumber %>')" title="Request Revision" style="font-size: 11px; border-radius: 4px;">
                                                    <i class="icofont-refresh"></i>
                                                </button>
                                            <% } %>
                                            <% if (canRejectRequest) { %>
                                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 ms-1" onclick="adminRejectRequest('<%= r._id %>', '<%= r.requestNumber %>')" title="Reject Request" style="font-size: 11px; border-radius: 4px;">
                                                    <i class="icofont-close-circled"></i>
                                                </button>
                                            <% } %>
                                        <% } else if (r.linkedQuotation) { %>
                                            <a href="/admin/quotations/<%= r.linkedQuotation._id || r.linkedQuotation %>" class="btn btn-sm btn-outline-success py-0 px-1 ms-1" title="View Quote" style="font-size: 11px; border-radius: 4px;">
                                                <i class="icofont-file-document"></i>
                                            </a>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted small">
                                    No incoming quotation requests.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- BOTTOM: OFFICIAL COMMERCIAL QUOTATIONS (FULL-WIDTH 100%) -->
<!-- ========================================================================= -->
<div class="w-100">
    <div class="admin-card mb-4 border-0 shadow-sm" style="border-radius: 12px; overflow: hidden; border: 1px solid var(--admin-border, #cbd5e1) !important;">
        <div class="admin-card-header bg-white d-flex flex-wrap align-items-center justify-content-between py-2 px-3 border-bottom">
            <div>
                <h5 class="admin-card-title mb-0 d-flex align-items-center gap-2" style="font-size: 14.5px; font-weight: 700;">
                    <i class="icofont-certificate-alt-1 text-success fs-5"></i>
                    Commercial Solar Quotations (<%= pagination.total %>)
                </h5>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold" style="font-size: 11px;">
                    <i class="icofont-check-circled me-1"></i> Executive Control Pipeline
                </span>
            </div>
        </div>

        <div class="admin-table-container approved-table-wrap">
            <table class="admin-table table approved-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 15%;">Quotation # & Date</th>
                        <th style="width: 18%;">Customer Details</th>
                        <th style="width: 12%;">Capacity & System</th>
                        <th style="width: 13%;">Gross Total</th>
                        <th style="width: 14%;">Net Payable</th>
                        <th style="width: 10%;">Requester</th>
                        <th style="width: 8%;">Status</th>
                        <th style="width: 18%;" class="text-end approved-actions-cell">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (quotations && quotations.length > 0) { %>
                        <% quotations.forEach(q => { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <a href="/admin/quotations/<%= q._id %>" class="fw-bold text-primary font-monospace" style="font-size: 13px;">
                                            <%= q.quotationNumber %>
                                        </a>
                                        <span class="badge bg-light text-muted border" style="font-size: 9.5px;">v<%= q.version %></span>
                                    </div>
                                    <div class="text-muted small mt-1" style="font-size: 10.5px;">
                                        <i class="icofont-calendar me-1"></i><%= new Date(q.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %>
                                    </div>
                                    <% const reqNum = (q.quotationRequestId && q.quotationRequestId.requestNumber) ? q.quotationRequestId.requestNumber : (typeof q.quotationRequestId === 'string' ? q.quotationRequestId : null); %>
                                    <% if (reqNum) { %>
                                        <div class="small text-muted mt-1" style="font-size: 10.5px;">
                                            <i class="icofont-link-alt text-primary"></i> Req: <strong><%= reqNum %></strong>
                                        </div>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark text-truncate" title="<%= q.customerName %>"><%= q.customerName %></div>
                                    <div class="text-muted small text-truncate" style="font-size: 11px;">
                                        <i class="icofont-phone text-secondary me-1"></i><%= q.customerMobile %>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 fw-bold"><%= q.plantCapacityKw %> kW</span>
                                    <div class="text-muted small mt-1 text-truncate" style="font-size: 10.5px;"><%= q.systemType %></div>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark text-nowrap">₹ <%= Number(q.grandTotal).toLocaleString('en-IN') %></span>
                                </td>
                                <td>
                                    <div class="fw-bold text-success text-nowrap" style="font-size: 13.5px;">₹ <%= Number(q.netPayableAfterSubsidy).toLocaleString('en-IN') %></div>
                                    <div class="small text-muted text-nowrap" style="font-size: 10.5px;">Subsidy: ₹<%= Number(q.estimatedSubsidy).toLocaleString('en-IN') %></div>
                                </td>
                                <td>
                                    <% const staff = q.assignedEmployee || (q.quotationRequestId && q.quotationRequestId.assignedEmployee) || null; %>
                                    <% if (staff) { %>
                                        <strong class="text-dark d-block text-truncate" style="font-size: 11.5px;"><%= staff.name %></strong>
                                        <div class="small text-muted" style="font-size: 10px;"><%= staff.employeeId || 'Staff' %></div>
                                    <% } else { %>
                                        <span class="small font-weight-bold text-truncate d-block"><%= q.preparedBy ? q.preparedBy.name : 'Staff' %></span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (q.status === 'APPROVED' || q.status === 'SHARED') { %>
                                        <span class="badge bg-success" style="font-size: 9.5px;">APPROVED</span>
                                    <% } else if (q.status === 'CUSTOMER_ACCEPTED') { %>
                                        <span class="badge bg-primary text-center px-1 py-1" style="font-size: 8.5px; line-height: 1.15; display: inline-block;">
                                            CLIENT<br>ACCEPTED
                                        </span>
                                    <% } else if (q.status === 'CUSTOMER_REJECTED') { %>
                                        <span class="badge bg-danger" style="font-size: 9.5px;">DECLINED</span>
                                    <% } else if (q.status === 'PENDING_APPROVAL') { %>
                                        <span class="badge bg-warning text-dark" style="font-size: 9.5px;">PENDING</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary" style="font-size: 9.5px;"><%= q.status %></span>
                                    <% } %>
                                </td>
                                <td class="text-end approved-actions-cell">
                                    <div class="approved-actions-grid">
                                        <!-- ROW 1: PDF & SHARE -->
                                        <% if (canViewQuotationDoc) { %>
                                            <a href="/quotations/<%= q._id %>/document" target="_blank" class="btn btn-outline-danger" title="Download & Print PDF">
                                                <i class="icofont-file-pdf"></i> PDF
                                            </a>
                                        <% } %>

                                        <% if (['APPROVED', 'SHARED', 'CUSTOMER_ACCEPTED'].includes(q.status)) { %>
                                            <button type="button" class="btn btn-share btn-open-share-modal" data-quote="<%= JSON.stringify({
                                                id: q._id,
                                                quotationNumber: q.quotationNumber,
                                                customerName: q.customerName,
                                                customerMobile: q.customerMobile,
                                                capacity: q.plantCapacityKw,
                                                systemType: q.systemType,
                                                grandTotal: q.grandTotal,
                                                subsidy: q.estimatedSubsidy,
                                                netPayable: q.netPayableAfterSubsidy,
                                                token: q.customerResponse ? q.customerResponse.acceptanceToken : ""
                                            }) %>" title="Share via WhatsApp & Copy Link">
                                                <i class="icofont-share"></i> Share
                                            </button>
                                        <% } else { %>
                                            <span class="action-pill-badge bg-light text-muted border">
                                                <i class="icofont-lock"></i> Pending
                                            </span>
                                        <% } %>

                                        <!-- ROW 2: DETAILS & APPROVE / STATUS -->
                                        <a href="/admin/quotations/<%= q._id %>" class="btn btn-outline-primary" title="View Full Proposal & History">
                                            <i class="icofont-eye"></i> Details
                                        </a>

                                        <% if (q.status === 'PENDING_APPROVAL') { %>
                                            <% if (canApproveQuotation) { %>
                                                <button type="button" class="btn btn-success text-white fw-bold" onclick="adminApprove('<%= q._id %>', '<%= q.quotationNumber %>')" title="Authorize Proposal">
                                                    <i class="icofont-check-circled"></i> Approve
                                                </button>
                                            <% } else { %>
                                                <span class="action-pill-badge bg-warning text-dark border">
                                                    <i class="icofont-clock-time"></i> Pending Authorization
                                                </span>
                                            <% } %>
                                        <% } else if (q.status === 'APPROVED' || q.status === 'SHARED') { %>
                                            <button type="button" class="btn btn-outline-primary fw-bold" onclick="openCustomerResponseModal('<%= q._id %>', '<%= q.quotationNumber %>', '<%= q.status %>', '<%= (q.quotationRequestId && (q.quotationRequestId._id || q.quotationRequestId)) || '' %>')" title="Actions, Revision & Client Decision">
                                                <i class="icofont-navigation-menu"></i> Actions
                                            </button>
                                            <% if (canCreateQuotation) { %>
                                                <a href="/admin/quotations/<%= q._id %>/edit" class="btn btn-outline-warning" title="Revise Quotation Details & Pricing">
                                                    <i class="icofont-edit"></i> Revise
                                                </a>
                                            <% } %>
                                        <% } else if (q.status === 'CUSTOMER_ACCEPTED') { %>
                                            <span class="action-pill-badge bg-success-subtle text-success border border-success-subtle" title="Customer Accepted - Project Active">
                                                <i class="icofont-check"></i> Accepted
                                            </span>
                                        <% } else if (q.status === 'CUSTOMER_REJECTED') { %>
                                            <button type="button" class="btn btn-outline-warning" onclick="openCustomerResponseModal('<%= q._id %>', '<%= q.quotationNumber %>', '<%= q.status %>', '<%= (q.quotationRequestId && (q.quotationRequestId._id || q.quotationRequestId)) || '' %>')" title="Revise Declined Quotation">
                                                <i class="icofont-edit"></i> Revise
                                            </button>
                                            <span class="action-pill-badge bg-danger-subtle text-danger border border-danger-subtle" title="Customer Declined">
                                                <i class="icofont-close"></i> Declined
                                            </span>
                                        <% } else { %>
                                            <span class="action-pill-badge bg-light text-muted border">
                                                Issued
                                            </span>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="icofont-file-document fs-1 d-block mb-2 text-light"></i>
                                No quotations found in the database.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        <% if (pagination.totalPages > 1) { %>
            <div class="p-3 border-top d-flex align-items-center justify-content-between">
                <small class="text-muted">Showing page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.total %> total quotations)</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <% for(let p = 1; p <= pagination.totalPages; p++) { %>
                            <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
                                <a class="page-link" href="?page=<%= p %>&status=<%= statusFilter %>&search=<%= search %>"><%= p %></a>
                            </li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/share-quotation-modal') %>
<%- include('partials/customer-response-modal') %>

<script>
async function adminRequestRevision(reqId, reqNum) {
    const reason = prompt(`Enter revision comments for request ${reqNum} (Employee will be asked to update details):`);
    if (!reason || !reason.trim()) return;

    try {
        const res = await fetch(`/admin/quotations/request/${reqId}/status`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': '<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>'
            },
            body: JSON.stringify({ action: 'REVISION_REQUESTED', reason })
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message);
            window.location.reload();
        } else {
            alert(data.message || 'Error sending revision request.');
        }
    } catch (err) {
        alert('Server error.');
    }
}

async function adminRejectRequest(reqId, reqNum) {
    const reason = prompt(`Enter rejection reason for request ${reqNum}:`);
    if (!reason || !reason.trim()) return;

    try {
        const res = await fetch(`/admin/quotations/request/${reqId}/status`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': '<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>'
            },
            body: JSON.stringify({ action: 'REJECTED', reason })
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message);
            window.location.reload();
        } else {
            alert(data.message || 'Error rejecting request.');
        }
    } catch (err) {
        alert('Server error.');
    }
}

async function adminApprove(id, qNum) {
    const comments = prompt(`Enter Super Admin authorization note for ${qNum}:`, 'Authorized by Executive Management');
    if (comments === null) return;

    try {
        const res = await fetch(`/admin/quotations/${id}/approve`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': '<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>'
            },
            body: JSON.stringify({ comments })
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message);
            window.location.reload();
        } else {
            alert(data.message || 'Authorization failed.');
        }
    } catch (err) {
        alert('Server error.');
    }
}

async function adminReject(id, qNum) {
    const reason = prompt(`Enter rejection reason for ${qNum}:`);
    if (!reason) return;

    try {
        const res = await fetch(`/admin/quotations/${id}/reject`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': '<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>'
            },
            body: JSON.stringify({ reason })
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message);
            window.location.reload();
        } else {
            alert(data.message || 'Error rejecting quotation.');
        }
    } catch (err) {
        alert('Server error.');
    }
}
</script>

