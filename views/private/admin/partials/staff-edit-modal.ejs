<!-- Reusable Modal & Shared Logic: Edit Staff / Manager Member (Super Admin) -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header text-white" style="background: var(--admin-navy-primary); border-top-left-radius: 16px; border-top-right-radius: 16px;">
                <h5 class="modal-title font-weight-bold" id="editUserModalLabel">
                    <i class="icofont-edit me-1 text-warning"></i> Edit Staff Member &amp; Profile Photo
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form onsubmit="handleUpdateUser(event)" style="display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; overflow: hidden;">
                <input type="hidden" id="editUserId">
                <div class="modal-body p-3 p-sm-4">
                    <div id="editErrAlert" class="alert alert-danger d-none small"></div>

                    <!-- Profile Picture Upload -->
                    <div class="p-3 bg-light rounded-3 mb-3 border d-flex flex-wrap align-items-center gap-3">
                        <img id="editAdminAvatarPreview" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%23e2e8f0'/%3E%3Ccircle cx='32' cy='24' r='12' fill='%2394a3b8'/%3E%3Cpath d='M12 56c0-11 9-18 20-18s20 7 20 18' fill='%2394a3b8'/%3E%3C/svg%3E" alt="Current Photo" class="rounded-circle border border-2 border-warning" style="width: 62px; height: 62px; object-fit: cover; flex-shrink: 0;">
                        <div class="flex-grow-1 min-w-0">
                            <label class="form-label small font-weight-bold mb-1">Profile Picture (ID Card Photo)</label>
                            <input type="file" id="editAdminAvatarFile" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp" onchange="previewAdminAvatar(this, 'editAdminAvatarPreview')">
                            <div class="form-text" style="font-size: 11px;">Leave blank to keep existing photo. JPG, PNG or WEBP (Max 5 MB).</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Full Name *</label>
                            <input type="text" id="editUserName" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Official Email *</label>
                            <input type="email" id="editUserEmail" class="form-control" required>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6 col-md-4">
                            <label class="form-label small font-weight-bold">Mobile Phone *</label>
                            <input type="tel" id="editUserMobile" class="form-control" required>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4">
                            <label class="form-label small font-weight-bold">Employee ID</label>
                            <input type="text" id="editUserEmpCode" class="form-control">
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small font-weight-bold">Account Status</label>
                            <select id="editUserStatus" class="form-select">
                                <option value="ACTIVE">ACTIVE (Approved)</option>
                                <option value="PENDING">PENDING</option>
                                <option value="INACTIVE">INACTIVE</option>
                                <option value="SUSPENDED">SUSPENDED</option>
                                <option value="REJECTED">REJECTED</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6 col-md-4" id="editRoleWrap">
                            <label class="form-label small font-weight-bold">Role</label>
                            <select id="editUserRole" class="form-select">
                                <option value="EMPLOYEE">Employee</option>
                                <option value="BRANCH_MANAGER">Branch Manager</option>
                                <option value="SUPER_ADMIN">Super Admin</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4">
                            <label class="form-label small font-weight-bold">Branch</label>
                            <select id="editUserBranchId" class="form-select">
                                <option value="">-- Select Branch --</option>
                                <% if (typeof branches !== 'undefined' && branches && branches.length > 0) { %>
                                    <% branches.forEach(b => { %>
                                        <option value="<%= b._id %>"><%= b.name %> (<%= b.code %>)</option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small font-weight-bold">Assigned Manager</label>
                            <select id="editUserManagerId" class="form-select">
                                <option value="">-- None --</option>
                                <% if (typeof managers !== 'undefined' && managers && managers.length > 0) { %>
                                    <% managers.forEach(m => { %>
                                        <option value="<%= m._id %>"><%= m.name %></option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label small font-weight-bold">Designation</label>
                            <input type="text" id="editUserDesig" class="form-control">
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label small font-weight-bold">Department</label>
                            <input type="text" id="editUserDept" class="form-control">
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <h6 class="font-weight-bold text-dark mb-2" style="font-size: 13px;">
                            <i class="icofont-id-card text-warning me-1"></i> Identity Card Details
                        </h6>
                        <div class="row g-2">
                            <div class="col-6 col-md-3">
                                <label class="form-label small font-weight-bold">Blood Group</label>
                                <select id="editUserBlood" class="form-select">
                                    <option value="B+">B+</option>
                                    <option value="O+">O+</option>
                                    <option value="A+">A+</option>
                                    <option value="AB+">AB+</option>
                                    <option value="B-">B-</option>
                                    <option value="O-">O-</option>
                                    <option value="A-">A-</option>
                                    <option value="AB-">AB-</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small font-weight-bold">Alt Contact</label>
                                <input type="tel" id="editUserAltMobile" class="form-control">
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small font-weight-bold">Joining Date</label>
                                <input type="date" id="editUserJoinDate" class="form-control">
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small font-weight-bold">Expiry Date</label>
                                <input type="date" id="editUserExpDate" class="form-control">
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="form-label small font-weight-bold">Reset Password (Optional, min 8 chars)</label>
                        <input type="password" id="editUserPass" class="form-control" minlength="8" placeholder="Leave blank to keep unchanged">
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm font-weight-bold px-3" style="background: var(--admin-navy-primary);">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const CSRF_TOKEN = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
const DEFAULT_ADMIN_AVATAR_PLACEHOLDER = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%23e2e8f0'/%3E%3Ccircle cx='32' cy='24' r='12' fill='%2394a3b8'/%3E%3Cpath d='M12 56c0-11 9-18 20-18s20 7 20 18' fill='%2394a3b8'/%3E%3C/svg%3E";
const ADMIN_STAFF_MAP = <%- JSON.stringify(((typeof staffList !== 'undefined' ? staffList : []) || []).reduce((acc, u) => {
    acc[String(u._id)] = {
        id: String(u._id),
        name: u.name || '',
        email: u.email || '',
        mobile: u.mobile || '',
        employeeId: u.employeeId || '',
        role: u.role || 'EMPLOYEE',
        isPrimarySuperAdmin: u.isPrimarySuperAdmin === true,
        branchId: u.branchId ? String(u.branchId._id || u.branchId) : '',
        managerId: u.managerId ? String(u.managerId._id || u.managerId) : '',
        designation: u.designation || '',
        department: u.department || '',
        bloodGroup: u.bloodGroup || 'B+',
        alternateMobile: u.alternateMobile || '',
        joiningDate: u.joiningDate ? new Date(u.joiningDate).toISOString().split('T')[0] : '',
        expiryDate: u.expiryDate ? new Date(u.expiryDate).toISOString().split('T')[0] : '',
        status: u.status || 'ACTIVE',
        avatar: (u.avatar && u.avatar !== '/images/misc/cst-1.webp') ? u.avatar : ''
    };
    return acc;
}, {})) %>;

function readAdminAvatarInput(fileInputId) {
    return new Promise((resolve, reject) => {
        const input = document.getElementById(fileInputId);
        if (!input || !input.files || input.files.length === 0) return resolve(null);
        const file = input.files[0];
        if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
            return reject(new Error('Profile picture must be a JPG, PNG, or WEBP image.'));
        }
        if (file.size > 5 * 1024 * 1024) {
            return reject(new Error('Profile picture must be smaller than 5 MB.'));
        }
        const reader = new FileReader();
        reader.onload = () => resolve({
            avatarData: reader.result,
            avatarFilename: file.name,
            avatarMimeType: file.type
        });
        reader.onerror = () => reject(new Error('Failed to read selected profile image.'));
        reader.readAsDataURL(file);
    });
}

function previewAdminAvatar(input, previewId) {
    const img = document.getElementById(previewId);
    if (!img || !input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = (ev) => { img.src = ev.target.result; };
    reader.readAsDataURL(input.files[0]);
}

function showToast(msg) {
    const toast = document.getElementById('empToast');
    const toastMsg = document.getElementById('empToastMsg');
    if (toast && toastMsg) {
        toastMsg.innerText = msg;
        toast.classList.remove('d-none');
        setTimeout(() => toast.classList.add('d-none'), 5000);
    }
}

function openEditUserModal(id) {
    const u = ADMIN_STAFF_MAP[id];
    if (!u) return;
    document.getElementById('editUserId').value = u.id;
    document.getElementById('editUserName').value = u.name;
    document.getElementById('editUserEmail').value = u.email;
    document.getElementById('editUserMobile').value = u.mobile;
    document.getElementById('editUserEmpCode').value = u.employeeId || '';
    document.getElementById('editUserStatus').value = u.status || 'ACTIVE';
    document.getElementById('editUserRole').value = u.role || 'EMPLOYEE';
    document.getElementById('editUserBranchId').value = u.branchId || '';
    document.getElementById('editUserManagerId').value = u.managerId || '';
    document.getElementById('editUserDesig').value = u.designation || '';
    document.getElementById('editUserDept').value = u.department || '';
    document.getElementById('editUserBlood').value = u.bloodGroup || 'B+';
    document.getElementById('editUserAltMobile').value = u.alternateMobile || '';
    document.getElementById('editUserJoinDate').value = u.joiningDate || '';
    document.getElementById('editUserExpDate').value = u.expiryDate || '';
    document.getElementById('editUserPass').value = '';
    document.getElementById('editAdminAvatarFile').value = '';
    document.getElementById('editAdminAvatarPreview').src = u.avatar || DEFAULT_ADMIN_AVATAR_PLACEHOLDER;

    document.getElementById('editUserRole').disabled = u.isPrimarySuperAdmin;
    document.getElementById('editUserStatus').disabled = u.isPrimarySuperAdmin;
    document.getElementById('editErrAlert').classList.add('d-none');
    new bootstrap.Modal(document.getElementById('editUserModal')).show();
}

async function handleUpdateUser(e) {
    e.preventDefault();
    const errBox = document.getElementById('editErrAlert');
    errBox.classList.add('d-none');
    const id = document.getElementById('editUserId').value;

    let avatarPayload = {};
    try {
        const imgObj = await readAdminAvatarInput('editAdminAvatarFile');
        if (imgObj) avatarPayload = imgObj;
    } catch (imgErr) {
        errBox.innerText = imgErr.message;
        errBox.classList.remove('d-none');
        return;
    }

    const roleSelect = document.getElementById('editUserRole');
    const statusSelect = document.getElementById('editUserStatus');
    const body = Object.assign({
        name: document.getElementById('editUserName').value.trim(),
        email: document.getElementById('editUserEmail').value.trim(),
        mobile: document.getElementById('editUserMobile').value.trim(),
        employeeId: document.getElementById('editUserEmpCode').value.trim(),
        role: roleSelect.disabled ? undefined : roleSelect.value,
        status: statusSelect.disabled ? undefined : statusSelect.value,
        branchId: document.getElementById('editUserBranchId').value || null,
        managerId: document.getElementById('editUserManagerId').value || null,
        designation: document.getElementById('editUserDesig').value.trim(),
        department: document.getElementById('editUserDept').value.trim(),
        bloodGroup: document.getElementById('editUserBlood').value,
        alternateMobile: document.getElementById('editUserAltMobile').value.trim(),
        joiningDate: document.getElementById('editUserJoinDate').value,
        expiryDate: document.getElementById('editUserExpDate').value,
        password: document.getElementById('editUserPass').value,
        _csrf: CSRF_TOKEN
    }, avatarPayload);

    try {
        const res = await fetch(`/api/admin/users/${id}/update`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('editUserModal')).hide();
            showToast(data.message || 'Staff profile updated successfully.');
            setTimeout(() => location.reload(), 800);
        } else {
            errBox.innerText = data.message || 'Error updating user.';
            errBox.classList.remove('d-none');
        }
    } catch (err) {
        errBox.innerText = 'Server communication error.';
        errBox.classList.remove('d-none');
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const editId = new URLSearchParams(window.location.search).get('edit');
    if (editId && ADMIN_STAFF_MAP[editId]) {
        openEditUserModal(editId);
    }
});
</script>
