            </main>
            <footer class="admin-footer">
        <div>
            &copy; <%= typeof currentYear !== 'undefined' ? currentYear : new Date().getFullYear() %> <strong><%= typeof company !== 'undefined' ? company.name : 'Shivay Energy Solutions' %></strong>. All Rights Reserved.
        </div>
        <div class="d-flex align-items-center gap-3">
            <span><i class="icofont-location-pin text-warning"></i> Raisen Central (M.P.)</span>
            <span class="text-muted">•</span>
            <span><i class="icofont-shield-alt text-success"></i> RBAC Security Active</span>
            <span class="text-muted">•</span>
            <span>Phase 1 Enterprise Edition</span>
        </div>
    </footer>
    </div><!-- /.admin-main -->
    </div><!-- /.admin-layout -->

    <!-- Admin Panel Core Interactions Script (Zero external theme dependencies, zero ripple) -->
    <script>
        (function() {
            // 1. Mobile Sidebar Drawer Toggle
            const toggleBtn = document.getElementById('adminSidebarToggle');
            const sidebar = document.getElementById('adminSidebar');
            const backdrop = document.getElementById('adminBackdrop');

            if (toggleBtn && sidebar && backdrop) {
                toggleBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    sidebar.classList.toggle('show');
                    backdrop.classList.toggle('show');
                });

                backdrop.addEventListener('click', function() {
                    sidebar.classList.remove('show');
                    backdrop.classList.remove('show');
                });
            }

            // Close sidebar on escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && sidebar && sidebar.classList.contains('show')) {
                    sidebar.classList.remove('show');
                    if (backdrop) backdrop.classList.remove('show');
                }
            });

            // 2. Native Bootstrap-Compatible Dropdowns (Profile Menus)
            document.addEventListener('click', function(e) {
                const toggle = e.target.closest('[data-bs-toggle="dropdown"]');
                const openDropdowns = document.querySelectorAll('.dropdown-menu.show');

                if (toggle) {
                    e.preventDefault();
                    e.stopPropagation();
                    const container = toggle.closest('.dropdown');
                    const menu = container ? container.querySelector('.dropdown-menu') : null;

                    // Close any other open dropdowns
                    openDropdowns.forEach(function(d) {
                        if (d !== menu) d.classList.remove('show');
                    });

                    if (menu) {
                        menu.classList.toggle('show');
                    }
                } else if (!e.target.closest('.dropdown-menu')) {
                    // Clicked outside - close all dropdown menus
                    openDropdowns.forEach(function(d) {
                        d.classList.remove('show');
                    });
                }
            });

            // 3. Native Bootstrap-Compatible Tabs Navigation
            document.addEventListener('click', function(e) {
                const tabBtn = e.target.closest('[data-bs-toggle="tab"], [data-bs-toggle="pill"]');
                if (!tabBtn) return;
                e.preventDefault();

                const targetSelector = tabBtn.getAttribute('data-bs-target') || tabBtn.getAttribute('href');
                if (!targetSelector) return;
                const targetPane = document.querySelector(targetSelector);
                if (!targetPane) return;

                // Deactivate sibling tabs in this tab list
                const nav = tabBtn.closest('.nav') || tabBtn.closest('.workspace-tabs') || tabBtn.closest('.nav-pills') || (tabBtn.parentElement && tabBtn.parentElement.parentElement);
                if (nav) {
                    nav.querySelectorAll('[data-bs-toggle="tab"], [data-bs-toggle="pill"]').forEach(btn => {
                        btn.classList.remove('active');
                        btn.setAttribute('aria-selected', 'false');
                    });
                }
                tabBtn.classList.add('active');
                tabBtn.setAttribute('aria-selected', 'true');

                // Switch tab-pane
                const tabContent = targetPane.closest('.tab-content') || document.querySelector('#projectTabContent') || document.querySelector('#settingsTabContent');
                if (tabContent) {
                    tabContent.querySelectorAll('.tab-pane').forEach(pane => {
                        pane.classList.remove('show', 'active');
                    });
                }
                targetPane.classList.add('show', 'active');
            });

            // 4. Native Bootstrap-Compatible Modals
            document.addEventListener('click', function(e) {
                const modalToggle = e.target.closest('[data-bs-toggle="modal"]');
                if (modalToggle) {
                    e.preventDefault();
                    const targetSelector = modalToggle.getAttribute('data-bs-target');
                    const targetModal = targetSelector ? document.querySelector(targetSelector) : null;
                    if (targetModal) {
                        targetModal.classList.add('show');
                        targetModal.style.display = 'block';
                        targetModal.removeAttribute('aria-hidden');
                        targetModal.setAttribute('aria-modal', 'true');
                        document.body.classList.add('modal-open');

                        // Ensure modal backdrop exists
                        if (!document.querySelector('.modal-backdrop')) {
                            const backdropEl = document.createElement('div');
                            backdropEl.className = 'modal-backdrop fade show';
                            document.body.appendChild(backdropEl);
                        }
                    }
                }

                const dismissBtn = e.target.closest('[data-bs-dismiss="modal"]');
                if (dismissBtn) {
                    e.preventDefault();
                    const modal = dismissBtn.closest('.modal');
                    if (modal) {
                        modal.classList.remove('show');
                        modal.style.display = 'none';
                        modal.setAttribute('aria-hidden', 'true');
                        modal.removeAttribute('aria-modal');
                        document.body.classList.remove('modal-open');

                        const backdropEl = document.querySelector('.modal-backdrop');
                        if (backdropEl) backdropEl.remove();
                    }
                }
            });

            // 5. Sidebar Scroll Position Retention Across Tab & Page Navigations
            const sidebarMenu = document.querySelector('.admin-sidebar-menu');
            if (sidebarMenu) {
                // Restore saved scroll position or auto-scroll active item into view
                const savedPos = sessionStorage.getItem('admin_sidebar_scroll_top');
                if (savedPos !== null) {
                    sidebarMenu.scrollTop = parseInt(savedPos, 10);
                } else {
                    const activeLink = sidebarMenu.querySelector('.admin-nav-link.active');
                    if (activeLink) {
                        activeLink.scrollIntoView({ block: 'nearest' });
                    }
                }

                // Continuously track scroll position
                sidebarMenu.addEventListener('scroll', function() {
                    sessionStorage.setItem('admin_sidebar_scroll_top', sidebarMenu.scrollTop);
                }, { passive: true });

                // Retain position upon clicking navigation tabs
                sidebarMenu.querySelectorAll('.admin-nav-link').forEach(function(link) {
                    link.addEventListener('click', function() {
                        sessionStorage.setItem('admin_sidebar_scroll_top', sidebarMenu.scrollTop);
                        // On mobile, auto close sidebar upon link click
                        if (window.innerWidth <= 991 && sidebar && backdrop) {
                            sidebar.classList.remove('show');
                            backdrop.classList.remove('show');
                        }
                    });
                });
            }

            // 6. Global Bootstrap.Modal Compatibility API
            window.bootstrap = window.bootstrap || {};
            window.bootstrap.Modal = function(target) {
                const modalEl = (typeof target === 'string') 
                    ? document.querySelector(target) 
                    : target;

                return {
                    show: function() {
                        if (!modalEl) return;
                        modalEl.classList.add('show');
                        modalEl.style.display = 'block';
                        modalEl.removeAttribute('aria-hidden');
                        modalEl.setAttribute('aria-modal', 'true');
                        document.body.classList.add('modal-open');
                        if (!document.querySelector('.modal-backdrop')) {
                            const backdropEl = document.createElement('div');
                            backdropEl.className = 'modal-backdrop fade show';
                            document.body.appendChild(backdropEl);
                        }
                    },
                    hide: function() {
                        if (!modalEl) return;
                        modalEl.classList.remove('show');
                        modalEl.style.display = 'none';
                        modalEl.setAttribute('aria-hidden', 'true');
                        modalEl.removeAttribute('aria-modal');
                        document.body.classList.remove('modal-open');
                        const backdropEl = document.querySelector('.modal-backdrop');
                        if (backdropEl) backdropEl.remove();
                    }
                };
            };
            window.bootstrap.Modal.getInstance = function(target) {
                return new window.bootstrap.Modal(target);
            };
            window.bootstrap.Modal.getOrCreateInstance = function(target) {
                return new window.bootstrap.Modal(target);
            };
        })();
    </script>
</body>
</html>
