                    <!-- Right Side: Transparent Logo (with Built-in Company Name) & Details over Full Solar Image -->
                    <div class="v-split-right-company">
                        <!-- Top Transparent Image Logo -->
                        <div class="v-right-top-logo-wrap">
                            <img src="/images/brandlogo_leftlgoog_rightname_trans.png" alt="Shivay Energy Solutions Logo" class="v-right-top-logo">
                        </div>

                        <!-- Branch Name -->
                        <div class="v-right-branch-title"><%= branchName %></div>

                        <!-- Address -->
                        <div class="v-right-address"><%= branchAddress %></div>

                        <!-- Company Email -->
                        <div class="v-right-email"><%= mainCompanyEmail %></div>

                        <!-- Website URL -->
                        <div class="v-right-website"><%= websiteUrl %></div>
                    </div>

