        </div>
    </div>

    <!-- Modal: Share Visiting Card with Employee -->
    <% if (isManagerOrAdmin) { %>
    <div class="modal fade" id="shareVisitingModal" tabindex="-1" aria-labelledby="shareVisitingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header text-white" style="background: var(--deep-blue);">
                    <h5 class="modal-title font-weight-bold" id="shareVisitingModalLabel">
                        <i class="icofont-share me-1 text-warning"></i> Share Visiting Card with <%= empName %>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Share this official Visiting Card link with <%= empName %>. They can share it with clients or print it for field operations.
                    </p>

                    <% 
                        const cleanMobileDigits = (empMobile || '').replace(/\D/g, '');
                        const shareLink = '/cards/view/visiting-card/' + employee._id + '?token=' + shareToken;
                        const defaultShareText = `Namaste ${empName}, here is your official Shivay Energy Solutions Visiting Card (${branchName}):\n${shareLink}\nBranch: ${branchName} | Email: ${mainCompanyEmail}`;
                        const waUrl = `https://wa.me/${cleanMobileDigits.length === 10 ? '91' + cleanMobileDigits : cleanMobileDigits}?text=${encodeURIComponent(defaultShareText)}`;
                    %>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Direct Secure Card URL</label>
                        <div class="input-group">
                            <input type="text" id="shareUrlInput" class="form-control form-control-sm" value="<%= shareLink %>" readonly>
                            <button class="btn btn-outline-secondary btn-sm" onclick="copyShareLink()">
                                <i class="icofont-copy me-1"></i> Copy
                            </button>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <a href="<%= waUrl %>" target="_blank" class="btn btn-success font-weight-bold text-white">
                            <i class="icofont-brand-whatsapp me-1"></i> Send Card on WhatsApp (<%= empMobile %>)
                        </a>
                        <button class="btn btn-primary font-weight-bold" onclick="copyShareText(`<%= defaultShareText.replace(/\n/g, ' ') %>`)">
                            <i class="icofont-ui-copy me-1"></i> Copy Share Message
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>
        function copyShareLink() {
            const input = document.getElementById('shareUrlInput');
            input.select();
            input.setSelectionRange(0, 99999);
            const fullUrl = window.location.origin + input.value;
            navigator.clipboard.writeText(fullUrl).then(() => {
                alert('Secure card link copied to clipboard: ' + fullUrl);
            });
        }

        function copyShareText(text) {
            const fullText = text.replace(document.getElementById('shareUrlInput').value, window.location.origin + document.getElementById('shareUrlInput').value);
            navigator.clipboard.writeText(fullText).then(() => {
                alert('Share message copied to clipboard!');
            });
        }
    </script>
</body>
</html>
