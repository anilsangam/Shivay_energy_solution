<%- include('partials/admin-head') %>

<%
    const pUser = typeof profileUser !== 'undefined' ? profileUser : (typeof user !== 'undefined' ? user : {});
    const initials = (pUser.name || 'User').split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase();
    
    let roleBadgeClass = 'badge-role-employee';
    let roleLabel = 'Employee (Field Staff)';
    if (pUser.role === 'SUPER_ADMIN') {
        roleBadgeClass = 'badge-role-superadmin';
        roleLabel = 'Super Administrator';
    } else if (pUser.role === 'MANAGER' || pUser.role === 'BRANCH_MANAGER') {
        roleBadgeClass = 'badge-role-manager';
        roleLabel = 'Branch Operations Manager';
    }

    const assignedMgr = (pUser.managerId && pUser.managerId.name) ? pUser.managerId : ((pUser.manager && pUser.manager.name) ? pUser.manager : null);
%>

<link rel="stylesheet" href="/css/private/profile.css">

<div class="row g-4 justify-content-center">
    <!-- User Profile Overview Card -->
    <div class="col-lg-5">
        <div class="prof-card text-center">
            <div class="prof-card-body">
                <!-- Avatar with initials -->
                <div class="admin-avatar-circle mx-auto mb-3" style="width: 80px; height: 80px; font-size: 28px; border: 4px solid var(--admin-solar-light); background: linear-gradient(135deg, #163563 0%, #0a192f 100%); color: #ffffff;">
                    <%= initials %>
                </div>

                <h4 class="font-weight-bold text-dark mb-1" style="font-size: 19px;"><%= pUser.name %></h4>
                <div class="mb-2 d-flex align-items-center justify-content-center gap-1 flex-wrap">
                    <span class="badge-role <%= roleBadgeClass %>"><%= roleLabel %></span>
                    <span class="badge-status badge-status-active"><%= pUser.status || 'ACTIVE' %></span>
                </div>
                <p class="text-muted small mb-3">
                    <%= pUser.designation || 'Technical Personnel' %> • <%= pUser.department || 'Shivay Energy Solutions' %>
                </p>

                <!-- Detailed Info List with Safe Wrapping for Mobile -->
                <div class="prof-details-box text-start">
                    <div class="prof-detail-row">
                        <span class="prof-detail-label">Staff / Employee ID:</span>
                        <code class="prof-detail-val font-monospace"><%= pUser.employeeId || 'N/A' %></code>
                    </div>
                    <div class="prof-detail-row">
                        <span class="prof-detail-label">Official Email:</span>
                        <strong class="prof-detail-val text-primary"><%= pUser.email %></strong>
                    </div>
                    <div class="prof-detail-row">
                        <span class="prof-detail-label">Contact Mobile:</span>
                        <strong class="prof-detail-val text-dark"><%= pUser.mobile %></strong>
                    </div>
                    <div class="prof-detail-row">
                        <span class="prof-detail-label">Assigned Branch:</span>
                        <span class="prof-detail-val"><%= (pUser.branchId && pUser.branchId.name) ? pUser.branchId.name : 'Raisen Central Branch' %></span>
                    </div>
                    <div class="prof-detail-row">
                        <span class="prof-detail-label">Reporting Manager:</span>
                        <span class="prof-detail-val">
                            <% if (assignedMgr) { %>
                                <i class="icofont-business-man text-warning me-1"></i><%= assignedMgr.name %> <small class="text-muted d-block d-sm-inline">(<%= assignedMgr.email %>)</small>
                            <% } else if (pUser.role === 'SUPER_ADMIN') { %>
                                Executive Authority (Self)
                            <% } else { %>
                                <span class="text-muted">Unassigned / Direct Office</span>
                            <% } %>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Password Change & Security Settings Card -->
    <div class="col-lg-7" id="passwordSection">
        <div class="prof-card">
            <div class="prof-card-header">
                <div>
                    <h5 class="prof-card-title">
                        <i class="icofont-key text-warning"></i> Security & Account Password
                    </h5>
                    <div class="prof-card-subtitle">Update your password securely using 256-bit bcrypt cryptography</div>
                </div>
                <span class="badge bg-light text-muted border font-monospace" style="font-size: 10.5px;">Bcrypt Salted</span>
            </div>

            <div class="prof-card-body">
                <!-- Feedback Alert Box -->
                <div id="pwdAlert" class="alert d-none py-2.5 px-3 rounded-2 small mb-3" role="alert"></div>

                <form class="prof-form" onsubmit="handlePasswordChange(event)">
                    <div class="mb-3">
                        <label class="form-label">Current Account Password <span class="text-danger fw-bold">*</span></label>
                        <input type="password" id="curPass" class="form-control" required placeholder="Enter current account password">
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label">New Password (min 8 chars) <span class="text-danger fw-bold">*</span></label>
                            <input type="password" id="newPass" class="form-control" required minlength="8" placeholder="Enter new password">
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Confirm New Password <span class="text-danger fw-bold">*</span></label>
                            <input type="password" id="confPass" class="form-control" required minlength="8" placeholder="Re-enter new password">
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-4 small text-muted border">
                        <div class="d-flex align-items-start gap-2">
                            <i class="icofont-shield-alt text-success fs-6 mt-0.5"></i>
                            <div>
                                <strong class="text-dark">Password Requirements:</strong> Minimum 8 characters. Must contain letters and numbers. Never disclose your login credentials to third parties.
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary font-weight-bold px-4 prof-submit-btn shadow-sm" style="background: var(--admin-navy-primary); border-color: var(--admin-navy-primary); border-radius: 8px; height: 38px;">
                        <i class="icofont-refresh me-1"></i> Update Password Securely
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
const CSRF_TOKEN = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

async function handlePasswordChange(e) {
    e.preventDefault();
    const cur = document.getElementById('curPass').value;
    const np = document.getElementById('newPass').value;
    const cp = document.getElementById('confPass').value;
    const box = document.getElementById('pwdAlert');

    box.className = 'alert d-none small';

    if (np !== cp) {
        box.className = 'alert alert-danger py-2.5 px-3 rounded-2 small mb-3 border border-danger d-block';
        box.innerHTML = '<i class="icofont-warning me-1"></i> New password and confirm password do not match.';
        return;
    }

    if (np.length < 8) {
        box.className = 'alert alert-danger py-2.5 px-3 rounded-2 small mb-3 border border-danger d-block';
        box.innerHTML = '<i class="icofont-warning me-1"></i> Password must be at least 8 characters long.';
        return;
    }

    try {
        const res = await fetch('/api/auth/change-password', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN
            },
            body: JSON.stringify({
                currentPassword: cur,
                newPassword: np,
                confirmPassword: cp,
                _csrf: CSRF_TOKEN
            })
        });

        const data = await res.json();
        if (data.success) {
            box.className = 'alert alert-success py-2.5 px-3 rounded-2 small mb-3 border border-success d-block';
            box.innerHTML = '<i class="icofont-check-circled me-1"></i> ' + (data.message || 'Password updated successfully.');
            document.getElementById('curPass').value = '';
            document.getElementById('newPass').value = '';
            document.getElementById('confPass').value = '';
        } else {
            box.className = 'alert alert-danger py-2.5 px-3 rounded-2 small mb-3 border border-danger d-block';
            box.innerHTML = '<i class="icofont-warning me-1"></i> ' + (data.message || 'Error updating password.');
        }
    } catch (err) {
        box.className = 'alert alert-danger py-2.5 px-3 rounded-2 small mb-3 border border-danger d-block';
        box.innerHTML = '<i class="icofont-warning me-1"></i> Server communication error. Please try again.';
    }
}
</script>

<%- include('partials/admin-footer') %>
