<!-- JAVASCRIPT: DYNAMIC CONTROLS & LIVE RECALCULATION -->
<!-- ========================================================================= -->
<script>
function numberToIndianWords(num) {
    num = Math.round(num);
    if (num === 0) return 'Zero Rupees Only';
    const a = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
    const b = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
    function inWords(n) {
        if (n < 20) return a[n];
        if (n < 100) return b[Math.floor(n / 10)] + (n % 10 !== 0 ? ' ' + a[n % 10] : '');
        if (n < 1000) return a[Math.floor(n / 100)] + ' Hundred' + (n % 100 !== 0 ? ' ' + inWords(n % 100) : '');
        if (n < 100000) return inWords(Math.floor(n / 1000)) + ' Thousand' + (n % 1000 !== 0 ? ' ' + inWords(n % 1000) : '');
        if (n < 10000000) return inWords(Math.floor(n / 100000)) + ' Lakh' + (n % 100000 !== 0 ? ' ' + inWords(n % 100000) : '');
        return inWords(Math.floor(n / 10000000)) + ' Crore' + (n % 10000000 !== 0 ? ' ' + inWords(n % 10000000) : '');
    }
    return inWords(num).trim() + ' Rupees Only';
}

function onToolbarChange() {
    const cap = parseFloat(document.getElementById('ctrlCapacity').value) || 10;
    const sysType = document.getElementById('ctrlSystemType').value;
    let baseCost = parseFloat(document.getElementById('ctrlBaseCost').value);
    const gstRate = parseFloat(document.getElementById('ctrlGstRate').value) || 9;

    // Default base cost formula if adjusted capacity
    if (isNaN(baseCost) || baseCost <= 0) {
        baseCost = cap * 39130;
        document.getElementById('ctrlBaseCost').value = baseCost;
    }

    const pricePerKw = Math.round(baseCost / cap);
    const gstAmt = Math.round(baseCost * (gstRate / 100));
    const totalCost = baseCost + gstAmt;
    const annualGen = cap * 1440;
    const panels = Math.max(1, Math.round((cap * 1000) / 540));

    // Update Page 1
    document.getElementById('docProjectSizeText').innerText = `${cap} kW ${sysType}.`;
    document.getElementById('docTechSystemTitle').innerText = `What is Solar ${sysType}?`;

    // Update Page 2
    document.getElementById('docP2Cap').innerText = `${cap} kW`;
    document.getElementById('docP2Gen').innerText = `${annualGen.toLocaleString('en-IN')} Units`;
    document.getElementById('docMatPanelQty').innerText = panels;
    document.getElementById('docMatPanelKw').innerText = `${cap}kW`;
    document.getElementById('docMatInvKw').innerText = cap;
    document.getElementById('docMatInvKw2').innerText = cap;
    document.getElementById('docMatStructKw').innerText = `${cap}kW`;

    // Update Page 3 (Full Package Pricing Table)
    document.getElementById('docPackagePerKw').innerText = pricePerKw.toLocaleString('en-IN');
    document.getElementById('docPackageTotalCost').innerText = baseCost.toLocaleString('en-IN');
    document.getElementById('docTotalProjectCost').innerText = baseCost.toLocaleString('en-IN');
    document.getElementById('docGstLabel').innerText = gstRate;
    document.getElementById('docGstRateCell').innerText = `${gstRate}%`;
    document.getElementById('docGstAmount').innerText = gstAmt.toLocaleString('en-IN');
    document.getElementById('docGrandTotal').innerText = totalCost.toLocaleString('en-IN');
    document.getElementById('docAmountInWords').innerText = numberToIndianWords(totalCost);
}

// Auto-print if query param print=true
<% if (typeof autoPrint !== 'undefined' && autoPrint) { %>
    window.addEventListener('load', () => {
        setTimeout(() => window.print(), 500);
    });
<% } %>
</script>

