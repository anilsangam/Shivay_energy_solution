<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= quotation ? quotation.quotationNumber : 'Quotation' %> - SHIVAY ENERGY SOLUTIONS</title>
    <link rel="icon" href="/images/brandlogo2.webp" type="image/webp">
    <link rel="stylesheet" href="/css/private/quotation-document.css">
</head>
<body>

<%
    // Derived Initial Quotation Parameters
    const capacityKw = Number((quotation && (quotation.plantCapacityKw || quotation.systemCapacityKw)) || 10);
    const systemTypeStr = (quotation && quotation.systemType) ? quotation.systemType : 'Ongrid Solar Rooftop';
    const projectSizeTitle = `${capacityKw} kW ${systemTypeStr}.`;
    
    // Calculations (Respect TAX_INCLUSIVE complete package pricing vs legacy TAX_EXCLUSIVE)
    const isTaxInclusive = quotation && quotation.pricingMode === 'TAX_INCLUSIVE';
    const annualUnits = capacityKw * 1440; // 10kW = 14400 Units
    const gstRate = Number(quotation && quotation.gstRate !== undefined ? quotation.gstRate : (isTaxInclusive ? 12 : 9));
    let baseProjectCost = 0;
    let gstAmount = 0;
    let totalCost = 0;
    if (isTaxInclusive && quotation && quotation.grandTotal > 0) {
        totalCost = Number(quotation.grandTotal);
        baseProjectCost = Number(quotation.taxableValue || Math.round(totalCost / (1 + gstRate / 100)));
        gstAmount = Number(quotation.totalGstAmount || (totalCost - baseProjectCost));
    } else {
        baseProjectCost = Number(quotation && (quotation.totalProjectCost || quotation.taxableValue || quotation.subtotal) ? (quotation.totalProjectCost || quotation.taxableValue || quotation.subtotal) : (capacityKw * 39130));
        gstAmount = Number(quotation && quotation.totalGstAmount ? quotation.totalGstAmount : Math.round(baseProjectCost * (gstRate / 100)));
        totalCost = baseProjectCost + gstAmount;
    }
    const pricePerKw = Math.round(baseProjectCost / capacityKw);

    // Number to Indian Words Helper
    function numberToWords(num) {
        num = Math.round(num);
        if (num === 0) return 'Zero Rupees Only';
        const a = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
        const b = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
        function inWords(n) {
            if (n < 20) return a[n];
            if (n < 100) return b[Math.floor(n / 10)] + (n % 10 !== 0 ? ' ' + a[n % 10] : '');
            if (n < 1000) return a[Math.floor(n / 100)] + ' Hundred' + (n % 100 !== 0 ? ' ' + inWords(n % 100) : '');
            if (n < 100000) return inWords(Math.floor(n / 1000)) + ' Thousand' + (n % 1000 !== 0 ? ' ' + inWords(n % 1000) : '');
            if (n < 10000000) return inWords(Math.floor(n / 100000)) + ' Lakh' + (n % 100000 !== 0 ? ' ' + inWords(n % 100000) : '');
            return inWords(Math.floor(n / 10000000)) + ' Crore' + (n % 10000000 !== 0 ? ' ' + inWords(n % 10000000) : '');
        }
        return inWords(num).trim() + ' Rupees Only';
    }

    const initialWords = numberToWords(totalCost);
    const panelCount = Math.max(1, Math.round((capacityKw * 1000) / 540));
    const quoteDate = quotation && quotation.createdAt ? new Date(quotation.createdAt).toLocaleDateString('en-GB') : '17/11/2026';
    const proposalNo = (quotation && (quotation.quotationNumber || quotation.proposalNo)) || '210';
%>

<!-- ========================================================================= -->
<!-- 1. TOP INTERACTIVE CONTROL TOOLBAR (SCREEN ONLY, HIDDEN IN PRINT) -->
<!-- ========================================================================= -->
<div class="no-print">
    <div class="control-bar-inner">
        <div style="font-weight: 800; font-size: 13px; color: #f8fafc; display: flex; align-items: center; gap: 8px;">
            <span style="background: #2563eb; padding: 2px 8px; border-radius: 4px;">4-Page Quotation</span>
            <span>SHIVAY ENERGY SOLUTIONS</span>
        </div>

        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px;">
            <!-- Capacity Selector -->
            <div class="control-group">
                <span class="control-label">Capacity:</span>
                <select class="control-select" id="ctrlCapacity" onchange="onToolbarChange()">
                    <option value="1">1 kW</option>
                    <option value="2">2 kW</option>
                    <option value="3">3 kW</option>
                    <option value="4">4 kW</option>
                    <option value="5">5 kW</option>
                    <option value="6">6 kW</option>
                    <option value="7">7 kW</option>
                    <option value="8">8 kW</option>
                    <option value="10" <%= capacityKw === 10 ? 'selected' : '' %>>10 kW</option>
                    <option value="12">12 kW</option>
                    <option value="15">15 kW</option>
                    <option value="20">20 kW</option>
                    <option value="25">25 kW</option>
                </select>
            </div>

            <!-- System Name Selector -->
            <div class="control-group">
                <span class="control-label">System Type:</span>
                <select class="control-select" id="ctrlSystemType" onchange="onToolbarChange()">
                    <option value="Ongrid Solar Rooftop" selected>Ongrid Solar Rooftop</option>
                    <option value="Offgrid Solar Rooftop">Offgrid Solar Rooftop</option>
                    <option value="Hybrid Solar Rooftop">Hybrid Solar Rooftop</option>
                    <option value="Commercial Solar Rooftop">Commercial Solar Rooftop</option>
                </select>
            </div>

            <!-- Package Base Cost -->
            <div class="control-group">
                <span class="control-label">Package Cost (₹):</span>
                <input type="number" class="control-input" id="ctrlBaseCost" value="<%= baseProjectCost %>" style="width: 105px;" oninput="onToolbarChange()">
            </div>

            <!-- GST % -->
            <div class="control-group">
                <span class="control-label">GST %:</span>
                <select class="control-select" id="ctrlGstRate" onchange="onToolbarChange()">
                    <option value="9" <%= gstRate === 9 ? 'selected' : '' %>>9% AVG</option>
                    <option value="12" <%= gstRate === 12 ? 'selected' : '' %>>12% Solar</option>
                    <option value="5">5% Concessional</option>
                    <option value="18">18% Standard</option>
                    <option value="0">0% Exempt</option>
                </select>
            </div>

            <!-- Action Buttons -->
            <div style="display: flex; gap: 8px;">
                <button class="btn-action btn-print" onclick="window.print()">
                    🖨️ Print / Save as PDF
                </button>
                <button class="btn-action btn-close-doc" onclick="window.close(); if(history.length > 1) history.back();">
                    ✕ Close
                </button>
            </div>
        </div>
    </div>
</div>

