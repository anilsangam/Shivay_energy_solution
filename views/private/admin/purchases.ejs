<%- include('partials/admin-head') %>

<%
    const purchaseStats = (typeof stats !== 'undefined' && stats) ? stats : {
        totalPurchases: 0,
        receivedPurchases: 0,
        draftPurchases: 0,
        totalSpent: 0
    };
    const totalP = (typeof totalPages !== 'undefined') ? totalPages : ((typeof pagination !== 'undefined' && pagination.totalPages) ? pagination.totalPages : 1);
    const currP = (typeof currentPage !== 'undefined') ? currentPage : ((typeof pagination !== 'undefined' && pagination.page) ? pagination.page : 1);
    const totalItms = (typeof totalItems !== 'undefined') ? totalItems : ((typeof pagination !== 'undefined' && pagination.total) ? pagination.total : 0);
    const filterObj = (typeof filters !== 'undefined' && filters) ? filters : {};
    const purchasesList = (typeof purchases !== 'undefined' && Array.isArray(purchases)) ? purchases : [];
%>

<!-- Action Feedback Alert Banner -->
<div id="purchaseToast" class="alert alert-success alert-dismissible fade show d-none mb-4" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="purchaseToastMsg">Action completed successfully.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('purchaseToast').classList.add('d-none')"></button>
</div>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            <i class="icofont-cart-alt me-2 text-warning"></i> Purchase Orders & Stock Inward
        </h2>
        <p class="text-muted small mb-0">
            Procure raw materials, modules, inverters, and hardware. Confirmed purchases atomically increment inventory and update Weighted Average Cost (WAC).
        </p>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin/purchases/new" class="btn btn-warning font-weight-bold text-dark shadow-sm" style="border-radius: 8px;">
            <i class="icofont-plus-circle me-1"></i> New Purchase Entry
        </a>
        <a href="/admin/inventory" class="btn btn-outline-primary" style="border-radius: 8px;">
            <i class="icofont-database me-1"></i> View Stock
        </a>
    </div>
</div>

<!-- Top Metrics Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Total Orders</span>
            <div class="h3 font-weight-bold text-dark mb-0 mt-1"><%= purchaseStats.totalPurchases %></div>
            <div class="small text-muted mt-1">Purchase orders recorded</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Stock Received</span>
            <div class="h3 font-weight-bold text-success mb-0 mt-1"><%= purchaseStats.receivedPurchases %></div>
            <div class="small text-muted mt-1">Inwarded to live inventory</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Draft / Pending Inward</span>
            <div class="h3 font-weight-bold text-warning mb-0 mt-1"><%= purchaseStats.draftPurchases %></div>
            <div class="small text-muted mt-1">Awaiting physical receipt</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Total Procurement</span>
            <div class="h3 font-weight-bold text-primary mb-0 mt-1">₹<%= Number(purchaseStats.totalSpent || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 }) %></div>
            <div class="small text-muted mt-1">Received inventory value</div>
        </div>
    </div>
</div>

<!-- Search & Filter Controls -->
<div class="admin-filter-card mb-4 shadow-sm">
    <form method="GET" action="/admin/purchases" class="row g-2 align-items-center m-0 w-100">
        <div class="col-12 col-md-6 p-0 pe-md-2">
            <div class="input-group admin-search-group">
                <span class="input-group-text bg-light border-end-0"><i class="icofont-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0" placeholder="Search by Purchase #, Invoice #, or notes..." value="<%= filterObj.search || '' %>">
            </div>
        </div>
        <div class="col-6 col-md-4 p-0 px-1">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="RECEIVED" <%= filterObj.status === 'RECEIVED' ? 'selected' : '' %>>RECEIVED (Inwarded)</option>
                <option value="DRAFT" <%= filterObj.status === 'DRAFT' ? 'selected' : '' %>>DRAFT (Pending)</option>
                <option value="ORDERED" <%= filterObj.status === 'ORDERED' ? 'selected' : '' %>>ORDERED (Dispatched by vendor)</option>
                <option value="CANCELLED" <%= filterObj.status === 'CANCELLED' ? 'selected' : '' %>>CANCELLED</option>
            </select>
        </div>
        <div class="col-6 col-md-2 p-0 ps-1 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100 fw-bold" style="background: var(--admin-navy-primary);"><i class="icofont-filter me-1"></i> Filter</button>
            <a href="/admin/purchases" class="btn btn-outline-secondary" title="Reset Filters"><i class="icofont-refresh"></i></a>
        </div>
    </form>
</div>

<!-- Purchases Table -->
<div class="admin-card border shadow-sm p-0 overflow-hidden" style="border: 1px solid var(--admin-border, #cbd5e1) !important; border-radius: 12px;">
    <div class="admin-card-header bg-white p-3 border-bottom d-flex align-items-center justify-content-between mb-0">
        <div>
            <h5 class="admin-card-title mb-0">Purchase Orders (<%= totalItms %>)</h5>
            <div class="admin-card-subtitle small text-muted">Material procurement, vendor invoices & stock inward records</div>
        </div>
        <span class="badge bg-light text-dark border">Procurement Inward</span>
    </div>
    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th class="ps-3 py-3" style="width: 140px;">PO Number</th>
                    <th class="py-3">Supplier Name</th>
                    <th class="py-3">Vendor Invoice</th>
                    <th class="py-3 text-center">Items</th>
                    <th class="py-3 text-end">Total Amount</th>
                    <th class="py-3 text-center">Payment</th>
                    <th class="py-3 text-center">Inward Status</th>
                    <th class="pe-3 py-3 text-end">Actions</th>
                </tr>
            </thead>
                <tbody>
                    <% if (purchasesList && purchasesList.length > 0) { %>
                        <% purchasesList.forEach(po => { %>
                            <tr>
                                <td class="ps-3">
                                    <a href="/admin/purchases/<%= po._id %>" class="fw-bold font-monospace text-primary text-decoration-none" style="font-size: 12px;">
                                        <%= po.purchaseNumber %>
                                    </a>
                                    <div class="text-muted" style="font-size: 11px;"><%= new Date(po.createdAt).toLocaleDateString('en-IN') %></div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark"><%= po.supplier ? po.supplier.supplierName : 'Direct Supplier' %></div>
                                    <% if (po.supplier && po.supplier.contactPerson) { %>
                                        <small class="text-muted"><%= po.supplier.contactPerson %></small>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="text-dark small fw-medium"><%= po.supplierInvoiceNumber || '—' %></div>
                                    <% if (po.supplierInvoiceDate) { %>
                                        <small class="text-muted"><%= new Date(po.supplierInvoiceDate).toLocaleDateString('en-IN') %></small>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border"><%= (po.items || []).length %> Line Item<%= (po.items || []).length === 1 ? '' : 's' %></span>
                                </td>
                                <td class="text-end fw-bold text-dark">
                                    ₹<%= Number(po.totalAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                                    <% if (po.additionalCharges > 0) { %>
                                        <div class="text-muted font-weight-normal" style="font-size: 10.5px;">+₹<%= po.additionalCharges %> charges</div>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill <%= po.paymentStatus === 'PAID' ? 'bg-success-subtle text-success' : (po.paymentStatus === 'PARTIAL' ? 'bg-warning-subtle text-warning' : 'bg-danger-subtle text-danger') %> border" style="font-size: 10px;">
                                        <%= po.paymentStatus || 'UNPAID' %>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <% if (po.status === 'RECEIVED') { %>
                                        <span class="badge bg-success" style="font-size: 11px;"><i class="icofont-check-circled me-1"></i> RECEIVED</span>
                                    <% } else if (po.status === 'DRAFT') { %>
                                        <span class="badge bg-warning text-dark" style="font-size: 11px;"><i class="icofont-clock-time me-1"></i> DRAFT</span>
                                    <% } else if (po.status === 'ORDERED') { %>
                                        <span class="badge bg-info text-dark" style="font-size: 11px;"><i class="icofont-truck-alt me-1"></i> ORDERED</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary" style="font-size: 11px;"><%= po.status %></span>
                                    <% } %>
                                </td>
                                <td class="pe-3 text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/admin/purchases/<%= po._id %>" class="btn btn-outline-primary" title="View Purchase Details">
                                            <i class="icofont-eye-alt"></i>
                                        </a>
                                        <% if (po.status === 'DRAFT' || po.status === 'ORDERED') { %>
                                            <button class="btn btn-outline-success" onclick="confirmReceivePurchase('<%= po._id %>', '<%= po.purchaseNumber %>')" title="Confirm & Receive Stock">
                                                <i class="icofont-download"></i> Inward
                                            </button>
                                            <button class="btn btn-outline-danger" onclick="cancelPurchaseOrder('<%= po._id %>', '<%= po.purchaseNumber %>')" title="Cancel Order">
                                                <i class="icofont-close"></i>
                                            </button>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <i class="icofont-cart-alt text-muted" style="font-size: 40px;"></i>
                                <p class="text-muted mt-2 mb-0">No purchase records found.</p>
                                <a href="/admin/purchases/new" class="btn btn-sm btn-warning mt-2">
                                    <i class="icofont-plus-circle me-1"></i> Create First Purchase Entry
                                </a>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    
    <% if (totalP > 1) { %>
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page <%= currP %> of <%= totalP %> (<%= totalItms %> purchase orders)</span>
            <ul class="pagination pagination-sm mb-0">
                <% for (let p = 1; p <= totalP; p++) { %>
                    <li class="page-item <%= p === currP ? 'active' : '' %>">
                        <a class="page-link" href="/admin/purchases?page=<%= p %>&search=<%= filterObj.search || '' %>&status=<%= filterObj.status || '' %>"><%= p %></a>
                    </li>
                <% } %>
            </ul>
        </div>
    <% } %>
</div>

<script>
const CSRF_TOKEN = '<%= csrfToken %>';

function showToast(msg, isError = false) {
    const t = document.getElementById('purchaseToast');
    const m = document.getElementById('purchaseToastMsg');
    t.className = `alert alert-${isError ? 'danger' : 'success'} alert-dismissible fade show mb-4`;
    m.textContent = msg;
    t.classList.remove('d-none');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

async function confirmReceivePurchase(id, poNum) {
    if (!confirm(`Are you sure you want to RECEIVE and INWARD Purchase ${poNum}?\n\nThis will atomically increment stock levels and update Weighted Average Cost (WAC) for all line items.`)) {
        return;
    }

    try {
        const res = await fetch(`/api/admin/purchases/${id}/confirm`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN
            },
            body: JSON.stringify({ _csrf: CSRF_TOKEN })
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.message || 'Stock successfully inwarded!');
            setTimeout(() => location.reload(), 700);
        } else {
            showToast(data.message || 'Error receiving purchase.', true);
        }
    } catch (err) {
        showToast('Server communication error.', true);
    }
}

async function cancelPurchaseOrder(id, poNum) {
    if (!confirm(`Are you sure you want to CANCEL Purchase Order ${poNum}?\n\nDraft orders that have not yet been inwarded can be cancelled.`)) {
        return;
    }

    try {
        const res = await fetch(`/api/admin/purchases/${id}/cancel`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN
            },
            body: JSON.stringify({ _csrf: CSRF_TOKEN })
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.message || 'Purchase cancelled.');
            setTimeout(() => location.reload(), 700);
        } else {
            showToast(data.message || 'Error cancelling purchase.', true);
        }
    } catch (err) {
        showToast('Server communication error.', true);
    }
}
</script>

<%- include('partials/admin-footer') %>
