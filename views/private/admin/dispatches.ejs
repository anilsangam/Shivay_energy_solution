<%- include('partials/admin-head') %>

<%
    const dispatchStats = (typeof stats !== 'undefined' && stats) ? stats : {
        totalDispatches: 0,
        pendingDispatches: 0,
        shippedDispatches: 0,
        deliveredDispatches: 0
    };
    const totalP = (typeof totalPages !== 'undefined') ? totalPages : ((typeof pagination !== 'undefined' && pagination.totalPages) ? pagination.totalPages : 1);
    const currP = (typeof currentPage !== 'undefined') ? currentPage : ((typeof pagination !== 'undefined' && pagination.page) ? pagination.page : 1);
    const totalItms = (typeof totalItems !== 'undefined') ? totalItems : ((typeof pagination !== 'undefined' && pagination.total) ? pagination.total : 0);
    const filterObj = (typeof filters !== 'undefined' && filters) ? filters : {};
    const dispatchesList = (typeof dispatches !== 'undefined' && Array.isArray(dispatches)) ? dispatches : [];
%>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            <i class="icofont-delivery-time me-2 text-warning"></i> Dispatch Management & Logistics
        </h2>
        <p class="text-muted small mb-0">
            Track staged consignments, vehicle numbers, transporter LR tracking, delivery dates, and site fulfillment.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin/sales-out" class="btn btn-outline-primary" style="border-radius: 8px;">
            <i class="icofont-truck-loaded me-1"></i> View Sales Orders
        </a>
    </div>
</div>

<!-- Top Metrics Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Total Dispatches</span>
            <div class="h3 font-weight-bold text-dark mb-0 mt-1"><%= dispatchStats.totalDispatches %></div>
            <div class="small text-muted mt-1">Consignments created</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Pending / Ready</span>
            <div class="h3 font-weight-bold text-warning mb-0 mt-1"><%= dispatchStats.pendingDispatches %></div>
            <div class="small text-muted mt-1">Staged for pickup</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">In Transit / Shipped</span>
            <div class="h3 font-weight-bold text-primary mb-0 mt-1"><%= dispatchStats.shippedDispatches %></div>
            <div class="small text-muted mt-1">On the road</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Successfully Delivered</span>
            <div class="h3 font-weight-bold text-success mb-0 mt-1"><%= dispatchStats.deliveredDispatches %></div>
            <div class="small text-muted mt-1">Fulfillment completed</div>
        </div>
    </div>
</div>

<!-- Search & Filter Controls -->
<div class="admin-filter-card mb-4 shadow-sm">
    <form method="GET" action="/admin/dispatch" class="row g-2 align-items-center m-0 w-100">
        <div class="col-12 col-md-6 p-0 pe-md-2">
            <div class="input-group admin-search-group">
                <span class="input-group-text bg-light border-end-0"><i class="icofont-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0" placeholder="Search by Dispatch #, Sale #, Customer, Transporter or LR #..." value="<%= filterObj.search || '' %>">
            </div>
        </div>
        <div class="col-6 col-md-4 p-0 px-1">
            <select name="status" class="form-select">
                <option value="">All Dispatch Statuses</option>
                <option value="READY_FOR_DISPATCH" <%= filterObj.status === 'READY_FOR_DISPATCH' ? 'selected' : '' %>>READY FOR DISPATCH</option>
                <option value="PACKING" <%= filterObj.status === 'PACKING' ? 'selected' : '' %>>PACKING</option>
                <option value="SHIPPED" <%= filterObj.status === 'SHIPPED' ? 'selected' : '' %>>SHIPPED (In Transit)</option>
                <option value="PARTIALLY_DELIVERED" <%= filterObj.status === 'PARTIALLY_DELIVERED' ? 'selected' : '' %>>PARTIALLY DELIVERED</option>
                <option value="DELIVERED" <%= filterObj.status === 'DELIVERED' ? 'selected' : '' %>>DELIVERED</option>
                <option value="DELIVERY_FAILED" <%= filterObj.status === 'DELIVERY_FAILED' ? 'selected' : '' %>>DELIVERY FAILED</option>
            </select>
        </div>
        <div class="col-6 col-md-2 p-0 ps-1 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100 fw-bold" style="background: var(--admin-navy-primary);"><i class="icofont-filter me-1"></i> Filter</button>
            <a href="/admin/dispatch" class="btn btn-outline-secondary" title="Reset Filters"><i class="icofont-refresh"></i></a>
        </div>
    </form>
</div>

<!-- Dispatches Table -->
<div class="admin-card border shadow-sm p-0 overflow-hidden" style="border: 1px solid var(--admin-border, #cbd5e1) !important; border-radius: 12px;">
    <div class="admin-card-header bg-white p-3 border-bottom d-flex align-items-center justify-content-between mb-0">
        <div>
            <h5 class="admin-card-title mb-0">Dispatch Orders & Consignments (<%= totalItms %>)</h5>
            <div class="admin-card-subtitle small text-muted">Logistics tracking, vehicle details & delivery fulfillment</div>
        </div>
        <span class="badge bg-light text-dark border">Consignments</span>
    </div>
    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th class="ps-3 py-3" style="width: 150px;">Dispatch #</th>
                    <th class="py-3">Sale Reference</th>
                    <th class="py-3">Customer / Consignee</th>
                    <th class="py-3">Transporter / LR Number</th>
                    <th class="py-3 text-center">Items Dispatched</th>
                    <th class="py-3 text-center">Status</th>
                    <th class="pe-3 py-3 text-end">Action</th>
                </tr>
            </thead>
                <tbody>
                    <% if (dispatchesList && dispatchesList.length > 0) { %>
                        <% dispatchesList.forEach(d => { %>
                            <tr>
                                <td class="ps-3">
                                    <a href="/admin/dispatch/<%= d._id %>" class="fw-bold font-monospace text-primary text-decoration-none">
                                        <%= d.dispatchNumber %>
                                    </a>
                                    <div class="text-muted" style="font-size: 11px;"><%= new Date(d.dispatchDate || d.createdAt).toLocaleDateString('en-IN') %></div>
                                </td>
                                <td>
                                    <a href="/admin/sales-out/<%= d.sale && d.sale._id ? d.sale._id : d.sale %>" class="fw-medium font-monospace text-dark text-decoration-none">
                                        <%= d.saleNumber %>
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark"><%= d.customerName || (d.sale && d.sale.customerName) || 'Direct Customer' %></div>
                                    <% if (d.shippingAddress) { %>
                                        <small class="text-muted text-truncate d-block" style="max-width: 220px;"><%= d.shippingAddress %></small>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark"><%= d.transporterName || 'Self / Direct Logistics' %></div>
                                    <div class="small text-muted font-monospace">
                                        <% if (d.trackingNumber) { %>LR: <%= d.trackingNumber %><% } %>
                                        <% if (d.vehicleNumber) { %> | <%= d.vehicleNumber %><% } %>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        <%= (d.items || []).reduce((acc, it) => acc + (it.dispatchedQuantity || 0), 0) %> units
                                    </span>
                                </td>
                                <td class="text-center">
                                    <% if (d.status === 'DELIVERED') { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="icofont-check me-1"></i>DELIVERED</span>
                                    <% } else if (d.status === 'SHIPPED') { %>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"><i class="icofont-truck me-1"></i>SHIPPED</span>
                                    <% } else if (d.status === 'READY_FOR_DISPATCH') { %>
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1"><i class="icofont-clock-time me-1"></i>READY</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1"><%= d.status %></span>
                                    <% } %>
                                </td>
                                <td class="pe-3 text-end">
                                    <a href="/admin/dispatch/<%= d._id %>" class="btn btn-sm btn-outline-secondary">
                                        <i class="icofont-eye-alt me-1"></i> View Details
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="icofont-delivery-time text-muted" style="font-size: 40px;"></i>
                                <p class="text-muted mt-2 mb-0">No dispatch consignments found.</p>
                                <a href="/admin/sales-out" class="btn btn-sm btn-primary mt-2">
                                    <i class="icofont-truck-loaded me-1"></i> Open Confirmed Sales to Dispatch
                                </a>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    
    <% if (totalP > 1) { %>
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page <%= currP %> of <%= totalP %> (<%= totalItms %> dispatches)</span>
            <ul class="pagination pagination-sm mb-0">
                <% for (let p = 1; p <= totalP; p++) { %>
                    <li class="page-item <%= p === currP ? 'active' : '' %>">
                        <a class="page-link" href="/admin/dispatch?page=<%= p %>&search=<%= filterObj.search || '' %>&status=<%= filterObj.status || '' %>"><%= p %></a>
                    </li>
                <% } %>
            </ul>
        </div>
    <% } %>
</div>

<%- include('partials/admin-footer') %>
