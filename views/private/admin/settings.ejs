<%- include('partials/admin-head') %>

<%
    const authUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : ((typeof user !== 'undefined' && user) ? user : null);
    const checkPerm = (typeof hasPermission === 'function') 
        ? hasPermission 
        : ((k) => authUser && (authUser.isPrimarySuperAdmin || (Array.isArray(authUser.permissions) && authUser.permissions.includes(k))));

    const canEditSettings = checkPerm('settings.general.edit');
%>

<!-- Action Feedback Alert Banner -->
<div id="settingsToast" class="alert alert-success alert-dismissible fade show d-none mb-4" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="settingsToastMsg">Settings updated successfully.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('settingsToast').classList.add('d-none')"></button>
</div>

<div id="settingsErrAlert" class="alert alert-danger d-none mb-4"></div>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            <i class="icofont-gear me-2 text-warning"></i> Company & System Configuration
        </h2>
        <p class="text-muted small mb-0">
            Configure enterprise master data, PM Surya Ghar subsidy rates, branch GPS geofences, and security controls.
        </p>
    </div>
    <div class="d-flex gap-2">
        <% if (canEditSettings) { %>
            <button type="button" class="btn btn-primary font-weight-bold px-4 shadow-sm" onclick="submitSettingsForm()" style="background: var(--admin-navy-primary); border-radius: 8px;">
                <i class="icofont-save me-1"></i> Save Changes
            </button>
        <% } else { %>
            <span class="badge bg-light text-muted border py-2 px-3 d-inline-flex align-items-center gap-1" style="font-size: 12px; border-radius: 8px;">
                <i class="icofont-lock text-warning"></i> View Only Mode
            </span>
        <% } %>
    </div>
</div>

<!-- Settings Card with Tabs -->
<div class="admin-card border-0 shadow-sm" style="border-radius: 12px; border: 1px solid var(--admin-border, #cbd5e1) !important;">
    <div class="admin-card-header bg-white p-3 border-bottom">
        <ul class="nav nav-pills gap-2" id="settingsTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active font-weight-bold btn-sm py-2 px-3" id="company-tab" data-bs-toggle="tab" data-bs-target="#company-pane" type="button" role="tab" style="border-radius: 8px;">
                    <i class="icofont-building me-1"></i> Company Profile
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link font-weight-bold btn-sm py-2 px-3" id="pricing-tab" data-bs-toggle="tab" data-bs-target="#pricing-pane" type="button" role="tab" style="border-radius: 8px;">
                    <i class="icofont-sun-alt me-1"></i> Pricing & Subsidy
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link font-weight-bold btn-sm py-2 px-3" id="geofence-tab" data-bs-toggle="tab" data-bs-target="#geofence-pane" type="button" role="tab" style="border-radius: 8px;">
                    <i class="icofont-location-pin me-1"></i> GPS Geofencing
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link font-weight-bold btn-sm py-2 px-3" id="security-tab" data-bs-toggle="tab" data-bs-target="#security-pane" type="button" role="tab" style="border-radius: 8px;">
                    <i class="icofont-shield-check me-1"></i> Security & Policies
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link font-weight-bold btn-sm py-2 px-3" id="discom-tab" data-bs-toggle="tab" data-bs-target="#discom-pane" type="button" role="tab" style="border-radius: 8px;">
                    <i class="icofont-flash me-1"></i> DISCOM Net-Metering
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link font-weight-bold btn-sm py-2 px-3" id="legal-tab" data-bs-toggle="tab" data-bs-target="#legal-pane" type="button" role="tab" style="border-radius: 8px;">
                    <i class="icofont-law-document me-1"></i> Privacy Policy &amp; Terms
                </button>
            </li>
        </ul>
    </div>

    <form id="settingsForm" onsubmit="event.preventDefault(); submitSettingsForm();">
        <div class="card-body p-4">
            <div class="tab-content" id="settingsTabContent">
                
                <!-- TAB 1: COMPANY PROFILE -->
                <div class="tab-pane fade show active" id="company-pane" role="tabpanel">
                    <h5 class="font-weight-bold text-dark mb-1" style="font-size: 16px;">Legal Entity & Branding Information</h5>
                    <p class="text-muted small mb-4">Official company details rendered on quotes, tax invoices, and legal disclosures.</p>
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Registered Legal Entity Name *</label>
                            <input type="text" class="form-control" name="companyName" value="<%= setting.companyName %>" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small font-weight-bold">Short Display Name</label>
                            <input type="text" class="form-control" name="shortName" value="<%= setting.shortName %>">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small font-weight-bold">GSTIN Number (State 23 - M.P.)</label>
                            <input type="text" class="form-control" name="gstin" value="<%= setting.gstin %>" placeholder="23AXXXX0000X1Z5">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Company Tagline</label>
                        <input type="text" class="form-control" name="tagline" value="<%= setting.tagline %>">
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">Official Business Email *</label>
                            <input type="email" class="form-control" name="officialEmail" value="<%= setting.officialEmail %>" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">Primary Phone (Mobile) *</label>
                            <input type="text" class="form-control" name="primaryPhone" value="<%= setting.primaryPhone %>" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">WhatsApp Business Number</label>
                            <input type="text" class="form-control" name="whatsappNumber" value="<%= setting.whatsappNumber %>">
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Alternate Contact / Support Phone</label>
                            <input type="text" class="form-control" name="alternatePhone" value="<%= setting.alternatePhone %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Official Website URL</label>
                            <input type="url" class="form-control" name="website" value="<%= setting.website %>">
                        </div>
                    </div>

                    <hr class="my-4 text-muted">
                    <h6 class="font-weight-bold text-dark mb-3" style="font-size: 14px;">Central Headquarters Address</h6>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Office Address Line *</label>
                        <input type="text" class="form-control" name="addressLine" value="<%= setting.addressLine %>" required>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label small font-weight-bold">City *</label>
                            <input type="text" class="form-control" name="city" value="<%= setting.city %>" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small font-weight-bold">District *</label>
                            <input type="text" class="form-control" name="district" value="<%= setting.district %>" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small font-weight-bold">State *</label>
                            <input type="text" class="form-control" name="state" value="<%= setting.state %>" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small font-weight-bold">Pincode *</label>
                            <input type="text" class="form-control" name="pincode" value="<%= setting.pincode %>" required>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: PRICING & SUBSIDY -->
                <div class="tab-pane fade" id="pricing-pane" role="tabpanel">
                    <h5 class="font-weight-bold text-dark mb-1" style="font-size: 16px;">PM Surya Ghar Subsidy Slabs & Default Rates</h5>
                    <p class="text-muted small mb-4">Configure direct benefit transfer (DBT) subsidy calculations and default solar rate per kilowatt.</p>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light border rounded-3">
                                <label class="form-label small font-weight-bold text-dark">Default Solar EPC Rate per kW (₹) *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">₹</span>
                                    <input type="number" class="form-control" name="defaultRatePerKw" value="<%= setting.defaultRatePerKw %>" required min="30000" max="150000" step="500">
                                </div>
                                <div class="form-text text-muted" style="font-size: 11px;">Standard installation rate applied during quotation preparation.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light border rounded-3">
                                <label class="form-label small font-weight-bold text-dark">Default Composite GST Rate (%)</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" name="defaultGstPercent" value="<%= setting.defaultGstPercent %>" min="0" max="28" step="0.1">
                                    <span class="input-group-text bg-white">%</span>
                                </div>
                                <div class="form-text text-muted" style="font-size: 11px;">Standard 13.8% composite rate (70% goods @ 12% + 30% services @ 18%).</div>
                            </div>
                        </div>
                    </div>

                    <h6 class="font-weight-bold text-dark mb-3" style="font-size: 14px;">
                        <i class="icofont-award text-warning me-1"></i> PM Surya Ghar: Muft Bijli Yojana Subsidy Slabs (MNRE)
                    </h6>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3">
                                <label class="form-label small font-weight-bold">1 kW System Subsidy</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">₹</span>
                                    <input type="number" class="form-control" name="subsidy1Kw" value="<%= setting.subsidy1Kw %>" min="0" step="1000">
                                </div>
                                <div class="small text-muted mt-2" style="font-size: 11px;">Official GoI slab: ₹30,000 for 1kW.</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3">
                                <label class="form-label small font-weight-bold">2 kW System Subsidy</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">₹</span>
                                    <input type="number" class="form-control" name="subsidy2Kw" value="<%= setting.subsidy2Kw %>" min="0" step="1000">
                                </div>
                                <div class="small text-muted mt-2" style="font-size: 11px;">Official GoI slab: ₹60,000 for 2kW.</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3">
                                <label class="form-label small font-weight-bold">3 kW & Above Max Subsidy</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">₹</span>
                                    <input type="number" class="form-control" name="subsidy3KwMax" value="<%= setting.subsidy3KwMax %>" min="0" step="1000">
                                </div>
                                <div class="small text-muted mt-2" style="font-size: 11px;">Official GoI cap: Maximum ₹78,000 for 3kW+.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 3: GPS GEOFENCING -->
                <div class="tab-pane fade" id="geofence-pane" role="tabpanel">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <div>
                            <h5 class="font-weight-bold text-dark mb-1" style="font-size: 16px;">Branch Geofence &amp; Attendance Settings</h5>
                            <p class="text-muted small mb-0">Configure strict attendance geofencing for Employees &amp; Managers and set the fallback HQ boundary on the map.</p>
                        </div>
                        <a href="/admin/branches" class="btn btn-sm btn-outline-primary font-weight-bold" style="border-radius: 8px;">
                            <i class="icofont-map me-1"></i> Branch-Wise Geofence Maps
                        </a>
                    </div>

                    <div class="p-3 bg-light border rounded-3 mb-4">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="enforceGeofenceSwitch" name="enforceGeofence" value="true" <%= setting.enforceGeofence ? 'checked' : '' %>>
                            <label class="form-check-label font-weight-bold text-dark ms-2" for="enforceGeofenceSwitch">
                                Enforce Strict GPS Geofence Verification for Manager &amp; Employee Check-In / Check-Out
                            </label>
                        </div>
                        <div class="small text-muted ms-4 mt-1" style="font-size: 11.5px;">
                            When enabled, Managers and Employees cannot mark attendance unless their live device GPS is inside their assigned branch's geofenced area (or fallback HQ zone below).
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">Default Geofence Radius (Meters) *</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="settingsHqRadius" name="defaultGeofenceRadiusMeters" value="<%= setting.defaultGeofenceRadiusMeters %>" min="50" max="50000" step="50" oninput="updateHqCircleRadius(this.value)" required>
                                <span class="input-group-text bg-white">meters</span>
                            </div>
                            <div class="form-text text-muted" style="font-size: 11px;">Standard boundary radius when a branch uses default sizing (default 500m).</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">HQ Latitude *</label>
                            <input type="number" class="form-control" id="settingsHqLat" name="hqLatitude" value="<%= setting.hqLatitude %>" step="0.000001" onchange="syncHqMapFromInputs()" required>
                            <div class="form-text text-muted" style="font-size: 11px;">Raisen Central HQ: 23.331500</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">HQ Longitude *</label>
                            <input type="number" class="form-control" id="settingsHqLng" name="hqLongitude" value="<%= setting.hqLongitude %>" step="0.000001" onchange="syncHqMapFromInputs()" required>
                            <div class="form-text text-muted" style="font-size: 11px;">Raisen Central HQ: 77.780700</div>
                        </div>
                    </div>

                    <div class="p-3 bg-light border rounded-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <span class="small font-weight-bold text-dark"><i class="icofont-map-pins text-primary me-1"></i> Select Fallback HQ Geofence Area on Map</span>
                            <div class="position-relative flex-grow-1" style="max-width: 440px;">
                                <div class="input-group input-group-sm">
                                    <input type="text" id="hqMapSearchInput" class="form-control" autocomplete="off" placeholder="Search city, area, pincode or lat,lng..." oninput="scheduleHqAutocomplete()" onkeydown="if(event.key==='Enter'){event.preventDefault();searchHqMap(true);}">
                                    <button type="button" class="btn btn-outline-primary" onclick="searchHqMap(true)"><i class="icofont-search-1"></i> Search</button>
                                    <button type="button" class="btn btn-outline-success" id="hqGpsBtn" onclick="useCurrentGpsForHq()"><i class="icofont-location-arrow"></i> Current Location</button>
                                </div>
                                <div id="hqMapSuggestions" class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1055; max-height: 200px; overflow-y: auto; top: 100%; left: 0;"></div>
                            </div>
                        </div>
                        <div id="settingsHqMap" style="height: 290px; width: 100%; border-radius: 10px; border: 1px solid #cbd5e1; z-index: 1;"></div>
                        <div id="hqMapStatus" class="small text-muted mt-1" style="font-size: 11px;">Click anywhere on map or drag pin to update HQ coordinates &amp; preview radius circle.</div>
                    </div>
                </div>

                <!-- TAB 4: SECURITY & ACCESS POLICIES -->
                <div class="tab-pane fade" id="security-pane" role="tabpanel">
                    <h5 class="font-weight-bold text-dark mb-1" style="font-size: 16px;">System Security & Session Governance</h5>
                    <p class="text-muted small mb-4">Enterprise access control, brute-force mitigation, and authentication lifecycle policies.</p>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <label class="form-label small font-weight-bold">Failed Login Lockout Threshold</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" name="maxFailedLoginAttempts" value="<%= setting.maxFailedLoginAttempts %>" min="3" max="10" required>
                                    <span class="input-group-text bg-white">attempts</span>
                                </div>
                                <div class="small text-muted mt-2" style="font-size: 11px;">Accounts are temporarily locked after this many consecutive bad passwords.</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <label class="form-label small font-weight-bold">Account Lockout Duration</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" name="lockoutDurationMinutes" value="<%= setting.lockoutDurationMinutes %>" min="5" max="120" required>
                                    <span class="input-group-text bg-white">minutes</span>
                                </div>
                                <div class="small text-muted mt-2" style="font-size: 11px;">Duration before a locked account can attempt authentication again.</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <label class="form-label small font-weight-bold">Session Expiry Timeout</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" name="sessionTimeoutHours" value="<%= setting.sessionTimeoutHours %>" min="1" max="168" required>
                                    <span class="input-group-text bg-white">hours</span>
                                </div>
                                <div class="small text-muted mt-2" style="font-size: 11px;">Cookie session lifetime before re-authentication is required.</div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 border rounded-3 bg-white">
                        <h6 class="font-weight-bold text-dark mb-2" style="font-size: 13px;">
                            <i class="icofont-check-circled text-success me-1"></i> Active Platform Defenses
                        </h6>
                        <ul class="mb-0 small text-muted ps-3">
                            <li class="mb-1"><strong>Real-time Session Revocation:</strong> Account suspension immediately terminates active user sessions.</li>
                            <li class="mb-1"><strong>CSRF Verification:</strong> State-changing requests strictly enforced with anti-CSRF token tokens.</li>
                            <li class="mb-1"><strong>IDOR & Branch Isolation:</strong> Managers and staff scoped strictly to their authorized jurisdiction.</li>
                            <li><strong>Helmet CSP Headers:</strong> Restricts unauthorized script injection and resource loading.</li>
                        </ul>
                    </div>
                </div>

                <!-- TAB 5: DISCOM NET-METERING -->
                <div class="tab-pane fade" id="discom-pane" role="tabpanel">
                    <h5 class="font-weight-bold text-dark mb-1" style="font-size: 16px;">DISCOM & Net-Meter Regulatory Configuration</h5>
                    <p class="text-muted small mb-4">Madhya Pradesh power utility connection settings and portal application parameters.</p>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Primary Electricity Distribution Company (DISCOM) *</label>
                            <input type="text" class="form-control" name="primaryDiscom" value="<%= setting.primaryDiscom %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">DISCOM Emergency Helpline</label>
                            <input type="text" class="form-control" name="discomHelpline" value="<%= setting.discomHelpline %>">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">DISCOM Net-Meter Application Portal URL</label>
                        <input type="url" class="form-control" name="discomPortalUrl" value="<%= setting.discomPortalUrl %>">
                    </div>
                </div>

                <!-- TAB 6: PRIVACY POLICY & TERMS -->
                <div class="tab-pane fade" id="legal-pane" role="tabpanel">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="font-weight-bold text-dark mb-1" style="font-size: 16px;">
                                <i class="icofont-law-document text-primary me-1"></i> Public Privacy Policy &amp; Terms &amp; Conditions
                            </h5>
                            <p class="text-muted small mb-0">
                                Edit or paste your company's official Privacy Policy and Terms &amp; Conditions. Content updates immediately on the public website.
                            </p>
                        </div>
                        <div class="d-flex gap-2 mt-2 mt-sm-0">
                            <a href="/privacy-policy" target="_blank" class="btn btn-outline-primary btn-sm" style="border-radius: 6px;">
                                <i class="icofont-external-link me-1"></i> View Live Privacy Policy
                            </a>
                            <a href="/terms-and-conditions" target="_blank" class="btn btn-outline-primary btn-sm" style="border-radius: 6px;">
                                <i class="icofont-external-link me-1"></i> View Live Terms &amp; Conditions
                            </a>
                        </div>
                    </div>

                    <!-- Privacy Policy Section -->
                    <div class="card border mb-4 rounded-3 shadow-none">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                            <span class="font-weight-bold text-dark small">
                                <i class="icofont-shield-alt text-success me-1"></i> 1. Public Privacy Policy Content
                            </span>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="pasteToField('privacyPolicyTextarea')">
                                    <i class="icofont-ui-copy me-1"></i> Paste from Clipboard
                                </button>
                                <button type="button" class="btn btn-outline-warning btn-sm" onclick="loadDefaultPolicy()">
                                    <i class="icofont-refresh me-1"></i> Load Default Policy
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm" onclick="clearField('privacyPolicyTextarea')">
                                    <i class="icofont-close-line"></i> Clear
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <p class="text-muted small mb-2">
                                <i class="icofont-info-circle text-info me-1"></i>
                                Covers customer inquiries, site surveys, PM Surya Ghar subsidy KYC, complaints, dealership forms, and data protection rules. Supports standard HTML or plain formatted text.
                            </p>
                            <textarea class="form-control font-monospace small" id="privacyPolicyTextarea" name="privacyPolicy" rows="10" placeholder="Paste your complete Privacy Policy text or HTML here..."><%= setting.privacyPolicy || "" %></textarea>
                        </div>
                    </div>

                    <!-- Terms & Conditions Section -->
                    <div class="card border rounded-3 shadow-none">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                            <span class="font-weight-bold text-dark small">
                                <i class="icofont-law-order text-primary me-1"></i> 2. Public Terms &amp; Conditions Content
                            </span>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="pasteToField('termsTextarea')">
                                    <i class="icofont-ui-copy me-1"></i> Paste from Clipboard
                                </button>
                                <button type="button" class="btn btn-outline-warning btn-sm" onclick="loadDefaultTerms()">
                                    <i class="icofont-refresh me-1"></i> Load Default T&amp;C
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm" onclick="clearField('termsTextarea')">
                                    <i class="icofont-close-line"></i> Clear
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <p class="text-muted small mb-2">
                                <i class="icofont-info-circle text-info me-1"></i>
                                Covers site survey feasibility, quotation validity, milestone payments (20/60/20), PM Surya Ghar subsidy processing, equipment warranties, and DISCOM net-metering. Supports standard HTML or plain formatted text.
                            </p>
                            <textarea class="form-control font-monospace small" id="termsTextarea" name="termsAndConditions" rows="10" placeholder="Paste your complete Terms & Conditions text or HTML here..."><%= setting.termsAndConditions || "" %></textarea>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="card-footer bg-light p-3 d-flex justify-content-end gap-2 border-top">
            <button type="button" class="btn btn-outline-secondary btn-sm px-4" onclick="location.reload()" style="border-radius: 8px;">
                Reset
            </button>
            <button type="submit" class="btn btn-primary btn-sm px-4 font-weight-bold" style="background: var(--admin-navy-primary); border-radius: 8px;">
                <i class="icofont-save me-1"></i> Save System Settings
            </button>
        </div>
    </form>
</div>

<script>
const CSRF_TOKEN = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

// Reliable Tab Switching for Settings Navigation
document.addEventListener('DOMContentLoaded', function() {
    const tabBtns = document.querySelectorAll('#settingsTab button');
    tabBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            tabBtns.forEach(b => {
                b.classList.remove('active');
                b.setAttribute('aria-selected', 'false');
            });
            document.querySelectorAll('#settingsTabContent .tab-pane').forEach(p => {
                p.classList.remove('show', 'active');
            });
            this.classList.add('active');
            this.setAttribute('aria-selected', 'true');
            const targetSelector = this.getAttribute('data-bs-target');
            const targetPane = document.querySelector(targetSelector);
            if (targetPane) {
                targetPane.classList.add('show', 'active');
            }
        });
    });
});

function showToast(msg) {
    const toast = document.getElementById('settingsToast');
    const toastMsg = document.getElementById('settingsToastMsg');
    if (toast && toastMsg) {
        toastMsg.innerText = msg;
        toast.classList.remove('d-none');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        setTimeout(() => toast.classList.add('d-none'), 5000);
    }
}

async function submitSettingsForm() {
    const errBox = document.getElementById('settingsErrAlert');
    errBox.classList.add('d-none');

    const form = document.getElementById('settingsForm');
    const formData = new FormData(form);
    const body = {};

    formData.forEach((value, key) => {
        body[key] = value;
    });

    body.enforceGeofence = document.getElementById('enforceGeofenceSwitch').checked;
    body._csrf = CSRF_TOKEN;

    try {
        const res = await fetch('/api/admin/settings/save', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN
            },
            body: JSON.stringify(body)
        });

        const data = await res.json();
        if (data.success) {
            showToast(data.message || 'System settings saved successfully.');
        } else {
            errBox.innerText = data.message || 'Error saving settings.';
            errBox.classList.remove('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    } catch (err) {
        errBox.innerText = 'Server error while communicating with system settings API.';
        errBox.classList.remove('d-none');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
}

// Legal Policies Helper Functions
const DEFAULT_POLICY_TEMPLATE = <%- JSON.stringify(typeof defaultPrivacyPolicy !== 'undefined' ? defaultPrivacyPolicy : '') %>;
const DEFAULT_TERMS_TEMPLATE = <%- JSON.stringify(typeof defaultTermsConditions !== 'undefined' ? defaultTermsConditions : '') %>;

async function pasteToField(fieldId) {
    try {
        const text = await navigator.clipboard.readText();
        if (text && text.trim()) {
            document.getElementById(fieldId).value = text.trim();
            showToast('Content successfully pasted from clipboard!');
        } else {
            alert('Clipboard is empty. Please copy text first.');
        }
    } catch (err) {
        alert('Clipboard permission denied by browser. Please paste directly using Ctrl+V inside the box.');
    }
}

function clearField(fieldId) {
    if (confirm('Are you sure you want to clear this policy content?')) {
        document.getElementById(fieldId).value = '';
    }
}

function loadDefaultPolicy() {
    if (confirm('Load standard Shivay Energy Solutions personalized Privacy Policy into editor?')) {
        document.getElementById('privacyPolicyTextarea').value = DEFAULT_POLICY_TEMPLATE;
        showToast('Default Privacy Policy loaded into editor.');
    }
}

function loadDefaultTerms() {
    if (confirm('Load standard Shivay Energy Solutions personalized Terms & Conditions into editor?')) {
        document.getElementById('termsTextarea').value = DEFAULT_TERMS_TEMPLATE;
        showToast('Default Terms & Conditions loaded into editor.');
    }
}
</script>

<link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
<script src="/vendor/leaflet/leaflet.js"></script>
<script>
let hqMapCtrl = null;

function initHqGeofenceMap() {
    if (typeof L === 'undefined') return;
    const latInput = document.getElementById('settingsHqLat');
    const lngInput = document.getElementById('settingsHqLng');
    const radInput = document.getElementById('settingsHqRadius');
    const lat = parseFloat(latInput.value) || 23.3315;
    const lng = parseFloat(lngInput.value) || 77.7807;
    const radius = Math.max(50, parseInt(radInput.value, 10) || 500);

    if (!hqMapCtrl) {
        const map = L.map('settingsHqMap').setView([lat, lng], 16);
        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            maxNativeZoom: 18,
            maxZoom: 19,
            attribution: '&copy; Esri Satellite'
        }).addTo(map);

        const marker = L.marker([lat, lng], { draggable: true }).addTo(map);
        const circle = L.circle([lat, lng], { radius, color: '#fbec6b', weight: 2.5, fillColor: '#38bdf8', fillOpacity: 0.22 }).addTo(map);

        const updatePos = (newLat, newLng, pan = false) => {
            const fLat = Number(newLat.toFixed(6));
            const fLng = Number(newLng.toFixed(6));
            latInput.value = fLat;
            lngInput.value = fLng;
            marker.setLatLng([fLat, fLng]);
            circle.setLatLng([fLat, fLng]);
            if (pan) map.setView([fLat, fLng], Math.max(map.getZoom(), 15));
            document.getElementById('hqMapStatus').innerText = `HQ Pin: ${fLat}, ${fLng} (Default Radius: ${circle.getRadius()}m)`;
        };

        marker.on('dragend', (ev) => updatePos(ev.target.getLatLng().lat, ev.target.getLatLng().lng, false));
        map.on('click', (ev) => updatePos(ev.latlng.lat, ev.latlng.lng, false));
        hqMapCtrl = { map, marker, circle, updatePos };
    } else {
        hqMapCtrl.map.invalidateSize();
    }
    setTimeout(() => hqMapCtrl && hqMapCtrl.map.invalidateSize(), 200);
}

function syncHqMapFromInputs() {
    const lat = parseFloat(document.getElementById('settingsHqLat').value);
    const lng = parseFloat(document.getElementById('settingsHqLng').value);
    if (hqMapCtrl && Number.isFinite(lat) && Number.isFinite(lng) && Math.abs(lat) <= 90 && Math.abs(lng) <= 180) {
        hqMapCtrl.updatePos(lat, lng, true);
    }
}

function updateHqCircleRadius(val) {
    if (hqMapCtrl) {
        hqMapCtrl.circle.setRadius(Math.max(50, parseInt(val, 10) || 500));
    }
}

let hqSearchTimer = null;
let hqSearchResults = [];

function selectHqResult(idx) {
    const item = hqSearchResults[idx];
    if (!item) return;
    document.getElementById('hqMapSearchInput').value = item.label;
    document.getElementById('hqMapSuggestions').classList.add('d-none');
    initHqGeofenceMap();
    if (hqMapCtrl) {
        hqMapCtrl.updatePos(item.lat, item.lng, true);
    }
    document.getElementById('hqMapStatus').innerText = `Pinned: ${item.label} (${item.lat.toFixed(6)}, ${item.lng.toFixed(6)})`;
}

function scheduleHqAutocomplete() {
    const q = (document.getElementById('hqMapSearchInput').value || '').trim();
    clearTimeout(hqSearchTimer);
    if (q.length < 3) {
        document.getElementById('hqMapSuggestions').classList.add('d-none');
        return;
    }
    hqSearchTimer = setTimeout(() => searchHqMap(false), 380);
}

async function searchHqMap(selectFirst = false) {
    const q = (document.getElementById('hqMapSearchInput').value || '').trim();
    const statusEl = document.getElementById('hqMapStatus');
    const sugBox = document.getElementById('hqMapSuggestions');
    if (q.length < 2) {
        sugBox.classList.add('d-none');
        return;
    }
    statusEl.innerText = 'Searching location...';
    try {
        const res = await fetch(`/api/admin/geocode?q=${encodeURIComponent(q)}`);
        const payload = await res.json();
        const list = (payload && payload.success && Array.isArray(payload.results)) ? payload.results : [];
        hqSearchResults = list;
        if (list.length === 0) {
            sugBox.classList.add('d-none');
            statusEl.innerText = 'No matching places found. Try city/area, pincode, or paste lat,lng coordinates.';
            return;
        }
        if (selectFirst) {
            selectHqResult(0);
            return;
        }
        sugBox.innerHTML = list.map((item, idx) => `
            <button type="button" class="list-group-item list-group-item-action py-2 px-3 small text-start" onclick="selectHqResult(${idx})">
                <i class="icofont-location-pin text-danger me-1"></i> ${String(item.label).replace(/</g, '&lt;')}
            </button>
        `).join('');
        sugBox.classList.remove('d-none');
        statusEl.innerText = `Select a matching location (${list.length} found).`;
    } catch (_) {
        sugBox.classList.add('d-none');
        statusEl.innerText = 'Search error. You can paste lat,lng or click directly on the map to set HQ pin.';
    }
}

function useCurrentGpsForHq() {
    const statusEl = document.getElementById('hqMapStatus');
    const btn = document.getElementById('hqGpsBtn');
    document.getElementById('hqMapSuggestions').classList.add('d-none');

    if (!navigator.geolocation) {
        statusEl.innerText = 'Browser geolocation unavailable.';
        return;
    }
    if (window.isSecureContext === false && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
        statusEl.innerText = 'Browser blocks GPS on non-HTTPS LAN URLs. Open via localhost/HTTPS or click directly on the map.';
        return;
    }

    if (btn) btn.disabled = true;
    statusEl.innerText = 'Detecting current location...';

    const onSuccess = (pos) => {
        if (btn) btn.disabled = false;
        initHqGeofenceMap();
        if (hqMapCtrl) {
            hqMapCtrl.updatePos(pos.coords.latitude, pos.coords.longitude, true);
        }
        statusEl.innerText = `HQ Pin snapped to your current location: ${pos.coords.latitude.toFixed(6)}, ${pos.coords.longitude.toFixed(6)} (±${Math.round(pos.coords.accuracy)}m).`;
    };

    const onFail = (err) => {
        if (btn) btn.disabled = false;
        statusEl.innerText = (err && err.code === 1)
            ? 'Location permission denied. Allow Location access in browser or click directly on the map.'
            : 'Could not detect current GPS automatically. Search location or click directly on the map.';
    };

    navigator.geolocation.getCurrentPosition(
        onSuccess,
        (err) => {
            if (err && err.code === 1) {
                onFail(err);
                return;
            }
            navigator.geolocation.getCurrentPosition(
                onSuccess,
                onFail,
                { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 }
            );
        },
        { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
    );
}

document.addEventListener('click', (ev) => {
    const inp = document.getElementById('hqMapSearchInput');
    const sug = document.getElementById('hqMapSuggestions');
    if (sug && inp && !sug.contains(ev.target) && ev.target !== inp) {
        sug.classList.add('d-none');
    }
});

document.addEventListener('DOMContentLoaded', () => {
    const geoTabBtn = document.getElementById('geofence-tab');
    if (geoTabBtn) {
        geoTabBtn.addEventListener('shown.bs.tab', () => initHqGeofenceMap());
    }
});
</script>

