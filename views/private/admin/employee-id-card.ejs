            </div>

        </div>
    </main>

    <!-- Modal: Share ID Card with Employee -->
    <% if (isManagerOrAdmin) { %>
    <div class="modal fade" id="shareCardModal" tabindex="-1" aria-labelledby="shareCardModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header text-white" style="background: var(--deep-blue);">
                    <h5 class="modal-title font-weight-bold" id="shareCardModalLabel">
                        <i class="icofont-share me-1 text-warning"></i> Share ID Card with <%= empName %>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        As an authorized Manager / Administrator, you can securely deliver this official Identity Card directly to the employee via WhatsApp or direct secure link.
                    </p>

                    <% 
                        const cleanMobileDigits = (empMobile || '').replace(/\D/g, '');
                        const shareLink = '/cards/view/id-card/' + employee._id + '?token=' + shareToken;
                        const defaultShareText = `Namaste ${empName}, here is your official Shivay Energy Solutions Employee ID Card (${branchName}):\n${shareLink}\nEmployee ID: ${empCode}`;
                        const waUrl = `https://wa.me/${cleanMobileDigits.length === 10 ? '91' + cleanMobileDigits : cleanMobileDigits}?text=${encodeURIComponent(defaultShareText)}`;
                    %>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Direct Secure Card URL</label>
                        <div class="input-group">
                            <input type="text" id="shareUrlInput" class="form-control form-control-sm" value="<%= shareLink %>" readonly>
                            <button class="btn btn-outline-secondary btn-sm" onclick="copyShareLink()">
                                <i class="icofont-copy me-1"></i> Copy
                            </button>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <a href="<%= waUrl %>" target="_blank" class="btn btn-success font-weight-bold text-white">
                            <i class="icofont-brand-whatsapp me-1"></i> Send ID Card on WhatsApp (<%= empMobile %>)
                        </a>
                        <button class="btn btn-primary font-weight-bold" onclick="copyShareText(`<%= defaultShareText.replace(/\n/g, ' ') %>`)">
                            <i class="icofont-ui-copy me-1"></i> Copy Share Message
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/qrcode-browser.js"></script>
    <script>
        (function renderRealIdQrFallback() {
            const box = document.getElementById('id-qr-container');
            if (!box || box.querySelector('svg') || typeof window.SesQRCode === 'undefined') return;
            const qrPayload = <%- JSON.stringify([
                'SHIVAY ENERGY SOLUTIONS - EMPLOYEE ID',
                'Name: ' + empName,
                'Role: ' + empDesig,
                'ID No: ' + empCode,
                'Phone: ' + empMobile,
                'Alt No: ' + ((empAlt && empAlt !== 'N/A' && empAlt !== 'None' && empAlt !== '') ? empAlt : 'N/A'),
                'Email: ' + empEmail,
                'Blood Gr: ' + (empBlood || 'B+'),
                'Join: ' + joinDateFormatted,
                'Expire: ' + expDateFormatted,
                'Branch: ' + branchName + ' (' + (branch ? branch.code : 'MP-RSN-01') + ')',
                'Website: https://www.shivayenergysolutions.com'
            ].join('\n')) %>;
            window.SesQRCode.toString(qrPayload, {
                type: 'svg',
                margin: 1,
                color: { dark: '#111827', light: '#ffffff' }
            }, function (err, svg) {
                if (!err && svg) {
                    box.innerHTML = svg;
                }
            });
        })();

        function copyShareLink() {
            const input = document.getElementById('shareUrlInput');
            input.select();
            input.setSelectionRange(0, 99999);
            const fullUrl = window.location.origin + input.value;
            navigator.clipboard.writeText(fullUrl).then(() => {
                alert('Secure card link copied to clipboard: ' + fullUrl);
            });
        }

        function copyShareText(text) {
            const fullText = text.replace(document.getElementById('shareUrlInput').value, window.location.origin + document.getElementById('shareUrlInput').value);
            navigator.clipboard.writeText(fullText).then(() => {
                alert('Share message copied to clipboard!');
            });
        }
    </script>
</body>
</html>
