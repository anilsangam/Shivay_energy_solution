<%- include('partials/admin-head') %>

<%
    const s = (typeof sale !== 'undefined' && sale) ? sale : {
        saleNumber: '—',
        status: 'DRAFT',
        items: [],
        invoice: {},
        customer: {},
        project: {},
        confirmedBy: {},
        createdBy: {}
    };
    const dispatchesList = (typeof dispatches !== 'undefined' && Array.isArray(dispatches)) ? dispatches : [];
    const returnsList = (typeof returns !== 'undefined' && Array.isArray(returns)) ? returns : [];
%>

<!-- Action Feedback Alert Banner -->
<div id="saleViewToast" class="alert alert-success alert-dismissible fade show d-none mb-4" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="saleViewToastMsg">Action completed.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('saleViewToast').classList.add('d-none')"></button>
</div>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <div class="mb-1">
            <a href="/admin/sales-out" class="text-muted small text-decoration-none">
                <i class="icofont-rounded-left me-1"></i> Back to All Sales
            </a>
        </div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="font-weight-bold mb-0" style="color: var(--admin-navy-primary); font-size: 24px;">
                Sale Order: <span class="font-monospace text-primary"><%= s.saleNumber %></span>
            </h2>
            <% if (s.status === 'CONFIRMED') { %>
                <span class="badge bg-success py-2 px-3"><i class="icofont-check-circled me-1"></i> CONFIRMED</span>
            <% } else if (s.status === 'PROCESSING') { %>
                <span class="badge bg-info text-dark py-2 px-3"><i class="icofont-sand-clock me-1"></i> PROCESSING (PARTIAL DISPATCH)</span>
            <% } else if (s.status === 'DRAFT') { %>
                <span class="badge bg-warning text-dark py-2 px-3"><i class="icofont-edit-alt me-1"></i> DRAFT (PENDING CONFIRMATION)</span>
            <% } else { %>
                <span class="badge bg-secondary py-2 px-3"><%= s.status %></span>
            <% } %>

            <% if (s.dispatchStatus === 'DELIVERED') { %>
                <span class="badge bg-success-subtle text-success border border-success-subtle py-2 px-3"><i class="icofont-check me-1"></i> ALL DELIVERED</span>
            <% } else if (s.dispatchStatus === 'DISPATCHED') { %>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-2 px-3"><i class="icofont-truck me-1"></i> FULLY DISPATCHED</span>
            <% } else if (s.dispatchStatus === 'PARTIALLY_DISPATCHED') { %>
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle py-2 px-3"><i class="icofont-clock-time me-1"></i> PARTIALLY DISPATCHED</span>
            <% } %>
        </div>
    </div>
    <div class="d-flex gap-2">
        <% if (s.status === 'DRAFT') { %>
            <button class="btn btn-success font-weight-bold shadow-sm" onclick="confirmSaleNow('<%= s._id %>')" style="border-radius: 8px;">
                <i class="icofont-check-circled me-1"></i> Confirm Sale & Deduct Stock
            </button>
            <button class="btn btn-outline-danger" onclick="cancelSaleNow('<%= s._id %>')" style="border-radius: 8px;">
                <i class="icofont-close me-1"></i> Cancel Sale
            </button>
        <% } %>
        <% if (s.status === 'CONFIRMED' || s.status === 'PROCESSING') { %>
            <button class="btn btn-warning font-weight-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#createDispatchModal" style="border-radius: 8px;">
                <i class="icofont-truck-alt me-1"></i> Create Dispatch
            </button>
            <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#createReturnModal" style="border-radius: 8px;">
                <i class="icofont-recycle me-1"></i> Request Return
            </button>
            <a href="/admin/sales-out/<%= s._id %>/invoice" class="btn btn-primary" target="_blank" style="border-radius: 8px;">
                <i class="icofont-print me-1"></i> Print Tax Invoice
            </a>
            <% if ((s.items || []).every(it => (it.dispatchedQuantity || 0) === 0)) { %>
                <button class="btn btn-outline-danger" onclick="cancelSaleNow('<%= s._id %>')" style="border-radius: 8px;" title="Cancel Sale and Reverse Stock">
                    <i class="icofont-close me-1"></i> Cancel & Reverse
                </button>
            <% } %>
        <% } %>
    </div>
</div>

<% if (s.status === 'CONFIRMED' || s.status === 'PROCESSING') { %>
    <div class="alert alert-success d-flex align-items-center mb-4 py-3 px-4 border-0 shadow-sm rounded-3">
        <i class="icofont-check-circled fs-3 me-3 text-success"></i>
        <div>
            <div class="fw-bold">Inventory Stock Deducted & Invoice Generated</div>
            <div class="small">
                This sale order was confirmed on <%= new Date(s.confirmedAt || s.updatedAt).toLocaleString('en-IN') %>. Stock levels were atomically decremented in the inventory ledger and invoice <strong class="font-monospace"><%= (s.invoice && s.invoice.invoiceNumber) || 'Generated' %></strong> was created.
            </div>
        </div>
    </div>
<% } %>

<!-- Two Info Cards: Buyer & Sale Meta -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 15px;">
                    <i class="icofont-user-suited text-warning me-2"></i> Buyer / Customer Information
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="h5 fw-bold text-dark mb-1"><%= s.customerName %></div>
                <div class="mb-2">
                    <span class="badge bg-light text-secondary border"><%= s.customerType || 'INDIVIDUAL' %></span>
                    <% if (s.companyName) { %>
                        <span class="badge bg-light text-primary border font-weight-semibold ms-1"><i class="icofont-building me-1"></i><%= s.companyName %></span>
                    <% } %>
                </div>
                <% if (s.customerGstin) { %>
                    <div class="text-muted small mb-2 font-monospace">GSTIN: <span class="text-dark fw-bold"><%= s.customerGstin %></span></div>
                <% } %>
                <hr class="my-2">
                <div class="row g-2 small">
                    <div class="col-6">
                        <span class="text-muted">Primary Mobile:</span>
                        <div class="fw-medium text-dark"><%= s.customerMobile || '—' %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Email:</span>
                        <div class="fw-medium text-dark"><%= s.customerEmail || '—' %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Contact Person:</span>
                        <div class="fw-medium text-dark"><%= s.contactPerson || '—' %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">City / State:</span>
                        <div class="fw-medium text-dark"><%= s.city || 'Raisen' %>, <%= s.state || 'Madhya Pradesh' %></div>
                    </div>
                    <div class="col-12 mt-1">
                        <span class="text-muted">Billing / Delivery Address:</span>
                        <div class="fw-medium text-dark"><%= s.customerAddress || '—' %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 15px;">
                    <i class="icofont-bill-alt text-warning me-2"></i> Sale Order Overview
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 small">
                    <div class="col-6">
                        <span class="text-muted">Order Date:</span>
                        <div class="fw-bold text-dark fs-6"><%= new Date(s.saleDate || s.createdAt).toLocaleDateString('en-IN') %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Tax Invoice No:</span>
                        <div class="fw-bold font-monospace text-primary fs-6">
                            <%= (s.invoice && s.invoice.invoiceNumber) || 'Pending Confirmation' %>
                        </div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Payment Status:</span>
                        <div>
                            <span class="badge <%= s.paymentStatus === 'PAID' ? 'bg-success' : (s.paymentStatus === 'PARTIALLY_PAID' ? 'bg-warning text-dark' : 'bg-danger') %>">
                                <%= s.paymentStatus || 'UNPAID' %>
                            </span>
                        </div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Payment Mode:</span>
                        <div class="fw-medium text-dark"><%= s.paymentMethod || 'Bank Transfer' %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Linked Solar Project:</span>
                        <div class="fw-medium text-dark">
                            <% if (s.projectNumber) { %>
                                <span class="badge bg-light text-primary border font-monospace"><i class="icofont-sun me-1"></i><%= s.projectNumber %></span>
                            <% } else { %>
                                <span class="text-muted">Standalone Sale (No Project)</span>
                            <% } %>
                        </div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Created By:</span>
                        <div class="fw-medium text-dark">
                            <%= (s.createdBy && s.createdBy.name) || 'Executive Administration' %>
                        </div>
                    </div>
                    <div class="col-12">
                        <span class="text-muted">Notes / Instructions:</span>
                        <div class="fw-medium text-dark"><%= s.notes || 'No special notes specified.' %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Line Items Table -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 16px;">
            <i class="icofont-listine-dots text-warning me-2"></i> Sold Materials & Fulfillment Status
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase font-weight-bold">
                    <tr>
                        <th class="ps-4 py-3" style="width: 50px;">#</th>
                        <th class="py-3">Material Name & SKU</th>
                        <th class="py-3 text-center">Unit</th>
                        <th class="py-3 text-end">Sold Qty</th>
                        <th class="py-3 text-center">Dispatched</th>
                        <th class="py-3 text-center">Returned</th>
                        <th class="py-3 text-end">Unit Price (₹)</th>
                        <th class="py-3 text-end">GST %</th>
                        <th class="py-3 text-end">Tax (₹)</th>
                        <th class="pe-4 py-3 text-end">Line Total (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (s.items && s.items.length > 0) { %>
                        <% s.items.forEach((item, idx) => { %>
                            <tr>
                                <td class="ps-4 text-muted"><%= idx + 1 %></td>
                                <td>
                                    <div class="fw-bold text-dark"><%= item.materialName %></div>
                                    <div class="font-monospace text-muted small" style="font-size: 11px;">SKU: <%= item.sku %></div>
                                    <% if (item.priceOverride && item.priceOverride.isOverridden) { %>
                                        <div class="mt-1">
                                            <span class="badge bg-warning text-dark font-weight-normal" style="font-size: 9.5px;">
                                                <i class="icofont-warning me-1"></i> Override: Catalog ₹<%= item.priceOverride.originalPrice %> -> Sale ₹<%= item.priceOverride.customPrice %>
                                            </span>
                                            <small class="text-muted d-block" style="font-size: 10px;">Reason: <%= item.priceOverride.reason %></small>
                                        </div>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border"><%= item.unit || 'Piece' %></span>
                                </td>
                                <td class="text-end fw-bold text-dark">
                                    <%= Number(item.quantity || 0).toLocaleString('en-IN') %>
                                </td>
                                <td class="text-center">
                                    <% const dQty = item.dispatchedQuantity || 0; %>
                                    <span class="badge <%= dQty >= item.quantity ? 'bg-success' : (dQty > 0 ? 'bg-warning text-dark' : 'bg-light text-muted border') %>">
                                        <%= dQty %> / <%= item.quantity %>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <% const rQty = item.returnedQuantity || 0; %>
                                    <% if (rQty > 0) { %>
                                        <span class="badge bg-danger"><%= rQty %> returned</span>
                                    <% } else { %>
                                        <span class="text-muted">—</span>
                                    <% } %>
                                </td>
                                <td class="text-end text-dark">
                                    ₹<%= Number(item.unitPrice || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td class="text-end text-muted small">
                                    <%= item.gstRate || 0 %>%
                                </td>
                                <td class="text-end text-muted">
                                    ₹<%= Number(item.taxAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td class="pe-4 text-end fw-bold text-dark">
                                    ₹<%= Number(item.lineTotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Financial Summary Row -->
<div class="row justify-content-end mb-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <table class="table table-sm table-borderless align-middle mb-0">
                    <tr>
                        <td class="text-muted">Subtotal (Materials):</td>
                        <td class="text-end fw-semibold">₹<%= Number(s.subtotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Tax / GST Total:</td>
                        <td class="text-end fw-semibold">₹<%= Number(s.taxTotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Freight / Packaging Charges:</td>
                        <td class="text-end text-primary fw-semibold">+₹<%= Number(s.additionalCharges || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    </tr>
                    <% if (s.discount > 0) { %>
                        <tr>
                            <td class="text-muted">Discount Applied:</td>
                            <td class="text-end text-danger fw-semibold">-₹<%= Number(s.discount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                        </tr>
                    <% } %>
                    <tr class="border-top">
                        <td class="pt-3 h5 font-weight-bold text-dark">Total Net Payable:</td>
                        <td class="pt-3 text-end h4 font-weight-bold" style="color: var(--admin-navy-primary);">
                            ₹<%= Number(s.grandTotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Linked Dispatches Section -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 16px;">
            <i class="icofont-delivery-time text-warning me-2"></i> Linked Dispatches & Delivery Consignments
        </h5>
        <% if (s.status === 'CONFIRMED' || s.status === 'PROCESSING') { %>
            <button class="btn btn-sm btn-outline-warning text-dark font-weight-semibold" data-bs-toggle="modal" data-bs-target="#createDispatchModal">
                <i class="icofont-plus-circle me-1"></i> New Dispatch
            </button>
        <% } %>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Dispatch #</th>
                        <th class="py-3">Date</th>
                        <th class="py-3">Transporter / Tracking</th>
                        <th class="py-3 text-center">Items Dispatched</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="pe-4 py-3 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (dispatchesList && dispatchesList.length > 0) { %>
                        <% dispatchesList.forEach(d => { %>
                            <tr>
                                <td class="ps-4">
                                    <a href="/admin/dispatch/<%= d._id %>" class="fw-bold font-monospace text-primary text-decoration-none">
                                        <%= d.dispatchNumber %>
                                    </a>
                                </td>
                                <td><%= new Date(d.dispatchDate || d.createdAt).toLocaleDateString('en-IN') %></td>
                                <td>
                                    <div class="fw-medium text-dark"><%= d.transporterName || 'Direct Logistics' %></div>
                                    <% if (d.trackingNumber) { %>
                                        <small class="text-muted font-monospace">LR: <%= d.trackingNumber %></small>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        <%= (d.items || []).reduce((acc, it) => acc + (it.dispatchedQuantity || 0), 0) %> units
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge <%= d.status === 'DELIVERED' ? 'bg-success' : (d.status === 'SHIPPED' ? 'bg-primary' : 'bg-warning text-dark') %>">
                                        <%= d.status %>
                                    </span>
                                </td>
                                <td class="pe-4 text-end">
                                    <a href="/admin/dispatch/<%= d._id %>" class="btn btn-sm btn-outline-secondary">
                                        <i class="icofont-eye-alt me-1"></i> View
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="icofont-truck-alt me-1"></i> No dispatches generated yet for this sale order.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Linked Returns Section -->
<div class="card border-0 shadow-sm rounded-3 mb-5">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 16px;">
            <i class="icofont-exchange text-warning me-2"></i> Linked Material Returns & RMAs
        </h5>
        <% if (s.status === 'CONFIRMED' || s.status === 'PROCESSING') { %>
            <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#createReturnModal">
                <i class="icofont-plus-circle me-1"></i> Request Return
            </button>
        <% } %>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Return #</th>
                        <th class="py-3">Date</th>
                        <th class="py-3">Reason</th>
                        <th class="py-3 text-center">Items Returned</th>
                        <th class="py-3 text-center">Inspection Status</th>
                        <th class="pe-4 py-3 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (returnsList && returnsList.length > 0) { %>
                        <% returnsList.forEach(r => { %>
                            <tr>
                                <td class="ps-4">
                                    <a href="/admin/returns/<%= r._id %>" class="fw-bold font-monospace text-primary text-decoration-none">
                                        <%= r.returnNumber %>
                                    </a>
                                </td>
                                <td><%= new Date(r.receivedDate || r.createdAt).toLocaleDateString('en-IN') %></td>
                                <td>
                                    <div class="text-truncate" style="max-width: 250px;"><%= r.returnReason %></div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        <%= (r.items || []).reduce((acc, it) => acc + (it.returnedQuantity || 0), 0) %> units
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge <%= r.status === 'APPROVED' ? 'bg-success' : (r.status === 'REJECTED' ? 'bg-danger' : 'bg-warning text-dark') %>">
                                        <%= r.status %>
                                    </span>
                                </td>
                                <td class="pe-4 text-end">
                                    <a href="/admin/returns/<%= r._id %>" class="btn btn-sm btn-outline-secondary">
                                        <i class="icofont-eye-alt me-1"></i> View
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="icofont-check-circled me-1 text-success"></i> No return requests recorded for this sale order.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Create Dispatch -->
<div class="modal fade" id="createDispatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="createDispatchForm" onsubmit="handleCreateDispatch(event)">
                <input type="hidden" name="saleId" value="<%= s._id %>">
                <div class="modal-header bg-navy text-white" style="background-color: var(--admin-navy-primary);">
                    <h5 class="modal-title font-weight-bold text-white"><i class="icofont-truck-alt me-2 text-warning"></i> Generate Dispatch Consignment</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 px-3 small mb-3">
                        <i class="icofont-info-circle me-1"></i> <strong>Logistics Notice:</strong> Inventory stock was already deducted upon sale confirmation. Generating a dispatch tracks transportation and will <strong>never deduct stock a second time</strong>.
                    </div>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="bg-light text-muted small">
                                <tr>
                                    <th>Material Item</th>
                                    <th class="text-center">Ordered</th>
                                    <th class="text-center">Dispatched So Far</th>
                                    <th class="text-center">Pending</th>
                                    <th style="width: 130px;" class="text-end">Dispatch Now</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% (s.items || []).forEach((it, i) => { %>
                                    <% const remaining = Math.max(0, it.quantity - (it.dispatchedQuantity || 0)); %>
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark"><%= it.materialName %></div>
                                            <small class="text-muted font-monospace"><%= it.sku %></small>
                                        </td>
                                        <td class="text-center"><%= it.quantity %> <%= it.unit %></td>
                                        <td class="text-center"><%= it.dispatchedQuantity || 0 %></td>
                                        <td class="text-center fw-bold text-primary"><%= remaining %></td>
                                        <td>
                                            <input type="number" step="1" min="0" max="<%= remaining %>" class="form-control form-control-sm text-end dispatch-qty-input" data-material-id="<%= it.material %>" value="<%= remaining %>" <%= remaining === 0 ? 'disabled' : '' %>>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label font-weight-semibold small">Transporter / Carrier Name</label>
                            <input type="text" name="transporterName" class="form-control" placeholder="e.g. VRL Logistics / Delhivery">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-semibold small">Vehicle Number</label>
                            <input type="text" name="vehicleNumber" class="form-control text-uppercase font-monospace" placeholder="e.g. MP-04-AB-1234">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-semibold small">Tracking / LR / Consignment No.</label>
                            <input type="text" name="trackingNumber" class="form-control font-monospace" placeholder="e.g. LR-987654321">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-semibold small">Expected Delivery Date</label>
                            <input type="date" name="expectedDeliveryDate" class="form-control">
                        </div>
                        <div class="col-12">
                            <label class="form-label font-weight-semibold small">Shipping / Delivery Address</label>
                            <input type="text" name="shippingAddress" class="form-control" value="<%= s.customerAddress || '' %>">
                        </div>
                        <div class="col-12">
                            <label class="form-label font-weight-semibold small">Dispatch Notes</label>
                            <input type="text" name="dispatchNotes" class="form-control" placeholder="Special handling, driver phone, gate pass number...">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning font-weight-bold text-dark px-4" id="saveDispatchBtn">
                        <i class="icofont-check-circled me-1"></i> Save Dispatch Consignment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Create Return -->
<div class="modal fade" id="createReturnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="createReturnForm" onsubmit="handleCreateReturn(event)">
                <input type="hidden" name="saleId" value="<%= s._id %>">
                <div class="modal-header bg-navy text-white" style="background-color: var(--admin-navy-primary);">
                    <h5 class="modal-title font-weight-bold text-white"><i class="icofont-recycle me-2 text-warning"></i> Initiate Material Return</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-warning py-2 px-3 small mb-3">
                        <i class="icofont-warning me-1"></i> Return requests must be inspected before stock restock. Good condition items return to sellable inventory; damaged or defective items are quarantined into non-sellable stock.
                    </div>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="bg-light text-muted small">
                                <tr>
                                    <th>Material Item</th>
                                    <th class="text-center">Sold Qty</th>
                                    <th class="text-center">Max Returnable</th>
                                    <th style="width: 120px;" class="text-end">Return Qty</th>
                                    <th style="width: 160px;" class="text-center">Condition</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% (s.items || []).forEach((it, i) => { %>
                                    <% const returnable = Math.max(0, it.quantity - (it.returnedQuantity || 0)); %>
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark"><%= it.materialName %></div>
                                            <small class="text-muted font-monospace"><%= it.sku %></small>
                                        </td>
                                        <td class="text-center"><%= it.quantity %> <%= it.unit %></td>
                                        <td class="text-center fw-bold text-primary"><%= returnable %></td>
                                        <td>
                                            <input type="number" step="1" min="0" max="<%= returnable %>" class="form-control form-control-sm text-end return-qty-input" data-material-id="<%= it.material %>" value="0" <%= returnable === 0 ? 'disabled' : '' %>>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm return-condition-input">
                                                <option value="GOOD">GOOD (Restock to sellable)</option>
                                                <option value="DAMAGED">DAMAGED (Quarantine)</option>
                                                <option value="DEFECTIVE">DEFECTIVE (Quarantine)</option>
                                                <option value="PENDING_INSPECTION" selected>PENDING INSPECTION</option>
                                            </select>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label font-weight-semibold small">Return Reason <span class="text-danger">*</span></label>
                            <input type="text" name="returnReason" class="form-control" placeholder="e.g. Customer site surplus, damaged during transit, incorrect model..." required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-semibold small">Financial Refund / Credit Treatment</label>
                            <select name="refundStatus" class="form-select">
                                <option value="NOT_APPLICABLE" selected>NOT APPLICABLE (No monetary refund)</option>
                                <option value="CREDIT_NOTE_ISSUED">CREDIT NOTE ISSUED</option>
                                <option value="REFUNDED">REFUNDED</option>
                                <option value="PENDING">PENDING REVIEW</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-semibold small">Refund / Credit Amount (₹)</label>
                            <input type="number" step="0.01" min="0" name="refundAmount" class="form-control" value="0.00">
                        </div>
                        <div class="col-12">
                            <label class="form-label font-weight-semibold small">Inspection Notes</label>
                            <input type="text" name="notes" class="form-control" placeholder="Warehouse inspection notes, serial numbers...">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger font-weight-bold px-4" id="saveReturnBtn">
                        <i class="icofont-check-circled me-1"></i> Submit Return Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const CSRF_TOKEN = '<%= csrfToken %>';

function showToast(msg, isError = false) {
    const t = document.getElementById('saleViewToast');
    const m = document.getElementById('saleViewToastMsg');
    t.className = `alert alert-${isError ? 'danger' : 'success'} alert-dismissible fade show mb-4`;
    m.textContent = msg;
    t.classList.remove('d-none');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

async function confirmSaleNow(id) {
    if (!confirm('Are you sure you want to CONFIRM this sale order?\n\nThis will atomically decrement live inventory stock and issue the tax invoice.')) return;
    try {
        const res = await fetch(`/api/admin/sales/${id}/confirm`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify({ _csrf: CSRF_TOKEN })
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.message || 'Sale confirmed successfully.');
            setTimeout(() => location.reload(), 700);
        } else {
            showToast(data.message || 'Error confirming sale.', true);
        }
    } catch (e) {
        showToast('Server communication error.', true);
    }
}

async function cancelSaleNow(id) {
    const reason = prompt('Please enter the cancellation reason:');
    if (reason === null) return;
    try {
        const res = await fetch(`/api/admin/sales/${id}/cancel`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify({ _csrf: CSRF_TOKEN, reason })
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.message || 'Sale cancelled.');
            setTimeout(() => location.reload(), 700);
        } else {
            showToast(data.message || 'Error cancelling sale.', true);
        }
    } catch (e) {
        showToast('Server communication error.', true);
    }
}

async function handleCreateDispatch(e) {
    e.preventDefault();
    const form = e.target;
    const saleId = form.saleId.value;

    const rows = form.querySelectorAll('tbody tr');
    const items = [];
    rows.forEach(r => {
        const input = r.querySelector('.dispatch-qty-input');
        if (input && !input.disabled) {
            const qty = Number(input.value);
            if (qty > 0) {
                items.push({
                    materialId: input.getAttribute('data-material-id'),
                    dispatchedQuantity: qty
                });
            }
        }
    });

    if (items.length === 0) {
        alert('Please specify at least one item with quantity greater than 0 to dispatch.');
        return;
    }

    const payload = {
        _csrf: CSRF_TOKEN,
        saleId,
        items,
        transporterName: form.transporterName.value.trim(),
        vehicleNumber: form.vehicleNumber.value.trim(),
        trackingNumber: form.trackingNumber.value.trim(),
        expectedDeliveryDate: form.expectedDeliveryDate.value || null,
        shippingAddress: form.shippingAddress.value.trim(),
        dispatchNotes: form.dispatchNotes.value.trim()
    };

    try {
        const res = await fetch('/api/admin/dispatch', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message || 'Dispatch consignment generated!');
            location.reload();
        } else {
            alert(data.message || 'Error creating dispatch.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}

async function handleCreateReturn(e) {
    e.preventDefault();
    const form = e.target;
    const saleId = form.saleId.value;

    const rows = form.querySelectorAll('tbody tr');
    const items = [];
    rows.forEach(r => {
        const input = r.querySelector('.return-qty-input');
        const condSelect = r.querySelector('.return-condition-input');
        if (input && !input.disabled) {
            const qty = Number(input.value);
            if (qty > 0) {
                items.push({
                    materialId: input.getAttribute('data-material-id'),
                    returnedQuantity: qty,
                    condition: condSelect ? condSelect.value : 'PENDING_INSPECTION'
                });
            }
        }
    });

    if (items.length === 0) {
        alert('Please specify at least one item with return quantity greater than 0.');
        return;
    }

    const payload = {
        _csrf: CSRF_TOKEN,
        saleId,
        items,
        returnReason: form.returnReason.value.trim(),
        refundStatus: form.refundStatus.value,
        refundAmount: Number(form.refundAmount.value) || 0,
        notes: form.notes.value.trim()
    };

    try {
        const res = await fetch('/api/admin/returns', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message || 'Return request recorded!');
            location.reload();
        } else {
            alert(data.message || 'Error recording return.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}
</script>

<%- include('partials/admin-footer') %>
