<%- include('partials/admin-head') %>

<%
    const po = (typeof purchase !== 'undefined' && purchase) ? purchase : {
        purchaseNumber: '—',
        status: 'DRAFT',
        supplier: {},
        items: [],
        createdBy: {}
    };
%>

<!-- Action Feedback Alert Banner -->
<div id="purchaseViewToast" class="alert alert-success alert-dismissible fade show d-none mb-4" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="purchaseViewToastMsg">Action completed.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('purchaseViewToast').classList.add('d-none')"></button>
</div>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <div class="mb-1">
            <a href="/admin/purchases" class="text-muted small text-decoration-none">
                <i class="icofont-rounded-left me-1"></i> Back to All Purchases
            </a>
        </div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="font-weight-bold mb-0" style="color: var(--admin-navy-primary); font-size: 24px;">
                Purchase Order: <span class="font-monospace text-primary"><%= po.purchaseNumber %></span>
            </h2>
            <% if (po.status === 'RECEIVED') { %>
                <span class="badge bg-success py-2 px-3"><i class="icofont-check-circled me-1"></i> INWARDED / RECEIVED</span>
            <% } else if (po.status === 'DRAFT') { %>
                <span class="badge bg-warning text-dark py-2 px-3"><i class="icofont-clock-time me-1"></i> DRAFT (PENDING INWARD)</span>
            <% } else if (po.status === 'ORDERED') { %>
                <span class="badge bg-info text-dark py-2 px-3"><i class="icofont-truck-alt me-1"></i> ORDERED</span>
            <% } else { %>
                <span class="badge bg-secondary py-2 px-3"><%= po.status %></span>
            <% } %>
        </div>
    </div>
    <div class="d-flex gap-2">
        <% if (po.status === 'DRAFT' || po.status === 'ORDERED') { %>
            <button class="btn btn-success font-weight-bold shadow-sm" onclick="confirmInwardNow('<%= po._id %>')" style="border-radius: 8px;">
                <i class="icofont-download me-1"></i> Confirm & Receive Stock
            </button>
            <button class="btn btn-outline-danger" onclick="cancelOrderNow('<%= po._id %>')" style="border-radius: 8px;">
                <i class="icofont-close me-1"></i> Cancel Order
            </button>
        <% } %>
        <button class="btn btn-outline-secondary" onclick="window.print()" style="border-radius: 8px;">
            <i class="icofont-print me-1"></i> Print / PDF
        </button>
    </div>
</div>

<% if (po.status === 'RECEIVED') { %>
    <div class="alert alert-success d-flex align-items-center mb-4 py-3 px-4 border-0 shadow-sm rounded-3">
        <i class="icofont-check-circled fs-3 me-3 text-success"></i>
        <div>
            <div class="fw-bold">Stock Inventory Inward Completed</div>
            <div class="small">
                This purchase was inwarded into inventory on <%= new Date(po.receivedAt || po.updatedAt).toLocaleString('en-IN') %>. Stock levels were atomically incremented and Weighted Average Cost (WAC) was updated.
            </div>
        </div>
    </div>
<% } %>

<!-- Two Info Cards: Supplier & PO Meta -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 15px;">
                    <i class="icofont-user-suited text-warning me-2"></i> Vendor / Supplier Information
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="h5 fw-bold text-dark mb-1"><%= po.supplier ? po.supplier.supplierName : 'Direct Supplier' %></div>
                <% if (po.supplier && po.supplier.gstin) { %>
                    <div class="text-muted small mb-2 font-monospace">GSTIN: <span class="text-dark fw-bold"><%= po.supplier.gstin %></span></div>
                <% } %>
                <hr class="my-2">
                <div class="row g-2 small">
                    <div class="col-6">
                        <span class="text-muted">Contact Person:</span>
                        <div class="fw-medium text-dark"><%= (po.supplier && po.supplier.contactPerson) || '—' %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Mobile / Phone:</span>
                        <div class="fw-medium text-dark"><%= (po.supplier && po.supplier.mobile) || '—' %></div>
                    </div>
                    <div class="col-12 mt-2">
                        <span class="text-muted">Address:</span>
                        <div class="fw-medium text-dark"><%= (po.supplier && po.supplier.address) || '—' %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 15px;">
                    <i class="icofont-bill-alt text-warning me-2"></i> Purchase Order Overview
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 small">
                    <div class="col-6">
                        <span class="text-muted">Vendor Invoice No:</span>
                        <div class="fw-bold text-dark fs-6"><%= po.supplierInvoiceNumber || '—' %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Vendor Invoice Date:</span>
                        <div class="fw-bold text-dark fs-6">
                            <%= po.supplierInvoiceDate ? new Date(po.supplierInvoiceDate).toLocaleDateString('en-IN') : '—' %>
                        </div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Payment Status:</span>
                        <div>
                            <span class="badge <%= po.paymentStatus === 'PAID' ? 'bg-success' : (po.paymentStatus === 'PARTIAL' ? 'bg-warning text-dark' : 'bg-danger') %>">
                                <%= po.paymentStatus || 'UNPAID' %>
                            </span>
                        </div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Created By:</span>
                        <div class="fw-medium text-dark">
                            <%= (po.createdBy && po.createdBy.name) || 'Executive Administration' %>
                        </div>
                    </div>
                    <div class="col-12">
                        <span class="text-muted">Reference / Memo Notes:</span>
                        <div class="fw-medium text-dark"><%= po.notes || 'No notes specified.' %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Line Items Table -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 16px;">
            <i class="icofont-listine-dots text-warning me-2"></i> Procured Line Items
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase font-weight-bold">
                    <tr>
                        <th class="ps-4 py-3" style="width: 50px;">#</th>
                        <th class="py-3">Material Name & SKU</th>
                        <th class="py-3 text-center">Unit</th>
                        <th class="py-3 text-end">Quantity</th>
                        <th class="py-3 text-end">Purchase Price (₹)</th>
                        <th class="py-3 text-end">Tax Rate</th>
                        <th class="py-3 text-end">Tax Amount (₹)</th>
                        <th class="py-3 text-end">Landed Charge (₹)</th>
                        <th class="pe-4 py-3 text-end">Total Landed (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (po.items && po.items.length > 0) { %>
                        <% po.items.forEach((item, idx) => { %>
                            <tr>
                                <td class="ps-4 text-muted"><%= idx + 1 %></td>
                                <td>
                                    <div class="fw-bold text-dark">
                                        <%= item.material ? item.material.name : 'Material' %>
                                    </div>
                                    <div class="font-monospace text-muted small" style="font-size: 11px;">
                                        SKU: <%= item.material ? item.material.sku : '—' %>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border"><%= (item.material && item.material.unitOfMeasurement) || 'NOS' %></span>
                                </td>
                                <td class="text-end fw-bold text-dark">
                                    <%= Number(item.quantity || 0).toLocaleString('en-IN') %>
                                </td>
                                <td class="text-end text-dark">
                                    ₹<%= Number(item.unitPurchasePrice || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td class="text-end text-muted small">
                                    <%= item.taxRate || 0 %>%
                                </td>
                                <td class="text-end text-muted">
                                    ₹<%= Number(item.taxAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td class="text-end text-primary small">
                                    ₹<%= Number(item.allocatedAdditionalCharge || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td class="pe-4 text-end fw-bold text-dark">
                                    ₹<%= Number(item.totalPrice || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Financial Summary -->
<div class="row justify-content-end mb-5">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <table class="table table-sm table-borderless align-middle mb-0">
                    <tr>
                        <td class="text-muted">Subtotal (Materials):</td>
                        <td class="text-end fw-semibold">₹<%= Number(po.subtotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Tax / GST Total:</td>
                        <td class="text-end fw-semibold">₹<%= Number(po.taxTotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Additional Charges (Freight/Unloading):</td>
                        <td class="text-end text-primary fw-semibold">+₹<%= Number(po.additionalCharges || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    </tr>
                    <% if (po.discount > 0) { %>
                        <tr>
                            <td class="text-muted">Discount:</td>
                            <td class="text-end text-danger fw-semibold">-₹<%= Number(po.discount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                        </tr>
                    <% } %>
                    <tr class="border-top">
                        <td class="pt-3 h5 font-weight-bold text-dark">Total Landed Amount:</td>
                        <td class="pt-3 text-end h4 font-weight-bold" style="color: var(--admin-navy-primary);">
                            ₹<%= Number(po.totalAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
const CSRF_TOKEN = '<%= csrfToken %>';

function showToast(msg, isError = false) {
    const t = document.getElementById('purchaseViewToast');
    const m = document.getElementById('purchaseViewToastMsg');
    t.className = `alert alert-${isError ? 'danger' : 'success'} alert-dismissible fade show mb-4`;
    m.textContent = msg;
    t.classList.remove('d-none');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

async function confirmInwardNow(id) {
    if (!confirm('Are you sure you want to RECEIVE and INWARD this purchase order?\n\nThis will atomically increment stock levels in your inventory and recalculate Weighted Average Cost (WAC).')) {
        return;
    }

    try {
        const res = await fetch(`/api/admin/purchases/${id}/confirm`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN
            },
            body: JSON.stringify({ _csrf: CSRF_TOKEN })
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.message || 'Stock successfully inwarded!');
            setTimeout(() => location.reload(), 700);
        } else {
            showToast(data.message || 'Error receiving purchase.', true);
        }
    } catch (err) {
        showToast('Server communication error.', true);
    }
}

async function cancelOrderNow(id) {
    if (!confirm('Are you sure you want to CANCEL this purchase order?')) {
        return;
    }

    try {
        const res = await fetch(`/api/admin/purchases/${id}/cancel`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN
            },
            body: JSON.stringify({ _csrf: CSRF_TOKEN })
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.message || 'Purchase order cancelled.');
            setTimeout(() => location.reload(), 700);
        } else {
            showToast(data.message || 'Error cancelling purchase.', true);
        }
    } catch (err) {
        showToast('Server communication error.', true);
    }
}
</script>

<%- include('partials/admin-footer') %>
