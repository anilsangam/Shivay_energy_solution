<%- include('partials/admin-head') %>

<%
    const d = (typeof dispatch !== 'undefined' && dispatch) ? dispatch : {
        dispatchNumber: '—',
        status: 'READY_FOR_DISPATCH',
        items: [],
        statusHistory: [],
        sale: {},
        createdBy: {}
    };
%>

<!-- Action Feedback Alert Banner -->
<div id="dispatchViewToast" class="alert alert-success alert-dismissible fade show d-none mb-4" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="dispatchViewToastMsg">Action completed.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('dispatchViewToast').classList.add('d-none')"></button>
</div>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <div class="mb-1">
            <a href="/admin/dispatch" class="text-muted small text-decoration-none">
                <i class="icofont-rounded-left me-1"></i> Back to Dispatches List
            </a>
        </div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="font-weight-bold mb-0" style="color: var(--admin-navy-primary); font-size: 24px;">
                Dispatch Manifest: <span class="font-monospace text-primary"><%= d.dispatchNumber %></span>
            </h2>
            <% if (d.status === 'DELIVERED') { %>
                <span class="badge bg-success py-2 px-3"><i class="icofont-check me-1"></i> DELIVERED</span>
            <% } else if (d.status === 'SHIPPED') { %>
                <span class="badge bg-primary py-2 px-3"><i class="icofont-truck me-1"></i> SHIPPED (IN TRANSIT)</span>
            <% } else if (d.status === 'READY_FOR_DISPATCH') { %>
                <span class="badge bg-warning text-dark py-2 px-3"><i class="icofont-clock-time me-1"></i> READY FOR DISPATCH</span>
            <% } else { %>
                <span class="badge bg-secondary py-2 px-3"><%= d.status %></span>
            <% } %>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-warning font-weight-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#updateStatusModal" style="border-radius: 8px;">
            <i class="icofont-edit me-1"></i> Update Logistics Status
        </button>
        <a href="/admin/sales-out/<%= d.sale && d.sale._id ? d.sale._id : d.sale %>" class="btn btn-outline-secondary" style="border-radius: 8px;">
            <i class="icofont-truck-loaded me-1"></i> View Parent Sale Order
        </a>
    </div>
</div>

<div class="alert alert-info py-2 px-3 small mb-4 border-0 shadow-sm rounded-3">
    <i class="icofont-info-circle me-1"></i> <strong>Logistics Workflow:</strong> Stock deduction occurred at sale confirmation. Updating dispatch logistics tracking tracks consignment stages and <strong>never deducts stock twice</strong>.
</div>

<!-- Two Info Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 15px;">
                    <i class="icofont-truck-alt text-warning me-2"></i> Transporter & Tracking Logistics
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 small">
                    <div class="col-6">
                        <span class="text-muted">Transporter Name:</span>
                        <div class="fw-bold text-dark fs-6"><%= d.transporterName || 'Direct Delivery' %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Vehicle Registration:</span>
                        <div class="fw-bold font-monospace text-dark fs-6"><%= d.vehicleNumber || '—' %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Tracking / LR / e-Way No:</span>
                        <div class="fw-bold font-monospace text-primary fs-6"><%= d.trackingNumber || '—' %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Expected Delivery Date:</span>
                        <div class="fw-medium text-dark"><%= d.expectedDeliveryDate ? new Date(d.expectedDeliveryDate).toLocaleDateString('en-IN') : '—' %></div>
                    </div>
                    <div class="col-12">
                        <span class="text-muted">Delivery Address:</span>
                        <div class="fw-medium text-dark"><%= d.shippingAddress || '—' %></div>
                    </div>
                    <% if (d.deliveredAt) { %>
                        <div class="col-6">
                            <span class="text-muted">Delivered On:</span>
                            <div class="fw-bold text-success"><%= new Date(d.deliveredAt).toLocaleString('en-IN') %></div>
                        </div>
                        <div class="col-6">
                            <span class="text-muted">Received By:</span>
                            <div class="fw-bold text-dark"><%= d.receivedBy || 'Customer Site Staff' %></div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 15px;">
                    <i class="icofont-bill-alt text-warning me-2"></i> Associated Sale Order
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 small">
                    <div class="col-6">
                        <span class="text-muted">Sale Order #:</span>
                        <div class="fw-bold font-monospace text-primary fs-6">
                            <a href="/admin/sales-out/<%= d.sale && d.sale._id ? d.sale._id : d.sale %>" class="text-decoration-none">
                                <%= d.saleNumber %>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Customer Name:</span>
                        <div class="fw-bold text-dark fs-6"><%= d.customerName || (d.sale && d.sale.customerName) || 'Customer' %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Contact Person / Phone:</span>
                        <div class="fw-medium text-dark"><%= d.contactPerson || '—' %> <%= d.contactPhone ? `(${d.contactPhone})` : '' %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Dispatch Created By:</span>
                        <div class="fw-medium text-dark"><%= (d.createdBy && d.createdBy.name) || 'Executive Admin' %></div>
                    </div>
                    <div class="col-12">
                        <span class="text-muted">Dispatch Memo / Special Notes:</span>
                        <div class="fw-medium text-dark"><%= d.dispatchNotes || 'No special notes.' %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dispatched Line Items Table -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 16px;">
            <i class="icofont-box text-warning me-2"></i> Materials in this Dispatch Consignment
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase font-weight-bold">
                    <tr>
                        <th class="ps-4 py-3" style="width: 50px;">#</th>
                        <th class="py-3">Material Name & SKU</th>
                        <th class="py-3 text-center">Unit</th>
                        <th class="py-3 text-end">Ordered in Sale</th>
                        <th class="pe-4 py-3 text-end">Dispatched in this Consignment</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (d.items && d.items.length > 0) { %>
                        <% d.items.forEach((item, idx) => { %>
                            <tr>
                                <td class="ps-4 text-muted"><%= idx + 1 %></td>
                                <td>
                                    <div class="fw-bold text-dark"><%= item.materialName %></div>
                                    <div class="font-monospace text-muted small" style="font-size: 11px;">SKU: <%= item.sku %></div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border"><%= item.unit || 'Piece' %></span>
                                </td>
                                <td class="text-end text-muted">
                                    <%= Number(item.orderedQuantity || 0).toLocaleString('en-IN') %>
                                </td>
                                <td class="pe-4 text-end fw-bold text-primary fs-6">
                                    <%= Number(item.dispatchedQuantity || 0).toLocaleString('en-IN') %> <%= item.unit || 'Piece' %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Status Timeline / History -->
<div class="card border-0 shadow-sm rounded-3 mb-5">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 16px;">
            <i class="icofont-history text-warning me-2"></i> Logistics Status Transition History
        </h5>
    </div>
    <div class="card-body p-4">
        <% if (d.statusHistory && d.statusHistory.length > 0) { %>
            <ul class="list-unstyled mb-0">
                <% d.statusHistory.forEach((h, idx) => { %>
                    <li class="d-flex align-items-start gap-3 mb-3">
                        <div class="badge bg-dark rounded-circle p-2 mt-1">
                            <i class="icofont-check" style="font-size: 12px;"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark"><%= h.status %></div>
                            <small class="text-muted"><%= new Date(h.changedAt).toLocaleString('en-IN') %> by <%= (h.changedBy && h.changedBy.name) || 'Executive Admin' %></small>
                            <% if (h.notes) { %>
                                <div class="small text-secondary mt-1"><%= h.notes %></div>
                            <% } %>
                        </div>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p class="text-muted small mb-0">Initial consignment created.</p>
        <% } %>
    </div>
</div>

<!-- Modal: Update Dispatch Status -->
<div class="modal fade" id="updateStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="updateStatusForm" onsubmit="handleUpdateStatus(event)">
                <div class="modal-header bg-navy text-white" style="background-color: var(--admin-navy-primary);">
                    <h5 class="modal-title font-weight-bold text-white"><i class="icofont-edit me-2 text-warning"></i> Update Logistics Status</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold small">New Dispatch Status <span class="text-danger">*</span></label>
                        <select name="status" id="newStatusSelect" class="form-select" onchange="onStatusSelectChange(this)" required>
                            <option value="PACKING" <%= d.status === 'PACKING' ? 'selected' : '' %>>PACKING</option>
                            <option value="READY_FOR_DISPATCH" <%= d.status === 'READY_FOR_DISPATCH' ? 'selected' : '' %>>READY FOR DISPATCH</option>
                            <option value="SHIPPED" <%= d.status === 'SHIPPED' ? 'selected' : '' %>>SHIPPED (In Transit)</option>
                            <option value="PARTIALLY_DELIVERED" <%= d.status === 'PARTIALLY_DELIVERED' ? 'selected' : '' %>>PARTIALLY DELIVERED</option>
                            <option value="DELIVERED" <%= d.status === 'DELIVERED' ? 'selected' : '' %>>DELIVERED</option>
                            <option value="DELIVERY_FAILED" <%= d.status === 'DELIVERY_FAILED' ? 'selected' : '' %>>DELIVERY FAILED</option>
                        </select>
                    </div>
                    <div id="deliveredFields" class="<%= d.status === 'DELIVERED' ? '' : 'd-none' %>">
                        <div class="mb-3">
                            <label class="form-label font-weight-semibold small">Received By / Site Contact</label>
                            <input type="text" name="receivedBy" class="form-control" placeholder="e.g. Site Supervisor / Security">
                        </div>
                        <div class="mb-3">
                            <label class="form-label font-weight-semibold small">Delivery Confirmation Notes</label>
                            <input type="text" name="deliveryNotes" class="form-control" placeholder="e.g. Unloaded successfully at warehouse site">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold small">Status Transition Remarks</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Driver reached checkpoint, dispatched from hub..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning font-weight-bold text-dark px-4" id="saveStatusBtn">
                        <i class="icofont-check-circled me-1"></i> Update Status
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const CSRF_TOKEN = '<%= csrfToken %>';
const DISPATCH_ID = '<%= d._id %>';

function onStatusSelectChange(sel) {
    const deliveredFields = document.getElementById('deliveredFields');
    if (sel.value === 'DELIVERED') {
        deliveredFields.classList.remove('d-none');
    } else {
        deliveredFields.classList.add('d-none');
    }
}

async function handleUpdateStatus(e) {
    e.preventDefault();
    const form = e.target;
    const payload = {
        _csrf: CSRF_TOKEN,
        status: form.status.value,
        notes: form.notes.value.trim(),
        receivedBy: form.receivedBy ? form.receivedBy.value.trim() : '',
        deliveryNotes: form.deliveryNotes ? form.deliveryNotes.value.trim() : ''
    };

    try {
        const res = await fetch(`/api/admin/dispatch/${DISPATCH_ID}/status`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message || 'Status updated successfully.');
            location.reload();
        } else {
            alert(data.message || 'Error updating status.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}
</script>

<%- include('partials/admin-footer') %>
