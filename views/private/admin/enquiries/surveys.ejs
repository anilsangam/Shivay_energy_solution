<%- include('../partials/admin-head') %>

<!-- Action Feedback Alert Banner -->
<div id="actionToast" class="alert alert-success alert-dismissible fade show d-none mb-4" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="actionToastMsg">Operation completed successfully.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('actionToast').classList.add('d-none')"></button>
</div>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            <i class="icofont-sun-alt me-2 text-warning"></i> Free Solar Site Survey Leads
        </h2>
        <p class="text-muted small mb-0">
            Incoming rooftop inspection and PM Surya Ghar Muft Bijli Yojana subsidy requests submitted via website.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/admin/enquiries/franchise" class="btn btn-outline-primary" style="border-radius: 8px;">
            <i class="icofont-handshake-deal me-1"></i> Franchise Leads
        </a>
    </div>
</div>

<!-- Stats Counter Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small text-uppercase font-weight-bold">Total Surveys</span>
            <div class="h3 font-weight-bold mb-0 text-dark mt-1"><%= counts.total %></div>
            <div class="small text-muted mt-1">All website requests</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small text-uppercase font-weight-bold">New Leads</span>
            <div class="h3 font-weight-bold mb-0 text-warning mt-1"><%= counts.new %></div>
            <div class="small text-muted mt-1">Needs verification</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small text-uppercase font-weight-bold">Survey Scheduled</span>
            <div class="h3 font-weight-bold mb-0 text-info mt-1"><%= counts.survey_scheduled %></div>
            <div class="small text-muted mt-1">Engineer assigned</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small text-uppercase font-weight-bold">Converted</span>
            <div class="h3 font-weight-bold mb-0 text-success mt-1"><%= counts.converted %></div>
            <div class="small text-muted mt-1">Moved to quotation</div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="admin-filter-card mb-4 shadow-sm">
    <form method="GET" action="/admin/enquiries/surveys" class="row g-2 align-items-center m-0 w-100">
        <div class="col-md-5 p-0 pe-md-2">
            <div class="input-group admin-search-group">
                <span class="input-group-text bg-light border-end-0"><i class="icofont-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0" placeholder="Search by name, phone, district, ID..." value="<%= search %>">
            </div>
        </div>
        <div class="col-md-4 p-0 px-1">
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All Statuses (<%= counts.total %>)</option>
                <option value="new" <%= currentStatus === 'new' ? 'selected' : '' %>>New (<%= counts.new %>)</option>
                <option value="contacted" <%= currentStatus === 'contacted' ? 'selected' : '' %>>Contacted (<%= counts.contacted %>)</option>
                <option value="survey_scheduled" <%= currentStatus === 'survey_scheduled' ? 'selected' : '' %>>Survey Scheduled (<%= counts.survey_scheduled %>)</option>
                <option value="converted" <%= currentStatus === 'converted' ? 'selected' : '' %>>Converted (<%= counts.converted %>)</option>
                <option value="closed" <%= currentStatus === 'closed' ? 'selected' : '' %>>Closed / Cancelled (<%= counts.closed %>)</option>
            </select>
        </div>
        <div class="col-md-3 p-0 ps-1 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100 fw-bold" style="background: var(--admin-navy-primary);">Filter</button>
            <% if (search || currentStatus) { %>
                <a href="/admin/enquiries/surveys" class="btn btn-outline-secondary" title="Clear Filters"><i class="icofont-refresh"></i></a>
            <% } %>
        </div>
    </form>
</div>

<!-- Surveys Table -->
<div class="admin-card border shadow-sm p-0 overflow-hidden mb-5" style="border: 1px solid var(--admin-border, #cbd5e1) !important; border-radius: 12px;">
    <div class="admin-card-header bg-white p-3 border-bottom d-flex align-items-center justify-content-between mb-0">
        <div>
            <h5 class="admin-card-title mb-0">Site Survey Bookings (<%= counts.total %>)</h5>
            <div class="admin-card-subtitle small text-muted">Rooftop feasibility inspection requests & consumer contacts</div>
        </div>
        <span class="badge bg-light text-dark border">Consumer Leads</span>
    </div>
    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th class="ps-3 py-3">Enquiry ID / Date</th>
                    <th>Customer Details</th>
                    <th>Location</th>
                    <th>Requirement & Bill</th>
                    <th>Status</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (surveys && surveys.length > 0) { %>
                    <% surveys.forEach(s => { %>
                        <tr id="survey-row-<%= s._id || s.enquiryId %>">
                            <td class="ps-3">
                                <div class="font-monospace fw-bold text-dark"><%= s.enquiryId %></div>
                                <small class="text-muted">
                                    <%= s.createdAt ? new Date(s.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Recent' %>
                                </small>
                            </td>

                            <td>
                                <div class="fw-bold text-dark"><%= s.name %></div>
                                <div class="small text-muted">
                                    <i class="icofont-phone me-1"></i>+91 <%= s.mobile %>
                                </div>
                                <% if (s.email) { %>
                                    <div class="small text-muted text-truncate" style="max-width: 180px;"><%= s.email %></div>
                                <% } %>
                            </td>

                            <td>
                                <div class="fw-bold small text-dark"><%= s.district || 'Raisen' %></div>
                                <small class="text-muted"><%= s.state || 'Madhya Pradesh' %> <%= s.pincode ? `(${s.pincode})` : '' %></small>
                            </td>

                            <td>
                                <div class="small fw-bold text-primary"><%= s.solarRequirement || 'Residential Rooftop' %></div>
                                <% if (s.monthlyBill) { %>
                                    <small class="text-muted">Bill: ₹<%= Number(s.monthlyBill).toLocaleString('en-IN') %>/mo</small>
                                <% } %>
                            </td>

                            <td>
                                <% 
                                    let badgeClass = 'bg-secondary';
                                    if (s.status === 'new') badgeClass = 'bg-warning text-dark';
                                    else if (s.status === 'contacted') badgeClass = 'bg-info text-dark';
                                    else if (s.status === 'survey_scheduled') badgeClass = 'bg-primary';
                                    else if (s.status === 'converted') badgeClass = 'bg-success';
                                %>
                                <span class="badge <%= badgeClass %> text-uppercase" style="font-size: 11px;">
                                    <%= (s.status || 'new').replace('_', ' ') %>
                                </span>
                            </td>

                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1">
                                    <a href="tel:+91<%= s.mobile %>" class="btn btn-sm btn-outline-success" title="Direct Call">
                                        <i class="icofont-phone"></i>
                                    </a>
                                    <a href="https://wa.me/91<%= s.mobile %>?text=Namaste%20<%= encodeURIComponent(s.name) %>,%20thank%20you%20for%20contacting%20Shivay%20Energy%20Solutions%20regarding%20your%20Solar%20Site%20Survey%20request%20(<%= s.enquiryId %>)." 
                                       target="_blank" class="btn btn-sm btn-success" title="WhatsApp Chat">
                                        <i class="icofont-brand-whatsapp"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick='openStatusModal("<%= s._id || s.enquiryId %>", "<%= s.enquiryId %>", "<%= s.name.replace(/"/g, "&quot;") %>", "<%= s.status %>")' title="Update Status">
                                        <i class="icofont-edit"></i> Status
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick='deleteSurvey("<%= s._id || s.enquiryId %>", "<%= s.enquiryId %>")' title="Delete Lead">
                                        <i class="icofont-ui-delete"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="icofont-inbox fs-2 d-block mb-2 text-muted"></i>
                            No solar survey requests matching current filter.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
        <div class="p-3 px-4 border-top d-flex flex-wrap align-items-center justify-content-between bg-light gap-2">
            <small class="text-muted" style="font-size: 12px;">
                Showing <%= ((pagination.page - 1) * pagination.limit) + 1 %> to <%= Math.min(pagination.page * pagination.limit, pagination.total) %> of <%= pagination.total %> survey requests
            </small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <% if (pagination.hasPrevPage) { %>
                        <li class="page-item">
                            <a class="page-link" href="?page=<%= pagination.prevPage %>&status=<%= currentStatus || '' %>&search=<%= search || '' %>" style="font-size: 12px; padding: 4px 10px;">&laquo; Prev</a>
                        </li>
                    <% } %>
                    <% for(let p = 1; p <= pagination.totalPages; p++) { %>
                        <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
                            <a class="page-link" href="?page=<%= p %>&status=<%= currentStatus || '' %>&search=<%= search || '' %>" style="font-size: 12px; padding: 4px 10px;"><%= p %></a>
                        </li>
                    <% } %>
                    <% if (pagination.hasNextPage) { %>
                        <li class="page-item">
                            <a class="page-link" href="?page=<%= pagination.nextPage %>&status=<%= currentStatus || '' %>&search=<%= search || '' %>" style="font-size: 12px; padding: 4px 10px;">Next &raquo;</a>
                        </li>
                    <% } %>
                </ul>
            </nav>
        </div>
    <% } %>
</div>

<!-- Modal: Update Survey Status -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title font-weight-bold" id="statusModalTitle">Update Lead Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="statusForm" onsubmit="handleStatusSubmit(event)">
                <input type="hidden" id="statusSurveyId" value="">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold small">Current Status *</label>
                        <select id="modalStatusSelect" class="form-select" required>
                            <option value="new">New Lead</option>
                            <option value="contacted">Contacted / Discussion in Progress</option>
                            <option value="survey_scheduled">Solar Site Survey Scheduled</option>
                            <option value="quotation_sent">Quotation Sent</option>
                            <option value="converted">Converted to Project</option>
                            <option value="closed">Closed / Not Interested</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold small">Follow-Up Date (Optional)</label>
                        <input type="date" id="modalFollowUpDate" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold small">Inspection / Discussion Note</label>
                        <textarea id="modalNote" class="form-control" rows="3" placeholder="e.g. Visited rooftop in Arjun Nagar, 3kW shadow-free space confirmed, subsidy documents checked."></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top py-2 px-4 bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="saveStatusBtn" class="btn btn-warning font-weight-bold text-dark px-4">
                        Update Status
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let statusModalInstance = null;

document.addEventListener('DOMContentLoaded', function() {
    statusModalInstance = new bootstrap.Modal(document.getElementById('statusModal'));
});

function openStatusModal(id, enquiryId, name, currentStatus) {
    document.getElementById('statusSurveyId').value = id;
    document.getElementById('statusModalTitle').innerText = `Update: ${enquiryId} (${name})`;
    document.getElementById('modalStatusSelect').value = currentStatus || 'new';
    document.getElementById('modalNote').value = '';
    statusModalInstance.show();
}

async function handleStatusSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('saveStatusBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Updating...';

    const id = document.getElementById('statusSurveyId').value;
    const payload = {
        _csrf: '<%= csrfToken %>',
        status: document.getElementById('modalStatusSelect').value,
        followUpDate: document.getElementById('modalFollowUpDate').value,
        note: document.getElementById('modalNote').value
    };

    try {
        const res = await fetch(`/api/admin/enquiries/surveys/${id}/status`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            statusModalInstance.hide();
            window.location.reload();
        } else {
            alert(data.message || 'Error updating status.');
        }
    } catch (err) {
        alert('Server communication error.');
    } finally {
        btn.disabled = false;
        btn.innerText = 'Update Status';
    }
}

async function deleteSurvey(id, enquiryId) {
    if (!confirm(`Are you sure you want to delete lead "${enquiryId}"?`)) return;

    try {
        const res = await fetch(`/api/admin/enquiries/surveys/${id}/delete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ _csrf: '<%= csrfToken %>' })
        });
        const data = await res.json();
        if (data.success) {
            const row = document.getElementById(`survey-row-${id}`);
            if (row) row.remove();
            const toast = document.getElementById('actionToast');
            document.getElementById('actionToastMsg').innerText = 'Survey lead deleted successfully.';
            toast.classList.remove('d-none');
        } else {
            alert(data.message || 'Error deleting lead.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}
</script>

<%- include('../partials/admin-footer') %>
