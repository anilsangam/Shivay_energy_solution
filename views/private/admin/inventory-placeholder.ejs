<%- include('partials/admin-head') %>

<%
    const iconClass = (typeof icon !== 'undefined' && icon) ? icon : ((typeof module !== 'undefined' && module.icon) ? module.icon : 'icofont-box');
    const headingText = typeof pageHeading !== 'undefined' ? pageHeading : ((typeof module !== 'undefined' && module.title) ? module.title : (typeof title !== 'undefined' ? title : 'Module Scheduled for Phase 2'));
    const descText = (typeof description !== 'undefined' && description) ? description : ((typeof module !== 'undefined' && module.desc) ? module.desc : 'This business module is reserved for Phase 2 implementation. The underlying Material Master, Supplier Network, Purchase Inward, and Stock Ledger foundation (Phase 1) are active and ready.');
    const featuresList = (typeof plannedFeatures !== 'undefined' && plannedFeatures) ? plannedFeatures : ((typeof module !== 'undefined' && module.plannedFeatures) ? module.plannedFeatures : []);
%>

<div class="row justify-content-center my-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">
            <div class="mb-4">
                <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill font-monospace" style="font-size: 13px; letter-spacing: 0.5px;">
                    <i class="icofont-clock-time me-1"></i> PHASE 2 ENTERPRISE ROADMAP
                </span>
            </div>
            
            <div class="display-1 text-warning mb-3">
                <i class="<%= iconClass %>"></i>
            </div>

            <h2 class="font-weight-bold text-dark mb-3" style="color: var(--admin-navy-primary);">
                <%= headingText %>
            </h2>

            <p class="text-muted lead fs-6 mx-auto mb-4" style="max-width: 580px;">
                <%= descText %>
            </p>

            <div class="card bg-light border-0 rounded-3 p-4 text-start mb-4 mx-auto" style="max-width: 580px;">
                <h6 class="font-weight-bold text-dark mb-2">
                    <i class="icofont-check-circled text-success me-2"></i> Planned Capabilities in Phase 2:
                </h6>
                <ul class="text-muted small mb-0 ps-3">
                    <% featuresList.forEach(f => { %>
                        <li class="mb-1"><%= f %></li>
                    <% }) %>
                </ul>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a href="/admin/inventory" class="btn btn-primary px-4 py-2" style="border-radius: 8px;">
                    <i class="icofont-database me-1"></i> Go to Stock Inventory
                </a>
                <a href="/admin/purchases" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 8px;">
                    <i class="icofont-cart-alt me-1"></i> View Purchases & Stock In
                </a>
            </div>
        </div>
    </div>
</div>

<%- include('partials/admin-footer') %>
