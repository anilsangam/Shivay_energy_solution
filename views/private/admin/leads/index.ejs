<!-- MODAL 5: COMPLETE LEAD DETAIL DRAWER & CALL HISTORY -->
<!-- ========================================================================= -->
<div class="modal fade" id="leadDetailModal" tabindex="-1" aria-labelledby="leadDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background: var(--admin-navy-primary, #0f2a4a);">
                <h5 class="modal-title fs-6 fw-bold" id="leadDetailModalLabel">
                    <i class="icofont-file-text me-1"></i> Lead Overview & Timeline
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="leadDetailContent">
                <!-- Dynamically populated via AJAX -->
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Client-side Interactive Script -->
<script>
    let validatedImportRecords = [];

    function toggleAssignStrategy() {
        const strategy = document.getElementById('importAssignStrategy').value;
        const group = document.getElementById('specificTelecallerGroup');
        group.style.display = (strategy === 'SPECIFIC') ? 'block' : 'none';
    }

    function handleCallOutcomeChange() {
        const outcome = document.getElementById('callOutcomeSelect').value;
        const statusSelect = document.getElementById('callUpdatedStatusSelect');
        if (outcome === 'Connected') {
            statusSelect.value = 'Contacted';
        } else if (outcome === 'Call Back Requested') {
            statusSelect.value = 'Follow-up Required';
        } else if (outcome === 'Invalid Number') {
            statusSelect.value = 'Disqualified';
        }
    }

    function openCallModal(id, name, mobile, currentStatus) {
        document.getElementById('callLeadId').value = id;
        document.getElementById('callLeadName').textContent = name;
        document.getElementById('callLeadMobile').textContent = mobile;
        document.getElementById('callOutcomeSelect').value = '';
        document.getElementById('callUpdatedStatusSelect').value = currentStatus || '';
        document.getElementById('callNotesInput').value = '';
        document.getElementById('callFollowUpInput').value = '';
        new bootstrap.Modal(document.getElementById('logCallModal')).show();
    }

    function openReassignModal(id, name) {
        document.getElementById('reassignLeadId').value = id;
        document.getElementById('reassignLeadName').textContent = name;
        document.getElementById('reassignReasonInput').value = '';
        new bootstrap.Modal(document.getElementById('reassignModal')).show();
    }

    async function openDetailModal(id) {
        const modal = new bootstrap.Modal(document.getElementById('leadDetailModal'));
        modal.show();
        const container = document.getElementById('leadDetailContent');
        container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';

        try {
            const res = await fetch(`/admin/leads/${id}`);
            const data = await res.json();
            if (!data.success) {
                container.innerHTML = `<div class="alert alert-danger">${data.message || 'Error loading lead details'}</div>`;
                return;
            }

            const l = data.lead;
            let callHistoryHtml = '';
            if (l.callHistory && l.callHistory.length > 0) {
                callHistoryHtml = l.callHistory.slice().reverse().map(c => `
                    <div class="border-start border-3 border-success ps-3 py-2 mb-2 bg-light rounded">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-success">${c.callOutcome}</span>
                            <span class="small text-muted">${new Date(c.callDate).toLocaleString('en-IN')}</span>
                        </div>
                        <div class="mt-1 small"><strong>Caller:</strong> ${c.callerName || 'Staff'}</div>
                        <div class="small text-dark mt-1">${c.notes || 'No notes recorded.'}</div>
                        ${c.nextFollowUpDate ? `<div class="small text-warning mt-1"><i class="icofont-clock-time"></i> Next follow-up: ${new Date(c.nextFollowUpDate).toLocaleString('en-IN')}</div>` : ''}
                    </div>
                `).join('');
            } else {
                callHistoryHtml = '<div class="text-muted small py-2">No call records logged yet.</div>';
            }

            let assignmentHistoryHtml = '';
            if (l.assignmentHistory && l.assignmentHistory.length > 0) {
                assignmentHistoryHtml = l.assignmentHistory.slice().reverse().map(a => `
                    <div class="small py-1 border-bottom">
                        <strong>${new Date(a.assignedAt).toLocaleDateString('en-IN')}:</strong> Assigned to <em>${a.newOwnerName || 'Staff'}</em> by ${a.assignedByName || 'System'} (${a.reason || 'Assignment'})
                    </div>
                `).join('');
            } else {
                assignmentHistoryHtml = '<div class="text-muted small py-2">No assignment history.</div>';
            }

            container.innerHTML = `
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-1">${l.name}</h6>
                        <div class="text-muted small"><i class="icofont-id"></i> ID: <strong>${l.leadId}</strong></div>
                        <div class="text-primary small mt-1"><i class="icofont-phone"></i> ${l.mobile} ${l.alternateMobile ? `| Alt: ${l.alternateMobile}` : ''}</div>
                        ${l.email ? `<div class="text-muted small"><i class="icofont-email"></i> ${l.email}</div>` : ''}
                    </div>
                    <div class="col-md-6">
                        <div class="small"><strong>Location:</strong> ${l.address || ''} ${l.city}, ${l.district}, ${l.state} ${l.pincode ? `(${l.pincode})` : ''}</div>
                        <div class="small mt-1"><strong>Requirement:</strong> ${l.solarRequirement}</div>
                        <div class="small mt-1"><strong>Source:</strong> <span class="badge bg-light text-dark border">${l.leadSource}</span> | <strong>Priority:</strong> <span class="badge bg-info-subtle text-info border">${l.leadPriority}</span></div>
                    </div>
                </div>

                <ul class="nav nav-tabs mb-3" role="tablist">
                    <li class="nav-item"><button class="nav-link active fw-bold small" data-bs-toggle="tab" data-bs-target="#tabCalls">Call History (${(l.callHistory || []).length})</button></li>
                    <li class="nav-item"><button class="nav-link fw-bold small" data-bs-toggle="tab" data-bs-target="#tabAssignments">Assignment Trail</button></li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="tabCalls">${callHistoryHtml}</div>
                    <div class="tab-pane fade" id="tabAssignments">${assignmentHistoryHtml}</div>
                </div>
            `;
        } catch (err) {
            container.innerHTML = `<div class="alert alert-danger">Error: ${err.message}</div>`;
        }
    }

    // New Lead Form Submit
    document.getElementById('newLeadForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const bodyObj = Object.fromEntries(formData.entries());

        try {
            const res = await fetch('/api/admin/leads/create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                },
                body: JSON.stringify(bodyObj)
            });
            const data = await res.json();
            if (data.success) {
                alert(data.message);
                window.location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        } catch (err) {
            alert('Failed to save lead: ' + err.message);
        }
    });

    // Log Call Form Submit
    document.getElementById('logCallForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        const leadId = document.getElementById('callLeadId').value;
        const callOutcome = document.getElementById('callOutcomeSelect').value;
        const updatedLeadStatus = document.getElementById('callUpdatedStatusSelect').value;
        const nextFollowUpDate = document.getElementById('callFollowUpInput').value;
        const notes = document.getElementById('callNotesInput').value;

        try {
            const res = await fetch(`/api/admin/leads/${leadId}/call`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                },
                body: JSON.stringify({ callOutcome, updatedLeadStatus, nextFollowUpDate, notes })
            });
            const data = await res.json();
            if (data.success) {
                alert('Call logged successfully.');
                window.location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        } catch (err) {
            alert('Error recording call: ' + err.message);
        }
    });

    // Reassign Form Submit
    document.getElementById('reassignForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        const leadId = document.getElementById('reassignLeadId').value;
        const newOwnerId = document.getElementById('reassignOwnerSelect').value;
        const reason = document.getElementById('reassignReasonInput').value;

        try {
            const res = await fetch(`/api/admin/leads/${leadId}/reassign`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                },
                body: JSON.stringify({ newOwnerId, reason })
            });
            const data = await res.json();
            if (data.success) {
                alert('Lead reassigned successfully.');
                window.location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        } catch (err) {
            alert('Error reassigning lead: ' + err.message);
        }
    });

    // Convert Lead to Customer
    async function convertLead(leadId, name) {
        if (!confirm(`Convert "${name}" from prospective lead to full Customer account?`)) return;

        try {
            const res = await fetch(`/api/admin/leads/${leadId}/convert`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                }
            });
            const data = await res.json();
            if (data.success) {
                alert(data.message);
                window.location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        } catch (err) {
            alert('Error converting lead: ' + err.message);
        }
    }

    // Step 1: Parse and Preview Bulk Import
    async function parseAndPreviewImport() {
        const fileInput = document.getElementById('importFileInput');
        const pasteInput = document.getElementById('importPasteInput').value;
        const spinner = document.getElementById('importSpinner');
        const previewContainer = document.getElementById('importPreviewContainer');
        const confirmBtn = document.getElementById('btnConfirmImport');

        let payload = {};

        if (fileInput.files && fileInput.files[0]) {
            const file = fileInput.files[0];
            const reader = new FileReader();
            spinner.classList.remove('d-none');

            reader.onload = async function(e) {
                payload = {
                    fileData: e.target.result,
                    filename: file.name
                };
                await executePreviewRequest(payload);
            };
            reader.readAsDataURL(file);
        } else if (pasteInput && pasteInput.trim().length > 0) {
            spinner.classList.remove('d-none');
            payload = { rawText: pasteInput.trim() };
            await executePreviewRequest(payload);
        } else {
            alert('Please select a CSV/Excel file or paste tabular data.');
        }
    }

    async function executePreviewRequest(payload) {
        const spinner = document.getElementById('importSpinner');
        const previewContainer = document.getElementById('importPreviewContainer');
        const confirmBtn = document.getElementById('btnConfirmImport');

        try {
            const res = await fetch('/api/admin/leads/import-preview', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            spinner.classList.add('d-none');

            if (!data.success) {
                alert('Preview error: ' + data.message);
                return;
            }

            validatedImportRecords = data.validRows || [];
            document.getElementById('prevTotal').textContent = data.totalRecords;
            document.getElementById('prevValid').textContent = data.validCount;
            document.getElementById('prevDuplicates').textContent = data.duplicateCount;
            document.getElementById('prevInvalid').textContent = data.invalidCount;

            const tbody = document.getElementById('importPreviewTableBody');
            tbody.innerHTML = (data.previewRows || []).map(r => `
                <tr class="${r.isDuplicate ? 'table-danger' : (!r.isValid ? 'table-warning' : 'table-success')}">
                    <td>${r.index}</td>
                    <td><strong>${r.name}</strong></td>
                    <td class="font-monospace">${r.formattedMobile || r.mobile}</td>
                    <td>${r.city || 'Raisen'}</td>
                    <td>${r.solarRequirement}</td>
                    <td>
                        ${r.isValid ? '<span class="badge bg-success">Valid</span>' : `<span class="badge bg-danger">${r.validationError || 'Invalid'}</span>`}
                    </td>
                </tr>
            `).join('');

            previewContainer.style.display = 'block';

            if (validatedImportRecords.length > 0) {
                confirmBtn.classList.remove('d-none');
            } else {
                confirmBtn.classList.add('d-none');
            }
        } catch (err) {
            spinner.classList.add('d-none');
            alert('Error generating preview: ' + err.message);
        }
    }

    // Step 2: Confirm and Import Valid Leads
    async function executeImport() {
        if (!validatedImportRecords || validatedImportRecords.length === 0) {
            alert('No valid records to import.');
            return;
        }

        const branchId = document.getElementById('importBranchSelect').value;
        const strategy = document.getElementById('importAssignStrategy').value;
        let telecallerId = null;
        let autoDistribute = false;

        if (strategy === 'AUTO') {
            autoDistribute = true;
        } else if (strategy === 'SPECIFIC') {
            telecallerId = document.getElementById('importSpecificTelecaller').value;
        }

        const confirmBtn = document.getElementById('btnConfirmImport');
        confirmBtn.disabled = true;
        confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Importing...';

        try {
            const res = await fetch('/api/admin/leads/import-confirm', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                },
                body: JSON.stringify({
                    records: validatedImportRecords,
                    branchId,
                    telecallerId,
                    autoDistribute,
                    leadSource: 'BULK_IMPORT'
                })
            });
            const data = await res.json();
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = '<i class="icofont-check-circled me-1"></i> Confirm & Import Valid Leads';

            if (data.success) {
                alert(data.message);
                window.location.reload();
            } else {
                alert('Import error: ' + data.message);
            }
        } catch (err) {
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = '<i class="icofont-check-circled me-1"></i> Confirm & Import Valid Leads';
            alert('Failed to execute import: ' + err.message);
        }
    }
</script>

