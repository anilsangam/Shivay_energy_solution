<%- include('../partials/admin-head') %>

<!-- Leads & Telecalling Header Banner -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary, #0f2a4a); font-size: 23px;">
            <i class="icofont-headphone-alt text-warning me-1"></i> Lead Management & Telecalling Console
        </h2>
        <p class="text-muted small mb-0">
            Track solar prospects, execute telecaller outreach, schedule follow-ups, and convert leads into verified customer installations.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
        <% if (currentUser && (currentUser.isPrimarySuperAdmin || (currentUser.permissions && currentUser.permissions.includes('crm.leads.export')))) { %>
            <a href="/admin/leads/export?status=<%= filters.status %>&callStatus=<%= filters.callStatus %>&priority=<%= filters.priority %>&search=<%= encodeURIComponent(filters.search) %>" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm" style="border-radius: 8px; padding: 7px 14px;">
                <i class="icofont-download"></i> Export CSV
            </a>
        <% } %>
        <% if (currentUser && (currentUser.isPrimarySuperAdmin || (currentUser.permissions && currentUser.permissions.includes('crm.leads.import')))) { %>
            <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#importLeadsModal" style="border-radius: 8px; padding: 7px 14px;">
                <i class="icofont-upload-alt"></i> Bulk Import
            </button>
        <% } %>
        <% if (currentUser && (currentUser.isPrimarySuperAdmin || (currentUser.permissions && currentUser.permissions.includes('crm.leads.create')))) { %>
            <button class="btn btn-sm btn-primary fw-bold d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newLeadModal" style="background: var(--admin-navy-primary, #0f2a4a); border-radius: 8px; padding: 7px 14px;">
                <i class="icofont-plus-circle fs-6"></i> Add New Lead
            </button>
        <% } %>
    </div>
</div>

<!-- Telecalling Metric Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3 col-xl-1-5" style="flex: 1 1 120px;">
        <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 10px; background: #fff; border-left: 4px solid #3b82f6 !important;">
            <div class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Total Leads</div>
            <div class="fs-4 fw-bold text-dark mt-1"><%= stats.totalLeads %></div>
            <div class="small text-muted mt-1"><i class="icofont-address-book"></i> Active Pipeline</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-1-5" style="flex: 1 1 120px;">
        <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 10px; background: #fff; border-left: 4px solid #ef4444 !important;">
            <div class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Not Called</div>
            <div class="fs-4 fw-bold text-danger mt-1"><%= stats.notCalled %></div>
            <div class="small text-muted mt-1"><i class="icofont-phone"></i> Pending First Touch</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-1-5" style="flex: 1 1 120px;">
        <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 10px; background: #fff; border-left: 4px solid #f59e0b !important;">
            <div class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Follow-Up Due</div>
            <div class="fs-4 fw-bold text-warning mt-1"><%= stats.followUpDue %></div>
            <div class="small text-muted mt-1"><i class="icofont-clock-time"></i> Due Today / Overdue</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-1-5" style="flex: 1 1 120px;">
        <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 10px; background: #fff; border-left: 4px solid #10b981 !important;">
            <div class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Connected</div>
            <div class="fs-4 fw-bold text-success mt-1"><%= stats.connected %></div>
            <div class="small text-muted mt-1"><i class="icofont-ui-call"></i> Contacted Leads</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-1-5" style="flex: 1 1 120px;">
        <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 10px; background: #fff; border-left: 4px solid #8b5cf6 !important;">
            <div class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Qualified</div>
            <div class="fs-4 fw-bold text-primary mt-1"><%= stats.qualified %></div>
            <div class="small text-muted mt-1"><i class="icofont-check-circled"></i> Ready for Site Survey</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-1-5" style="flex: 1 1 120px;">
        <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 10px; background: #fff; border-left: 4px solid #059669 !important;">
            <div class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Converted</div>
            <div class="fs-4 fw-bold text-success mt-1"><%= stats.converted %></div>
            <div class="small text-muted mt-1"><i class="icofont-trophy"></i> Customer Projects</div>
        </div>
    </div>
</div>

<!-- Search & Multi-Filter Card -->
<div class="card border-0 shadow-sm mb-4 p-3" style="border-radius: 12px; background: #fff;">
    <form method="GET" action="/admin/leads" class="row g-2 align-items-center">
        <!-- Search -->
        <div class="col-12 col-md-3">
            <label class="form-label small text-muted mb-1">Search Leads</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0" style="border-radius: 8px 0 0 8px;"><i class="icofont-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0" placeholder="Name, mobile, city, or ID..." value="<%= filters.search %>" style="border-radius: 0 8px 8px 0; font-size: 13px;">
            </div>
        </div>

        <!-- Status Filter -->
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">Lead Status</label>
            <select name="status" class="form-select form-select-sm" style="border-radius: 8px; font-size: 13px; height: 38px;">
                <option value="ALL" <%= filters.status === 'ALL' || !filters.status ? 'selected' : '' %>>All Statuses</option>
                <option value="New" <%= filters.status === 'New' ? 'selected' : '' %>>New</option>
                <option value="Contacted" <%= filters.status === 'Contacted' ? 'selected' : '' %>>Contacted</option>
                <option value="Qualified" <%= filters.status === 'Qualified' ? 'selected' : '' %>>Qualified</option>
                <option value="Follow-up Required" <%= filters.status === 'Follow-up Required' ? 'selected' : '' %>>Follow-up Required</option>
                <option value="Not Interested" <%= filters.status === 'Not Interested' ? 'selected' : '' %>>Not Interested</option>
                <option value="Disqualified" <%= filters.status === 'Disqualified' ? 'selected' : '' %>>Disqualified</option>
                <option value="Converted" <%= filters.status === 'Converted' ? 'selected' : '' %>>Converted</option>
            </select>
        </div>

        <!-- Call Status Filter -->
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">Call Outreach</label>
            <select name="callStatus" class="form-select form-select-sm" style="border-radius: 8px; font-size: 13px; height: 38px;">
                <option value="ALL" <%= filters.callStatus === 'ALL' || !filters.callStatus ? 'selected' : '' %>>All Calls</option>
                <option value="Not Called" <%= filters.callStatus === 'Not Called' ? 'selected' : '' %>>Not Called</option>
                <option value="Called" <%= filters.callStatus === 'Called' ? 'selected' : '' %>>Called</option>
            </select>
        </div>

        <!-- Follow-Up Date Filter -->
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">Follow-Up Schedule</label>
            <select name="followUp" class="form-select form-select-sm" style="border-radius: 8px; font-size: 13px; height: 38px;">
                <option value="" <%= !filters.followUp ? 'selected' : '' %>>All Timelines</option>
                <option value="today" <%= filters.followUp === 'today' ? 'selected' : '' %>>Due Today</option>
                <option value="overdue" <%= filters.followUp === 'overdue' ? 'selected' : '' %>>Overdue</option>
                <option value="upcoming" <%= filters.followUp === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
                <option value="none" <%= filters.followUp === 'none' ? 'selected' : '' %>>No Follow-Up Set</option>
            </select>
        </div>

        <!-- Priority Filter -->
        <div class="col-6 col-md-1">
            <label class="form-label small text-muted mb-1">Priority</label>
            <select name="priority" class="form-select form-select-sm" style="border-radius: 8px; font-size: 13px; height: 38px;">
                <option value="ALL" <%= filters.priority === 'ALL' || !filters.priority ? 'selected' : '' %>>All</option>
                <option value="URGENT" <%= filters.priority === 'URGENT' ? 'selected' : '' %>>Urgent</option>
                <option value="HIGH" <%= filters.priority === 'HIGH' ? 'selected' : '' %>>High</option>
                <option value="MEDIUM" <%= filters.priority === 'MEDIUM' ? 'selected' : '' %>>Medium</option>
                <option value="LOW" <%= filters.priority === 'LOW' ? 'selected' : '' %>>Low</option>
            </select>
        </div>

        <!-- Action Buttons -->
        <div class="col-12 col-md-2 d-flex gap-2 align-items-end mt-2 mt-md-0">
            <button type="submit" class="btn btn-primary w-100 fw-bold d-flex align-items-center justify-content-center" style="height: 38px; border-radius: 8px; font-size: 13px; background: var(--admin-navy-primary, #0f2a4a);">
                <i class="icofont-filter me-1"></i> Filter
            </button>
            <a href="/admin/leads" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" title="Reset Filters" style="height: 38px; width: 44px; border-radius: 8px; flex-shrink: 0;">
                <i class="icofont-refresh"></i>
            </a>
        </div>
    </form>
</div>

<!-- Leads Data Table Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden; background: #fff;">
    <div class="card-header bg-white border-bottom py-3 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <h5 class="mb-0 fw-bold d-flex align-items-center gap-2" style="font-size: 15px; color: #0f2a4a;">
                <i class="icofont-list text-primary fs-5"></i>
                Lead Pipeline & Telecalling Queue
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace ms-1" style="font-size: 12px;">
                    <%= pagination.total %> Leads
                </span>
            </h5>
        </div>
        <div class="small text-muted font-monospace" style="font-size: 12px;">
            Showing Page <%= pagination.page %> of <%= pagination.totalPages || 1 %>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
            <thead class="table-light" style="font-size: 12px; text-transform: uppercase;">
                <tr>
                    <th style="width: 14%;">Lead ID & Date</th>
                    <th style="width: 20%;">Contact Info</th>
                    <th style="width: 15%;">Requirement</th>
                    <th style="width: 10%;">Priority</th>
                    <th style="width: 13%;">Lead Status</th>
                    <th style="width: 13%;">Call Outreach</th>
                    <th style="width: 15%;">Assigned To</th>
                    <th class="text-end" style="width: 10%;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (leads && leads.length > 0) { %>
                    <% leads.forEach(l => { %>
                        <tr>
                            <!-- Lead ID & Date -->
                            <td>
                                <div class="fw-bold text-dark font-monospace"><%= l.leadId %></div>
                                <div class="text-muted" style="font-size: 11px;">
                                    <%= new Date(l.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                </div>
                                <span class="badge bg-light text-secondary border font-monospace mt-1" style="font-size: 10px;">
                                    <%= l.leadSource %>
                                </span>
                            </td>

                            <!-- Contact Info -->
                            <td>
                                <div class="fw-bold text-dark"><%= l.name %></div>
                                <div class="d-flex align-items-center gap-1 mt-1">
                                    <a href="tel:<%= l.mobile %>" class="text-primary text-decoration-none fw-bold" style="font-size: 12px;">
                                        <i class="icofont-phone"></i> <%= l.mobile %>
                                    </a>
                                </div>
                                <% if (l.city || l.district) { %>
                                    <div class="text-muted small mt-1" style="font-size: 11px;">
                                        <i class="icofont-location-pin text-danger"></i> <%= l.city || l.district %>, <%= l.state || 'M.P.' %>
                                    </div>
                                <% } %>
                            </td>

                            <!-- Requirement -->
                            <td>
                                <div class="text-dark small"><%= l.solarRequirement %></div>
                                <% if (l.monthlyBill > 0) { %>
                                    <div class="text-muted font-monospace small mt-1">₹<%= l.monthlyBill.toLocaleString('en-IN') %>/mo bill</div>
                                <% } %>
                            </td>

                            <!-- Priority -->
                            <td>
                                <% if (l.leadPriority === 'URGENT') { %>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold">Urgent</span>
                                <% } else if (l.leadPriority === 'HIGH') { %>
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle fw-bold">High</span>
                                <% } else if (l.leadPriority === 'LOW') { %>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Low</span>
                                <% } else { %>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">Medium</span>
                                <% } %>
                            </td>

                            <!-- Lead Status -->
                            <td>
                                <% if (l.leadStatus === 'New') { %>
                                    <span class="badge bg-primary text-white">New</span>
                                <% } else if (l.leadStatus === 'Contacted') { %>
                                    <span class="badge bg-info text-dark">Contacted</span>
                                <% } else if (l.leadStatus === 'Qualified') { %>
                                    <span class="badge bg-success text-white">Qualified</span>
                                <% } else if (l.leadStatus === 'Follow-up Required') { %>
                                    <span class="badge bg-warning text-dark">Follow-Up</span>
                                <% } else if (l.leadStatus === 'Converted') { %>
                                    <span class="badge bg-success fw-bold text-white"><i class="icofont-check-circled me-1"></i> Converted</span>
                                <% } else if (l.leadStatus === 'Not Interested' || l.leadStatus === 'Disqualified') { %>
                                    <span class="badge bg-secondary text-white"><%= l.leadStatus %></span>
                                <% } %>

                                <% if (l.followUpDate) { %>
                                    <% 
                                        const now = new Date();
                                        const isPast = new Date(l.followUpDate) < now;
                                    %>
                                    <div class="mt-1 font-monospace <%= isPast ? 'text-danger fw-bold' : 'text-muted' %>" style="font-size: 11px;">
                                        <i class="icofont-clock-time"></i> <%= new Date(l.followUpDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %>
                                    </div>
                                <% } %>
                            </td>

                            <!-- Call Outreach -->
                            <td>
                                <% if (l.callStatus === 'Called') { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="icofont-check"></i> Called (<%= (l.callHistory || []).length %>)
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                        <i class="icofont-close"></i> Not Called
                                    </span>
                                <% } %>

                                <% if (l.callHistory && l.callHistory.length > 0) { %>
                                    <% const lastCall = l.callHistory[l.callHistory.length - 1]; %>
                                    <div class="text-muted mt-1 small" style="font-size: 11px;">
                                        Last: <span class="fw-bold"><%= lastCall.callOutcome %></span>
                                    </div>
                                <% } %>
                            </td>

                            <!-- Assigned Staff & Branch -->
                            <td>
                                <% if (l.assignedTelecaller) { %>
                                    <div class="fw-bold text-dark"><%= l.assignedTelecaller.name %></div>
                                    <div class="text-muted small" style="font-size: 11px;"><%= l.assignedTelecaller.designation || 'Telecaller' %></div>
                                <% } else { %>
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Unassigned</span>
                                <% } %>

                                <% if (l.branch) { %>
                                    <div class="text-muted mt-1" style="font-size: 11px;">
                                        <i class="icofont-building"></i> <%= l.branch.name %>
                                    </div>
                                <% } %>
                            </td>

                            <!-- Action Buttons -->
                            <td class="text-end text-nowrap">
                                <!-- Log Call Outcome -->
                                <button class="btn btn-sm btn-outline-success py-1 px-2" onclick="openCallModal('<%= l._id %>', '<%= l.name %>', '<%= l.mobile %>', '<%= l.leadStatus %>')" title="Log Call Outcome">
                                    <i class="icofont-ui-call"></i> Log Call
                                </button>

                                <!-- View Full Detail / Timeline Drawer -->
                                <button class="btn btn-sm btn-outline-primary py-1 px-2 ms-1" onclick="openDetailModal('<%= l._id %>')" title="View Lead Timeline & Notes">
                                    <i class="icofont-eye"></i>
                                </button>

                                <!-- Dropdown More Actions -->
                                <div class="dropdown d-inline-block ms-1">
                                    <button class="btn btn-sm btn-light border py-1 px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="icofont-navigation-menu"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size: 13px;">
                                        <li>
                                            <a class="dropdown-item" href="javascript:void(0)" onclick="openCallModal('<%= l._id %>', '<%= l.name %>', '<%= l.mobile %>', '<%= l.leadStatus %>')">
                                                <i class="icofont-phone text-success me-2"></i> Record Call
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="javascript:void(0)" onclick="openReassignModal('<%= l._id %>', '<%= l.name %>')">
                                                <i class="icofont-exchange text-info me-2"></i> Reassign Lead
                                            </a>
                                        </li>
                                        <% if (l.leadStatus !== 'Converted') { %>
                                            <li>
                                                <a class="dropdown-item text-primary" href="javascript:void(0)" onclick="convertLead('<%= l._id %>', '<%= l.name %>')">
                                                    <i class="icofont-check-circled text-primary me-2"></i> Convert to Customer
                                                </a>
                                            </li>
                                        <% } %>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" href="javascript:void(0)" onclick="openDetailModal('<%= l._id %>')">
                                                <i class="icofont-file-text text-secondary me-2"></i> Full Activity History
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="icofont-inbox fs-1 text-secondary d-block mb-2"></i>
                            No lead records match your search and filter criteria.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <% if (pagination.totalPages > 1) { %>
        <div class="card-footer bg-white border-top py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="small text-muted">
                Showing <%= ((pagination.page - 1) * pagination.limit) + 1 %> to <%= Math.min(pagination.page * pagination.limit, pagination.total) %> of <%= pagination.total %> leads
            </div>
            <nav aria-label="Lead pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="/admin/leads?page=<%= pagination.page - 1 %>&search=<%= filters.search %>&status=<%= filters.status %>&callStatus=<%= filters.callStatus %>&priority=<%= filters.priority %>&followUp=<%= filters.followUp %>">Previous</a>
                    </li>
                    <% for (let p = Math.max(1, pagination.page - 2); p <= Math.min(pagination.totalPages, pagination.page + 2); p++) { %>
                        <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
                            <a class="page-link" href="/admin/leads?page=<%= p %>&search=<%= filters.search %>&status=<%= filters.status %>&callStatus=<%= filters.callStatus %>&priority=<%= filters.priority %>&followUp=<%= filters.followUp %>"><%= p %></a>
                        </li>
                    <% } %>
                    <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="/admin/leads?page=<%= pagination.page + 1 %>&search=<%= filters.search %>&status=<%= filters.status %>&callStatus=<%= filters.callStatus %>&priority=<%= filters.priority %>&followUp=<%= filters.followUp %>">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    <% } %>
</div>

<!-- ========================================================================= -->
<!-- MODAL 1: ADD NEW LEAD (MANUAL) -->
<!-- ========================================================================= -->
<div class="modal fade" id="newLeadModal" tabindex="-1" aria-labelledby="newLeadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background: var(--admin-navy-primary, #0f2a4a);">
                <h5 class="modal-title fs-6 fw-bold" id="newLeadModalLabel">
                    <i class="icofont-plus-circle me-1"></i> Register New Solar Lead
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="newLeadForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Customer / Contact Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" placeholder="e.g. Ramesh Kumar" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Primary Mobile Number <span class="text-danger">*</span></label>
                            <input type="tel" name="mobile" class="form-control" placeholder="10-digit mobile number" required pattern="[6-9][0-9]{9}">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Alternate Mobile</label>
                            <input type="tel" name="alternateMobile" class="form-control" placeholder="Optional secondary number">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Email Address</label>
                            <input type="email" name="email" class="form-control" placeholder="client@example.com">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Address / Location</label>
                            <input type="text" name="address" class="form-control" placeholder="House/Shop no, street, landmark">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">City / Town</label>
                            <input type="text" name="city" class="form-control" value="Raisen">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">District</label>
                            <input type="text" name="district" class="form-control" value="Raisen">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">PIN Code</label>
                            <input type="text" name="pincode" class="form-control" placeholder="e.g. 464551">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Solar Requirement</label>
                            <select name="solarRequirement" class="form-select">
                                <option value="Residential Rooftop (PM Surya Ghar)">Residential Rooftop (PM Surya Ghar)</option>
                                <option value="Commercial Rooftop (5kW - 50kW)">Commercial Rooftop (5kW - 50kW)</option>
                                <option value="Industrial Solar Plant (50kW+)">Industrial Solar Plant (50kW+)</option>
                                <option value="Solar Water Pump (PM KUSUM)">Solar Water Pump (PM KUSUM)</option>
                                <option value="Off-Grid / Hybrid Battery System">Off-Grid / Hybrid Battery System</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Avg Monthly Electricity Bill (₹)</label>
                            <input type="number" name="monthlyBill" class="form-control" placeholder="e.g. 2500" min="0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Lead Source</label>
                            <select name="leadSource" class="form-select">
                                <option value="MANUAL">Manual Entry</option>
                                <option value="COLD_CALL">Cold Calling List</option>
                                <option value="REFERRAL">Customer Referral</option>
                                <option value="CAMPAIGN">Field Campaign</option>
                                <option value="WALK_IN">Branch Walk-In</option>
                                <option value="WEBSITE">Website Form</option>
                                <option value="OTHER">Other</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Priority</label>
                            <select name="leadPriority" class="form-select">
                                <option value="MEDIUM" selected>Medium</option>
                                <option value="HIGH">High</option>
                                <option value="URGENT">Urgent</option>
                                <option value="LOW">Low</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Assign Telecaller</label>
                            <select name="assignedTelecallerId" class="form-select">
                                <option value="">-- Leave Unassigned --</option>
                                <% telecallers.forEach(t => { %>
                                    <option value="<%= t._id %>"><%= t.name %> (<%= t.designation || t.role %>)</option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Initial Notes / Comments</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="Record customer requirements or call instructions..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold" style="background: var(--admin-navy-primary, #0f2a4a);">Save Lead</button>
                </div>
            </form>
        </div>
    </div>
</div>

