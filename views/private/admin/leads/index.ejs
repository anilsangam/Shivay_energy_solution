<!-- MODAL 2: BULK IMPORT LEADS (CSV / EXCEL / COPY-PASTE) -->
<!-- ========================================================================= -->
<div class="modal fade" id="importLeadsModal" tabindex="-1" aria-labelledby="importLeadsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background: var(--admin-navy-primary, #0f2a4a);">
                <h5 class="modal-title fs-6 fw-bold" id="importLeadsModalLabel">
                    <i class="icofont-upload-alt me-1"></i> Bulk Lead Import Console
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Nav Tabs for Import Modes -->
                <ul class="nav nav-tabs mb-3" id="importTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold" id="file-tab" data-bs-toggle="tab" data-bs-target="#fileImportPane" type="button" role="tab">
                            <i class="icofont-file-excel text-success me-1"></i> Upload File (CSV / Excel)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold" id="paste-tab" data-bs-toggle="tab" data-bs-target="#pasteImportPane" type="button" role="tab">
                            <i class="icofont-ui-copy text-primary me-1"></i> Copy-Paste Tabular Data
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="importTabContent">
                    <!-- File Upload Tab -->
                    <div class="tab-pane fade show active" id="fileImportPane" role="tabpanel">
                        <div class="border rounded p-3 mb-3 bg-light">
                            <label class="form-label fw-bold small">Select CSV or Excel Workbook (.xlsx, .xls, .csv)</label>
                            <input type="file" id="importFileInput" class="form-control" accept=".csv, .xlsx, .xls">
                            <div class="text-muted small mt-1">
                                Supported columns: <strong>Name, Mobile, Alternate Mobile, Email, City, Address, Requirement, Monthly Bill, Priority</strong>. Maximum file size: 5 MB.
                            </div>
                        </div>
                    </div>

                    <!-- Copy-Paste Tab -->
                    <div class="tab-pane fade" id="pasteImportPane" role="tabpanel">
                        <div class="border rounded p-3 mb-3 bg-light">
                            <label class="form-label fw-bold small">Paste Tab-Separated or Comma-Separated Data (including header row)</label>
                            <textarea id="importPasteInput" class="form-control font-monospace" rows="5" placeholder="Name&#9;Mobile&#9;City&#9;Requirement
Ramesh Kumar&#9;9876543210&#9;Raisen&#9;3kW Rooftop
Suresh Patel&#9;9123456780&#9;Bhopal&#9;5kW Commercial"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Assignment & Import Options -->
                <div class="row g-3 p-3 bg-white border rounded mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Target Branch</label>
                        <select id="importBranchSelect" class="form-select form-select-sm">
                            <% branches.forEach(b => { %>
                                <option value="<%= b._id %>"><%= b.name %> (<%= b.code %>)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Assignment Strategy</label>
                        <select id="importAssignStrategy" class="form-select form-select-sm" onchange="toggleAssignStrategy()">
                            <option value="AUTO">Auto-Distribute (Workload Balancing)</option>
                            <option value="SPECIFIC">Assign to Specific Telecaller</option>
                            <option value="NONE">Leave Unassigned</option>
                        </select>
                    </div>
                    <div class="col-md-4" id="specificTelecallerGroup" style="display: none;">
                        <label class="form-label small fw-bold">Select Telecaller</label>
                        <select id="importSpecificTelecaller" class="form-select form-select-sm">
                            <% telecallers.forEach(t => { %>
                                <option value="<%= t._id %>"><%= t.name %> (<%= t.designation || t.role %>)</option>
                            <% }); %>
                        </select>
                    </div>
                </div>

                <!-- Parse & Preview Action Button -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <button type="button" id="btnParsePreview" class="btn btn-outline-primary fw-bold" onclick="parseAndPreviewImport()">
                        <i class="icofont-search-job me-1"></i> Step 1: Validate & Preview Records
                    </button>
                    <div id="importSpinner" class="spinner-border spinner-border-sm text-primary d-none" role="status">
                        <span class="visually-hidden">Parsing...</span>
                    </div>
                </div>

                <!-- Preview Results Container -->
                <div id="importPreviewContainer" style="display: none;">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-dark px-3 py-2 fs-6">Total: <span id="prevTotal">0</span></span>
                        <span class="badge bg-success px-3 py-2 fs-6">Valid: <span id="prevValid">0</span></span>
                        <span class="badge bg-danger px-3 py-2 fs-6">Duplicates (Skipped): <span id="prevDuplicates">0</span></span>
                        <span class="badge bg-warning text-dark px-3 py-2 fs-6">Invalid: <span id="prevInvalid">0</span></span>
                    </div>

                    <div class="table-responsive border rounded" style="max-height: 250px;">
                        <table class="table table-sm table-striped mb-0" style="font-size: 12px;">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Mobile</th>
                                    <th>City</th>
                                    <th>Requirement</th>
                                    <th>Validation Status</th>
                                </tr>
                            </thead>
                            <tbody id="importPreviewTableBody">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnConfirmImport" class="btn btn-success fw-bold d-none" onclick="executeImport()">
                    <i class="icofont-check-circled me-1"></i> Step 2: Confirm & Import Valid Leads
                </button>
            </div>
        </div>
    </div>
</div>

