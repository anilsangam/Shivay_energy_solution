<%- include('../partials/admin-head') %>

<!-- Action Feedback Alert Banner -->
<div id="actionToast" class="alert alert-success alert-dismissible fade show d-none mb-4" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="actionToastMsg">Operation completed successfully.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('actionToast').classList.add('d-none')"></button>
</div>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            <i class="icofont-energy-solar me-2 text-warning"></i> Recent Projects Master
        </h2>
        <p class="text-muted small mb-0">
            Showcase completed residential, commercial, and agricultural solar rooftop installations across Madhya Pradesh.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/projects" target="_blank" class="btn btn-outline-secondary font-weight-bold shadow-sm" style="border-radius: 8px;">
            <i class="icofont-external-link me-1"></i> View Live Projects Page
        </a>
        <button type="button" class="btn btn-warning font-weight-bold text-dark shadow-sm" style="border-radius: 8px;" onclick="openCreateModal()">
            <i class="icofont-plus-circle me-1"></i> Add New Project
        </button>
    </div>
</div>

<!-- Quick Module Navigation Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
    <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="small font-weight-bold text-muted text-uppercase me-2"><i class="icofont-layers me-1"></i> Website CMS:</span>
            <a href="/admin/website/projects" class="btn btn-sm btn-dark font-weight-bold shadow-sm" style="border-radius: 20px;">
                <i class="icofont-energy-solar me-1 text-warning"></i> Projects (Active)
            </a>
            <a href="/admin/website/products" class="btn btn-sm btn-outline-dark" style="border-radius: 20px;">
                <i class="icofont-box me-1 text-primary"></i> Products
            </a>
            <a href="/admin/website/services" class="btn btn-sm btn-outline-dark" style="border-radius: 20px;">
                <i class="icofont-tasks-alt me-1 text-primary"></i> Services
            </a>
            <a href="/admin/website/team" class="btn btn-sm btn-outline-dark" style="border-radius: 20px;">
                <i class="icofont-users-alt-5 me-1 text-info"></i> Founders & Team
            </a>
            <a href="/admin/website/testimonials" class="btn btn-sm btn-outline-dark" style="border-radius: 20px;">
                <i class="icofont-star me-1 text-warning"></i> Testimonials
            </a>
            <a href="/admin/website/contact" class="btn btn-sm btn-outline-dark" style="border-radius: 20px;">
                <i class="icofont-address-book me-1 text-success"></i> Contact Info
            </a>
        </div>
        <span class="badge bg-light text-muted border">Total Projects: <%= projects.length %></span>
    </div>
</div>

<!-- Projects Grid -->
<div class="row g-4 mb-5">
    <% if (projects && projects.length > 0) { %>
        <% projects.forEach(pr => { %>
            <div class="col-lg-4 col-md-6" id="project-card-<%= pr._id %>">
                <div class="card border-0 shadow-sm rounded-3 h-100 overflow-hidden bg-white d-flex flex-column">
                    <div style="height: 190px; position: relative; background: #eaedf2; overflow: hidden;">
                        <img src="<%= pr.image && (pr.image.startsWith('http') || pr.image.startsWith('/')) ? pr.image : '/' + pr.image %>" 
                             alt="<%= pr.title %>" 
                             style="width: 100%; height: 100%; object-fit: cover;"
                             onerror="this.src='/images/slider/slider1.webp'">
                        <span class="badge position-absolute top-0 start-0 m-2 bg-dark">
                            <%= pr.capacity %>
                        </span>
                        <span class="badge position-absolute top-0 end-0 m-2 <%= pr.isActive ? 'bg-success' : 'bg-secondary' %>">
                            <%= pr.isActive ? 'Active' : 'Draft / Hidden' %>
                        </span>
                        <span class="badge position-absolute bottom-0 start-0 m-2 bg-primary">
                            <%= pr.category %>
                        </span>
                        <span class="badge position-absolute bottom-0 end-0 m-2 bg-dark text-white opacity-75">
                            <%= pr.year %>
                        </span>
                    </div>

                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                        <h5 class="font-weight-bold text-dark mb-1 fs-6 text-truncate" title="<%= pr.title %>">
                            <%= pr.title %>
                        </h5>
                        <div class="small text-muted mb-2">
                            <i class="icofont-location-pin text-danger me-1"></i><%= pr.location %>
                        </div>

                        <p class="text-muted small mb-2 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            <%= pr.description %>
                        </p>

                        <div class="p-2 bg-light rounded-2 mb-3 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Panels:</span>
                                <strong class="text-truncate" style="max-width: 60%;"><%= pr.panels %></strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Inverter:</span>
                                <strong class="text-truncate" style="max-width: 60%;"><%= pr.inverter %></strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Impact:</span>
                                <strong class="text-success text-truncate" style="max-width: 60%;"><%= pr.impact %></strong>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-auto">
                            <span class="font-monospace small text-muted">ID: <%= pr.projectId %></span>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary" onclick='openEditModal(<%= JSON.stringify(pr) %>)'>
                                    <i class="icofont-edit me-1"></i> Edit
                                </button>
                                <button type="button" class="btn btn-outline-danger" onclick="deleteProject('<%= pr._id %>', '<%= pr.title.replace(/'/g, "\\'") %>')">
                                    <i class="icofont-ui-delete me-1"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3 p-5 text-center bg-white">
                <i class="icofont-energy-solar text-muted" style="font-size: 48px;"></i>
                <h5 class="mt-3 font-weight-bold">No Projects Showcased</h5>
                <p class="text-muted small">Add your first solar rooftop installation.</p>
                <div>
                    <button type="button" class="btn btn-warning font-weight-bold" onclick="openCreateModal()">
                        <i class="icofont-plus me-1"></i> Add Project
                    </button>
                </div>
            </div>
        </div>
    <% } %>
</div>

<!-- Modal: Create / Edit Project -->
<div class="modal fade" id="projectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title font-weight-bold" id="modalTitle">Add New Solar Project</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="projectForm" onsubmit="handleProjectSubmit(event)">
                <input type="hidden" id="projectEditId" value="">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label font-weight-bold small">Project Title *</label>
                            <input type="text" id="projectTitle" class="form-control" required placeholder="e.g. 3 kW Residential Rooftop Solar">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label font-weight-bold small">Category *</label>
                            <select id="projectCategory" class="form-select" required>
                                <option value="Residential Solar">Residential Solar</option>
                                <option value="Commercial & Industrial">Commercial & Industrial</option>
                                <option value="Agricultural Solar">Agricultural Solar (KUSUM)</option>
                                <option value="Institutional Solar">Institutional Solar</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label font-weight-bold small">Location *</label>
                            <input type="text" id="projectLocation" class="form-control" required placeholder="e.g. Arjun Nagar, Raisen (M.P.)">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label font-weight-bold small">Capacity</label>
                            <input type="text" id="projectCapacity" class="form-control" placeholder="3 kW">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label font-weight-bold small">Commission Year</label>
                            <input type="text" id="projectYear" class="form-control" placeholder="2024">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label font-weight-bold small">Panels / Modules</label>
                            <input type="text" id="projectPanels" class="form-control" placeholder="6x 540W Mono PERC Half-Cut">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold small">Inverter Model</label>
                            <input type="text" id="projectInverter" class="form-control" placeholder="3 kW Dual MPPT On-Grid">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label font-weight-bold small">Impact / Savings</label>
                            <input type="text" id="projectImpact" class="form-control" placeholder="Bill reduced from ₹3,200 to ₹0">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label font-weight-bold small">Display Order</label>
                            <input type="number" id="projectOrder" class="form-control" value="0">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label font-weight-bold small">Status</label>
                            <select id="projectActive" class="form-select">
                                <option value="true">Active (Visible)</option>
                                <option value="false">Hidden / Draft</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label font-weight-bold small">Project Description</label>
                            <textarea id="projectDescription" class="form-control" rows="3" placeholder="Full turnkey details, subsidy processing, net-meter approval..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label font-weight-bold small">Image File (Upload to Cloudinary)</label>
                            <input type="file" id="projectFile" class="form-control" accept="image/*" onchange="previewSelectedImage(this)">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold small">Or Image URL / Path</label>
                            <input type="text" id="projectImageUrl" class="form-control" placeholder="https://... or /images/slider/slider1.webp">
                        </div>
                        <div class="col-12" id="imagePreviewContainer" style="display: none;">
                            <label class="form-label font-weight-bold small">Image Preview</label>
                            <div style="height: 120px; width: 220px; border-radius: 8px; overflow: hidden; border: 1px solid #ddd;">
                                <img id="projectImagePreview" src="" style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top py-2 px-4 bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="saveProjectBtn" class="btn btn-warning font-weight-bold text-dark px-4">
                        Save Project
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let selectedImageData = null;
let selectedImageName = null;
let selectedImageType = null;
let projectModalInstance = null;

document.addEventListener('DOMContentLoaded', function() {
    projectModalInstance = new bootstrap.Modal(document.getElementById('projectModal'));
});

function previewSelectedImage(input) {
    if (input.files && input.files[0]) {
        const file = input.files[0];
        selectedImageName = file.name;
        selectedImageType = file.type;
        const reader = new FileReader();
        reader.onload = function(e) {
            selectedImageData = e.target.result;
            document.getElementById('projectImagePreview').src = selectedImageData;
            document.getElementById('imagePreviewContainer').style.display = 'block';
        };
        reader.readAsDataURL(file);
    }
}

function openCreateModal() {
    document.getElementById('modalTitle').innerText = 'Add New Solar Project';
    document.getElementById('projectEditId').value = '';
    document.getElementById('projectTitle').value = '';
    document.getElementById('projectCategory').value = 'Residential Solar';
    document.getElementById('projectLocation').value = '';
    document.getElementById('projectCapacity').value = '3 kW';
    document.getElementById('projectYear').value = new Date().getFullYear().toString();
    document.getElementById('projectPanels').value = 'Mono PERC Half-Cut';
    document.getElementById('projectInverter').value = 'Dual MPPT On-Grid Inverter';
    document.getElementById('projectImpact').value = 'Zero electricity bill';
    document.getElementById('projectOrder').value = '0';
    document.getElementById('projectActive').value = 'true';
    document.getElementById('projectDescription').value = '';
    document.getElementById('projectImageUrl').value = '/images/slider/slider1.webp';
    document.getElementById('projectFile').value = '';
    selectedImageData = null;
    document.getElementById('imagePreviewContainer').style.display = 'none';
    projectModalInstance.show();
}

function openEditModal(pr) {
    document.getElementById('modalTitle').innerText = 'Edit Project: ' + pr.title;
    document.getElementById('projectEditId').value = pr._id;
    document.getElementById('projectTitle').value = pr.title || '';
    document.getElementById('projectCategory').value = pr.category || 'Residential Solar';
    document.getElementById('projectLocation').value = pr.location || '';
    document.getElementById('projectCapacity').value = pr.capacity || '';
    document.getElementById('projectYear').value = pr.year || '';
    document.getElementById('projectPanels').value = pr.panels || '';
    document.getElementById('projectInverter').value = pr.inverter || '';
    document.getElementById('projectImpact').value = pr.impact || '';
    document.getElementById('projectOrder').value = pr.order || 0;
    document.getElementById('projectActive').value = pr.isActive ? 'true' : 'false';
    document.getElementById('projectDescription').value = pr.description || '';
    document.getElementById('projectImageUrl').value = pr.image || '';
    document.getElementById('projectFile').value = '';
    selectedImageData = null;

    if (pr.image) {
        document.getElementById('projectImagePreview').src = (pr.image.startsWith('http') || pr.image.startsWith('/')) ? pr.image : '/' + pr.image;
        document.getElementById('imagePreviewContainer').style.display = 'block';
    } else {
        document.getElementById('imagePreviewContainer').style.display = 'none';
    }

    projectModalInstance.show();
}

async function handleProjectSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('saveProjectBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

    const editId = document.getElementById('projectEditId').value;
    const url = editId ? `/api/admin/website/projects/${editId}/update` : '/api/admin/website/projects';

    const payload = {
        _csrf: '<%= csrfToken %>',
        title: document.getElementById('projectTitle').value,
        category: document.getElementById('projectCategory').value,
        location: document.getElementById('projectLocation').value,
        capacity: document.getElementById('projectCapacity').value,
        year: document.getElementById('projectYear').value,
        panels: document.getElementById('projectPanels').value,
        inverter: document.getElementById('projectInverter').value,
        impact: document.getElementById('projectImpact').value,
        order: document.getElementById('projectOrder').value,
        isActive: document.getElementById('projectActive').value === 'true',
        description: document.getElementById('projectDescription').value,
        image: document.getElementById('projectImageUrl').value,
        imageData: selectedImageData,
        imageName: selectedImageName,
        imageType: selectedImageType
    };

    try {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            projectModalInstance.hide();
            window.location.reload();
        } else {
            alert(data.message || 'Error saving project.');
        }
    } catch (err) {
        alert('Server communication error.');
    } finally {
        btn.disabled = false;
        btn.innerText = 'Save Project';
    }
}

async function deleteProject(id, title) {
    if (!confirm(`Are you sure you want to delete "${title}"?`)) return;

    try {
        const res = await fetch(`/api/admin/website/projects/${id}/delete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ _csrf: '<%= csrfToken %>' })
        });
        const data = await res.json();
        if (data.success) {
            const card = document.getElementById(`project-card-${id}`);
            if (card) card.remove();
            showToast('Project deleted successfully.');
        } else {
            alert(data.message || 'Error deleting project.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}

function showToast(msg) {
    const toast = document.getElementById('actionToast');
    document.getElementById('actionToastMsg').innerText = msg;
    toast.classList.remove('d-none');
}
</script>

<%- include('../partials/admin-footer') %>
