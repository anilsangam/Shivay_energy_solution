<%- include('../partials/admin-head') %>

<!-- Action Feedback Alert Banner -->
<div id="actionToast" class="alert alert-success alert-dismissible fade show d-none mb-4" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="actionToastMsg">Operation completed successfully.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('actionToast').classList.add('d-none')"></button>
</div>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            <i class="icofont-tasks-alt me-2 text-warning"></i> Website Services Master
        </h2>
        <p class="text-muted small mb-0">
            Manage solar and renewable services shown dynamically across the public website and homepage.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/services" target="_blank" class="btn btn-outline-secondary font-weight-bold shadow-sm" style="border-radius: 8px;">
            <i class="icofont-external-link me-1"></i> View Live Services Page
        </a>
        <button type="button" class="btn btn-warning font-weight-bold text-dark shadow-sm" style="border-radius: 8px;" onclick="openCreateModal()">
            <i class="icofont-plus-circle me-1"></i> Add New Service
        </button>
    </div>
</div>

<!-- Quick Module Navigation Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
    <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="small font-weight-bold text-muted text-uppercase me-2"><i class="icofont-layers me-1"></i> Website CMS:</span>
            <a href="/admin/website/projects" class="btn btn-sm btn-outline-dark" style="border-radius: 20px;">
                <i class="icofont-energy-solar me-1 text-warning"></i> Projects
            </a>
            <a href="/admin/website/products" class="btn btn-sm btn-outline-dark" style="border-radius: 20px;">
                <i class="icofont-box me-1 text-primary"></i> Products
            </a>
            <a href="/admin/website/services" class="btn btn-sm btn-dark font-weight-bold shadow-sm" style="border-radius: 20px;">
                <i class="icofont-tasks-alt me-1 text-warning"></i> Services (Active)
            </a>
            <a href="/admin/website/team" class="btn btn-sm btn-outline-dark" style="border-radius: 20px;">
                <i class="icofont-users-alt-5 me-1 text-info"></i> Founders & Team
            </a>
            <a href="/admin/website/testimonials" class="btn btn-sm btn-outline-dark" style="border-radius: 20px;">
                <i class="icofont-star me-1 text-warning"></i> Testimonials
            </a>
            <a href="/admin/website/contact" class="btn btn-sm btn-outline-dark" style="border-radius: 20px;">
                <i class="icofont-address-book me-1 text-success"></i> Contact Info
            </a>
        </div>
        <span class="badge bg-light text-muted border">Total Services: <%= services.length %></span>
    </div>
</div>

<!-- Services Grid -->
<div class="row g-4 mb-5">
    <% if (services && services.length > 0) { %>
        <% services.forEach(s => { %>
            <div class="col-lg-4 col-md-6" id="service-card-<%= s._id %>">
                <div class="card border-0 shadow-sm rounded-3 h-100 overflow-hidden bg-white d-flex flex-column">
                    <div style="height: 180px; position: relative; background: #eaedf2; overflow: hidden;">
                        <img src="<%= s.image && (s.image.startsWith('http') || s.image.startsWith('/')) ? s.image : '/' + s.image %>" 
                             alt="<%= s.title %>" 
                             style="width: 100%; height: 100%; object-fit: cover;"
                             onerror="this.src='/images/services/1.webp'">
                        <span class="badge position-absolute top-0 end-0 m-2 <%= s.isActive ? 'bg-success' : 'bg-secondary' %>">
                            <%= s.isActive ? 'Active' : 'Draft / Hidden' %>
                        </span>
                        <span class="badge position-absolute bottom-0 start-0 m-2 bg-dark text-white opacity-75">
                            Order: <%= s.order %>
                        </span>
                    </div>

                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="p-2 rounded bg-warning bg-opacity-10 text-warning">
                                <i class="<%= s.icon || 'icofont-home' %> fs-5"></i>
                            </span>
                            <h5 class="font-weight-bold text-dark mb-0 fs-6 text-truncate" title="<%= s.title %>">
                                <%= s.title %>
                            </h5>
                        </div>

                        <p class="text-muted small mb-2 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            <%= s.shortDesc %>
                        </p>

                        <% if (s.highlights && s.highlights.length > 0) { %>
                            <div class="mb-3">
                                <% s.highlights.slice(0, 2).forEach(h => { %>
                                    <div class="small text-secondary text-truncate"><i class="icofont-check-circled text-success me-1"></i><%= h %></div>
                                <% }); %>
                            </div>
                        <% } %>

                        <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-auto">
                            <span class="font-monospace small text-muted">ID: <%= s.serviceId %></span>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary" onclick='openEditModal(<%= JSON.stringify(s) %>)'>
                                    <i class="icofont-edit me-1"></i> Edit
                                </button>
                                <button type="button" class="btn btn-outline-danger" onclick="deleteService('<%= s._id %>', '<%= s.title.replace(/'/g, "\\'") %>')">
                                    <i class="icofont-ui-delete me-1"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3 p-5 text-center bg-white">
                <i class="icofont-tasks-alt text-muted" style="font-size: 48px;"></i>
                <h5 class="mt-3 font-weight-bold">No Services Configured Yet</h5>
                <p class="text-muted small">Add your first solar service to display it on the public website.</p>
                <div>
                    <button type="button" class="btn btn-warning font-weight-bold" onclick="openCreateModal()">
                        <i class="icofont-plus me-1"></i> Create First Service
                    </button>
                </div>
            </div>
        </div>
    <% } %>
</div>

<!-- Modal: Create / Edit Service -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title font-weight-bold" id="modalTitle">Add New Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="serviceForm" onsubmit="handleServiceSubmit(event)">
                <input type="hidden" id="serviceEditId" value="">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label font-weight-bold small">Service Title *</label>
                            <input type="text" id="serviceTitle" class="form-control" required placeholder="e.g. Residential Rooftop Solar Installation">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label font-weight-bold small">Display Order</label>
                            <input type="number" id="serviceOrder" class="form-control" value="0">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label font-weight-bold small">Icon Class</label>
                            <input type="text" id="serviceIcon" class="form-control" placeholder="icofont-home">
                            <small class="text-muted">Options: icofont-home, icofont-building-alt, icofont-tools-alt-2, icofont-sun</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold small">Status</label>
                            <select id="serviceActive" class="form-select">
                                <option value="true">Active (Visible on Website)</option>
                                <option value="false">Hidden / Draft</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label font-weight-bold small">Short Description *</label>
                            <textarea id="serviceShortDesc" class="form-control" rows="2" required placeholder="Brief description displayed on cards..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label font-weight-bold small">Full Details</label>
                            <textarea id="serviceDetails" class="form-control" rows="3" placeholder="In-depth service specifications, process, subsidy support..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label font-weight-bold small">Key Highlights (One per line)</label>
                            <textarea id="serviceHighlights" class="form-control" rows="3" placeholder="Up to ₹78,000 Direct Govt Subsidy&#10;Zero Electricity Bills&#10;25 Years Performance Warranty"></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label font-weight-bold small">Image File (Upload to Cloudinary)</label>
                            <input type="file" id="serviceFile" class="form-control" accept="image/*" onchange="previewSelectedImage(this)">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold small">Or Image URL / Path</label>
                            <input type="text" id="serviceImageUrl" class="form-control" placeholder="/images/services/1.webp or https://...">
                        </div>
                        <div class="col-12" id="imagePreviewContainer" style="display: none;">
                            <label class="form-label font-weight-bold small">Image Preview</label>
                            <div style="height: 120px; width: 220px; border-radius: 8px; overflow: hidden; border: 1px solid #ddd;">
                                <img id="serviceImagePreview" src="" style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top py-2 px-4 bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="saveServiceBtn" class="btn btn-warning font-weight-bold text-dark px-4">
                        Save Service
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let selectedImageData = null;
let selectedImageName = null;
let selectedImageType = null;
let serviceModalInstance = null;

document.addEventListener('DOMContentLoaded', function() {
    serviceModalInstance = new bootstrap.Modal(document.getElementById('serviceModal'));
});

function previewSelectedImage(input) {
    if (input.files && input.files[0]) {
        const file = input.files[0];
        selectedImageName = file.name;
        selectedImageType = file.type;
        const reader = new FileReader();
        reader.onload = function(e) {
            selectedImageData = e.target.result;
            document.getElementById('serviceImagePreview').src = selectedImageData;
            document.getElementById('imagePreviewContainer').style.display = 'block';
        };
        reader.readAsDataURL(file);
    }
}

function openCreateModal() {
    document.getElementById('modalTitle').innerText = 'Add New Solar Service';
    document.getElementById('serviceEditId').value = '';
    document.getElementById('serviceTitle').value = '';
    document.getElementById('serviceOrder').value = '0';
    document.getElementById('serviceIcon').value = 'icofont-home';
    document.getElementById('serviceActive').value = 'true';
    document.getElementById('serviceShortDesc').value = '';
    document.getElementById('serviceDetails').value = '';
    document.getElementById('serviceHighlights').value = '';
    document.getElementById('serviceImageUrl').value = '/images/services/1.webp';
    document.getElementById('serviceFile').value = '';
    selectedImageData = null;
    document.getElementById('imagePreviewContainer').style.display = 'none';
    serviceModalInstance.show();
}

function openEditModal(service) {
    document.getElementById('modalTitle').innerText = 'Edit Service: ' + service.title;
    document.getElementById('serviceEditId').value = service._id;
    document.getElementById('serviceTitle').value = service.title || '';
    document.getElementById('serviceOrder').value = service.order || 0;
    document.getElementById('serviceIcon').value = service.icon || 'icofont-home';
    document.getElementById('serviceActive').value = service.isActive ? 'true' : 'false';
    document.getElementById('serviceShortDesc').value = service.shortDesc || '';
    document.getElementById('serviceDetails').value = service.details || '';
    document.getElementById('serviceHighlights').value = (service.highlights || []).join('\n');
    document.getElementById('serviceImageUrl').value = service.image || '';
    document.getElementById('serviceFile').value = '';
    selectedImageData = null;

    if (service.image) {
        document.getElementById('serviceImagePreview').src = (service.image.startsWith('http') || service.image.startsWith('/')) ? service.image : '/' + service.image;
        document.getElementById('imagePreviewContainer').style.display = 'block';
    } else {
        document.getElementById('imagePreviewContainer').style.display = 'none';
    }

    serviceModalInstance.show();
}

async function handleServiceSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('saveServiceBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

    const editId = document.getElementById('serviceEditId').value;
    const url = editId ? `/api/admin/website/services/${editId}/update` : '/api/admin/website/services';

    const payload = {
        _csrf: '<%= csrfToken %>',
        title: document.getElementById('serviceTitle').value,
        order: document.getElementById('serviceOrder').value,
        icon: document.getElementById('serviceIcon').value,
        isActive: document.getElementById('serviceActive').value === 'true',
        shortDesc: document.getElementById('serviceShortDesc').value,
        details: document.getElementById('serviceDetails').value,
        highlights: document.getElementById('serviceHighlights').value,
        image: document.getElementById('serviceImageUrl').value,
        imageData: selectedImageData,
        imageName: selectedImageName,
        imageType: selectedImageType
    };

    try {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            serviceModalInstance.hide();
            window.location.reload();
        } else {
            alert(data.message || 'Error saving service.');
        }
    } catch (err) {
        alert('Server communication error.');
    } finally {
        btn.disabled = false;
        btn.innerText = 'Save Service';
    }
}

async function deleteService(id, title) {
    if (!confirm(`Are you sure you want to delete "${title}"?`)) return;

    try {
        const res = await fetch(`/api/admin/website/services/${id}/delete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ _csrf: '<%= csrfToken %>' })
        });
        const data = await res.json();
        if (data.success) {
            const card = document.getElementById(`service-card-${id}`);
            if (card) card.remove();
            showToast('Service deleted successfully.');
        } else {
            alert(data.message || 'Error deleting service.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}

function showToast(msg) {
    const toast = document.getElementById('actionToast');
    document.getElementById('actionToastMsg').innerText = msg;
    toast.classList.remove('d-none');
}
</script>

<%- include('../partials/admin-footer') %>
