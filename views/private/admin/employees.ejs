<%- include('partials/admin-head') %>

<%
    const authUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : ((typeof user !== 'undefined' && user) ? user : null);
    const checkPerm = (typeof hasPermission === 'function') 
        ? hasPermission 
        : ((k) => authUser && (authUser.isPrimarySuperAdmin || (Array.isArray(authUser.permissions) && authUser.permissions.includes(k))));

    const canCreateUser = checkPerm('users.employees.create');
    const canManageUser = checkPerm('users.employees.manage');
    const pendingApprovalUsers = (users || []).filter(u => u.status === 'PENDING');
%>

<!-- Action Feedback Alert Banner -->
<div id="empToast" class="alert alert-success alert-dismissible fade show d-none" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="empToastMsg">User updated successfully.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('empToast').classList.add('d-none')"></button>
</div>

<% if (pendingApprovalUsers.length > 0 && canManageUser) { %>
<div class="alert alert-warning border-warning d-flex flex-wrap align-items-center justify-content-between mb-3 shadow-sm" role="alert">
    <div>
        <i class="icofont-shield-alt me-2"></i>
        <strong><%= pendingApprovalUsers.length %> Employee Account(s) Awaiting Super Admin Approval:</strong>
        <span class="small">Managers created these accounts; users cannot log in until you click <strong>Approve</strong>.</span>
    </div>
    <span class="badge bg-dark text-warning px-3 py-2"><%= pendingApprovalUsers.length %> Pending</span>
</div>
<% } %>

<!-- Header Controls -->
<div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: clamp(19px, 3.5vw, 24px);">
            Staff &amp; Personnel Management
        </h2>
        <p class="text-muted small mb-0">
            Manage employees, branch managers, reporting lines, and security permissions for Shivay Energy Solutions
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <% if (canCreateUser) { %>
            <button class="btn btn-warning font-weight-bold text-dark flex-grow-1 flex-sm-grow-0" data-bs-toggle="modal" data-bs-target="#createUserModal" style="border-radius: 8px;">
                <i class="icofont-plus-circle me-1"></i> Add New Staff Member
            </button>
        <% } %>
        <% if (canManageUser) { %>
            <a href="/admin/managers" class="btn btn-outline-primary flex-grow-1 flex-sm-grow-0 text-center" style="border-radius: 8px;">
                <i class="icofont-business-man me-1"></i> View Managers (<%= managers ? managers.length : 0 %>)
            </a>
        <% } %>
    </div>
</div>

<%
    function renderStaffMeta(u) {
        let roleClass = 'badge-role-employee';
        let roleName = 'Employee';
        if (u.role === 'SUPER_ADMIN') {
            roleClass = 'badge-role-superadmin';
            roleName = 'Super Admin';
        } else if (u.role === 'MANAGER' || u.role === 'BRANCH_MANAGER') {
            roleClass = 'badge-role-manager';
            roleName = 'Branch Manager';
        }

        let statusClass = 'badge-status-active';
        if (u.status === 'PENDING') statusClass = 'badge-status-pending';
        else if (u.status === 'SUSPENDED' || u.status === 'REJECTED') statusClass = 'badge-status-suspended';
        else if (u.status === 'INACTIVE') statusClass = 'badge-status-inactive';

        let mgrDisplay = '';
        let mgrIcon = 'icofont-business-man text-warning';
        if (u.role === 'SUPER_ADMIN') {
            mgrDisplay = 'Self / Executive Board';
            mgrIcon = 'icofont-shield-check text-primary';
        } else if (u.role === 'MANAGER' || u.role === 'BRANCH_MANAGER') {
            const branchName = (u.branchId && u.branchId.name) ? u.branchId.name : ((u.branch && u.branch.name) ? u.branch.name : 'Central Branch');
            mgrDisplay = `Self / Branch Head (${branchName})`;
            mgrIcon = 'icofont-building text-info';
        } else {
            mgrDisplay = (u.managerId && u.managerId.name) ? u.managerId.name : ((u.manager && u.manager.name) ? u.manager.name : 'None (Unassigned)');
        }
        return { roleClass, roleName, statusClass, mgrDisplay, mgrIcon };
    }
%>
<% function renderStaffActions(u) { %>
    <div class="d-inline-flex align-items-center justify-content-end gap-1">
        <% if (canManageUser) { %>
            <!-- Visible Action 1: Profile Edit -->
            <% if (!u.isPrimarySuperAdmin || (authUser && authUser.isPrimarySuperAdmin)) { %>
                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Edit Staff Profile & Photo" onclick="openEditUserModal('<%= u._id %>')">
                    <i class="icofont-edit"></i>
                </button>
            <% } %>

            <!-- Visible Action 2: Granular Permissions -->
            <a href="/admin/users/<%= u._id %>/permissions" class="btn btn-sm btn-outline-warning py-1 px-2" title="Manage Granular Permissions & Security Scope">
                <i class="icofont-key"></i>
            </a>
        <% } %>

        <!-- 3-Dot Menu Containing ALL Actions (Left-Aligned on Open) -->
        <div class="dropdown d-inline-block">
            <button type="button" class="btn btn-sm btn-outline-dark py-1 px-2" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" title="All Actions">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" style="vertical-align: -2px;">
                    <circle cx="8" cy="3" r="1.5"/>
                    <circle cx="8" cy="8" r="1.5"/>
                    <circle cx="8" cy="13" r="1.5"/>
                </svg>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-1" style="min-width: 210px; max-height: 75vh; overflow-y: auto; font-size: 13px; z-index: 1055;">
                <li>
                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/admin/employees/<%= u._id %>/id-card" target="_blank">
                        <i class="icofont-id-card text-primary"></i> View / Print ID Card
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/admin/employees/<%= u._id %>/visiting-card" target="_blank">
                        <i class="icofont-credit-card text-info"></i> View / Print Visiting Card
                    </a>
                </li>

                <% if (canManageUser) { %>
                    <li><hr class="dropdown-divider my-1"></li>

                    <% if (!u.isPrimarySuperAdmin || (authUser && authUser.isPrimarySuperAdmin)) { %>
                        <li>
                            <button type="button" class="dropdown-item py-2 d-flex align-items-center gap-2" onclick="openEditUserModal('<%= u._id %>')">
                                <i class="icofont-edit text-secondary"></i> Edit Profile &amp; Photo
                            </button>
                        </li>
                    <% } %>

                    <li>
                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/admin/users/<%= u._id %>/permissions">
                            <i class="icofont-key text-warning"></i> Manage Permissions
                        </a>
                    </li>

                    <% if (u.role === 'EMPLOYEE') { %>
                        <li>
                            <button type="button" class="dropdown-item py-2 d-flex align-items-center gap-2" onclick="openAssignModalById('<%= u._id %>')">
                                <i class="icofont-business-man text-primary"></i> Assign Manager
                            </button>
                        </li>
                    <% } %>

                    <% if (u.role !== 'SUPER_ADMIN') { %>
                        <% if (u.status === 'PENDING') { %>
                            <li>
                                <button type="button" class="dropdown-item py-2 d-flex align-items-center gap-2 text-success font-weight-bold" onclick="updateStatus('<%= u._id %>', 'ACTIVE')">
                                    <i class="icofont-check-circled"></i> Approve Login
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger" onclick="updateStatus('<%= u._id %>', 'REJECTED')">
                                    <i class="icofont-close-circled"></i> Reject Request
                                </button>
                            </li>
                        <% } else if (u.status === 'ACTIVE') { %>
                            <li>
                                <button type="button" class="dropdown-item py-2 d-flex align-items-center gap-2 text-warning" onclick="updateStatus('<%= u._id %>', 'SUSPENDED')">
                                    <i class="icofont-ban"></i> Suspend Account
                                </button>
                            </li>
                        <% } else { %>
                            <li>
                                <button type="button" class="dropdown-item py-2 d-flex align-items-center gap-2 text-success" onclick="updateStatus('<%= u._id %>', 'ACTIVE')">
                                    <i class="icofont-check"></i> Activate Account
                                </button>
                            </li>
                        <% } %>
                    <% } %>

                    <% if (!u.isPrimarySuperAdmin) { %>
                        <li>
                            <button type="button" class="dropdown-item py-2 d-flex align-items-center gap-2 text-dark" onclick="openResetModalById('<%= u._id %>')">
                                <i class="icofont-ui-lock"></i> Reset Password
                            </button>
                        </li>
                    <% } else { %>
                        <li><span class="dropdown-item-text text-muted small py-1"><i class="icofont-shield-alt me-1"></i> Primary Root Protected</span></li>
                    <% } %>
                <% } %>
            </ul>
        </div>
    </div>
<% } %>

<!-- Users Table Card -->
<div class="admin-card">
    <div class="admin-card-header">
        <div>
            <h5 class="admin-card-title">All Registered Personnel (<%= users ? users.length : 0 %>)</h5>
            <div class="admin-card-subtitle">Verified users with role-based access control</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border">Raisen Central Operations</span>
        </div>
    </div>

    <!-- Desktop / Large Screen Table -->
    <div class="admin-table-container d-none d-lg-block">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Staff Name</th>
                    <th>Emp ID</th>
                    <th class="admin-table-col-contact">Contact</th>
                    <th>Role</th>
                    <th class="admin-table-col-mgr">Manager / Branch</th>
                    <th>Status</th>
                    <th>Permissions</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (users && users.length > 0) { %>
                    <% users.forEach(u => {
                        const { roleClass, roleName, statusClass, mgrDisplay, mgrIcon } = renderStaffMeta(u);
                    %>
                        <tr id="user-row-<%= u._id %>">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <% if (u.avatar && u.avatar !== '/images/misc/cst-1.webp') { %>
                                        <img src="<%= u.avatar %>" alt="<%= u.name %>" class="rounded-circle border flex-shrink-0" style="width: 34px; height: 34px; object-fit: cover;">
                                    <% } else { %>
                                        <div class="admin-avatar-circle flex-shrink-0" style="width: 34px; height: 34px; font-size: 11px;">
                                            <%= (u.name || 'U').split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase() %>
                                        </div>
                                    <% } %>
                                    <div>
                                        <strong class="text-dark" style="font-size: 12.5px;"><%= u.name %></strong>
                                        <div class="text-muted" style="font-size: 11px;"><%= u.designation || 'Staff' %></div>
                                    </div>
                                </div>
                            </td>
                            <td style="font-size: 11px;"><code><%= u.employeeId || 'N/A' %></code></td>
                            <td class="admin-table-col-contact">
                                <div class="contact-email" style="font-size: 11.5px;" title="<%= u.email %>"><i class="icofont-envelope text-muted me-1"></i><%= u.email %></div>
                                <div style="font-size: 11.5px; white-space: nowrap;"><i class="icofont-phone text-muted me-1"></i><%= u.mobile %></div>
                            </td>
                            <td><span class="badge-role <%= roleClass %>"><%= roleName %></span></td>
                            <td class="admin-table-col-mgr">
                                <span class="d-inline-flex align-items-start gap-1 font-weight-bold" style="font-size: 11.5px; color: var(--admin-navy-primary);">
                                    <i class="<%= mgrIcon %> mt-1"></i> <span><%= mgrDisplay %></span>
                                </span>
                            </td>
                            <td>
                                <span class="badge-status <%= statusClass %>" id="status-badge-<%= u._id %>">
                                    <%= u.status %>
                                </span>
                            </td>
                            <td>
                                <% if (u.isPrimarySuperAdmin) { %>
                                    <span class="badge bg-warning text-dark font-weight-bold" title="Primary Super Admin holds unconditional full bypass across all modules">
                                        <i class="icofont-crown text-dark me-1"></i> Root Bypass (117)
                                    </span>
                                <% } else { 
                                    const pCount = u.permissions ? u.permissions.length : 0;
                                    const fCount = u.fieldPermissions ? u.fieldPermissions.length : 0;
                                %>
                                    <a href="/admin/users/<%= u._id %>/permissions" class="badge <%= pCount > 0 ? 'bg-primary' : 'bg-secondary' %> text-decoration-none" title="Click to view & configure granular permissions">
                                        <i class="icofont-key me-1"></i> <%= pCount %> / 117 active
                                        <% if (fCount > 0) { %>
                                            <span class="badge bg-danger ms-1" style="font-size: 9px;"><%= fCount %> fields</span>
                                        <% } %>
                                    </a>
                                <% } %>
                            </td>
                            <td class="text-end" style="white-space: nowrap;">
                                <% renderStaffActions(u); %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">No personnel records found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Mobile & Tablet Responsive Compact Card List (< 992px) -->
    <div class="admin-mobile-staff-list d-lg-none">
        <% if (users && users.length > 0) { %>
            <% users.forEach(u => {
                const { roleClass, roleName, statusClass, mgrDisplay, mgrIcon } = renderStaffMeta(u);
                const pCount = u.permissions ? u.permissions.length : 0;
                const fCount = u.fieldPermissions ? u.fieldPermissions.length : 0;
            %>
                <div class="admin-mobile-staff-card" data-mobile-user-row="<%= u._id %>">
                    <div class="d-flex align-items-center justify-content-between gap-2 pb-1 mb-1 border-bottom">
                        <div class="d-flex align-items-center gap-2 min-w-0">
                            <% if (u.avatar && u.avatar !== '/images/misc/cst-1.webp') { %>
                                <img src="<%= u.avatar %>" alt="<%= u.name %>" class="rounded-circle border flex-shrink-0" style="width: 34px; height: 34px; object-fit: cover;">
                            <% } else { %>
                                <div class="admin-avatar-circle flex-shrink-0" style="width: 34px; height: 34px; font-size: 11px;">
                                    <%= (u.name || 'U').split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase() %>
                                </div>
                            <% } %>
                            <div class="min-w-0">
                                <div class="font-weight-bold text-dark text-truncate" style="font-size: 13.5px; line-height: 1.2;"><%= u.name %></div>
                                <div class="text-muted text-truncate" style="font-size: 11px;"><%= u.designation || 'Staff' %> &bull; <code><%= u.employeeId || 'N/A' %></code></div>
                            </div>
                        </div>
                        <div class="flex-shrink-0 text-end">
                            <span class="badge-status <%= statusClass %>" style="font-size: 10px; padding: 2px 7px;"><%= u.status %></span>
                            <div class="mt-1"><span class="badge-role <%= roleClass %>" style="font-size: 9px; padding: 2px 5px;"><%= roleName %></span></div>
                        </div>
                    </div>

                    <div class="admin-mobile-meta-grid my-1">
                        <div class="admin-mobile-meta-item">
                            <i class="icofont-phone text-muted me-1"></i><strong><%= u.mobile %></strong>
                        </div>
                        <div class="admin-mobile-meta-item" style="color: var(--admin-navy-primary);">
                            <i class="<%= mgrIcon %> me-1"></i><strong><%= mgrDisplay %></strong>
                        </div>
                        <div class="admin-mobile-meta-item" style="grid-column: span 2;">
                            <i class="icofont-envelope text-muted me-1"></i><%= u.email %>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between gap-2 pt-1 mt-1 border-top">
                        <div>
                            <% if (u.isPrimarySuperAdmin) { %>
                                <span class="badge bg-warning text-dark font-weight-bold" style="font-size: 10px;"><i class="icofont-crown me-1"></i>Root (117)</span>
                            <% } else { %>
                                <a href="/admin/users/<%= u._id %>/permissions" class="badge <%= pCount > 0 ? 'bg-primary' : 'bg-secondary' %> text-decoration-none" style="font-size: 10.5px;">
                                    <i class="icofont-key me-1"></i><%= pCount %> / 117
                                    <% if (fCount > 0) { %><span class="badge bg-danger ms-1" style="font-size: 9px;"><%= fCount %> fields</span><% } %>
                                </a>
                            <% } %>
                        </div>
                        <% renderStaffActions(u); %>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="text-center py-4 text-muted">No personnel records found.</div>
        <% } %>
    </div>
</div>

<!-- Modal: Add New Staff Member -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header text-white" style="background: var(--admin-navy-primary); border-top-left-radius: 16px; border-top-right-radius: 16px;">
                <h5 class="modal-title font-weight-bold" id="createUserModalLabel">
                    <i class="icofont-plus-circle me-1 text-warning"></i> Add New Staff Member
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form onsubmit="handleCreateUser(event)">
                <div class="modal-body p-3 p-sm-4">
                    <div id="createErrAlert" class="alert alert-danger d-none small"></div>

                    <!-- Profile Picture Upload -->
                    <div class="p-3 bg-light rounded-3 mb-3 border d-flex flex-wrap align-items-center gap-3">
                        <img id="newAvatarPreview" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%23e2e8f0'/%3E%3Ccircle cx='32' cy='24' r='12' fill='%2394a3b8'/%3E%3Cpath d='M12 56c0-11 9-18 20-18s20 7 20 18' fill='%2394a3b8'/%3E%3C/svg%3E" alt="Profile Preview" class="rounded-circle border border-2 border-warning" style="width: 58px; height: 58px; object-fit: cover; flex-shrink: 0;">
                        <div class="flex-grow-1 min-w-0">
                            <label class="form-label small font-weight-bold mb-1">Profile Picture (ID Card Photo)</label>
                            <input type="file" id="newAvatarFile" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp" onchange="previewAdminAvatar(this, 'newAvatarPreview')">
                            <div class="form-text" style="font-size: 11px;">JPG, PNG or WEBP (Max 5 MB).</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Full Name *</label>
                        <input type="text" id="newName" class="form-control" required placeholder="e.g. Vikram Solanki">
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label small font-weight-bold">Official Email *</label>
                            <input type="email" id="newEmail" class="form-control" required placeholder="vikram@shivayenergy.com">
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label small font-weight-bold">Mobile Phone *</label>
                            <input type="tel" id="newMobile" class="form-control" required placeholder="+91 98260 00000">
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label small font-weight-bold">Initial Password *</label>
                            <input type="password" id="newPass" class="form-control" required minlength="8" placeholder="••••••••">
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label small font-weight-bold">Role Assignment *</label>
                            <select id="newRole" class="form-select" required onchange="handleRoleChange(this.value)">
                                <option value="EMPLOYEE" selected>Employee (Field Staff)</option>
                                <option value="BRANCH_MANAGER">Branch Manager</option>
                                <option value="SUPER_ADMIN">Super Admin</option>
                            </select>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 px-3 small mb-3">
                        <i class="icofont-info-circle me-1"></i> <strong>Zero-Trust Authorization:</strong> Newly created accounts start with empty permissions. After creation, click the key icon (<strong>Manage Permissions</strong>) to assign specific modules, features, or administrative actions.
                    </div>

                    <!-- Branch Assignment (Required for Branch Manager) -->
                    <div class="mb-3" id="branchSelectWrap">
                        <label class="form-label small font-weight-bold" id="branchLabel">
                            Branch Assignment <span id="branchReqStar" class="text-danger" style="display: none;">*</span>
                        </label>
                        <select id="newBranchId" class="form-select">
                            <option value="">-- Select Branch --</option>
                            <% if (typeof branches !== 'undefined' && branches && branches.length > 0) { %>
                                <% branches.forEach(b => { %>
                                    <option value="<%= b._id %>"><%= b.name %> (<%= b.code %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                        <div class="form-text text-muted" id="branchHelpText" style="font-size: 11px;">
                            Each branch can have only one active Branch Manager.
                        </div>
                    </div>

                    <!-- Reporting Manager (Hidden for Branch Managers & Super Admins) -->
                    <div class="mb-3" id="managerSelectWrap">
                        <label class="form-label small font-weight-bold">Assigned Manager</label>
                        <select id="newManagerId" class="form-select">
                            <option value="">-- Select Reporting Manager --</option>
                            <% if (managers && managers.length > 0) { %>
                                <% managers.forEach(m => { %>
                                    <option value="<%= m._id %>"><%= m.name %> (<%= m.role %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label small font-weight-bold">Designation</label>
                            <input type="text" id="newDesig" class="form-control" placeholder="e.g. Site Engineer">
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label small font-weight-bold">Department</label>
                            <input type="text" id="newDept" class="form-control" placeholder="e.g. EPC Installations">
                        </div>
                    </div>

                    <!-- ID Card Details -->
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <h6 class="font-weight-bold text-dark mb-2" style="font-size: 13px;">
                            <i class="icofont-id-card text-warning me-1"></i> Identity Card & Contact Information
                        </h6>
                        <div class="row g-2 mb-2">
                            <div class="col-12 col-sm-6">
                                <label class="form-label small font-weight-bold">Blood Group</label>
                                <select id="newBlood" class="form-select">
                                    <option value="B+" selected>B+ (Positive)</option>
                                    <option value="O+">O+ (Positive)</option>
                                    <option value="A+">A+ (Positive)</option>
                                    <option value="AB+">AB+ (Positive)</option>
                                    <option value="B-">B- (Negative)</option>
                                    <option value="O-">O- (Negative)</option>
                                    <option value="A-">A- (Negative)</option>
                                    <option value="AB-">AB- (Negative)</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label small font-weight-bold">Alt / Emergency Contact</label>
                                <input type="tel" id="newAltMobile" class="form-control" placeholder="+91 98260 00000">
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-12 col-sm-6">
                                <label class="form-label small font-weight-bold">Joining Date</label>
                                <input type="date" id="newJoinDate" class="form-control">
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label small font-weight-bold">Card Expiry Date</label>
                                <input type="date" id="newExpDate" class="form-control">
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Employee ID (Optional)</label>
                        <input type="text" id="newEmpId" class="form-control" placeholder="Leave blank to auto-generate (e.g. SES-EMP-...)">
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm font-weight-bold px-3" style="background: var(--admin-navy-primary);">
                        Create Staff Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('partials/staff-edit-modal', { staffList: users, branches, managers }) %>

<!-- Modal: Assign Manager -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-light">
                <h6 class="modal-title font-weight-bold text-dark">Assign Manager</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form onsubmit="handleAssignManager(event)">
                <div class="modal-body">
                    <input type="hidden" id="assignEmpId">
                    <p class="small text-muted mb-2">Assign reporting manager for: <strong class="text-dark" id="assignEmpName"></strong></p>
                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Select Manager</label>
                        <select id="assignMgrSelect" class="form-select">
                            <option value="">-- No Manager (Unassigned) --</option>
                            <% if (managers && managers.length > 0) { %>
                                <% managers.forEach(m => { %>
                                    <option value="<%= m._id %>"><%= m.name %> (<%= m.role %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light p-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary" style="background: var(--admin-navy-primary);">Save Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Reset Password -->
<div class="modal fade" id="resetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-light">
                <h6 class="modal-title font-weight-bold text-dark">Reset Password</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form onsubmit="handleResetPassword(event)">
                <div class="modal-body">
                    <input type="hidden" id="resetUserId">
                    <p class="small text-muted mb-2">Reset password for: <strong class="text-dark" id="resetUserName"></strong></p>
                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">New Password (min 8 chars) *</label>
                        <input type="password" id="resetNewPass" class="form-control" required minlength="8" placeholder="••••••••">
                    </div>
                </div>
                <div class="modal-footer bg-light p-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger font-weight-bold">Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function handleRoleChange(role) {
    const mgrWrap = document.getElementById('managerSelectWrap');
    const branchWrap = document.getElementById('branchSelectWrap');
    const branchReqStar = document.getElementById('branchReqStar');
    const empIdInput = document.getElementById('newEmpId');

    if (role === 'BRANCH_MANAGER') {
        if (mgrWrap) mgrWrap.style.display = 'none';
        if (branchWrap) branchWrap.style.display = 'block';
        if (branchReqStar) branchReqStar.style.display = 'inline';
        if (empIdInput) empIdInput.placeholder = 'Leave blank to auto-generate (e.g. SES-MGR-...)';
    } else if (role === 'EMPLOYEE') {
        if (mgrWrap) mgrWrap.style.display = 'block';
        if (branchWrap) branchWrap.style.display = 'block';
        if (branchReqStar) branchReqStar.style.display = 'none';
        if (empIdInput) empIdInput.placeholder = 'Leave blank to auto-generate (e.g. SES-EMP-...)';
    } else if (role === 'SUPER_ADMIN') {
        if (mgrWrap) mgrWrap.style.display = 'none';
        if (branchWrap) branchWrap.style.display = 'none';
        if (empIdInput) empIdInput.placeholder = 'Leave blank to auto-generate (e.g. SES-ADMIN-...)';
    }
}

async function handleCreateUser(e) {
    e.preventDefault();
    const errBox = document.getElementById('createErrAlert');
    errBox.classList.add('d-none');

    const role = document.getElementById('newRole').value;
    const branchId = document.getElementById('newBranchId') ? document.getElementById('newBranchId').value : null;
    const managerId = (role === 'EMPLOYEE' && document.getElementById('newManagerId')) ? (document.getElementById('newManagerId').value || null) : null;

    if (role === 'BRANCH_MANAGER' && !branchId) {
        errBox.innerText = 'Branch selection is required when creating a Branch Manager.';
        errBox.classList.remove('d-none');
        return;
    }

    let avatarPayload = {};
    try {
        const imgObj = await readAdminAvatarInput('newAvatarFile');
        if (imgObj) avatarPayload = imgObj;
    } catch (imgErr) {
        errBox.innerText = imgErr.message;
        errBox.classList.remove('d-none');
        return;
    }

    const body = Object.assign({
        name: document.getElementById('newName').value,
        email: document.getElementById('newEmail').value,
        mobile: document.getElementById('newMobile').value,
        password: document.getElementById('newPass').value,
        role: role,
        branchId: branchId || null,
        managerId: managerId,
        designation: document.getElementById('newDesig').value,
        department: document.getElementById('newDept').value,
        bloodGroup: document.getElementById('newBlood') ? document.getElementById('newBlood').value : 'B+',
        alternateMobile: document.getElementById('newAltMobile') ? document.getElementById('newAltMobile').value : '',
        joiningDate: document.getElementById('newJoinDate') ? document.getElementById('newJoinDate').value : '',
        expiryDate: document.getElementById('newExpDate') ? document.getElementById('newExpDate').value : '',
        employeeId: document.getElementById('newEmpId').value,
        _csrf: CSRF_TOKEN
    }, avatarPayload);

    try {
        const res = await fetch('/api/admin/users/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('createUserModal')).hide();
            showToast(data.message || 'Staff member created successfully.');
            setTimeout(() => location.reload(), 800);
        } else {
            errBox.innerText = data.message || 'Error creating user.';
            errBox.classList.remove('d-none');
        }
    } catch (err) {
        errBox.innerText = 'Server error creating user.';
        errBox.classList.remove('d-none');
    }
}

async function updateStatus(userId, status) {
    if (!confirm(`Are you sure you want to change this user status to ${status}?`)) return;

    try {
        const res = await fetch('/api/admin/users/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify({ userId, status, _csrf: CSRF_TOKEN })
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.message);
            setTimeout(() => location.reload(), 800);
        } else {
            alert(data.message || 'Error updating status.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}

function openAssignModalById(empId) {
    const u = ADMIN_STAFF_MAP[empId];
    if (!u) return;
    openAssignModal(u.id, u.name, u.managerId || '');
}

function openAssignModal(empId, name, currentMgrId) {
    document.getElementById('assignEmpId').value = empId;
    document.getElementById('assignEmpName').innerText = name;
    document.getElementById('assignMgrSelect').value = currentMgrId || '';
    new bootstrap.Modal(document.getElementById('assignModal')).show();
}

async function handleAssignManager(e) {
    e.preventDefault();
    const employeeId = document.getElementById('assignEmpId').value;
    const managerId = document.getElementById('assignMgrSelect').value;

    try {
        const res = await fetch('/api/admin/employees/assign-manager', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify({ employeeId, managerId, _csrf: CSRF_TOKEN })
        });
        const data = await res.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('assignModal')).hide();
            showToast(data.message);
            setTimeout(() => location.reload(), 800);
        } else {
            alert(data.message || 'Error assigning manager.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}

function openResetModalById(userId) {
    const u = ADMIN_STAFF_MAP[userId];
    if (!u) return;
    openResetModal(u.id, u.name);
}

function openResetModal(userId, name) {
    document.getElementById('resetUserId').value = userId;
    document.getElementById('resetUserName').innerText = name;
    document.getElementById('resetNewPass').value = '';
    new bootstrap.Modal(document.getElementById('resetModal')).show();
}

async function handleResetPassword(e) {
    e.preventDefault();
    const userId = document.getElementById('resetUserId').value;
    const newPassword = document.getElementById('resetNewPass').value;

    try {
        const res = await fetch('/api/admin/users/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify({ userId, newPassword, _csrf: CSRF_TOKEN })
        });
        const data = await res.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('resetModal')).hide();
            showToast(data.message);
        } else {
            alert(data.message || 'Error resetting password.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}
</script>

<%- include('partials/admin-footer') %>
