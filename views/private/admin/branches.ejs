<%- include('partials/admin-head') %>

<%
    const authUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : ((typeof user !== 'undefined' && user) ? user : null);
    const checkPerm = (typeof hasPermission === 'function') 
        ? hasPermission 
        : ((k) => authUser && (authUser.isPrimarySuperAdmin || (Array.isArray(authUser.permissions) && authUser.permissions.includes(k))));

    const canCreateBranch = checkPerm('branches.offices.create');
    const canEditBranch = checkPerm('branches.offices.edit');
    const canManageBranch = checkPerm('branches.offices.manage');
    const canViewStaff = checkPerm('users.employees.view');
%>

<!-- Action Feedback Alert Banner -->
<div id="branchToast" class="alert alert-success alert-dismissible fade show d-none mb-4" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="branchToastMsg">Branch updated successfully.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('branchToast').classList.add('d-none')"></button>
</div>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            <i class="icofont-building-alt me-2 text-warning"></i> Regional Branches & Operational Hubs
        </h2>
        <p class="text-muted small mb-0">
            Manage company branches, regional office contacts, GPS attendance geofencing, and designated Branch Managers.
        </p>
    </div>
    <div class="d-flex gap-2">
        <% if (canCreateBranch) { %>
            <button class="btn btn-warning font-weight-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#createBranchModal" style="border-radius: 8px;">
                <i class="icofont-plus-circle me-1"></i> Add New Branch
            </button>
        <% } %>
        <% if (canViewStaff) { %>
            <a href="/admin/employees" class="btn btn-outline-primary" style="border-radius: 8px;">
                <i class="icofont-users-alt-2 me-1"></i> Staff Management
            </a>
        <% } %>
    </div>
</div>

<!-- Top Metrics Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Total Branches</span>
            <div class="h3 font-weight-bold text-dark mb-0 mt-1"><%= stats.totalBranches %></div>
            <div class="small text-muted mt-1"><%= stats.activeBranches %> operational hubs</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Active Regional Hubs</span>
            <div class="h3 font-weight-bold text-success mb-0 mt-1"><%= stats.activeBranches %></div>
            <div class="small text-muted mt-1">100% geofenced</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Field Personnel</span>
            <div class="h3 font-weight-bold text-primary mb-0 mt-1"><%= stats.totalEmployees %></div>
            <div class="small text-muted mt-1">Assigned across branches</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Active Solar Projects</span>
            <div class="h3 font-weight-bold text-warning mb-0 mt-1"><%= stats.totalProjects %></div>
            <div class="small text-muted mt-1">Under regional execution</div>
        </div>
    </div>
</div>

<!-- Branches Table Card -->
<div class="admin-card border-0 shadow-sm" style="border-radius: 12px; border: 1px solid var(--admin-border, #cbd5e1) !important;">
    <div class="admin-card-header bg-white p-3 border-bottom d-flex align-items-center justify-content-between">
        <div>
            <h5 class="admin-card-title mb-0">Branch Locations (<%= branches.length %>)</h5>
            <div class="admin-card-subtitle small text-muted">Authorized regional offices and geofenced operations</div>
        </div>
        <span class="badge bg-light text-dark border">Madhya Pradesh Network</span>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Branch Details</th>
                    <th>Branch Code</th>
                    <th>Location / District</th>
                    <th>Branch Manager</th>
                    <th>Contact & Email</th>
                    <th>Geofence</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (branches && branches.length > 0) { %>
                    <% branches.forEach(b => { 
                        const mgr = b.manager;
                        const mgrName = (mgr && mgr.name) ? mgr.name : 'Unassigned';
                        const mgrEmpId = (mgr && mgr.employeeId) ? mgr.employeeId : '';
                    %>
                        <tr id="branch-row-<%= b._id %>">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="admin-avatar-circle" style="width: 36px; height: 36px; font-size: 13px; background: #e0f2fe; color: #0284c7;">
                                        <i class="icofont-building"></i>
                                    </div>
                                    <div>
                                        <strong class="text-dark"><%= b.name %></strong>
                                        <div class="text-muted" style="font-size: 11px;"><%= b.address %></div>
                                    </div>
                                </div>
                            </td>
                            <td><code><%= b.code %></code></td>
                            <td>
                                <div><strong class="text-dark"><%= b.city %></strong></div>
                                <div class="text-muted" style="font-size: 11px;"><%= b.district %>, <%= b.state %></div>
                            </td>
                            <td>
                                <% if (mgr && mgr.name) { %>
                                    <span class="d-inline-flex align-items-center gap-1 font-weight-bold" style="font-size: 12.5px; color: var(--admin-navy-primary);">
                                        <i class="icofont-business-man text-warning"></i> <%= mgrName %>
                                    </span>
                                    <div class="text-muted" style="font-size: 11px;"><%= mgrEmpId %></div>
                                <% } else { %>
                                    <span class="badge bg-light text-muted border">No Manager Assigned</span>
                                <% } %>
                            </td>
                            <td>
                                <div style="font-size: 12px;"><i class="icofont-phone text-muted me-1"></i><%= b.contactNumber %></div>
                                <% if (b.email) { %>
                                    <div style="font-size: 12px;"><i class="icofont-envelope text-muted me-1"></i><%= b.email %></div>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge <%= b.geofenceEnabled !== false ? 'bg-primary-subtle text-primary border border-primary-subtle' : 'bg-secondary-subtle text-secondary border' %>">
                                    <i class="icofont-location-pin me-1"></i><%= b.geofenceEnabled !== false ? `${b.geofenceRadiusMeters || 500}m Strict` : 'Geofence Off' %>
                                </span>
                                <div class="text-muted mt-1" style="font-size: 10.5px;">
                                    <i class="icofont-clock-time me-1 text-warning"></i><%= b.attendanceTimeEnabled !== false ? `${b.attendanceStartTime || '09:00'} – ${b.attendanceEndTime || '17:00'} IST` : 'Anytime' %>
                                </div>
                                <% if (b.attendanceTimeEnabled !== false) { %>
                                    <div class="text-muted" style="font-size: 10px;">
                                        -<%= b.checkInEarlyMinutes !== undefined ? b.checkInEarlyMinutes : 10 %>m In / -<%= b.checkOutEarlyMinutes !== undefined ? b.checkOutEarlyMinutes : 5 %>m Out <%= b.allowLateCheckOut !== false ? '• Late Out OK' : '' %>
                                    </div>
                                <% } %>
                            </td>
                            <td>
                                <% if (b.isActive !== false) { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                                <% } else { %>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Inactive</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <% if (canEditBranch) { %>
                                        <button class="btn btn-sm btn-outline-info py-1 px-2" title="Configure Geofence Map" onclick='openEditModal(<%= JSON.stringify(b) %>, true)'>
                                            <i class="icofont-map"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary py-1 px-2" title="Edit Branch" onclick='openEditModal(<%= JSON.stringify(b) %>)'>
                                            <i class="icofont-ui-edit"></i>
                                        </button>
                                    <% } %>
                                    <% if (canManageBranch) { %>
                                        <% if (b.isActive !== false) { %>
                                            <button class="btn btn-sm btn-outline-warning py-1 px-2" title="Deactivate Branch" onclick="toggleStatus('<%= b._id %>', false)">
                                                <i class="icofont-ban"></i>
                                            </button>
                                        <% } else { %>
                                            <button class="btn btn-sm btn-outline-success py-1 px-2" title="Activate Branch" onclick="toggleStatus('<%= b._id %>', true)">
                                                <i class="icofont-check"></i>
                                            </button>
                                        <% } %>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">No branch locations found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add New Branch -->
<div class="modal fade" id="createBranchModal" tabindex="-1" aria-labelledby="createBranchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header text-white" style="background: var(--admin-navy-primary); border-top-left-radius: 16px; border-top-right-radius: 16px;">
                <h5 class="modal-title font-weight-bold" id="createBranchModalLabel">
                    <i class="icofont-plus-circle me-1 text-warning"></i> Add New Regional Branch
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form onsubmit="handleCreateBranch(event)">
                <div class="modal-body p-4">
                    <div id="createBranchErrAlert" class="alert alert-danger d-none small"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label class="form-label small font-weight-bold">Branch Name *</label>
                            <input type="text" id="newBranchName" class="form-control" required placeholder="e.g. Bhopal Regional Hub">
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small font-weight-bold">Branch Code (Optional)</label>
                            <input type="text" id="newBranchCode" class="form-control" placeholder="Leave blank to auto-generate (e.g. MP-BPL-02)">
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Official Contact Number *</label>
                            <input type="text" id="newBranchPhone" class="form-control" required placeholder="+91 755 2400000">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Branch Official Email</label>
                            <input type="email" id="newBranchEmail" class="form-control" placeholder="bhopal@shivayenergy.com">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Office Address Line *</label>
                        <input type="text" id="newBranchAddress" class="form-control" required placeholder="Plot No., Commercial Complex / Street">
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">City *</label>
                            <input type="text" id="newBranchCity" class="form-control" required placeholder="Bhopal">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">District *</label>
                            <input type="text" id="newBranchDistrict" class="form-control" required placeholder="Bhopal">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">State *</label>
                            <input type="text" id="newBranchState" class="form-control" required value="Madhya Pradesh">
                        </div>
                    </div>

                    <div class="p-3 bg-light border rounded-3 mb-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <div>
                                <div class="font-weight-bold small text-dark"><i class="icofont-map-pins text-primary me-1"></i> Select Branch Geofence Area on Map</div>
                                <div class="text-muted" style="font-size: 11px;">Click on the map, drag the pin, search address, or use your current GPS location.</div>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="newBranchGeofenceEnabled" checked>
                                <label class="form-check-label small fw-bold" for="newBranchGeofenceEnabled">Enforce Geofence</label>
                            </div>
                        </div>

                        <div class="position-relative mb-2">
                            <div class="input-group input-group-sm">
                                <input type="text" id="createMapSearchInput" class="form-control" autocomplete="off" placeholder="Search city, area, pincode, or paste lat,lng (e.g. MP Nagar Bhopal)..." oninput="scheduleMapAutocomplete('create')" onkeydown="if(event.key==='Enter'){event.preventDefault();searchBranchMap('create', true);}">
                                <button type="button" class="btn btn-outline-primary" onclick="searchBranchMap('create', true)"><i class="icofont-search-1"></i> Search</button>
                                <button type="button" class="btn btn-outline-success" id="createGpsBtn" onclick="useCurrentGpsForMap('create')"><i class="icofont-location-arrow"></i> Current Location</button>
                            </div>
                            <div id="createMapSuggestions" class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1055; max-height: 210px; overflow-y: auto; top: 100%; left: 0;"></div>
                        </div>

                        <div id="createBranchMap" style="height: 270px; width: 100%; border-radius: 10px; border: 1px solid #cbd5e1; z-index: 1;"></div>
                        <div id="createMapMsg" class="small text-muted mt-1" style="font-size: 11px;">Click or drag marker to position the branch center.</div>

                        <div class="row g-2 mt-2 align-items-center">
                            <div class="col-md-3">
                                <label class="form-label small font-weight-bold mb-1">GPS Latitude</label>
                                <input type="number" id="newBranchLat" class="form-control form-control-sm" step="0.000001" value="23.259933" onchange="syncMapFromInputs('create')">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small font-weight-bold mb-1">GPS Longitude</label>
                                <input type="number" id="newBranchLng" class="form-control form-control-sm" step="0.000001" value="77.412613" onchange="syncMapFromInputs('create')">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small font-weight-bold mb-1">Geofence Radius: <span id="newBranchRadiusLabel" class="text-primary">500m</span></label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="range" id="newBranchRadiusSlider" class="form-range flex-grow-1" min="50" max="5000" step="50" value="500" oninput="syncRadiusFromSlider('create', this.value)">
                                    <input type="number" id="newBranchRadius" class="form-control form-control-sm" style="width: 88px;" value="500" min="50" max="50000" step="50" oninput="syncRadiusFromInput('create', this.value)">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light border rounded-3 mb-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <div>
                                <div class="font-weight-bold small text-dark"><i class="icofont-clock-time text-warning me-1"></i> Branch Attendance Time Duration (IST)</div>
                                <div class="text-muted" style="font-size: 11px;">Employees &amp; Managers can mark attendance only during this window when enabled.</div>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="newBranchTimeEnabled" checked>
                                <label class="form-check-label small fw-bold" for="newBranchTimeEnabled">Enforce Timing</label>
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small font-weight-bold mb-1">Start Time (IST)</label>
                                <input type="time" id="newBranchStartTime" class="form-control form-control-sm" value="09:00" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label small font-weight-bold mb-1">End Time (IST)</label>
                                <input type="time" id="newBranchEndTime" class="form-control form-control-sm" value="17:00" required>
                            </div>
                        </div>
                        <div class="row g-2 align-items-end">
                            <div class="col-6 col-md-4">
                                <label class="form-label small font-weight-bold mb-1">Early Check-In (Min)</label>
                                <input type="number" id="newBranchCheckInEarly" class="form-control form-control-sm" value="10" min="0" max="180">
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label small font-weight-bold mb-1">Early Check-Out (Min)</label>
                                <input type="number" id="newBranchCheckOutEarly" class="form-control form-control-sm" value="5" min="0" max="180">
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="form-check form-switch mb-1">
                                    <input class="form-check-input" type="checkbox" id="newBranchAllowLateOut" checked>
                                    <label class="form-check-label small fw-bold" for="newBranchAllowLateOut">Allow Late Evening Out</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Designated Branch Manager</label>
                        <select id="newBranchManagerId" class="form-select">
                            <option value="">-- No Manager Assigned (Assign Later) --</option>
                            <% if (managers && managers.length > 0) { %>
                                <% managers.forEach(m => { %>
                                    <option value="<%= m._id %>"><%= m.name %> (<%= m.employeeId || 'Manager' %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                        <div class="form-text text-muted" style="font-size: 11px;">Each branch can only have one Branch Manager.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm font-weight-bold px-3" style="background: var(--admin-navy-primary);">
                        Create Branch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Branch -->
<div class="modal fade" id="editBranchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-weight-bold text-dark">
                    <i class="icofont-ui-edit text-primary me-1"></i> Edit Branch Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form onsubmit="handleUpdateBranch(event)">
                <div class="modal-body p-4">
                    <input type="hidden" id="editBranchId">
                    <div id="editBranchErrAlert" class="alert alert-danger d-none small"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label class="form-label small font-weight-bold">Branch Name *</label>
                            <input type="text" id="editBranchName" class="form-control" required>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small font-weight-bold">Branch Code</label>
                            <input type="text" id="editBranchCode" class="form-control" disabled>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Contact Number *</label>
                            <input type="text" id="editBranchPhone" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Email</label>
                            <input type="email" id="editBranchEmail" class="form-control">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Address *</label>
                        <input type="text" id="editBranchAddress" class="form-control" required>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">City</label>
                            <input type="text" id="editBranchCity" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">District</label>
                            <input type="text" id="editBranchDistrict" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">State</label>
                            <input type="text" id="editBranchState" class="form-control" required>
                        </div>
                    </div>

                    <div class="p-3 bg-light border rounded-3 mb-3" id="editGeofenceSection">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <div>
                                <div class="font-weight-bold small text-dark"><i class="icofont-map-pins text-primary me-1"></i> Branch Geofence Location &amp; Boundary Map</div>
                                <div class="text-muted" style="font-size: 11px;">Staff (Managers &amp; Employees) must be inside this circle to mark attendance.</div>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="editBranchGeofenceEnabled" checked>
                                <label class="form-check-label small fw-bold" for="editBranchGeofenceEnabled">Enforce Geofence</label>
                            </div>
                        </div>

                        <div class="position-relative mb-2">
                            <div class="input-group input-group-sm">
                                <input type="text" id="editMapSearchInput" class="form-control" autocomplete="off" placeholder="Search city, area, pincode, or paste lat,lng..." oninput="scheduleMapAutocomplete('edit')" onkeydown="if(event.key==='Enter'){event.preventDefault();searchBranchMap('edit', true);}">
                                <button type="button" class="btn btn-outline-primary" onclick="searchBranchMap('edit', true)"><i class="icofont-search-1"></i> Search</button>
                                <button type="button" class="btn btn-outline-success" id="editGpsBtn" onclick="useCurrentGpsForMap('edit')"><i class="icofont-location-arrow"></i> Current Location</button>
                            </div>
                            <div id="editMapSuggestions" class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1055; max-height: 210px; overflow-y: auto; top: 100%; left: 0;"></div>
                        </div>

                        <div id="editBranchMap" style="height: 270px; width: 100%; border-radius: 10px; border: 1px solid #cbd5e1; z-index: 1;"></div>
                        <div id="editMapMsg" class="small text-muted mt-1" style="font-size: 11px;">Click on map or drag pin to update exact branch coordinates.</div>

                        <div class="row g-2 mt-2 align-items-center">
                            <div class="col-md-3">
                                <label class="form-label small font-weight-bold mb-1">Latitude</label>
                                <input type="number" id="editBranchLat" class="form-control form-control-sm" step="0.000001" onchange="syncMapFromInputs('edit')">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small font-weight-bold mb-1">Longitude</label>
                                <input type="number" id="editBranchLng" class="form-control form-control-sm" step="0.000001" onchange="syncMapFromInputs('edit')">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small font-weight-bold mb-1">Geofence Radius: <span id="editBranchRadiusLabel" class="text-primary">500m</span></label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="range" id="editBranchRadiusSlider" class="form-range flex-grow-1" min="50" max="5000" step="50" value="500" oninput="syncRadiusFromSlider('edit', this.value)">
                                    <input type="number" id="editBranchRadius" class="form-control form-control-sm" style="width: 88px;" min="50" max="50000" step="50" oninput="syncRadiusFromInput('edit', this.value)">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light border rounded-3 mb-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <div>
                                <div class="font-weight-bold small text-dark"><i class="icofont-clock-time text-warning me-1"></i> Branch Attendance Time Duration (IST)</div>
                                <div class="text-muted" style="font-size: 11px;">Staff (Employees &amp; Managers) can mark attendance only during these hours when enabled.</div>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="editBranchTimeEnabled" checked>
                                <label class="form-check-label small fw-bold" for="editBranchTimeEnabled">Enforce Timing</label>
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small font-weight-bold mb-1">Start Time (IST)</label>
                                <input type="time" id="editBranchStartTime" class="form-control form-control-sm" value="09:00" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label small font-weight-bold mb-1">End Time (IST)</label>
                                <input type="time" id="editBranchEndTime" class="form-control form-control-sm" value="17:00" required>
                            </div>
                        </div>
                        <div class="row g-2 align-items-end">
                            <div class="col-6 col-md-4">
                                <label class="form-label small font-weight-bold mb-1">Early Check-In (Min)</label>
                                <input type="number" id="editBranchCheckInEarly" class="form-control form-control-sm" value="10" min="0" max="180">
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label small font-weight-bold mb-1">Early Check-Out (Min)</label>
                                <input type="number" id="editBranchCheckOutEarly" class="form-control form-control-sm" value="5" min="0" max="180">
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="form-check form-switch mb-1">
                                    <input class="form-check-input" type="checkbox" id="editBranchAllowLateOut" checked>
                                    <label class="form-check-label small fw-bold" for="editBranchAllowLateOut">Allow Late Evening Out</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Designated Branch Manager</label>
                        <select id="editBranchManagerId" class="form-select">
                            <option value="">-- No Manager Assigned --</option>
                            <% if (managers && managers.length > 0) { %>
                                <% managers.forEach(m => { %>
                                    <option value="<%= m._id %>"><%= m.name %> (<%= m.employeeId || 'Manager' %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm font-weight-bold" style="background: var(--admin-navy-primary);">
                        Update Branch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
<script src="/vendor/leaflet/leaflet.js"></script>
<script>
const CSRF_TOKEN = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

const mapControllers = {};

function getFieldIds(mode) {
    return mode === 'create'
        ? { mapEl: 'createBranchMap', latEl: 'newBranchLat', lngEl: 'newBranchLng', radEl: 'newBranchRadius', sliderEl: 'newBranchRadiusSlider', labelEl: 'newBranchRadiusLabel', searchEl: 'createMapSearchInput', sugEl: 'createMapSuggestions', gpsBtnEl: 'createGpsBtn', msgEl: 'createMapMsg' }
        : { mapEl: 'editBranchMap', latEl: 'editBranchLat', lngEl: 'editBranchLng', radEl: 'editBranchRadius', sliderEl: 'editBranchRadiusSlider', labelEl: 'editBranchRadiusLabel', searchEl: 'editMapSearchInput', sugEl: 'editMapSuggestions', gpsBtnEl: 'editGpsBtn', msgEl: 'editMapMsg' };
}

function initOrRefreshMap(mode, focusCoords = null) {
    if (typeof L === 'undefined') return;
    const ids = getFieldIds(mode);
    const latInput = document.getElementById(ids.latEl);
    const lngInput = document.getElementById(ids.lngEl);
    const radInput = document.getElementById(ids.radEl);
    const lat = Number.isFinite(Number(focusCoords && focusCoords.lat)) ? Number(focusCoords.lat) : (parseFloat(latInput.value) || 23.3315);
    const lng = Number.isFinite(Number(focusCoords && focusCoords.lng)) ? Number(focusCoords.lng) : (parseFloat(lngInput.value) || 77.7807);
    const radius = Math.max(50, parseInt(radInput.value, 10) || 500);

    if (!mapControllers[mode]) {
        const map = L.map(ids.mapEl, { zoomControl: true }).setView([lat, lng], 16);
        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            maxNativeZoom: 18,
            maxZoom: 19,
            attribution: '&copy; Esri Satellite'
        }).addTo(map);

        const marker = L.marker([lat, lng], { draggable: true }).addTo(map);
        const circle = L.circle([lat, lng], {
            radius,
            color: '#fbec6b',
            weight: 2.5,
            fillColor: '#38bdf8',
            fillOpacity: 0.22
        }).addTo(map);

        const updatePosition = (newLat, newLng, pan = false) => {
            const fixedLat = Number(newLat.toFixed(6));
            const fixedLng = Number(newLng.toFixed(6));
            latInput.value = fixedLat;
            lngInput.value = fixedLng;
            marker.setLatLng([fixedLat, fixedLng]);
            circle.setLatLng([fixedLat, fixedLng]);
            if (pan) map.setView([fixedLat, fixedLng], Math.max(map.getZoom(), 15));
            document.getElementById(ids.msgEl).innerText = `Pinned: ${fixedLat}, ${fixedLng} (Radius: ${circle.getRadius()}m)`;
        };

        marker.on('dragend', (ev) => {
            const pos = ev.target.getLatLng();
            updatePosition(pos.lat, pos.lng, false);
        });
        map.on('click', (ev) => {
            updatePosition(ev.latlng.lat, ev.latlng.lng, false);
        });

        mapControllers[mode] = { map, marker, circle, updatePosition };
    } else {
        const ctrl = mapControllers[mode];
        ctrl.marker.setLatLng([lat, lng]);
        ctrl.circle.setLatLng([lat, lng]);
        ctrl.circle.setRadius(radius);
        ctrl.map.setView([lat, lng], 16);
    }

    document.getElementById(ids.labelEl).innerText = `${radius}m`;
    const slider = document.getElementById(ids.sliderEl);
    if (slider) slider.value = Math.min(5000, Math.max(50, radius));
    setTimeout(() => mapControllers[mode] && mapControllers[mode].map.invalidateSize(), 220);
}

function syncMapFromInputs(mode) {
    const ids = getFieldIds(mode);
    const lat = parseFloat(document.getElementById(ids.latEl).value);
    const lng = parseFloat(document.getElementById(ids.lngEl).value);
    const ctrl = mapControllers[mode];
    if (ctrl && Number.isFinite(lat) && Number.isFinite(lng) && Math.abs(lat) <= 90 && Math.abs(lng) <= 180) {
        ctrl.updatePosition(lat, lng, true);
    }
}

function syncRadiusFromSlider(mode, val) {
    const ids = getFieldIds(mode);
    const radius = Math.max(50, parseInt(val, 10) || 500);
    document.getElementById(ids.radEl).value = radius;
    document.getElementById(ids.labelEl).innerText = `${radius}m`;
    if (mapControllers[mode]) {
        mapControllers[mode].circle.setRadius(radius);
    }
}

function syncRadiusFromInput(mode, val) {
    const ids = getFieldIds(mode);
    const radius = Math.min(50000, Math.max(50, parseInt(val, 10) || 500));
    document.getElementById(ids.labelEl).innerText = `${radius}m`;
    const slider = document.getElementById(ids.sliderEl);
    if (slider) slider.value = Math.min(5000, radius);
    if (mapControllers[mode]) {
        mapControllers[mode].circle.setRadius(radius);
    }
}

const mapSearchTimers = {};
const mapLastResults = {};

function hideSuggestions(mode) {
    const ids = getFieldIds(mode);
    const box = document.getElementById(ids.sugEl);
    if (box) box.classList.add('d-none');
}

function selectMapSearchResult(mode, idx) {
    const list = mapLastResults[mode] || [];
    const item = list[idx];
    if (!item) return;
    const ids = getFieldIds(mode);
    document.getElementById(ids.searchEl).value = item.label;
    hideSuggestions(mode);
    initOrRefreshMap(mode, { lat: item.lat, lng: item.lng });
    if (mapControllers[mode]) {
        mapControllers[mode].updatePosition(item.lat, item.lng, true);
    }
    if (mode === 'create') {
        const cityEl = document.getElementById('newBranchCity');
        const distEl = document.getElementById('newBranchDistrict');
        const stateEl = document.getElementById('newBranchState');
        if (cityEl && !cityEl.value.trim() && item.city) cityEl.value = item.city;
        if (distEl && !distEl.value.trim() && item.district) distEl.value = item.district;
        if (stateEl && item.state) stateEl.value = item.state;
    }
    document.getElementById(ids.msgEl).innerText = `Pinned: ${item.label} (${item.lat.toFixed(6)}, ${item.lng.toFixed(6)})`;
}

function scheduleMapAutocomplete(mode) {
    const ids = getFieldIds(mode);
    const q = (document.getElementById(ids.searchEl).value || '').trim();
    clearTimeout(mapSearchTimers[mode]);
    if (q.length < 3) {
        hideSuggestions(mode);
        return;
    }
    mapSearchTimers[mode] = setTimeout(() => searchBranchMap(mode, false), 380);
}

async function searchBranchMap(mode, selectFirst = false) {
    const ids = getFieldIds(mode);
    const q = (document.getElementById(ids.searchEl).value || '').trim();
    const msgEl = document.getElementById(ids.msgEl);
    const sugBox = document.getElementById(ids.sugEl);
    if (q.length < 2) {
        hideSuggestions(mode);
        return;
    }
    msgEl.innerText = 'Searching location on map...';
    try {
        const res = await fetch(`/api/admin/geocode?q=${encodeURIComponent(q)}`);
        const payload = await res.json();
        const results = (payload && payload.success && Array.isArray(payload.results)) ? payload.results : [];
        mapLastResults[mode] = results;

        if (results.length === 0) {
            hideSuggestions(mode);
            msgEl.innerText = 'No matching places found. Try city/area name, pin code, or paste lat,lng coordinates.';
            return;
        }

        if (selectFirst) {
            selectMapSearchResult(mode, 0);
            return;
        }

        sugBox.innerHTML = results.map((item, idx) => `
            <button type="button" class="list-group-item list-group-item-action py-2 px-3 small text-start" onclick="selectMapSearchResult('${mode}', ${idx})">
                <i class="icofont-location-pin text-danger me-1"></i> ${String(item.label).replace(/</g, '&lt;')}
            </button>
        `).join('');
        sugBox.classList.remove('d-none');
        msgEl.innerText = `Select a matching location from the dropdown (${results.length} found).`;
    } catch (_) {
        hideSuggestions(mode);
        msgEl.innerText = 'Location search failed. You can paste lat,lng (e.g. 23.2599, 77.4126) or click directly on the map.';
    }
}

function useCurrentGpsForMap(mode) {
    const ids = getFieldIds(mode);
    const msgEl = document.getElementById(ids.msgEl);
    const btn = document.getElementById(ids.gpsBtnEl);
    hideSuggestions(mode);

    if (!navigator.geolocation) {
        msgEl.innerText = 'Device GPS is not supported by this browser.';
        return;
    }
    if (window.isSecureContext === false && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
        msgEl.innerText = 'Browser blocks GPS on non-HTTPS LAN URLs. Open via localhost/HTTPS or click directly on the map.';
        return;
    }

    if (btn) btn.disabled = true;
    msgEl.innerText = 'Detecting your current location...';

    const onSuccess = (pos) => {
        if (btn) btn.disabled = false;
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;
        initOrRefreshMap(mode, { lat, lng });
        if (mapControllers[mode]) {
            mapControllers[mode].updatePosition(lat, lng, true);
        }
        msgEl.innerText = `Current location selected: ${lat.toFixed(6)}, ${lng.toFixed(6)} (±${Math.round(pos.coords.accuracy)}m).`;
    };

    const onFinalError = (err) => {
        if (btn) btn.disabled = false;
        if (err && err.code === 1) {
            msgEl.innerText = 'Location permission blocked in browser settings. Please allow Location access or pick on the map.';
        } else {
            msgEl.innerText = 'Could not detect device location automatically. Please search area or click directly on the map.';
        }
    };

    navigator.geolocation.getCurrentPosition(
        onSuccess,
        (err) => {
            if (err && err.code === 1) {
                onFinalError(err);
                return;
            }
            // Retry with Wi-Fi / network location for Windows desktops & indoors
            navigator.geolocation.getCurrentPosition(
                onSuccess,
                onFinalError,
                { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 }
            );
        },
        { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
    );
}

document.addEventListener('click', (ev) => {
    ['create', 'edit'].forEach(mode => {
        const ids = getFieldIds(mode);
        const searchEl = document.getElementById(ids.searchEl);
        const sugEl = document.getElementById(ids.sugEl);
        if (sugEl && searchEl && !sugEl.contains(ev.target) && ev.target !== searchEl) {
            hideSuggestions(mode);
        }
    });
});

document.addEventListener('DOMContentLoaded', () => {
    const createModalEl = document.getElementById('createBranchModal');
    const editModalEl = document.getElementById('editBranchModal');
    if (createModalEl) {
        createModalEl.addEventListener('shown.bs.modal', () => initOrRefreshMap('create'));
    }
    if (editModalEl) {
        editModalEl.addEventListener('shown.bs.modal', () => {
            initOrRefreshMap('edit');
        });
    }
});

function showToast(msg) {
    const toast = document.getElementById('branchToast');
    const toastMsg = document.getElementById('branchToastMsg');
    if (toast && toastMsg) {
        toastMsg.innerText = msg;
        toast.classList.remove('d-none');
        setTimeout(() => toast.classList.add('d-none'), 5000);
    }
}

async function handleCreateBranch(e) {
    e.preventDefault();
    const errBox = document.getElementById('createBranchErrAlert');
    errBox.classList.add('d-none');

    const body = {
        name: document.getElementById('newBranchName').value,
        code: document.getElementById('newBranchCode').value,
        contactNumber: document.getElementById('newBranchPhone').value,
        email: document.getElementById('newBranchEmail').value,
        address: document.getElementById('newBranchAddress').value,
        city: document.getElementById('newBranchCity').value,
        district: document.getElementById('newBranchDistrict').value,
        state: document.getElementById('newBranchState').value,
        latitude: document.getElementById('newBranchLat').value,
        longitude: document.getElementById('newBranchLng').value,
        geofenceRadiusMeters: document.getElementById('newBranchRadius').value,
        geofenceEnabled: document.getElementById('newBranchGeofenceEnabled').checked,
        attendanceTimeEnabled: document.getElementById('newBranchTimeEnabled').checked,
        attendanceStartTime: document.getElementById('newBranchStartTime').value,
        attendanceEndTime: document.getElementById('newBranchEndTime').value,
        checkInEarlyMinutes: document.getElementById('newBranchCheckInEarly').value,
        checkOutEarlyMinutes: document.getElementById('newBranchCheckOutEarly').value,
        allowLateCheckOut: document.getElementById('newBranchAllowLateOut').checked,
        managerId: document.getElementById('newBranchManagerId').value || null,
        _csrf: CSRF_TOKEN
    };

    try {
        const res = await fetch('/api/admin/branches/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('createBranchModal')).hide();
            showToast(data.message || 'Branch created successfully.');
            setTimeout(() => location.reload(), 800);
        } else {
            errBox.innerText = data.message || 'Error creating branch.';
            errBox.classList.remove('d-none');
        }
    } catch (err) {
        errBox.innerText = 'Server communication error.';
        errBox.classList.remove('d-none');
    }
}

function openEditModal(branch, focusMap = false) {
    document.getElementById('editBranchId').value = branch._id;
    document.getElementById('editBranchName').value = branch.name || '';
    document.getElementById('editBranchCode').value = branch.code || '';
    document.getElementById('editBranchPhone').value = branch.contactNumber || '';
    document.getElementById('editBranchEmail').value = branch.email || '';
    document.getElementById('editBranchAddress').value = branch.address || '';
    document.getElementById('editBranchCity').value = branch.city || '';
    document.getElementById('editBranchDistrict').value = branch.district || '';
    document.getElementById('editBranchState').value = branch.state || '';
    document.getElementById('editBranchLat').value = (branch.coordinates && Number.isFinite(Number(branch.coordinates.latitude))) ? branch.coordinates.latitude : 23.3315;
    document.getElementById('editBranchLng').value = (branch.coordinates && Number.isFinite(Number(branch.coordinates.longitude))) ? branch.coordinates.longitude : 77.7807;
    const rad = branch.geofenceRadiusMeters || 500;
    document.getElementById('editBranchRadius').value = rad;
    document.getElementById('editBranchRadiusSlider').value = Math.min(5000, Math.max(50, rad));
    document.getElementById('editBranchRadiusLabel').innerText = `${rad}m`;
    document.getElementById('editBranchGeofenceEnabled').checked = branch.geofenceEnabled !== false;
    document.getElementById('editBranchTimeEnabled').checked = branch.attendanceTimeEnabled !== false;
    document.getElementById('editBranchStartTime').value = branch.attendanceStartTime || '09:00';
    document.getElementById('editBranchEndTime').value = branch.attendanceEndTime || '17:00';
    document.getElementById('editBranchCheckInEarly').value = branch.checkInEarlyMinutes !== undefined ? branch.checkInEarlyMinutes : 10;
    document.getElementById('editBranchCheckOutEarly').value = branch.checkOutEarlyMinutes !== undefined ? branch.checkOutEarlyMinutes : 5;
    document.getElementById('editBranchAllowLateOut').checked = branch.allowLateCheckOut !== false;
    
    const mgrId = branch.manager ? (branch.manager._id || branch.manager) : '';
    document.getElementById('editBranchManagerId').value = mgrId;

    const modalEl = document.getElementById('editBranchModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();
    if (focusMap) {
        setTimeout(() => {
            const sec = document.getElementById('editGeofenceSection');
            if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 260);
    }
}

async function handleUpdateBranch(e) {
    e.preventDefault();
    const errBox = document.getElementById('editBranchErrAlert');
    errBox.classList.add('d-none');

    const body = {
        branchId: document.getElementById('editBranchId').value,
        name: document.getElementById('editBranchName').value,
        contactNumber: document.getElementById('editBranchPhone').value,
        email: document.getElementById('editBranchEmail').value,
        address: document.getElementById('editBranchAddress').value,
        city: document.getElementById('editBranchCity').value,
        district: document.getElementById('editBranchDistrict').value,
        state: document.getElementById('editBranchState').value,
        latitude: document.getElementById('editBranchLat').value,
        longitude: document.getElementById('editBranchLng').value,
        geofenceRadiusMeters: document.getElementById('editBranchRadius').value,
        geofenceEnabled: document.getElementById('editBranchGeofenceEnabled').checked,
        attendanceTimeEnabled: document.getElementById('editBranchTimeEnabled').checked,
        attendanceStartTime: document.getElementById('editBranchStartTime').value,
        attendanceEndTime: document.getElementById('editBranchEndTime').value,
        checkInEarlyMinutes: document.getElementById('editBranchCheckInEarly').value,
        checkOutEarlyMinutes: document.getElementById('editBranchCheckOutEarly').value,
        allowLateCheckOut: document.getElementById('editBranchAllowLateOut').checked,
        managerId: document.getElementById('editBranchManagerId').value || null,
        _csrf: CSRF_TOKEN
    };

    try {
        const res = await fetch('/api/admin/branches/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('editBranchModal')).hide();
            showToast(data.message || 'Branch updated successfully.');
            setTimeout(() => location.reload(), 800);
        } else {
            errBox.innerText = data.message || 'Error updating branch.';
            errBox.classList.remove('d-none');
        }
    } catch (err) {
        errBox.innerText = 'Server communication error.';
        errBox.classList.remove('d-none');
    }
}

async function toggleStatus(branchId, isActive) {
    const action = isActive ? 'activate' : 'deactivate';
    if (!confirm(`Are you sure you want to ${action} this branch?`)) return;

    try {
        const res = await fetch('/api/admin/branches/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify({ branchId, isActive, _csrf: CSRF_TOKEN })
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.message);
            setTimeout(() => location.reload(), 800);
        } else {
            alert(data.message || 'Error toggling branch status.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}
</script>

<%- include('partials/admin-footer') %>
