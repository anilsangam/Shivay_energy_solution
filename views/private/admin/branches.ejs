<%- include('partials/admin-head') %>

<%
    const authUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : ((typeof user !== 'undefined' && user) ? user : null);
    const checkPerm = (typeof hasPermission === 'function') 
        ? hasPermission 
        : ((k) => authUser && (authUser.isPrimarySuperAdmin || (Array.isArray(authUser.permissions) && authUser.permissions.includes(k))));

    const canCreateBranch = checkPerm('branches.offices.create');
    const canEditBranch = checkPerm('branches.offices.edit');
    const canManageBranch = checkPerm('branches.offices.manage');
    const canViewStaff = checkPerm('users.employees.view');
%>

<!-- Action Feedback Alert Banner -->
<div id="branchToast" class="alert alert-success alert-dismissible fade show d-none mb-4" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="branchToastMsg">Branch updated successfully.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('branchToast').classList.add('d-none')"></button>
</div>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            <i class="icofont-building-alt me-2 text-warning"></i> Regional Branches & Operational Hubs
        </h2>
        <p class="text-muted small mb-0">
            Manage company branches, regional office contacts, GPS attendance geofencing, and designated Branch Managers.
        </p>
    </div>
    <div class="d-flex gap-2">
        <% if (canCreateBranch) { %>
            <button class="btn btn-warning font-weight-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#createBranchModal" style="border-radius: 8px;">
                <i class="icofont-plus-circle me-1"></i> Add New Branch
            </button>
        <% } %>
        <% if (canViewStaff) { %>
            <a href="/admin/employees" class="btn btn-outline-primary" style="border-radius: 8px;">
                <i class="icofont-users-alt-2 me-1"></i> Staff Management
            </a>
        <% } %>
    </div>
</div>

<!-- Top Metrics Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Total Branches</span>
            <div class="h3 font-weight-bold text-dark mb-0 mt-1"><%= stats.totalBranches %></div>
            <div class="small text-muted mt-1"><%= stats.activeBranches %> operational hubs</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Active Regional Hubs</span>
            <div class="h3 font-weight-bold text-success mb-0 mt-1"><%= stats.activeBranches %></div>
            <div class="small text-muted mt-1">100% geofenced</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Field Personnel</span>
            <div class="h3 font-weight-bold text-primary mb-0 mt-1"><%= stats.totalEmployees %></div>
            <div class="small text-muted mt-1">Assigned across branches</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
            <span class="text-muted small font-weight-bold text-uppercase">Active Solar Projects</span>
            <div class="h3 font-weight-bold text-warning mb-0 mt-1"><%= stats.totalProjects %></div>
            <div class="small text-muted mt-1">Under regional execution</div>
        </div>
    </div>
</div>

<!-- Branches Table Card -->
<div class="admin-card border-0 shadow-sm" style="border-radius: 12px; border: 1px solid var(--admin-border, #cbd5e1) !important;">
    <div class="admin-card-header bg-white p-3 border-bottom d-flex align-items-center justify-content-between">
        <div>
            <h5 class="admin-card-title mb-0">Branch Locations (<%= branches.length %>)</h5>
            <div class="admin-card-subtitle small text-muted">Authorized regional offices and geofenced operations</div>
        </div>
        <span class="badge bg-light text-dark border">Madhya Pradesh Network</span>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Branch Details</th>
                    <th>Branch Code</th>
                    <th>Location / District</th>
                    <th>Branch Manager</th>
                    <th>Contact & Email</th>
                    <th>Geofence</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (branches && branches.length > 0) { %>
                    <% branches.forEach(b => { 
                        const mgr = b.manager;
                        const mgrName = (mgr && mgr.name) ? mgr.name : 'Unassigned';
                        const mgrEmpId = (mgr && mgr.employeeId) ? mgr.employeeId : '';
                    %>
                        <tr id="branch-row-<%= b._id %>">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="admin-avatar-circle" style="width: 36px; height: 36px; font-size: 13px; background: #e0f2fe; color: #0284c7;">
                                        <i class="icofont-building"></i>
                                    </div>
                                    <div>
                                        <strong class="text-dark"><%= b.name %></strong>
                                        <div class="text-muted" style="font-size: 11px;"><%= b.address %></div>
                                    </div>
                                </div>
                            </td>
                            <td><code><%= b.code %></code></td>
                            <td>
                                <div><strong class="text-dark"><%= b.city %></strong></div>
                                <div class="text-muted" style="font-size: 11px;"><%= b.district %>, <%= b.state %></div>
                            </td>
                            <td>
                                <% if (mgr && mgr.name) { %>
                                    <span class="d-inline-flex align-items-center gap-1 font-weight-bold" style="font-size: 12.5px; color: var(--admin-navy-primary);">
                                        <i class="icofont-business-man text-warning"></i> <%= mgrName %>
                                    </span>
                                    <div class="text-muted" style="font-size: 11px;"><%= mgrEmpId %></div>
                                <% } else { %>
                                    <span class="badge bg-light text-muted border">No Manager Assigned</span>
                                <% } %>
                            </td>
                            <td>
                                <div style="font-size: 12px;"><i class="icofont-phone text-muted me-1"></i><%= b.contactNumber %></div>
                                <% if (b.email) { %>
                                    <div style="font-size: 12px;"><i class="icofont-envelope text-muted me-1"></i><%= b.email %></div>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="icofont-location-pin text-primary me-1"></i><%= b.geofenceRadiusMeters || 500 %>m
                                </span>
                            </td>
                            <td>
                                <% if (b.isActive !== false) { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                                <% } else { %>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Inactive</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <% if (canEditBranch) { %>
                                        <button class="btn btn-sm btn-outline-primary py-1 px-2" title="Edit Branch" onclick='openEditModal(<%= JSON.stringify(b) %>)'>
                                            <i class="icofont-ui-edit"></i>
                                        </button>
                                    <% } %>
                                    <% if (canManageBranch) { %>
                                        <% if (b.isActive !== false) { %>
                                            <button class="btn btn-sm btn-outline-warning py-1 px-2" title="Deactivate Branch" onclick="toggleStatus('<%= b._id %>', false)">
                                                <i class="icofont-ban"></i>
                                            </button>
                                        <% } else { %>
                                            <button class="btn btn-sm btn-outline-success py-1 px-2" title="Activate Branch" onclick="toggleStatus('<%= b._id %>', true)">
                                                <i class="icofont-check"></i>
                                            </button>
                                        <% } %>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">No branch locations found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add New Branch -->
<div class="modal fade" id="createBranchModal" tabindex="-1" aria-labelledby="createBranchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header text-white" style="background: var(--admin-navy-primary); border-top-left-radius: 16px; border-top-right-radius: 16px;">
                <h5 class="modal-title font-weight-bold" id="createBranchModalLabel">
                    <i class="icofont-plus-circle me-1 text-warning"></i> Add New Regional Branch
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form onsubmit="handleCreateBranch(event)">
                <div class="modal-body p-4">
                    <div id="createBranchErrAlert" class="alert alert-danger d-none small"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label class="form-label small font-weight-bold">Branch Name *</label>
                            <input type="text" id="newBranchName" class="form-control" required placeholder="e.g. Bhopal Regional Hub">
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small font-weight-bold">Branch Code (Optional)</label>
                            <input type="text" id="newBranchCode" class="form-control" placeholder="Leave blank to auto-generate (e.g. MP-BPL-02)">
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Official Contact Number *</label>
                            <input type="text" id="newBranchPhone" class="form-control" required placeholder="+91 755 2400000">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Branch Official Email</label>
                            <input type="email" id="newBranchEmail" class="form-control" placeholder="bhopal@shivayenergy.com">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Office Address Line *</label>
                        <input type="text" id="newBranchAddress" class="form-control" required placeholder="Plot No., Commercial Complex / Street">
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">City *</label>
                            <input type="text" id="newBranchCity" class="form-control" required placeholder="Bhopal">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">District *</label>
                            <input type="text" id="newBranchDistrict" class="form-control" required placeholder="Bhopal">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">State *</label>
                            <input type="text" id="newBranchState" class="form-control" required value="Madhya Pradesh">
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">GPS Latitude</label>
                            <input type="number" id="newBranchLat" class="form-control" step="0.000001" value="23.259933">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">GPS Longitude</label>
                            <input type="number" id="newBranchLng" class="form-control" step="0.000001" value="77.412613">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">Geofence Radius (Meters)</label>
                            <input type="number" id="newBranchRadius" class="form-control" value="500" min="50" max="5000" step="50">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Designated Branch Manager</label>
                        <select id="newBranchManagerId" class="form-select">
                            <option value="">-- No Manager Assigned (Assign Later) --</option>
                            <% if (managers && managers.length > 0) { %>
                                <% managers.forEach(m => { %>
                                    <option value="<%= m._id %>"><%= m.name %> (<%= m.employeeId || 'Manager' %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                        <div class="form-text text-muted" style="font-size: 11px;">Each branch can only have one Branch Manager.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm font-weight-bold px-3" style="background: var(--admin-navy-primary);">
                        Create Branch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Branch -->
<div class="modal fade" id="editBranchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-weight-bold text-dark">
                    <i class="icofont-ui-edit text-primary me-1"></i> Edit Branch Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form onsubmit="handleUpdateBranch(event)">
                <div class="modal-body p-4">
                    <input type="hidden" id="editBranchId">
                    <div id="editBranchErrAlert" class="alert alert-danger d-none small"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label class="form-label small font-weight-bold">Branch Name *</label>
                            <input type="text" id="editBranchName" class="form-control" required>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small font-weight-bold">Branch Code</label>
                            <input type="text" id="editBranchCode" class="form-control" disabled>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Contact Number *</label>
                            <input type="text" id="editBranchPhone" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small font-weight-bold">Email</label>
                            <input type="email" id="editBranchEmail" class="form-control">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Address *</label>
                        <input type="text" id="editBranchAddress" class="form-control" required>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">City</label>
                            <input type="text" id="editBranchCity" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">District</label>
                            <input type="text" id="editBranchDistrict" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">State</label>
                            <input type="text" id="editBranchState" class="form-control" required>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">Latitude</label>
                            <input type="number" id="editBranchLat" class="form-control" step="0.000001">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">Longitude</label>
                            <input type="number" id="editBranchLng" class="form-control" step="0.000001">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small font-weight-bold">Geofence Radius (Meters)</label>
                            <input type="number" id="editBranchRadius" class="form-control" min="50" max="5000" step="50">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small font-weight-bold">Designated Branch Manager</label>
                        <select id="editBranchManagerId" class="form-select">
                            <option value="">-- No Manager Assigned --</option>
                            <% if (managers && managers.length > 0) { %>
                                <% managers.forEach(m => { %>
                                    <option value="<%= m._id %>"><%= m.name %> (<%= m.employeeId || 'Manager' %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm font-weight-bold" style="background: var(--admin-navy-primary);">
                        Update Branch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const CSRF_TOKEN = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

function showToast(msg) {
    const toast = document.getElementById('branchToast');
    const toastMsg = document.getElementById('branchToastMsg');
    if (toast && toastMsg) {
        toastMsg.innerText = msg;
        toast.classList.remove('d-none');
        setTimeout(() => toast.classList.add('d-none'), 5000);
    }
}

async function handleCreateBranch(e) {
    e.preventDefault();
    const errBox = document.getElementById('createBranchErrAlert');
    errBox.classList.add('d-none');

    const body = {
        name: document.getElementById('newBranchName').value,
        code: document.getElementById('newBranchCode').value,
        contactNumber: document.getElementById('newBranchPhone').value,
        email: document.getElementById('newBranchEmail').value,
        address: document.getElementById('newBranchAddress').value,
        city: document.getElementById('newBranchCity').value,
        district: document.getElementById('newBranchDistrict').value,
        state: document.getElementById('newBranchState').value,
        latitude: document.getElementById('newBranchLat').value,
        longitude: document.getElementById('newBranchLng').value,
        geofenceRadiusMeters: document.getElementById('newBranchRadius').value,
        managerId: document.getElementById('newBranchManagerId').value || null,
        _csrf: CSRF_TOKEN
    };

    try {
        const res = await fetch('/api/admin/branches/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('createBranchModal')).hide();
            showToast(data.message || 'Branch created successfully.');
            setTimeout(() => location.reload(), 800);
        } else {
            errBox.innerText = data.message || 'Error creating branch.';
            errBox.classList.remove('d-none');
        }
    } catch (err) {
        errBox.innerText = 'Server communication error.';
        errBox.classList.remove('d-none');
    }
}

function openEditModal(branch) {
    document.getElementById('editBranchId').value = branch._id;
    document.getElementById('editBranchName').value = branch.name || '';
    document.getElementById('editBranchCode').value = branch.code || '';
    document.getElementById('editBranchPhone').value = branch.contactNumber || '';
    document.getElementById('editBranchEmail').value = branch.email || '';
    document.getElementById('editBranchAddress').value = branch.address || '';
    document.getElementById('editBranchCity').value = branch.city || '';
    document.getElementById('editBranchDistrict').value = branch.district || '';
    document.getElementById('editBranchState').value = branch.state || '';
    document.getElementById('editBranchLat').value = branch.coordinates ? branch.coordinates.latitude : '';
    document.getElementById('editBranchLng').value = branch.coordinates ? branch.coordinates.longitude : '';
    document.getElementById('editBranchRadius').value = branch.geofenceRadiusMeters || 500;
    
    const mgrId = branch.manager ? (branch.manager._id || branch.manager) : '';
    document.getElementById('editBranchManagerId').value = mgrId;

    new bootstrap.Modal(document.getElementById('editBranchModal')).show();
}

async function handleUpdateBranch(e) {
    e.preventDefault();
    const errBox = document.getElementById('editBranchErrAlert');
    errBox.classList.add('d-none');

    const body = {
        branchId: document.getElementById('editBranchId').value,
        name: document.getElementById('editBranchName').value,
        contactNumber: document.getElementById('editBranchPhone').value,
        email: document.getElementById('editBranchEmail').value,
        address: document.getElementById('editBranchAddress').value,
        city: document.getElementById('editBranchCity').value,
        district: document.getElementById('editBranchDistrict').value,
        state: document.getElementById('editBranchState').value,
        latitude: document.getElementById('editBranchLat').value,
        longitude: document.getElementById('editBranchLng').value,
        geofenceRadiusMeters: document.getElementById('editBranchRadius').value,
        managerId: document.getElementById('editBranchManagerId').value || null,
        _csrf: CSRF_TOKEN
    };

    try {
        const res = await fetch('/api/admin/branches/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('editBranchModal')).hide();
            showToast(data.message || 'Branch updated successfully.');
            setTimeout(() => location.reload(), 800);
        } else {
            errBox.innerText = data.message || 'Error updating branch.';
            errBox.classList.remove('d-none');
        }
    } catch (err) {
        errBox.innerText = 'Server communication error.';
        errBox.classList.remove('d-none');
    }
}

async function toggleStatus(branchId, isActive) {
    const action = isActive ? 'activate' : 'deactivate';
    if (!confirm(`Are you sure you want to ${action} this branch?`)) return;

    try {
        const res = await fetch('/api/admin/branches/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify({ branchId, isActive, _csrf: CSRF_TOKEN })
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.message);
            setTimeout(() => location.reload(), 800);
        } else {
            alert(data.message || 'Error toggling branch status.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}
</script>

<%- include('partials/admin-footer') %>
