<%- include('partials/admin-head') %>

<!-- Top Header & Action Banner -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="font-weight-bold mb-0" style="color: var(--admin-navy-primary); font-size: 22px;">
                Quotation: <%= quotation.quotationNumber %>
            </h2>
            <span class="badge <%= quotation.status === 'APPROVED' ? 'bg-success' : (quotation.status === 'PENDING_APPROVAL' ? 'bg-warning text-dark' : (quotation.status === 'CUSTOMER_ACCEPTED' ? 'bg-primary' : (quotation.status === 'CUSTOMER_REJECTED' ? 'bg-danger' : 'bg-secondary'))) %> px-2 py-1">
                <%= quotation.status %>
            </span>
            <span class="badge bg-light text-muted border">v<%= quotation.version %></span>
        </div>
        <p class="text-muted small mb-0">
            Prepared by <strong><%= quotation.preparedBy ? quotation.preparedBy.name : 'Branch Staff' %></strong> on <%= new Date(quotation.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
        </p>
    </div>

    <!-- Contextual Actions -->
    <div class="d-flex align-items-center flex-wrap gap-2 mt-3 mt-md-0">
        <a href="<%= currentUser && currentUser.role === 'EMPLOYEE' ? '/employee/quotations' : (currentUser && currentUser.role === 'SUPER_ADMIN' ? '/admin/quotations' : '/manager/quotations') %>" class="btn btn-sm btn-outline-secondary">
            <i class="icofont-arrow-left me-1"></i> Back
        </a>

        <!-- Maker-Checker Approval Actions for Manager / Admin -->
        <% if (quotation.status === 'PENDING_APPROVAL' && currentUser && (currentUser.role === 'BRANCH_MANAGER' || currentUser.role === 'SUPER_ADMIN')) { %>
            <% if (String(quotation.preparedBy._id) !== String(currentUser._id) || currentUser.role === 'SUPER_ADMIN') { %>
                <button class="btn btn-sm btn-success fw-bold" onclick="openApproveModal()">
                    <i class="icofont-check-circled me-1"></i> Authorize & Approve Quotation
                </button>
                <button class="btn btn-sm btn-outline-danger" onclick="openRejectModal()">
                    <i class="icofont-close-circled me-1"></i> Reject
                </button>
            <% } else { %>
                <span class="badge bg-light text-muted border p-2" title="Maker-Checker Rule: Another manager or Super Admin must approve this quotation">
                    <i class="icofont-info-circle text-warning me-1"></i> Pending Independent Approval
                </span>
            <% } %>
        <% } %>

        <!-- Actions Available for Approved Quotations -->
        <% if (quotation.status === 'APPROVED' || quotation.status === 'SHARED' || quotation.status === 'CUSTOMER_ACCEPTED' || quotation.status === 'CUSTOMER_REJECTED') { %>
            <a href="/quotations/<%= quotation._id %>/document" target="_blank" class="btn btn-sm btn-outline-primary">
                <i class="icofont-print me-1"></i> Official PDF Document
            </a>

            <a href="https://wa.me/91<%= quotation.customerMobile.replace(/[^0-9]/g, '').slice(-10) %>?text=<%= whatsappText %>" target="_blank" class="btn btn-sm btn-success fw-bold">
                <i class="icofont-brand-whatsapp me-1"></i> Send on WhatsApp
            </a>

            <button class="btn btn-sm btn-outline-secondary" onclick="copyAcceptanceLink('<%= acceptUrl %>')">
                <i class="icofont-ui-copy me-1"></i> Copy Client Link
            </button>

            <% if (quotation.status !== 'CUSTOMER_ACCEPTED' && quotation.status !== 'CUSTOMER_REJECTED') { %>
                <button class="btn btn-sm btn-dark" data-bs-toggle="modal" data-bs-target="#customerResponseModal" style="background: var(--admin-navy-primary);">
                    <i class="icofont-ui-check me-1"></i> Record Customer Decision
                </button>
            <% } %>
        <% } %>
    </div>
</div>

<!-- Customer Decision Alert Banner -->
<% if (quotation.status === 'CUSTOMER_ACCEPTED') { %>
    <div class="alert alert-success d-flex align-items-center justify-content-between mb-4 shadow-sm" style="border-left: 4px solid #10b981;">
        <div class="d-flex align-items-center gap-3">
            <i class="icofont-check-circled fs-3 text-success"></i>
            <div>
                <h6 class="mb-0 font-weight-bold">Customer Accepted Proposal!</h6>
                <small class="text-muted">Confirmed on <%= quotation.customerResponse.responseDate ? new Date(quotation.customerResponse.responseDate).toLocaleDateString('en-IN') : 'N/A' %>. Remarks: "<%= quotation.customerResponse.remarks || 'Proceeding with rooftop solar installation.' %>"</small>
            </div>
        </div>
        <span class="badge bg-success px-3 py-2">Ready for Phase 3 Project Execution</span>
    </div>
<% } else if (quotation.status === 'CUSTOMER_REJECTED') { %>
    <div class="alert alert-danger d-flex align-items-center gap-3 mb-4 shadow-sm" style="border-left: 4px solid #ef4444;">
        <i class="icofont-close-circled fs-3 text-danger"></i>
        <div>
            <h6 class="mb-0 font-weight-bold">Customer Declined Proposal</h6>
            <small class="text-muted">Decision logged on <%= quotation.customerResponse.responseDate ? new Date(quotation.customerResponse.responseDate).toLocaleDateString('en-IN') : 'N/A' %>. Customer Reason: "<%= quotation.customerResponse.remarks || 'Customer chose not to proceed.' %>"</small>
        </div>
    </div>
<% } %>

<div class="row g-4">
    <!-- Left Column: Specs, Line Items, Terms -->
    <div class="col-lg-8">
        <!-- Customer Details Card -->
        <div class="admin-card mb-4">
            <div class="admin-card-header">
                <div>
                    <h5 class="admin-card-title">Customer & Site Details</h5>
                    <div class="admin-card-subtitle">Interconnection DISCOM: <%= quotation.discom || 'MPPKVVCL' %></div>
                </div>
                <span class="badge bg-light text-primary border"><%= quotation.customerType %></span>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Client Name</small>
                        <strong class="text-dark fs-6"><%= quotation.customerName %></strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Mobile Contact</small>
                        <span class="fw-bold text-dark"><i class="icofont-phone text-success me-1"></i><%= quotation.customerMobile %></span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">DISCOM Consumer Number</small>
                        <span class="font-monospace fw-bold"><%= quotation.consumerNumber || 'Pending' %></span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Installation Address</small>
                        <span><%= quotation.address %>, <%= quotation.city %>, <%= quotation.state %> - <%= quotation.pincode %></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Technical Plant Specifications -->
        <div class="admin-card mb-4">
            <div class="admin-card-header">
                <div>
                    <h5 class="admin-card-title">Technical Plant Engineering Specifications</h5>
                    <div class="admin-card-subtitle">Designed for optimal yield in Raisen, Central Madhya Pradesh</div>
                </div>
                <span class="badge bg-primary text-white"><%= quotation.plantCapacityKw %> kW <%= quotation.systemType %></span>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <small class="text-muted d-block">System Capacity</small>
                        <h4 class="text-primary mb-0 font-weight-bold"><%= quotation.plantCapacityKw %> kW</h4>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted d-block">System Configuration</small>
                        <strong class="text-dark"><%= quotation.systemType %></strong>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted d-block">Roof Architecture</small>
                        <strong><%= quotation.roofType %></strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Line Items Table -->
        <div class="admin-card mb-4">
            <div class="admin-card-header">
                <div>
                    <h5 class="admin-card-title">Bill of Materials & Priced Line Items</h5>
                    <div class="admin-card-subtitle">Approved equipment components and statutory taxes</div>
                </div>
            </div>
            <div class="admin-table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Description</th>
                            <th>Qty</th>
                            <th>Unit Price</th>
                            <th>Taxable (₹)</th>
                            <th>GST</th>
                            <th class="text-end">Line Total (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% quotation.lineItems.forEach((item, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td>
                                    <strong class="text-dark"><%= item.description %></strong>
                                    <% if (item.sku) { %><div class="small text-muted font-monospace"><%= item.sku %></div><% } %>
                                </td>
                                <td><%= item.quantity %> <%= item.unit %></td>
                                <td>₹ <%= Number(item.unitPrice).toLocaleString('en-IN') %></td>
                                <td>₹ <%= Number(item.taxableAmount).toLocaleString('en-IN') %></td>
                                <td><span class="badge bg-light text-muted border"><%= item.gstRate %>%</span></td>
                                <td class="text-end fw-bold text-dark">₹ <%= Number(item.lineTotal).toLocaleString('en-IN') %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Scope, Terms & Warranties -->
        <div class="admin-card mb-4">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Commercial Scope & Warranties</h5>
            </div>
            <div class="p-4">
                <div class="mb-3">
                    <small class="text-muted d-block fw-bold">Warranty Clauses</small>
                    <p class="small text-dark mb-0"><%= quotation.warrantyTerms %></p>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block fw-bold">Delivery & Interconnection Timeline</small>
                    <p class="small text-dark mb-0"><%= quotation.deliveryTerms %></p>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block fw-bold">Payment Schedule</small>
                    <p class="small text-dark mb-0"><%= quotation.paymentTerms %></p>
                </div>
                <div class="row g-2">
                    <div class="col-sm-6">
                        <small class="text-muted d-block fw-bold">Included Scope of Work</small>
                        <p class="small text-muted mb-0"><%= quotation.scopeOfWork %></p>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block fw-bold">Exclusions</small>
                        <p class="small text-muted mb-0"><%= quotation.exclusions %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Authoritative Financial Summary & Audit Trail -->
    <div class="col-lg-4">
        <!-- Authoritative Financial Breakdown Card -->
        <div class="admin-card mb-4">
            <div class="admin-card-header bg-light">
                <h5 class="admin-card-title text-primary"><i class="icofont-bill-alt me-1"></i> Financial Summary</h5>
            </div>
            <div class="p-4">
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Total Taxable Value:</span>
                    <strong>₹ <%= Number(quotation.taxableValue).toLocaleString('en-IN') %></strong>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">CGST (6% Intra-State MP):</span>
                    <span>₹ <%= Number(quotation.cgstAmount).toLocaleString('en-IN') %></span>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">SGST (6% Intra-State MP):</span>
                    <span>₹ <%= Number(quotation.sgstAmount).toLocaleString('en-IN') %></span>
                </div>
                <% if (quotation.igstAmount > 0) { %>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">IGST (Inter-State):</span>
                        <span>₹ <%= Number(quotation.igstAmount).toLocaleString('en-IN') %></span>
                    </div>
                <% } %>
                <div class="d-flex justify-content-between mb-2 small border-top pt-2">
                    <span class="fw-bold">Gross Total:</span>
                    <strong class="text-dark">₹ <%= Number(quotation.grossTotal).toLocaleString('en-IN') %></strong>
                </div>

                <% if (quotation.specialDiscount > 0) { %>
                    <div class="d-flex justify-content-between mb-2 small text-danger">
                        <span>Commercial Discount:</span>
                        <span>- ₹ <%= Number(quotation.specialDiscount).toLocaleString('en-IN') %></span>
                    </div>
                <% } %>

                <div class="d-flex justify-content-between mb-3 small fw-bold">
                    <span>Grand Total:</span>
                    <span class="text-primary">₹ <%= Number(quotation.grandTotal).toLocaleString('en-IN') %></span>
                </div>

                <!-- Govt Subsidy Box -->
                <div class="p-3 mb-3 rounded" style="background: #ecfdf5; border: 1px solid #a7f3d0;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <small class="fw-bold text-success"><i class="icofont-sun-alt me-1"></i> PM Surya Ghar Subsidy</small>
                        <span class="badge bg-success">Direct Benefit</span>
                    </div>
                    <div class="h5 font-weight-bold text-success mb-0">
                        - ₹ <%= Number(quotation.estimatedSubsidy).toLocaleString('en-IN') %>
                    </div>
                    <small class="text-muted" style="font-size: 11px;">DBT to customer Aadhaar-linked account</small>
                </div>

                <!-- Net Payable Box -->
                <div class="p-3 mb-4 rounded" style="background: #eff6ff; border: 1px solid #bfdbfe;">
                    <small class="text-muted d-block">Estimated Net Customer Cost</small>
                    <div class="h4 font-weight-bold text-primary mb-0">
                        ₹ <%= Number(quotation.netPayableAfterSubsidy).toLocaleString('en-IN') %>
                    </div>
                </div>

                <!-- Milestone Payment Schedule -->
                <div class="border rounded p-3 mb-0 bg-light small">
                    <div class="fw-bold text-dark mb-2">Payment Milestones</div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>20% Advance with Order:</span>
                        <strong>₹ <%= Number(quotation.advanceAmount).toLocaleString('en-IN') %></strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>80% Balance on Delivery:</span>
                        <strong>₹ <%= Number(quotation.balanceAmount).toLocaleString('en-IN') %></strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Approval & Verification Card -->
        <div class="admin-card mb-4">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Governance & Maker-Checker</h5>
            </div>
            <div class="p-4 small">
                <div class="mb-3">
                    <span class="text-muted d-block">Prepared By:</span>
                    <strong><%= quotation.preparedBy ? quotation.preparedBy.name : 'Unknown' %></strong>
                    <div class="text-muted"><%= quotation.preparedBy ? quotation.preparedBy.role : '' %> • <%= new Date(quotation.createdAt).toLocaleDateString('en-IN') %></div>
                </div>

                <div class="mb-3">
                    <span class="text-muted d-block">Authorized By:</span>
                    <% if (quotation.approvedBy) { %>
                        <strong class="text-success"><i class="icofont-check-circled me-1"></i><%= quotation.approvedBy.name %></strong>
                        <div class="text-muted"><%= quotation.approvedBy.role %> • <%= new Date(quotation.approvedAt).toLocaleDateString('en-IN') %></div>
                        <% if (quotation.approvalComments) { %>
                            <div class="p-2 bg-light rounded mt-1 border text-dark font-monospace" style="font-size: 11px;">
                                <%= quotation.approvalComments %>
                            </div>
                        <% } %>
                    <% } else { %>
                        <span class="text-warning fw-bold"><i class="icofont-clock-time me-1"></i> Awaiting Authorization</span>
                    <% } %>
                </div>

                <div>
                    <span class="text-muted d-block">Validity Expiry:</span>
                    <span><%= quotation.validityDate ? new Date(quotation.validityDate).toLocaleDateString('en-IN') : '30 Days from issue' %></span>
                </div>
            </div>
        </div>

        <!-- Workflow Status Trail -->
        <div class="admin-card mb-4">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Status History Trail</h5>
            </div>
            <div class="p-4">
                <% if (history && history.length > 0) { %>
                    <div class="timeline" style="border-left: 2px solid var(--admin-border); padding-left: 15px;">
                        <% history.forEach(h => { %>
                            <div class="mb-3 position-relative">
                                <div style="position: absolute; left: -21px; top: 3px; width: 10px; height: 10px; border-radius: 50%; background: var(--admin-navy-primary);"></div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <strong class="small text-dark"><%= h.newStatus %></strong>
                                    <small class="text-muted" style="font-size: 11px;">
                                        <%= new Date(h.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %>
                                    </small>
                                </div>
                                <small class="text-muted d-block">By: <%= h.changedBy ? h.changedBy.name : 'System' %></small>
                                <% if (h.comments) { %>
                                    <div class="p-1 mt-1 bg-light rounded small text-dark border" style="font-size: 11px;">
                                        <%= h.comments %>
                                    </div>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-muted small mb-0">Initial generation logged.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Record Customer Response -->
<div class="modal fade" id="customerResponseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background: var(--admin-navy-primary); color: white;">
                <h5 class="modal-title fs-6">Record Customer Decision</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="customerResponseForm">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Record the client's decision for quotation <strong class="text-dark"><%= quotation.quotationNumber %></strong>:
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Customer Decision *</label>
                        <select class="form-select" name="status" required>
                            <option value="CUSTOMER_ACCEPTED">Client Accepted Proposal (Ready for PO/Project)</option>
                            <option value="CUSTOMER_REJECTED">Client Declined Proposal</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Customer Feedback / Remarks</label>
                        <textarea class="form-control" name="remarks" rows="3" placeholder="Enter customer comments or payment mode agreed..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold" id="btnSubmitResponse">
                        Record Decision
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function copyAcceptanceLink(url) {
    navigator.clipboard.writeText(url).then(() => {
        alert('Public quotation acceptance link copied to clipboard:\n' + url);
    }).catch(err => {
        prompt('Copy this link:', url);
    });
}

async function openApproveModal() {
    const comments = prompt('Enter optional approval comments / authorization note for <%= quotation.quotationNumber %>:');
    if (comments === null) return;

    try {
        const res = await fetch('/manager/quotations/<%= quotation._id %>/approve', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': '<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>'
            },
            body: JSON.stringify({ comments })
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message);
            window.location.reload();
        } else {
            alert(data.message || 'Authorization failed.');
        }
    } catch (err) {
        alert('Server connection error.');
    }
}

async function openRejectModal() {
    const reason = prompt('Enter rejection reason for <%= quotation.quotationNumber %>:');
    if (!reason) return;

    try {
        const res = await fetch('/manager/quotations/<%= quotation._id %>/reject', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': '<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>'
            },
            body: JSON.stringify({ reason })
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message);
            window.location.reload();
        } else {
            alert(data.message || 'Error rejecting quotation.');
        }
    } catch (err) {
        alert('Server connection error.');
    }
}

document.getElementById('customerResponseForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitResponse');
    btn.disabled = true;
    const formData = new FormData(this);
    const payload = Object.fromEntries(formData.entries());

    try {
        const res = await fetch('/employee/quotations/<%= quotation._id %>/customer-response', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': payload._csrf
            },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            alert('Customer response recorded successfully!');
            window.location.reload();
        } else {
            alert(data.message || 'Error recording response.');
            btn.disabled = false;
        }
    } catch (err) {
        alert('Server connection error.');
        btn.disabled = false;
    }
});
</script>

<%- include('partials/admin-footer') %>
