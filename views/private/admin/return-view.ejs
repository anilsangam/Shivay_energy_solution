<%- include('partials/admin-head') %>

<%
    const r = (typeof returnDoc !== 'undefined' && returnDoc) ? returnDoc : {
        returnNumber: '—',
        status: 'REQUESTED',
        items: [],
        sale: {},
        inspectingUser: {},
        approvedBy: {},
        rejectedBy: {}
    };
%>

<!-- Action Feedback Alert Banner -->
<div id="returnViewToast" class="alert alert-success alert-dismissible fade show d-none mb-4" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="returnViewToastMsg">Action completed.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('returnViewToast').classList.add('d-none')"></button>
</div>

<!-- Header Controls -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <div class="mb-1">
            <a href="/admin/returns" class="text-muted small text-decoration-none">
                <i class="icofont-rounded-left me-1"></i> Back to Returns List
            </a>
        </div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="font-weight-bold mb-0" style="color: var(--admin-navy-primary); font-size: 24px;">
                Return RMA: <span class="font-monospace text-primary"><%= r.returnNumber %></span>
            </h2>
            <% if (r.status === 'APPROVED' || r.status === 'COMPLETED') { %>
                <span class="badge bg-success py-2 px-3"><i class="icofont-check me-1"></i> APPROVED & STOCKED</span>
            <% } else if (r.status === 'REJECTED') { %>
                <span class="badge bg-danger py-2 px-3"><i class="icofont-close me-1"></i> REJECTED</span>
            <% } else { %>
                <span class="badge bg-warning text-dark py-2 px-3"><i class="icofont-clock-time me-1"></i> <%= r.status %></span>
            <% } %>
        </div>
    </div>
    <div class="d-flex gap-2">
        <% if (r.status !== 'APPROVED' && r.status !== 'COMPLETED' && r.status !== 'REJECTED') { %>
            <button class="btn btn-success font-weight-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#approveReturnModal" style="border-radius: 8px;">
                <i class="icofont-check-circled me-1"></i> Inspect & Approve Return
            </button>
            <button class="btn btn-outline-danger" onclick="rejectReturnNow('<%= r._id %>')" style="border-radius: 8px;">
                <i class="icofont-close me-1"></i> Reject Return
            </button>
        <% } %>
        <a href="/admin/sales-out/<%= r.sale && r.sale._id ? r.sale._id : r.sale %>" class="btn btn-outline-secondary" style="border-radius: 8px;">
            <i class="icofont-truck-loaded me-1"></i> View Parent Sale
        </a>
    </div>
</div>

<div class="alert alert-warning py-2 px-3 small mb-4 border-0 shadow-sm rounded-3">
    <i class="icofont-shield-alt me-1"></i> <strong>Stock Quarantine Integrity:</strong> Approving items in <strong>GOOD</strong> condition adds them to sellable inventory. Items marked as <strong>DAMAGED</strong> or <strong>DEFECTIVE</strong> are quarantined into separate non-sellable stock categories and will <strong>never increase sellable stock</strong>.
</div>

<!-- Two Info Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 15px;">
                    <i class="icofont-recycle text-warning me-2"></i> Return Case Overview
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 small">
                    <div class="col-6">
                        <span class="text-muted">Parent Sale Order:</span>
                        <div class="fw-bold font-monospace text-primary fs-6">
                            <a href="/admin/sales-out/<%= r.sale && r.sale._id ? r.sale._id : r.sale %>" class="text-decoration-none">
                                <%= r.saleNumber %>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Customer / Buyer:</span>
                        <div class="fw-bold text-dark fs-6"><%= r.customerName || (r.sale && r.sale.customerName) || 'Customer' %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Received Date:</span>
                        <div class="fw-medium text-dark"><%= new Date(r.receivedDate || r.createdAt).toLocaleDateString('en-IN') %></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Financial Refund / Credit:</span>
                        <div>
                            <span class="badge bg-light text-dark border"><%= r.refundStatus || 'NOT_APPLICABLE' %></span>
                            <% if (r.refundAmount > 0) { %>
                                <span class="fw-bold text-success ms-1">₹<%= Number(r.refundAmount).toLocaleString('en-IN') %></span>
                            <% } %>
                        </div>
                    </div>
                    <div class="col-12">
                        <span class="text-muted">Return Reason:</span>
                        <div class="fw-medium text-dark"><%= r.returnReason %></div>
                    </div>
                    <% if (r.notes) { %>
                        <div class="col-12">
                            <span class="text-muted">General Remarks:</span>
                            <div class="text-secondary"><%= r.notes %></div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 15px;">
                    <i class="icofont-check-circled text-warning me-2"></i> Quality Inspection & Audit
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 small">
                    <div class="col-6">
                        <span class="text-muted">Inspection Status:</span>
                        <div>
                            <span class="badge <%= r.status === 'APPROVED' ? 'bg-success' : (r.status === 'REJECTED' ? 'bg-danger' : 'bg-warning text-dark') %>">
                                <%= r.status %>
                            </span>
                        </div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted">Inspected By:</span>
                        <div class="fw-medium text-dark"><%= (r.inspectingUser && r.inspectingUser.name) || (r.approvedBy && r.approvedBy.name) || 'Pending QA' %></div>
                    </div>
                    <% if (r.approvedAt) { %>
                        <div class="col-6">
                            <span class="text-muted">Approved Date:</span>
                            <div class="fw-medium text-dark"><%= new Date(r.approvedAt).toLocaleString('en-IN') %></div>
                        </div>
                        <div class="col-6">
                            <span class="text-muted">Approved By:</span>
                            <div class="fw-medium text-dark"><%= (r.approvedBy && r.approvedBy.name) || 'Executive Admin' %></div>
                        </div>
                    <% } %>
                    <% if (r.rejectedAt) { %>
                        <div class="col-6">
                            <span class="text-muted">Rejected Date:</span>
                            <div class="fw-medium text-danger"><%= new Date(r.rejectedAt).toLocaleString('en-IN') %></div>
                        </div>
                        <div class="col-12">
                            <span class="text-muted">Rejection Reason:</span>
                            <div class="text-danger fw-medium"><%= r.rejectionReason || 'Inspection failed.' %></div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Returned Line Items Table -->
<div class="card border-0 shadow-sm rounded-3 mb-5">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 16px;">
            <i class="icofont-box text-warning me-2"></i> Returned Materials Condition & Restock Ledger Status
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase font-weight-bold">
                    <tr>
                        <th class="ps-4 py-3" style="width: 50px;">#</th>
                        <th class="py-3">Material Name & SKU</th>
                        <th class="py-3 text-center">Unit</th>
                        <th class="py-3 text-end">Original Sold</th>
                        <th class="py-3 text-end">Returned Qty</th>
                        <th class="py-3 text-center">Physical Condition</th>
                        <th class="pe-4 py-3 text-end">Restock Accounting</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (r.items && r.items.length > 0) { %>
                        <% r.items.forEach((item, idx) => { %>
                            <tr>
                                <td class="ps-4 text-muted"><%= idx + 1 %></td>
                                <td>
                                    <div class="fw-bold text-dark"><%= item.materialName %></div>
                                    <div class="font-monospace text-muted small" style="font-size: 11px;">SKU: <%= item.sku %></div>
                                    <% if (item.inspectionNotes) { %>
                                        <small class="text-muted d-block mt-1">QA Notes: <%= item.inspectionNotes %></small>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border"><%= item.unit || 'Piece' %></span>
                                </td>
                                <td class="text-end text-muted">
                                    <%= Number(item.soldQuantity || 0).toLocaleString('en-IN') %>
                                </td>
                                <td class="text-end fw-bold text-dark fs-6">
                                    <%= Number(item.returnedQuantity || 0).toLocaleString('en-IN') %>
                                </td>
                                <td class="text-center">
                                    <% if (item.condition === 'GOOD') { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="icofont-check me-1"></i>GOOD (Sellable)</span>
                                    <% } else if (item.condition === 'DAMAGED') { %>
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="icofont-warning me-1"></i>DAMAGED (Quarantine)</span>
                                    <% } else if (item.condition === 'DEFECTIVE') { %>
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="icofont-tools me-1"></i>DEFECTIVE (Quarantine)</span>
                                    <% } else { %>
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">PENDING INSPECTION</span>
                                    <% } %>
                                </td>
                                <td class="pe-4 text-end">
                                    <% if (item.restocked) { %>
                                        <span class="badge bg-success text-white py-1 px-2"><i class="icofont-check-circled me-1"></i>Restocked to Sellable</span>
                                    <% } else if (item.nonSellableRecorded) { %>
                                        <span class="badge bg-danger text-white py-1 px-2"><i class="icofont-shield-alt me-1"></i>Quarantined Non-Sellable</span>
                                    <% } else { %>
                                        <span class="badge bg-light text-muted border py-1 px-2">Pending Approval</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Approve Return & Set Inspection Condition -->
<div class="modal fade" id="approveReturnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="approveReturnForm" onsubmit="handleApproveReturn(event)">
                <div class="modal-header bg-navy text-white" style="background-color: var(--admin-navy-primary);">
                    <h5 class="modal-title font-weight-bold text-white"><i class="icofont-check-circled me-2 text-warning"></i> Inspection & Return Approval</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Review the physical condition of each returned item. Selecting <strong>GOOD</strong> increments sellable stock balance in the live ledger. Selecting <strong>DAMAGED</strong> or <strong>DEFECTIVE</strong> quarantines items without affecting sellable inventory.
                    </p>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="bg-light text-muted small">
                                <tr>
                                    <th>Material Item</th>
                                    <th class="text-end" style="width: 100px;">Return Qty</th>
                                    <th style="width: 180px;">Inspected Condition</th>
                                    <th>QA Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% (r.items || []).forEach((it, i) => { %>
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark"><%= it.materialName %></div>
                                            <small class="text-muted font-monospace"><%= it.sku %></small>
                                        </td>
                                        <td class="text-end fw-bold"><%= it.returnedQuantity %> <%= it.unit %></td>
                                        <td>
                                            <select class="form-select form-select-sm return-item-condition" data-material-id="<%= it.material %>">
                                                <option value="GOOD" <%= it.condition === 'GOOD' ? 'selected' : '' %>>GOOD (Sellable Restock)</option>
                                                <option value="DAMAGED" <%= it.condition === 'DAMAGED' ? 'selected' : '' %>>DAMAGED (Quarantine)</option>
                                                <option value="DEFECTIVE" <%= it.condition === 'DEFECTIVE' ? 'selected' : '' %>>DEFECTIVE (OEM RMA)</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm return-item-notes" placeholder="Condition details...">
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label font-weight-semibold small">Refund / Credit Settlement</label>
                            <select name="refundStatus" class="form-select">
                                <option value="NOT_APPLICABLE" <%= r.refundStatus === 'NOT_APPLICABLE' ? 'selected' : '' %>>NOT APPLICABLE (No Cash Refund)</option>
                                <option value="CREDIT_NOTE_ISSUED" <%= r.refundStatus === 'CREDIT_NOTE_ISSUED' ? 'selected' : '' %>>CREDIT NOTE ISSUED</option>
                                <option value="REFUNDED" <%= r.refundStatus === 'REFUNDED' ? 'selected' : '' %>>REFUNDED</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-semibold small">Refund / Credit Amount (₹)</label>
                            <input type="number" step="0.01" min="0" name="refundAmount" class="form-control" value="<%= r.refundAmount || 0 %>">
                        </div>
                        <div class="col-12">
                            <label class="form-label font-weight-semibold small">Final Inspection Summary Notes</label>
                            <input type="text" name="notes" class="form-control" placeholder="QA inspector remarks...">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success font-weight-bold px-4" id="confirmApproveBtn">
                        <i class="icofont-check-circled me-1"></i> Approve & Process Stock Ledger
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const CSRF_TOKEN = '<%= csrfToken %>';
const RETURN_ID = '<%= r._id %>';

async function handleApproveReturn(e) {
    e.preventDefault();
    const form = e.target;

    const conditionRows = form.querySelectorAll('.return-item-condition');
    const noteRows = form.querySelectorAll('.return-item-notes');
    const items = [];

    conditionRows.forEach((sel, idx) => {
        items.push({
            materialId: sel.getAttribute('data-material-id'),
            condition: sel.value,
            inspectionNotes: noteRows[idx] ? noteRows[idx].value.trim() : ''
        });
    });

    const payload = {
        _csrf: CSRF_TOKEN,
        items,
        refundStatus: form.refundStatus.value,
        refundAmount: Number(form.refundAmount.value) || 0,
        notes: form.notes.value.trim()
    };

    try {
        const res = await fetch(`/api/admin/returns/${RETURN_ID}/approve`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message || 'Return approved successfully.');
            location.reload();
        } else {
            alert(data.message || 'Error approving return.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}

async function rejectReturnNow(id) {
    const reason = prompt('Please enter the rejection reason:');
    if (reason === null) return;
    try {
        const res = await fetch(`/api/admin/returns/${id}/reject`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify({ _csrf: CSRF_TOKEN, rejectionReason: reason })
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message || 'Return rejected.');
            location.reload();
        } else {
            alert(data.message || 'Error rejecting return.');
        }
    } catch (err) {
        alert('Server communication error.');
    }
}
</script>

<%- include('partials/admin-footer') %>
