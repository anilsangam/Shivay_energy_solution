<%- include('partials/admin-head') %>

<%
    const safeBackUrl = typeof backUrl !== 'undefined' && backUrl ? backUrl : '/admin/employees';
    const userPerms = Array.isArray(targetUser.permissions) ? targetUser.permissions : [];
    const activeCaller = typeof user !== 'undefined' ? user : (typeof currentUser !== 'undefined' ? currentUser : null);
    const callerIsPrimaryAdmin = typeof isCallerPrimaryAdmin !== 'undefined'
        ? Boolean(isCallerPrimaryAdmin)
        : Boolean(activeCaller && activeCaller.isPrimarySuperAdmin);
    const callerPermSet = (typeof callerPermissions !== 'undefined' && Array.isArray(callerPermissions)) ? new Set(callerPermissions) : null;
    const callerFieldSet = (typeof callerFieldPermissions !== 'undefined' && Array.isArray(callerFieldPermissions)) ? new Set(callerFieldPermissions) : null;
    const canDelegatePerm = (k) => callerIsPrimaryAdmin || callerPermSet === null || callerPermSet.has(k);
    const canDelegateField = (k) => callerIsPrimaryAdmin || callerFieldSet === null || callerFieldSet.has(k);
    const canGrantAdminAttendance = canDelegatePerm('attendance.all.view') || canDelegatePerm('attendance.all.export');
    const canGrantManagerAttendance = canDelegatePerm('attendance.branch.view');
    const canGrantEmployeeAttendance = canDelegatePerm('attendance.punch.create') || canDelegatePerm('attendance.personal.view');
%>

<!-- Feedback Alert Banner -->
<div id="permToast" class="alert alert-success alert-dismissible fade show d-none" role="alert">
    <i class="icofont-check-circled me-2"></i><span id="permToastMsg">Permissions updated successfully.</span>
    <button type="button" class="btn-close" onclick="document.getElementById('permToast').classList.add('d-none')"></button>
</div>

<!-- Unsaved Changes Floating Bar -->
<div id="unsavedChangesBar" class="admin-unsaved-bar d-none">
    <div class="d-flex flex-wrap align-items-center justify-content-between container-fluid px-4 py-3 gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="spinner-grow spinner-grow-sm text-warning" role="status"></span>
            <span class="font-weight-bold text-white">
                <span id="pendingChangesCount">0</span> unsaved change(s)
            </span>
            <span class="badge bg-warning text-dark ms-1" id="pendingChangesDiff">+0 added, -0 removed</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-light" onclick="discardChanges()">
                <i class="icofont-refresh me-1"></i> Discard
            </button>
            <button type="button" class="btn btn-sm btn-warning font-weight-bold text-dark px-3" onclick="savePermissions()">
                <i class="icofont-save me-1"></i> Save Changes
            </button>
        </div>
    </div>
</div>

<!-- Header Navigation & Title -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="<%= safeBackUrl %>" class="btn btn-sm btn-outline-secondary py-1 px-2 text-decoration-none">
                <i class="icofont-arrow-left me-1"></i> Back to Staff List
            </a>
            <span class="badge bg-light text-dark border">Simple Permission Control</span>
        </div>
        <h2 class="font-weight-bold mb-1" style="color: var(--admin-navy-primary); font-size: 24px;">
            Manage Permissions: <%= targetUser.name %>
        </h2>
        <p class="text-muted small mb-0">
            Choose simple Employee or Manager level permissions cleanly — or expand Advanced Mode for fine-grained control.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3 mt-md-0">
        <button type="button" class="btn btn-outline-secondary btn-sm px-3" id="toggleAdvancedBtn" onclick="toggleAdvancedMode()">
            <i class="icofont-sliders-alt me-1"></i> Show Advanced Keys
        </button>
        <% if (canEdit) { %>
            <button type="button" class="btn btn-warning font-weight-bold text-dark px-3 shadow-sm" onclick="savePermissions()" id="topSaveBtn">
                <i class="icofont-save me-1"></i> Save Changes
            </button>
        <% } %>
    </div>
</div>

<!-- Target User Profile Summary Card -->
<div class="admin-card mb-4 <%= isTargetPrimaryAdmin ? 'border-warning' : '' %>">
    <div class="p-3 p-md-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="admin-avatar-circle" style="width: 52px; height: 52px; font-size: 18px; background: <%= isTargetPrimaryAdmin ? '#f59e0b' : 'var(--admin-navy-primary)' %>; color: #fff;">
                    <%= (targetUser.name || 'U').split(' ').filter(Boolean).map(n=>n[0]).join('').substring(0,2).toUpperCase() %>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h4 class="font-weight-bold text-dark mb-0"><%= targetUser.name %></h4>
                        <% if (isTargetPrimaryAdmin) { %>
                            <span class="badge bg-warning text-dark border border-warning font-weight-bold">
                                <i class="icofont-crown text-dark me-1"></i> PRIMARY SUPER ADMIN
                            </span>
                        <% } else if (targetUser.role === 'SUPER_ADMIN') { %>
                            <span class="badge bg-danger text-white">Super Admin</span>
                        <% } else if (targetUser.role === 'MANAGER' || targetUser.role === 'BRANCH_MANAGER') { %>
                            <span class="badge bg-primary text-white">Branch Manager</span>
                        <% } else { %>
                            <span class="badge bg-secondary text-white">Employee</span>
                        <% } %>
                        <span class="badge <%= targetUser.status === 'ACTIVE' ? 'bg-success' : 'bg-warning text-dark' %>"><%= targetUser.status %></span>
                    </div>
                    <div class="text-muted small mt-1 d-flex flex-wrap gap-3">
                        <span><i class="icofont-id-card me-1"></i><code><%= targetUser.employeeId || 'N/A' %></code></span>
                        <span><i class="icofont-phone me-1"></i><%= targetUser.mobile %></span>
                        <span><i class="icofont-building me-1"></i><strong><%= (targetUser.branchId && targetUser.branchId.name) ? targetUser.branchId.name : 'Central Branch' %></strong></span>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 text-center">
                <div class="p-2 px-3 bg-light rounded-3 border">
                    <div class="small text-muted" style="font-size: 11px;">Access Level</div>
                    <div class="font-weight-bold text-primary small mt-1" id="metricRoleLevel">Checking...</div>
                </div>
                <div class="p-2 px-3 bg-light rounded-3 border">
                    <div class="small text-muted" style="font-size: 11px;">Basic Attendance</div>
                    <div class="font-weight-bold text-success small mt-1" id="metricAttendanceLevel">Common On</div>
                </div>
                <div class="p-2 px-3 bg-light rounded-3 border">
                    <div class="small text-muted" style="font-size: 11px;">Active Permissions</div>
                    <div class="font-weight-bold text-dark fs-6" id="metricAssignedCount"><%= userPerms.length %></div>
                </div>
            </div>
        </div>

        <% if (isTargetPrimaryAdmin) { %>
            <div class="alert alert-warning mt-3 mb-0 py-2 small">
                <i class="icofont-shield-alt me-1"></i> <strong>Protected Root Account:</strong> Primary Super Admin holds full system access and cannot be restricted.
            </div>
        <% } else if (isSelf) { %>
            <div class="alert alert-info mt-3 mb-0 py-2 small">
                <i class="icofont-info-circle me-1"></i> <strong>Self-Edit Guard:</strong> You cannot change your own permissions.
            </div>
        <% } %>
    </div>
</div>

<form id="permissionsForm" onsubmit="event.preventDefault(); savePermissions();">

<% if (canEdit) { %>
<!-- 1. 1-CLICK STANDARD ACCESS LEVEL (FULL ROLE AUTO-SELECT + EXTRA CUSTOMIZATION BELOW) -->
<div class="admin-card mb-4 border-primary shadow-sm">
    <div class="admin-card-header text-white d-flex flex-wrap align-items-center justify-content-between gap-2 py-3" style="background: var(--admin-navy-primary);">
        <div class="d-flex align-items-center gap-2">
            <i class="icofont-shield-alt fs-4 text-warning"></i>
            <div>
                <h5 class="admin-card-title mb-0 text-white font-weight-bold">Step 1: 1-Click Standard Access Level</h5>
                <div class="text-white-50 small">Select Employee Level or Manager Level to auto-select all standard permissions — then add extra modules or job roles below if needed</div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning text-dark fw-bold" id="roleLevelCardBadge">Checking...</span>
            <button type="button" class="btn btn-sm btn-outline-warning text-white" onclick="openStep3CustomMode()">
                <i class="icofont-edit me-1"></i> Custom Edit
            </button>
        </div>
    </div>
    <div class="p-3 p-md-4 bg-light">
        <div class="row g-3">
            <!-- None -->
            <div class="col-12 col-sm-6 col-lg-<%= callerIsPrimaryAdmin ? '3' : '4' %>">
                <button type="button" class="btn btn-white w-100 p-3 text-start border rounded-3 shadow-sm h-100 access-level-card" data-access-level="NONE" onclick="applyAccessLevel('NONE')">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-secondary-subtle text-secondary border"><i class="icofont-ban me-1"></i> Clear All</span>
                        <span class="access-check-icon text-muted"><i class="icofont-check-circled fs-5 d-none"></i></span>
                    </div>
                    <strong class="d-block text-dark mb-1">Remove All Access</strong>
                    <div class="text-muted small" style="font-size: 11.5px;">Clear all permissions and assign custom modules manually below.</div>
                </button>
            </div>

            <!-- Standard Employee Level (All Employee Baseline Modules + Basic Attendance) -->
            <div class="col-12 col-sm-6 col-lg-<%= callerIsPrimaryAdmin ? '3' : '4' %>">
                <button type="button" class="btn btn-white w-100 p-3 text-start border rounded-3 shadow-sm h-100 access-level-card" data-access-level="EMPLOYEE" onclick="applyAccessLevel('EMPLOYEE')">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="icofont-user me-1"></i> Employee Level</span>
                        <span class="access-check-icon text-success"><i class="icofont-check-circled fs-5 d-none"></i></span>
                    </div>
                    <strong class="d-block text-dark mb-1">Allow Employee Level</strong>
                    <div class="text-muted small" style="font-size: 11.5px;">Auto-selects all standard employee access: Basic Attendance, Projects, Quotations &amp; Client Lookup. You can add extra modules below.</div>
                </button>
            </div>

            <!-- Manager Level (All Manager Modules) -->
            <div class="col-12 col-sm-6 col-lg-<%= callerIsPrimaryAdmin ? '3' : '4' %>">
                <button type="button" class="btn btn-white w-100 p-3 text-start border rounded-3 shadow-sm h-100 access-level-card" data-access-level="MANAGER" onclick="applyAccessLevel('MANAGER')">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="icofont-business-man me-1"></i> Manager Level</span>
                        <span class="access-check-icon text-primary"><i class="icofont-check-circled fs-5 d-none"></i></span>
                    </div>
                    <strong class="d-block text-dark mb-1">Allow Manager Level</strong>
                    <div class="text-muted small" style="font-size: 11.5px;">Auto-selects all branch management permissions: Team Attendance, Approvals, CRM Leads, Invoices &amp; Staff View (within your authority).</div>
                </button>
            </div>

            <% if (callerIsPrimaryAdmin) { %>
            <!-- Super Admin Level -->
            <div class="col-12 col-sm-6 col-lg-3">
                <button type="button" class="btn btn-white w-100 p-3 text-start border rounded-3 shadow-sm h-100 access-level-card" data-access-level="ADMIN" onclick="applyAccessLevel('ADMIN')">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-warning-subtle text-dark border border-warning"><i class="icofont-crown me-1"></i> Admin Level</span>
                        <span class="access-check-icon text-warning"><i class="icofont-check-circled fs-5 d-none"></i></span>
                    </div>
                    <strong class="d-block text-dark mb-1">Full Admin Access</strong>
                    <div class="text-muted small" style="font-size: 11.5px;">All modules across all branches plus full settings and exports.</div>
                </button>
            </div>
            <% } %>
        </div>
    </div>
</div>

<!-- 2. QUICK JOB ROLE PRESETS (BASIC ATTENDANCE ALWAYS INCLUDED) -->
<div class="admin-card mb-4 shadow-sm">
    <div class="admin-card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-2 py-3 border-bottom">
        <div>
            <h5 class="admin-card-title mb-0 text-dark font-weight-bold"><i class="icofont-magic text-warning me-2"></i>Step 2: Quick Job Role Assignment</h5>
            <div class="text-muted small">Assign a specific job role (Telecaller, Sales, Engineer, etc.) — <strong>Basic GPS Attendance is automatically common &amp; included for all</strong></div>
        </div>
        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="icofont-location-pin me-1"></i> Basic Attendance Common</span>
    </div>
    <div class="p-3 bg-light">
        <div class="row g-2">
            <div class="col-6 col-md-4 col-lg-3">
                <button type="button" class="btn btn-white w-100 p-2 text-start border shadow-sm h-100 role-preset-card" data-preset-key="TELECALLER" onclick="applyQuickPreset('TELECALLER')">
                    <strong class="text-dark small d-block"><i class="icofont-phone text-info me-1"></i> Telecaller</strong>
                    <div class="text-muted" style="font-size: 11px;">Basic Attendance + Full Telecaller &amp; Leads Section</div>
                </button>
            </div>
            <div class="col-6 col-md-4 col-lg-3">
                <button type="button" class="btn btn-white w-100 p-2 text-start border shadow-sm h-100 role-preset-card" data-preset-key="FIELD_INSPECTOR" onclick="applyQuickPreset('FIELD_INSPECTOR')">
                    <strong class="text-dark small d-block"><i class="icofont-ruler-pencil text-success me-1"></i> Field Inspector / Eng</strong>
                    <div class="text-muted" style="font-size: 11px;">Basic Attendance + All Projects, Customers &amp; Quotations</div>
                </button>
            </div>
            <div class="col-6 col-md-4 col-lg-3">
                <button type="button" class="btn btn-white w-100 p-2 text-start border shadow-sm h-100 role-preset-card" data-preset-key="SALES_EXECUTIVE" onclick="applyQuickPreset('SALES_EXECUTIVE')">
                    <strong class="text-dark small d-block"><i class="icofont-briefcase text-primary me-1"></i> Sales Executive</strong>
                    <div class="text-muted" style="font-size: 11px;">Basic Attendance + CRM &amp; All Quotations</div>
                </button>
            </div>
            <div class="col-6 col-md-4 col-lg-3">
                <button type="button" class="btn btn-white w-100 p-2 text-start border shadow-sm h-100 role-preset-card" data-preset-key="INSTALLATION_TECHNICIAN" onclick="applyQuickPreset('INSTALLATION_TECHNICIAN')">
                    <strong class="text-dark small d-block"><i class="icofont-tools text-warning me-1"></i> Installation Tech</strong>
                    <div class="text-muted" style="font-size: 11px;">Basic Attendance + Site Execution &amp; Docs</div>
                </button>
            </div>
            <div class="col-6 col-md-4 col-lg-3">
                <button type="button" class="btn btn-white w-100 p-2 text-start border shadow-sm h-100 role-preset-card" data-preset-key="SERVICE_TECHNICIAN" onclick="applyQuickPreset('SERVICE_TECHNICIAN')">
                    <strong class="text-dark small d-block"><i class="icofont-wrench text-danger me-1"></i> Service Tech</strong>
                    <div class="text-muted" style="font-size: 11px;">Basic Attendance + Complaints &amp; Service</div>
                </button>
            </div>
            <div class="col-6 col-md-4 col-lg-3">
                <button type="button" class="btn btn-white w-100 p-2 text-start border shadow-sm h-100 role-preset-card" data-preset-key="STORE_KEEPER" onclick="applyQuickPreset('STORE_KEEPER')">
                    <strong class="text-dark small d-block"><i class="icofont-box text-secondary me-1"></i> Store Keeper</strong>
                    <div class="text-muted" style="font-size: 11px;">Basic Attendance + Inventory &amp; Dispatch</div>
                </button>
            </div>
            <div class="col-6 col-md-4 col-lg-3">
                <button type="button" class="btn btn-white w-100 p-2 text-start border shadow-sm h-100 role-preset-card" data-preset-key="ACCOUNTANT" onclick="applyQuickPreset('ACCOUNTANT')">
                    <strong class="text-dark small d-block"><i class="icofont-bill text-success me-1"></i> Accountant</strong>
                    <div class="text-muted" style="font-size: 11px;">Basic Attendance + Invoices &amp; Reports</div>
                </button>
            </div>
            <% if (canGrantManagerAttendance) { %>
            <div class="col-6 col-md-4 col-lg-3">
                <button type="button" class="btn btn-white w-100 p-2 text-start border shadow-sm h-100 role-preset-card" data-preset-key="BRANCH_MANAGER" onclick="applyQuickPreset('BRANCH_MANAGER')">
                    <strong class="text-dark small d-block"><i class="icofont-building text-primary me-1"></i> Branch Manager</strong>
                    <div class="text-muted" style="font-size: 11px;">Manager Attendance + Approvals &amp; Team</div>
                </button>
            </div>
            <% } %>
        </div>
    </div>
</div>

<!-- 3. SIMPLE MODULE PERMISSIONS SWITCHBOARD (CUSTOMIZE / ADD EXTRA MODULES) -->
<div class="admin-card mb-4 shadow-sm">
    <div class="admin-card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-2 py-3 border-bottom">
        <div>
            <h5 class="admin-card-title mb-0 text-dark font-weight-bold"><i class="icofont-toggle-on text-success me-2"></i>Step 3: Add or Customize Any Module</h5>
            <div class="text-muted small">After choosing Employee Level or a Job Role, easily turn on any extra department below — Basic Attendance stays common</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm btn-warning text-dark fw-bold" id="toggleAllDrawersBtn" onclick="toggleAllCustomDrawers()">
                <i class="icofont-edit me-1"></i> Custom Edit All Sections
            </button>
            <% if (canGrantEmployeeAttendance) { %>
                <button type="button" class="btn btn-sm btn-outline-success" onclick="ensureBasicAttendance()">+ Ensure Basic Attendance</button>
            <% } %>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="grantAllViewPermissions()">Read-Only All</button>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmRevokeAll()">Revoke All</button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Department / Module</th>
                    <th>Current Status</th>
                    <th class="text-end pe-3">Simple Access &amp; Custom Edit</th>
                </tr>
            </thead>
            <tbody>
                <% for (const [modId, modData] of Object.entries(permissionTree)) {
                    const modPermsList = modData.permissions || [];
                    const delegatablePerms = modPermsList.filter(p => canDelegatePerm(p.key));
                    if (delegatablePerms.length === 0) continue;
                %>
                <tr class="simple-module-row" data-simple-module="<%= modId %>">
                    <td class="ps-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-dark border p-2"><i class="<%= modData.icon || 'icofont-box' %>"></i></span>
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <strong class="text-dark"><%= modData.name %></strong>
                                    <% if (modId === 'attendance') { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 9.5px;">Basic Common</span>
                                    <% } %>
                                </div>
                                <span class="text-muted d-block" style="font-size: 11px;"><%= modData.description %></span>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-secondary simple-mod-status" id="simple_status_<%= modId %>">None</span>
                    </td>
                    <td class="text-end pe-3">
                        <div class="d-inline-flex flex-wrap align-items-center justify-content-end gap-1">
                            <% if (modId === 'attendance') { %>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-secondary simple-mod-btn" data-level="NONE" onclick="setAttendanceLevel('NONE')">Off</button>
                                    <% if (canGrantEmployeeAttendance) { %>
                                        <button type="button" class="btn btn-outline-success simple-mod-btn" data-level="EMPLOYEE" onclick="setAttendanceLevel('EMPLOYEE')">Basic (Common)</button>
                                    <% } %>
                                    <% if (canGrantManagerAttendance) { %>
                                        <button type="button" class="btn btn-outline-primary simple-mod-btn" data-level="MANAGER" onclick="setAttendanceLevel('MANAGER')">Manager</button>
                                    <% } %>
                                    <% if (canGrantAdminAttendance) { %>
                                        <button type="button" class="btn btn-outline-warning text-dark simple-mod-btn" data-level="ADMIN" onclick="setAttendanceLevel('ADMIN')">Full</button>
                                    <% } %>
                                </div>
                            <% } else { %>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-secondary simple-mod-btn" data-level="NONE" onclick="setSimpleModuleLevel('<%= modId %>', 'NONE')">Off</button>
                                    <button type="button" class="btn btn-outline-info text-dark simple-mod-btn" data-level="VIEW" onclick="setSimpleModuleLevel('<%= modId %>', 'VIEW')">View Only</button>
                                    <button type="button" class="btn btn-outline-primary simple-mod-btn" data-level="MANAGE" onclick="setSimpleModuleLevel('<%= modId %>', 'MANAGE')">Full Allowed</button>
                                </div>
                            <% } %>
                            <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-semibold custom-edit-toggle-btn" id="custom_btn_<%= modId %>" onclick="toggleCustomModuleDrawer('<%= modId %>')" title="Pick individual permissions for <%= modData.name %>">
                                <i class="icofont-edit me-1"></i>Custom Edit
                            </button>
                        </div>
                    </td>
                </tr>
                <tr class="d-none custom-module-drawer bg-light" id="custom_drawer_<%= modId %>" data-custom-drawer="<%= modId %>">
                    <td colspan="3" class="p-3 border-bottom">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pb-2 border-bottom">
                            <div class="small fw-bold text-dark">
                                <i class="icofont-settings-alt text-primary me-1"></i>
                                Custom Permissions: <%= modData.name %>
                                <span class="text-muted fw-normal ms-1">(<%= delegatablePerms.length %> available)</span>
                            </div>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 11px;" onclick="selectAllInModule('<%= modId %>')">Select All</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11px;" onclick="clearAllInModule('<%= modId %>')">Clear</button>
                                <button type="button" class="btn btn-sm btn-dark py-0 px-2" style="font-size: 11px;" onclick="toggleCustomModuleDrawer('<%= modId %>')">Done</button>
                            </div>
                        </div>
                        <div class="row g-2">
                            <% delegatablePerms.forEach(p => {
                                const isChecked = isTargetPrimaryAdmin || userPerms.includes(p.key); %>
                                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                    <label class="d-flex align-items-start gap-2 p-2 bg-white border rounded-2 h-100 custom-drawer-card <%= isChecked ? 'border-primary' : '' %>" style="cursor: pointer;">
                                        <input class="form-check-input mt-1 custom-drawer-check" type="checkbox" data-target-perm="<%= p.key %>" data-module="<%= modId %>" <%= isChecked ? 'checked' : '' %> onchange="handleCustomDrawerToggle(this)">
                                        <span>
                                            <strong class="d-block text-dark" style="font-size: 12px;"><%= p.label || p.name %></strong>
                                            <span class="text-muted d-block" style="font-size: 10.5px; line-height: 1.25;"><%= p.description || '' %></span>
                                        </span>
                                    </label>
                                </div>
                            <% }); %>
                        </div>
                    </td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
<% } %>

<!-- ADVANCED GRANULAR SECTION (Collapsed by default for simplicity) -->
<div id="advancedPermissionsContainer" class="d-none">
    <!-- Action & Search Toolbar -->
    <div class="admin-card mb-4">
        <div class="p-3">
            <div class="row g-2 align-items-center justify-content-between">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="icofont-search text-muted"></i></span>
                        <input type="text" id="permissionSearchInput" class="form-control border-start-0" placeholder="Search technical keys or actions..." oninput="handleSearch(this.value)">
                        <button class="btn btn-outline-secondary" type="button" onclick="clearSearch()"><i class="icofont-close-line"></i></button>
                    </div>
                </div>
                <div class="col-md-7 d-flex flex-wrap gap-2 justify-content-md-end align-items-center">
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-primary active" id="filterBtnAll" onclick="setFilter('ALL')">All (<span id="totalVisibleCount">0</span>)</button>
                        <button type="button" class="btn btn-outline-primary" id="filterBtnAssigned" onclick="setFilter('ASSIGNED')">Assigned (<span id="totalAssignedCount"><%= userPerms.length %></span>)</button>
                        <button type="button" class="btn btn-outline-primary" id="filterBtnUnassigned" onclick="setFilter('UNASSIGNED')">Unassigned (<span id="totalUnassignedCount">0</span>)</button>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleExpandAll()" id="expandAllBtn">
                        <i class="icofont-expand me-1"></i> Expand All
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Branch & Data Scope -->
    <div class="admin-card mb-4">
        <div class="admin-card-header bg-light">
            <div>
                <h5 class="admin-card-title mb-0"><i class="icofont-building text-primary me-2"></i> Branch &amp; Data Scope</h5>
                <div class="admin-card-subtitle">Data visibility scope applied on backend queries</div>
            </div>
            <span class="badge bg-secondary" id="scopeBadgeDisplay">Scope: <%= targetUser.dataScope || 'BRANCH' %></span>
        </div>
        <div class="p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small font-weight-bold">Primary Data Scope</label>
                    <select id="dataScopeSelect" class="form-select" onchange="handleDataScopeChange(this.value)" <%= !canEdit ? 'disabled' : '' %>>
                        <option value="BRANCH" <%= (!targetUser.dataScope || targetUser.dataScope === 'BRANCH') ? 'selected' : '' %>>Branch Scope (Standard)</option>
                        <option value="OWN" <%= targetUser.dataScope === 'OWN' ? 'selected' : '' %>>Own Records Only</option>
                        <option value="ASSIGNED" <%= targetUser.dataScope === 'ASSIGNED' ? 'selected' : '' %>>Assigned &amp; Reporting Scope</option>
                        <% if (callerIsPrimaryAdmin || (activeCaller && activeCaller.dataScope === 'GLOBAL')) { %>
                            <option value="MULTI_BRANCH" <%= targetUser.dataScope === 'MULTI_BRANCH' ? 'selected' : '' %>>Multi-Branch Scope</option>
                        <% } %>
                        <% if (callerIsPrimaryAdmin) { %>
                            <option value="GLOBAL" <%= targetUser.dataScope === 'GLOBAL' ? 'selected' : '' %>>Global Enterprise Scope</option>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-6" id="multiBranchContainer" style="display: <%= targetUser.dataScope === 'MULTI_BRANCH' ? 'block' : 'none' %>;">
                    <label class="form-label small font-weight-bold">Authorized Multi-Branch Access</label>
                    <div class="border rounded p-2 bg-light" style="max-height: 140px; overflow-y: auto;">
                        <% const assignedBranchIds = (targetUser.authorizedBranches || []).map(b => (b._id || b).toString());
                           branches.forEach(b => {
                               const isChecked = assignedBranchIds.includes(b._id.toString()); %>
                            <div class="form-check form-check-sm mb-1">
                                <input class="form-check-input authorized-branch-checkbox" type="checkbox" value="<%= b._id %>" id="branch_<%= b._id %>" <%= isChecked ? 'checked' : '' %> <%= !canEdit ? 'disabled' : '' %> onchange="markUnsaved()">
                                <label class="form-check-label small" for="branch_<%= b._id %>"><strong><%= b.name %></strong> (<%= b.code %>)</label>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sensitive Field Permissions -->
    <div class="admin-card mb-4 border-danger">
        <div class="admin-card-header text-white d-flex flex-wrap align-items-center justify-content-between gap-2" style="background: #991b1b;">
            <div>
                <h5 class="admin-card-title mb-0 text-white font-weight-bold">Sensitive Field Access</h5>
                <div class="text-white-50 small">Confidential pricing, margins, and unmasked customer PII</div>
            </div>
            <% if (canEdit) { %>
                <button type="button" class="btn btn-sm btn-outline-light py-1 px-2" style="font-size: 11px;" onclick="setFieldPreset('NONE')">Hide All Sensitive Fields</button>
            <% } %>
        </div>
        <div class="p-3 bg-light">
            <div class="row g-2">
                <% const userFieldPerms = targetUser.fieldPermissions || [];
                   for (const [fieldKey, fieldMeta] of Object.entries(sensitiveFields)) {
                       const isChecked = isTargetPrimaryAdmin || userFieldPerms.includes(fieldKey);
                       const isFieldLocked = !canEdit || !canDelegateField(fieldKey); %>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border bg-white p-2">
                            <div class="form-check form-switch mb-1">
                                <input class="form-check-input field-perm-checkbox" type="checkbox" id="field_<%= fieldKey %>" value="<%= fieldKey %>" data-delegatable="<%= canDelegateField(fieldKey) ? 'true' : 'false' %>" <%= isChecked ? 'checked' : '' %> <%= isFieldLocked ? 'disabled' : '' %> onchange="handleFieldCheck(this)">
                                <label class="form-check-label font-weight-bold text-dark small" for="field_<%= fieldKey %>">
                                    <%= fieldMeta.label || fieldKey %>
                                    <% if (!canDelegateField(fieldKey)) { %><span class="badge bg-light text-muted border ms-1" style="font-size: 9px;">Admin Only</span><% } %>
                                </label>
                            </div>
                            <div class="text-muted" style="font-size: 11px;"><%= fieldMeta.description || '' %></div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Granular Module & Action Accordions -->
    <div class="mb-4">
        <div class="accordion" id="modulesAccordion">
            <% for (const [modId, modData] of Object.entries(permissionTree)) {
                const featuresMap = {};
                (modData.permissions || []).forEach(perm => {
                    const featureKey = perm.feature || 'general';
                    if (!featuresMap[featureKey]) featuresMap[featureKey] = [];
                    featuresMap[featureKey].push(perm);
                });
                const totalModPerms = (modData.permissions || []).length;
                const assignedModPerms = (modData.permissions || []).filter(p => isTargetPrimaryAdmin || userPerms.includes(p.key)).length;
            %>
                <div class="accordion-item admin-card mb-3 module-accordion-card" id="card_mod_<%= modId %>" data-module="<%= modId %>">
                    <h2 class="accordion-header" id="heading_<%= modId %>">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_<%= modId %>" aria-expanded="false" aria-controls="collapse_<%= modId %>">
                            <div class="d-flex align-items-center justify-content-between w-100 me-3">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="<%= modData.icon || 'icofont-box' %> text-primary"></i>
                                    <span class="font-weight-bold text-dark"><%= modData.name %></span>
                                </div>
                                <span class="badge <%= assignedModPerms === totalModPerms ? 'bg-success' : (assignedModPerms > 0 ? 'bg-primary' : 'bg-secondary') %> module-counter-badge" id="counter_<%= modId %>">
                                    <%= assignedModPerms %> / <%= totalModPerms %>
                                </span>
                            </div>
                        </button>
                    </h2>
                    <div id="collapse_<%= modId %>" class="accordion-collapse collapse" aria-labelledby="heading_<%= modId %>">
                        <div class="accordion-body p-3 bg-white border-top">
                            <% if (canEdit) { %>
                                <div class="d-flex justify-content-end gap-2 mb-3">
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 11px;" onclick="selectAllInModule('<%= modId %>')">Select All Allowed</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11px;" onclick="clearAllInModule('<%= modId %>')">Clear Module</button>
                                </div>
                            <% } %>
                            <% for (const [featureKey, permsList] of Object.entries(featuresMap)) {
                                const featureTitle = (featureKey || 'general').split('_').filter(Boolean).map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
                            %>
                                <div class="feature-block mb-3 p-2 rounded-3 bg-light border feature-item" data-feature="<%= featureKey %>" data-module="<%= modId %>">
                                    <div class="font-weight-bold text-dark small mb-2 px-1"><%= featureTitle %></div>
                                    <div class="row g-2">
                                        <% permsList.forEach(p => {
                                            const isPermChecked = isTargetPrimaryAdmin || userPerms.includes(p.key);
                                            const permName = p.name || p.label || p.key;
                                            const permDesc = p.description || '';
                                            const permAction = p.action || 'action';
                                            const allowedForCaller = canDelegatePerm(p.key);
                                        %>
                                            <div class="col-md-6 col-lg-4 permission-item-col" data-key="<%= p.key %>" data-name="<%= String(permName).toLowerCase() %>" data-desc="<%= String(permDesc).toLowerCase() %>" data-action="<%= String(permAction).toLowerCase() %>">
                                                <div class="card p-2 h-100 bg-white border shadow-none perm-card <%= isPermChecked ? 'border-primary' : '' %>">
                                                    <div class="form-check form-check-sm mb-0 d-flex align-items-start gap-2">
                                                        <input class="form-check-input perm-checkbox mt-1" type="checkbox" id="perm_<%= p.key %>" value="<%= p.key %>" data-module="<%= modId %>" data-feature="<%= featureKey %>" data-action="<%= String(permAction).toLowerCase() %>" data-delegatable="<%= allowedForCaller ? 'true' : 'false' %>" <%= isPermChecked ? 'checked' : '' %> <%= (!canEdit || !allowedForCaller) ? 'disabled' : '' %> onchange="handlePermCheck(this)">
                                                        <label class="form-check-label text-dark font-weight-bold small w-100" for="perm_<%= p.key %>">
                                                            <div class="d-flex align-items-center justify-content-between gap-1">
                                                                <span><%= permName %></span>
                                                                <% if (!allowedForCaller) { %>
                                                                    <span class="badge bg-light text-muted border" style="font-size: 9px;">Admin Only</span>
                                                                <% } %>
                                                            </div>
                                                            <div class="text-muted fw-normal" style="font-size: 11px; line-height: 1.3;"><%= permDesc %></div>
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Audit Notes & Bottom Action Bar -->
<div class="admin-card mb-4">
    <div class="p-3 p-md-4">
        <label class="form-label small font-weight-bold mb-1" for="auditNotesInput">Permission Change Note (Optional)</label>
        <input type="text" id="auditNotesInput" class="form-control form-control-sm" placeholder="e.g. Enabled employee-level GPS attendance & project view" <%= !canEdit ? 'disabled' : '' %>>
    </div>
</div>

<div class="d-flex align-items-center justify-content-between mb-5">
    <a href="<%= safeBackUrl %>" class="btn btn-outline-secondary">
        <i class="icofont-arrow-left me-1"></i> Back to Staff List
    </a>
    <% if (canEdit) { %>
        <button type="button" class="btn btn-warning font-weight-bold text-dark px-4 shadow-sm" onclick="savePermissions()">
            <i class="icofont-save me-1"></i> Save Changes
        </button>
    <% } %>
</div>
</form>

<style>
.admin-unsaved-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #0f172a; box-shadow: 0 -4px 16px rgba(0,0,0,0.25); z-index: 1050; border-top: 2px solid #f59e0b; }
.att-level-card, .access-level-card, .role-preset-card { transition: all .18s ease; }
.att-level-card.active-att-card,
.access-level-card.active-access-card,
.role-preset-card.active-preset-card { border-color: #163563 !important; background: #eff6ff !important; box-shadow: 0 0 0 2px rgba(22, 53, 99, .18) !important; }
.role-preset-card:hover, .att-level-card:hover, .access-level-card:hover { border-color: #163563 !important; transform: translateY(-1px); }
</style>

<script>
const USER_ID = '<%= targetUser._id %>';
const CSRF_TOKEN = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
const CAN_EDIT = <%= canEdit ? 'true' : 'false' %>;
const ROLE_BASELINES = <%- JSON.stringify(roleBaselines || {}).replace(/</g, '\\u003c') %>;
const DESIGNATION_PRESETS = <%- JSON.stringify(typeof designationPresets !== 'undefined' ? designationPresets : {}).replace(/</g, '\\u003c') %>;

const COMMON_BASIC_ATTENDANCE = ['attendance.module.access', 'attendance.punch.create', 'attendance.personal.view'];

const ATT_LEVEL_PERMS = {
    NONE: [],
    EMPLOYEE: COMMON_BASIC_ATTENDANCE,
    MANAGER: [...COMMON_BASIC_ATTENDANCE, 'attendance.branch.view'],
    ADMIN: [...COMMON_BASIC_ATTENDANCE, 'attendance.branch.view', 'attendance.all.view', 'attendance.all.export']
};

const initialPermsSet = new Set(<%- JSON.stringify(userPerms).replace(/</g, '\\u003c') %>);
const initialFieldsSet = new Set(<%- JSON.stringify(targetUser.fieldPermissions || []).replace(/</g, '\\u003c') %>);
const initialDataScope = '<%= targetUser.dataScope || "BRANCH" %>';
let hasUnsavedChanges = false;
let currentFilter = 'ALL';

function toggleAdvancedMode() {
    const box = document.getElementById('advancedPermissionsContainer');
    const btn = document.getElementById('toggleAdvancedBtn');
    const isHidden = box.classList.contains('d-none');
    box.classList.toggle('d-none', !isHidden);
    btn.innerHTML = isHidden
        ? '<i class="icofont-simple-up me-1"></i> Hide Advanced Keys'
        : '<i class="icofont-sliders-alt me-1"></i> Show Advanced Keys';
}

function getCurrentSelectedPermissions() {
    return Array.from(document.querySelectorAll('.perm-checkbox:checked')).map(cb => cb.value);
}

function getCurrentSelectedFields() {
    return Array.from(document.querySelectorAll('.field-perm-checkbox:checked')).map(cb => cb.value);
}

function getCurrentAuthorizedBranches() {
    return Array.from(document.querySelectorAll('.authorized-branch-checkbox:checked')).map(cb => cb.value);
}

function detectAttendanceLevel(permsSet) {
    if (permsSet.has('attendance.all.view') || permsSet.has('attendance.all.export')) return 'ADMIN';
    if (permsSet.has('attendance.branch.view')) return 'MANAGER';
    if (permsSet.has('attendance.punch.create') || permsSet.has('attendance.personal.view')) return 'EMPLOYEE';
    if (permsSet.has('attendance.module.access')) return 'EMPLOYEE';
    return 'NONE';
}

function detectOverallAccessLevel(permsSet) {
    if (permsSet.size === 0) return 'NONE';
    const saPerms = (ROLE_BASELINES.SUPER_ADMIN && ROLE_BASELINES.SUPER_ADMIN.permissions) || [];
    const mgrPerms = (ROLE_BASELINES.BRANCH_MANAGER && ROLE_BASELINES.BRANCH_MANAGER.permissions) || [];
    const empPerms = (ROLE_BASELINES.EMPLOYEE && ROLE_BASELINES.EMPLOYEE.permissions) || [];
    const delegatableSet = new Set(
        Array.from(document.querySelectorAll('.perm-checkbox[data-delegatable="true"]')).map(cb => cb.value)
    );
    const matchesBaseline = (list) => {
        const eligible = list.filter(k => delegatableSet.has(k));
        return eligible.length > 0 && eligible.every(k => permsSet.has(k));
    };
    if (saPerms.length > 0 && delegatableSet.has('settings.security.manage') && matchesBaseline(saPerms)) return 'ADMIN';
    if (mgrPerms.length > 0 && permsSet.has('attendance.branch.view') && matchesBaseline(mgrPerms)) return 'MANAGER';
    if (empPerms.length > 0 && matchesBaseline(empPerms)) return 'EMPLOYEE';
    return 'CUSTOM';
}

function syncSimpleUiStates() {
    const selectedSet = new Set(getCurrentSelectedPermissions());
    const attLevel = detectAttendanceLevel(selectedSet);
    const overallLevel = detectOverallAccessLevel(selectedSet);
    const attNames = { NONE: 'Off', EMPLOYEE: 'Basic Common On', MANAGER: 'Manager On', ADMIN: 'Full Admin' };
    const roleNames = { NONE: 'No Access', EMPLOYEE: 'Employee Level', MANAGER: 'Manager Level', ADMIN: 'Full Admin Access', CUSTOM: 'Custom / Role Setup' };

    const metricRole = document.getElementById('metricRoleLevel');
    const roleBadge = document.getElementById('roleLevelCardBadge');
    const metricAtt = document.getElementById('metricAttendanceLevel');
    if (metricRole) metricRole.innerText = roleNames[overallLevel] || 'Custom';
    if (roleBadge) roleBadge.innerText = `Current: ${roleNames[overallLevel] || 'Custom'}`;
    if (metricAtt) {
        metricAtt.innerText = attNames[attLevel];
        metricAtt.className = `font-weight-bold small mt-1 ${attLevel === 'NONE' ? 'text-danger' : 'text-success'}`;
    }

    document.querySelectorAll('.access-level-card').forEach(btn => {
        const isMatch = btn.getAttribute('data-access-level') === overallLevel;
        btn.classList.toggle('active-access-card', isMatch);
        const icon = btn.querySelector('.access-check-icon i');
        if (icon) icon.classList.toggle('d-none', !isMatch);
    });

    // Highlight matching designation preset cards
    document.querySelectorAll('.role-preset-card').forEach(btn => {
        const key = btn.getAttribute('data-preset-key');
        const list = DESIGNATION_PRESETS[key] || ((ROLE_BASELINES[key] && ROLE_BASELINES[key].permissions) || []);
        const isExactOrCovered = list.length > 0 && list.every(p => {
            const cb = document.querySelector(`.perm-checkbox[value="${p}"]`);
            return !cb || cb.getAttribute('data-delegatable') !== 'true' || selectedSet.has(p);
        });
        btn.classList.toggle('active-preset-card', isExactOrCovered && key !== 'BRANCH_MANAGER' ? isExactOrCovered : (key === 'BRANCH_MANAGER' && overallLevel === 'MANAGER'));
    });

    // Sync Simple Module Switchboard
    document.querySelectorAll('.simple-module-row').forEach(row => {
        const modId = row.getAttribute('data-simple-module');
        const modCheckboxes = Array.from(document.querySelectorAll(`.perm-checkbox[data-module="${modId}"]`));
        const checkedBoxes = modCheckboxes.filter(cb => cb.checked);
        const statusEl = document.getElementById(`simple_status_${modId}`);

        let modState = 'NONE';
        if (modId === 'attendance') {
            modState = attLevel;
            if (statusEl) {
                statusEl.innerText = attNames[attLevel];
                statusEl.className = `badge simple-mod-status ${attLevel === 'NONE' ? 'bg-secondary' : (attLevel === 'EMPLOYEE' ? 'bg-success' : 'bg-primary')}`;
            }
        } else {
            const delegatableCount = modCheckboxes.filter(cb => cb.getAttribute('data-delegatable') === 'true').length;
            if (checkedBoxes.length === 0) {
                modState = 'NONE';
            } else if (delegatableCount > 0 && checkedBoxes.length >= delegatableCount) {
                modState = 'MANAGE';
            } else if (checkedBoxes.every(cb => ['view', 'access'].includes(cb.getAttribute('data-action')))) {
                modState = 'VIEW';
            } else {
                modState = 'CUSTOM';
            }
            if (statusEl) {
                const statusMap = { NONE: ['bg-secondary', 'Off'], VIEW: ['bg-info text-dark', 'View Only'], MANAGE: ['bg-primary', 'Full Allowed'], CUSTOM: ['bg-warning text-dark', `${checkedBoxes.length}/${modCheckboxes.length} Custom`] };
                const [cls, txt] = statusMap[modState] || statusMap.NONE;
                statusEl.className = `badge simple-mod-status ${cls}`;
                statusEl.innerText = txt;
            }
        }

        row.querySelectorAll('.simple-mod-btn').forEach(b => {
            b.classList.toggle('active', b.getAttribute('data-level') === modState);
        });
    });

    // Keep inline Custom Edit drawer checkboxes synced with underlying .perm-checkbox inputs
    document.querySelectorAll('.custom-drawer-check').forEach(dc => {
        const permKey = dc.getAttribute('data-target-perm');
        const realCb = document.querySelector(`.perm-checkbox[value="${permKey}"]`);
        if (realCb) {
            dc.checked = realCb.checked;
            dc.disabled = realCb.disabled;
            const card = dc.closest('.custom-drawer-card');
            if (card) card.classList.toggle('border-primary', dc.checked);
        }
    });
}

function handleCustomDrawerToggle(drawerCb) {
    if (!CAN_EDIT || !drawerCb) return;
    const permKey = drawerCb.getAttribute('data-target-perm');
    const realCb = document.querySelector(`.perm-checkbox[value="${permKey}"]`);
    if (realCb) {
        setCheckboxState(realCb, drawerCb.checked);
        markUnsaved();
    }
}

function toggleCustomModuleDrawer(modId) {
    const drawer = document.getElementById(`custom_drawer_${modId}`);
    const btn = document.getElementById(`custom_btn_${modId}`);
    if (!drawer) return;
    const willOpen = drawer.classList.contains('d-none');
    drawer.classList.toggle('d-none', !willOpen);
    if (btn) {
        btn.classList.toggle('btn-warning', willOpen);
        btn.classList.toggle('btn-outline-warning', !willOpen);
    }
    syncToggleAllDrawersBtn();
}

function toggleAllCustomDrawers() {
    const drawers = Array.from(document.querySelectorAll('.custom-module-drawer'));
    const hasClosed = drawers.some(d => d.classList.contains('d-none'));
    drawers.forEach(d => {
        const modId = d.getAttribute('data-custom-drawer');
        d.classList.toggle('d-none', !hasClosed);
        const btn = document.getElementById(`custom_btn_${modId}`);
        if (btn) {
            btn.classList.toggle('btn-warning', hasClosed);
            btn.classList.toggle('btn-outline-warning', !hasClosed);
        }
    });
    syncToggleAllDrawersBtn();
}

function syncToggleAllDrawersBtn() {
    const allBtn = document.getElementById('toggleAllDrawersBtn');
    if (!allBtn) return;
    const drawers = Array.from(document.querySelectorAll('.custom-module-drawer'));
    const anyOpen = drawers.some(d => !d.classList.contains('d-none'));
    allBtn.innerHTML = anyOpen
        ? '<i class="icofont-simple-up me-1"></i> Collapse Custom Sections'
        : '<i class="icofont-edit me-1"></i> Custom Edit All Sections';
}

function openStep3CustomMode() {
    const drawers = Array.from(document.querySelectorAll('.custom-module-drawer'));
    drawers.forEach(d => {
        const modId = d.getAttribute('data-custom-drawer');
        d.classList.remove('d-none');
        const btn = document.getElementById(`custom_btn_${modId}`);
        if (btn) {
            btn.classList.add('btn-warning');
            btn.classList.remove('btn-outline-warning');
        }
    });
    syncToggleAllDrawersBtn();
    const firstRow = document.querySelector('.simple-module-row');
    if (firstRow) firstRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function setCheckboxState(cb, shouldCheck) {
    if (!cb) return;
    const isDelegatable = cb.getAttribute('data-delegatable') === 'true';
    if (shouldCheck && !isDelegatable) return;
    if (!shouldCheck && !isDelegatable && cb.checked) return;
    cb.checked = Boolean(shouldCheck);
    const card = cb.closest('.perm-card');
    if (card) card.classList.toggle('border-primary', cb.checked);
}

function applyAccessLevel(level) {
    if (!CAN_EDIT) return;
    if (level === 'NONE') {
        document.querySelectorAll('.perm-checkbox').forEach(cb => setCheckboxState(cb, false));
        document.querySelectorAll('.field-perm-checkbox').forEach(cb => {
            if (cb.getAttribute('data-delegatable') === 'true') cb.checked = false;
        });
        markUnsaved();
        return;
    }

    let baseline = null;
    let targetScope = 'ASSIGNED';
    if (level === 'EMPLOYEE') {
        baseline = ROLE_BASELINES.EMPLOYEE || {};
        targetScope = 'ASSIGNED';
    } else if (level === 'MANAGER') {
        baseline = ROLE_BASELINES.BRANCH_MANAGER || {};
        targetScope = 'BRANCH';
    } else if (level === 'ADMIN') {
        baseline = ROLE_BASELINES.SUPER_ADMIN || {};
        targetScope = 'GLOBAL';
    }
    if (!baseline) return;

    const targetKeys = new Set([
        ...(baseline.permissions || []),
        ...COMMON_BASIC_ATTENDANCE
    ]);
    document.querySelectorAll('.perm-checkbox').forEach(cb => setCheckboxState(cb, targetKeys.has(cb.value)));

    const fieldSet = new Set(baseline.fieldPermissions || []);
    document.querySelectorAll('.field-perm-checkbox').forEach(cb => {
        if (cb.getAttribute('data-delegatable') === 'true') cb.checked = fieldSet.has(cb.value);
    });

    const scopeSelect = document.getElementById('dataScopeSelect');
    if (scopeSelect && Array.from(scopeSelect.options).some(o => o.value === targetScope)) {
        scopeSelect.value = targetScope;
        handleDataScopeChange(targetScope);
    }
    markUnsaved();
}

function ensureBasicAttendance() {
    if (!CAN_EDIT) return;
    COMMON_BASIC_ATTENDANCE.forEach(k => {
        const cb = document.querySelector(`.perm-checkbox[value="${k}"]`);
        setCheckboxState(cb, true);
    });
    markUnsaved();
}

function setAttendanceLevel(level) {
    if (!CAN_EDIT) return;
    const targetKeys = new Set(ATT_LEVEL_PERMS[level] || []);
    document.querySelectorAll('.perm-checkbox[data-module="attendance"]').forEach(cb => {
        setCheckboxState(cb, targetKeys.has(cb.value));
    });
    markUnsaved();
}

function setSimpleModuleLevel(modId, level) {
    if (!CAN_EDIT) return;
    document.querySelectorAll(`.perm-checkbox[data-module="${modId}"]`).forEach(cb => {
        if (level === 'NONE') {
            setCheckboxState(cb, false);
        } else if (level === 'VIEW') {
            const act = cb.getAttribute('data-action');
            setCheckboxState(cb, act === 'view' || act === 'access');
        } else {
            setCheckboxState(cb, true);
        }
    });
    markUnsaved();
}

function markUnsaved() {
    if (!CAN_EDIT) return;
    const currentPerms = getCurrentSelectedPermissions();
    const currentFields = getCurrentSelectedFields();
    const scopeEl = document.getElementById('dataScopeSelect');
    const currentScope = scopeEl ? scopeEl.value : initialDataScope;

    let addedCount = 0;
    let removedCount = 0;
    currentPerms.forEach(p => { if (!initialPermsSet.has(p)) addedCount++; });
    initialPermsSet.forEach(p => { if (!currentPerms.includes(p)) removedCount++; });
    currentFields.forEach(f => { if (!initialFieldsSet.has(f)) addedCount++; });
    initialFieldsSet.forEach(f => { if (!currentFields.includes(f)) removedCount++; });

    const scopeChanged = currentScope !== initialDataScope;
    const totalDiff = addedCount + removedCount + (scopeChanged ? 1 : 0);
    hasUnsavedChanges = totalDiff > 0;

    const unsavedBar = document.getElementById('unsavedChangesBar');
    if (unsavedBar) unsavedBar.classList.toggle('d-none', !hasUnsavedChanges);
    const countSpan = document.getElementById('pendingChangesCount');
    if (countSpan) countSpan.innerText = totalDiff;
    const diffBadge = document.getElementById('pendingChangesDiff');
    if (diffBadge) diffBadge.innerText = `+${addedCount} added, -${removedCount} removed${scopeChanged ? ', scope updated' : ''}`;

    updateMetricCounters(currentPerms.length, currentFields.length);
    syncSimpleUiStates();
}

function updateMetricCounters(permsCount) {
    const allPermsCount = document.querySelectorAll('.perm-checkbox').length;
    const metricPerm = document.getElementById('metricAssignedCount');
    const totalAssignedCount = document.getElementById('totalAssignedCount');
    const totalUnassignedCount = document.getElementById('totalUnassignedCount');
    if (metricPerm) metricPerm.innerText = `${permsCount} / ${allPermsCount}`;
    if (totalAssignedCount) totalAssignedCount.innerText = permsCount;
    if (totalUnassignedCount) totalUnassignedCount.innerText = Math.max(0, allPermsCount - permsCount);

    document.querySelectorAll('.module-accordion-card').forEach(card => {
        const modId = card.getAttribute('data-module');
        const checkboxes = card.querySelectorAll('.perm-checkbox');
        const checkedCount = card.querySelectorAll('.perm-checkbox:checked').length;
        const badge = document.getElementById(`counter_${modId}`);
        if (badge) {
            badge.innerText = `${checkedCount} / ${checkboxes.length}`;
            badge.className = `badge ${checkedCount === checkboxes.length ? 'bg-success' : (checkedCount > 0 ? 'bg-primary' : 'bg-secondary')} module-counter-badge`;
        }
    });
}

function handlePermCheck(el) {
    const card = el.closest('.perm-card');
    if (card) card.classList.toggle('border-primary', el.checked);
    markUnsaved();
}

function handleFieldCheck(el) {
    markUnsaved();
}

function handleDataScopeChange(val) {
    const multiContainer = document.getElementById('multiBranchContainer');
    if (multiContainer) multiContainer.style.display = (val === 'MULTI_BRANCH') ? 'block' : 'none';
    const badge = document.getElementById('scopeBadgeDisplay');
    if (badge) badge.innerText = `Scope: ${val}`;
    markUnsaved();
}

function selectAllInModule(modId) {
    if (!CAN_EDIT) return;
    document.querySelectorAll(`.perm-checkbox[data-module="${modId}"]`).forEach(cb => setCheckboxState(cb, true));
    markUnsaved();
}

function clearAllInModule(modId) {
    if (!CAN_EDIT) return;
    document.querySelectorAll(`.perm-checkbox[data-module="${modId}"]`).forEach(cb => setCheckboxState(cb, false));
    markUnsaved();
}

function applyQuickPreset(presetKey) {
    if (!CAN_EDIT) return;
    let targetPerms = [];
    let targetScope = 'ASSIGNED';
    let targetFields = [];

    if (presetKey === 'SUPER_ADMIN') {
        const sa = ROLE_BASELINES.SUPER_ADMIN || {};
        targetPerms = sa.permissions || [];
        targetFields = sa.fieldPermissions || [];
        targetScope = 'GLOBAL';
    } else if (presetKey === 'BRANCH_MANAGER') {
        const bm = ROLE_BASELINES.BRANCH_MANAGER || {};
        targetPerms = bm.permissions || [];
        targetFields = ['fields.quotation.cost_breakdown.view', 'fields.customer.pii.view'];
        targetScope = 'BRANCH';
    } else if (DESIGNATION_PRESETS[presetKey]) {
        targetPerms = DESIGNATION_PRESETS[presetKey];
        targetScope = presetKey === 'STORE_KEEPER' ? 'BRANCH' : 'ASSIGNED';
    } else {
        return;
    }

    const permSet = new Set([...targetPerms, ...COMMON_BASIC_ATTENDANCE]);
    document.querySelectorAll('.perm-checkbox').forEach(cb => setCheckboxState(cb, permSet.has(cb.value)));

    const fieldSet = new Set(targetFields);
    document.querySelectorAll('.field-perm-checkbox').forEach(cb => {
        if (cb.getAttribute('data-delegatable') === 'true') cb.checked = fieldSet.has(cb.value);
    });

    const scopeSelect = document.getElementById('dataScopeSelect');
    if (scopeSelect && Array.from(scopeSelect.options).some(o => o.value === targetScope)) {
        scopeSelect.value = targetScope;
        handleDataScopeChange(targetScope);
    }
    markUnsaved();
}

function grantAllViewPermissions() {
    if (!CAN_EDIT) return;
    document.querySelectorAll('.perm-checkbox').forEach(cb => {
        const act = cb.getAttribute('data-action');
        if (act === 'view' || act === 'access') setCheckboxState(cb, true);
    });
    markUnsaved();
}

function setFieldPreset(presetType) {
    if (!CAN_EDIT) return;
    document.querySelectorAll('.field-perm-checkbox').forEach(cb => {
        if (cb.getAttribute('data-delegatable') === 'true') cb.checked = (presetType !== 'NONE');
    });
    markUnsaved();
}

function confirmRevokeAll() {
    if (!CAN_EDIT) return;
    if (!confirm('Remove all assigned permissions for this user?')) return;
    document.querySelectorAll('.perm-checkbox').forEach(cb => setCheckboxState(cb, false));
    document.querySelectorAll('.field-perm-checkbox').forEach(cb => {
        if (cb.getAttribute('data-delegatable') === 'true') cb.checked = false;
    });
    markUnsaved();
}

function discardChanges() {
    window.location.reload();
}

function handleSearch(term) {
    const cleanTerm = (term || '').trim().toLowerCase();
    let visible = 0;
    document.querySelectorAll('.permission-item-col').forEach(col => {
        const key = (col.getAttribute('data-key') || '').toLowerCase();
        const name = col.getAttribute('data-name') || '';
        const desc = col.getAttribute('data-desc') || '';
        const action = col.getAttribute('data-action') || '';
        const cb = col.querySelector('.perm-checkbox');
        const isChecked = cb ? cb.checked : false;

        const matchesSearch = !cleanTerm || key.includes(cleanTerm) || name.includes(cleanTerm) || desc.includes(cleanTerm) || action.includes(cleanTerm);
        const matchesFilter = currentFilter === 'ALL' || (currentFilter === 'ASSIGNED' ? isChecked : !isChecked);
        const show = matchesSearch && matchesFilter;
        col.style.display = show ? 'block' : 'none';
        if (show) visible++;
    });

    document.querySelectorAll('.feature-item').forEach(feat => {
        const hasCols = Array.from(feat.querySelectorAll('.permission-item-col')).some(c => c.style.display !== 'none');
        feat.style.display = hasCols ? 'block' : 'none';
    });

    document.querySelectorAll('.module-accordion-card').forEach(card => {
        const modId = card.getAttribute('data-module');
        const collapseEl = document.getElementById(`collapse_${modId}`);
        const btn = card.querySelector('.accordion-button');
        const hasFeats = Array.from(card.querySelectorAll('.feature-item')).some(f => f.style.display !== 'none');
        card.style.display = hasFeats ? 'block' : 'none';
        if (cleanTerm && hasFeats && collapseEl) {
            collapseEl.classList.add('show');
            if (btn) btn.classList.remove('collapsed');
        }
    });

    const totalVisibleSpan = document.getElementById('totalVisibleCount');
    if (totalVisibleSpan) totalVisibleSpan.innerText = visible;
}

function clearSearch() {
    document.getElementById('permissionSearchInput').value = '';
    handleSearch('');
}

function setFilter(type) {
    currentFilter = type;
    ['All', 'Assigned', 'Unassigned'].forEach(t => {
        const btn = document.getElementById(`filterBtn${t}`);
        if (btn) btn.classList.toggle('active', t.toUpperCase() === type);
    });
    handleSearch(document.getElementById('permissionSearchInput').value);
}

function toggleExpandAll() {
    const collapses = document.querySelectorAll('.accordion-collapse');
    const buttons = document.querySelectorAll('.accordion-button[data-bs-toggle="collapse"]');
    const hasClosed = Array.from(collapses).some(c => !c.classList.contains('show'));
    collapses.forEach(c => c.classList.toggle('show', hasClosed));
    buttons.forEach(b => {
        b.classList.toggle('collapsed', !hasClosed);
        b.setAttribute('aria-expanded', String(hasClosed));
    });
    const btn = document.getElementById('expandAllBtn');
    if (btn) btn.innerHTML = hasClosed ? '<i class="icofont-collapse me-1"></i> Collapse All' : '<i class="icofont-expand me-1"></i> Expand All';
}

async function savePermissions() {
    if (!CAN_EDIT) return;
    const scopeEl = document.getElementById('dataScopeSelect');
    const notesEl = document.getElementById('auditNotesInput');

    const body = {
        permissions: getCurrentSelectedPermissions(),
        fieldPermissions: getCurrentSelectedFields(),
        dataScope: scopeEl ? scopeEl.value : initialDataScope,
        authorizedBranches: getCurrentAuthorizedBranches(),
        notes: notesEl ? notesEl.value : '',
        _csrf: CSRF_TOKEN
    };

    const saveEndpoint = window.location.pathname.startsWith('/manager')
        ? `/api/manager/employees/${USER_ID}/permissions`
        : `/api/admin/users/${USER_ID}/permissions`;

    try {
        const res = await fetch(saveEndpoint, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN
            },
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.success) {
            hasUnsavedChanges = false;
            const toast = document.getElementById('permToast');
            const toastMsg = document.getElementById('permToastMsg');
            if (toast && toastMsg) {
                toastMsg.innerText = data.message || 'Permissions updated successfully.';
                toast.classList.remove('d-none');
            }
            const unsavedBar = document.getElementById('unsavedChangesBar');
            if (unsavedBar) unsavedBar.classList.add('d-none');
            setTimeout(() => window.location.reload(), 900);
        } else {
            alert(data.message || 'Error updating permissions.');
        }
    } catch (err) {
        alert('Server communication error during permission save.');
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const allCount = document.querySelectorAll('.perm-checkbox').length;
    const totalVis = document.getElementById('totalVisibleCount');
    if (totalVis) totalVis.innerText = allCount;
    updateMetricCounters(getCurrentSelectedPermissions().length);
    syncSimpleUiStates();
});

window.addEventListener('beforeunload', (e) => {
    if (hasUnsavedChanges) {
        e.preventDefault();
        e.returnValue = 'You have unsaved permission changes.';
    }
});
</script>

