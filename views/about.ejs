<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <!-- Clean Sleek Subheader -->
    <section id="subheader" class="bg-dark text-light relative" style="background: linear-gradient(rgba(22, 53, 99, 0.85), rgba(15, 38, 71, 0.9)), url('/images/background/2.webp') center/cover no-repeat; padding: 110px 0 60px 0;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1 class="text-white font-weight-bold mt-2 mb-2" style="font-size: 44px; line-height: 1.2;">About Us</h1>
                    <p class="text-white-50 mb-0" style="font-size: 17px;"><%= company.tagline %> • Raisen, Madhya Pradesh</p>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section (Exact Image 2 Layout & Animations) -->
    <section class="py-5 bg-white">
        <div class="container py-4">
            <div class="row align-items-center g-5">
                <!-- Left Column: Overlapping Images + Floating Badge -->
                <div class="col-lg-6">
                    <div class="position-relative pe-lg-4">
                        <!-- Main Image: Mother & Child pointing at solar panels -->
                        <div class="overflow-hidden shadow-lg wow fadeInLeft" data-wow-delay=".2s" style="border-radius: 20px;">
                            <img src="/images/misc/p1.webp" class="img-fluid w-100 d-block" alt="Clean Solar Energy Family" style="transition: transform 0.5s ease;">
                        </div>

                        <!-- Secondary Overlapping Image: Solar Roof -->
                        <div class="position-absolute overflow-hidden shadow-lg wow fadeInUp d-none d-sm-block" data-wow-delay=".4s" style="bottom: -30px; right: 0; width: 55%; border-radius: 18px; border: 4px solid #ffffff;">
                            <img src="/images/misc/p2.webp" class="img-fluid w-100 d-block" alt="Rooftop Solar Installation">
                        </div>

                        <!-- Dark Blue Floating Badge (325% Clean Energy Growth) -->
                        <div class="position-absolute wow zoomIn" data-wow-delay=".5s" style="bottom: 20px; left: -15px; background: #0f2647; color: #ffffff; padding: 20px 28px; border-radius: 14px; box-shadow: 0 12px 30px rgba(0,0,0,0.3); z-index: 5;">
                            <h2 class="text-white font-weight-bold mb-0" style="font-size: 36px; line-height: 1; letter-spacing: -1px;">325%</h2>
                            <span style="color: var(--primary-color); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Clean Energy Growth</span>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Clean Typography & Content -->
                <div class="col-lg-6">
                    <div class="ps-lg-3 wow fadeInRight" data-wow-delay=".3s">
                        <span class="text-uppercase font-weight-bold d-block mb-2" style="color: #163563; font-size: 13px; letter-spacing: 2px;">About Us</span>
                        <h2 class="font-weight-bold mb-3 text-dark" style="font-size: 38px; line-height: 1.25; letter-spacing: -0.5px;">
                            Solar Solutions for Maximum Energy Savings
                        </h2>

                        <p class="text-muted mb-3" style="font-size: 16px; line-height: 1.8;">
                            At <%= company.name %>, we are passionate about harnessing the power of the sun to create a cleaner, more sustainable future. Since our founding in Raisen, Madhya Pradesh, we've been committed to making solar energy accessible and affordable for homeowners and businesses alike. Our team of experts specializes in designing and installing high-efficiency solar systems tailored to each customer's unique energy needs, helping them reduce electricity bills while lowering their carbon footprint.
                        </p>

                        <p class="text-muted mb-4" style="font-size: 16px; line-height: 1.8;">
                            We believe that switching to solar shouldn't be complicated. That's why we offer end-to-end solutions, from consultation and financing to installation and ongoing maintenance. As an authorized partner, we help families avail up to <strong>₹78,000</strong> direct bank subsidy under <strong>PM Surya Ghar: Muft Bijli Yojana</strong>. By choosing <%= company.name %>, you're not just saving money—you're investing in a greener tomorrow.
                        </p>

                        <div class="row g-3 pt-2 mb-4">
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center">
                                    <div class="me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; border-radius: 50%; background: rgba(198, 255, 125, 0.25); color: #163563; font-size: 20px;">
                                        <i class="icofont-check"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 font-weight-bold text-dark">Tier-1 DCR Panels</h6>
                                        <small class="text-muted">25-Yr Performance Guarantee</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center">
                                    <div class="me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; border-radius: 50%; background: rgba(198, 255, 125, 0.25); color: #163563; font-size: 20px;">
                                        <i class="icofont-check"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 font-weight-bold text-dark">Govt DBT Subsidy</h6>
                                        <small class="text-muted">Fast DISCOM Net-Metering</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <a href="/calculator" class="btn-main fx-slide" style="background: var(--primary-color); color: #000; border-radius: 30px; padding: 12px 30px; font-weight: 700;">
                                <span>Get a Free Solar Quote</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Leadership Section -->
    <section id="team" class="py-5" style="background: #f8f9fa;">
        <div class="container py-4">
            <div class="row justify-content-center text-center mb-4">
                <div class="col-lg-8">
                    <span class="text-uppercase font-weight-bold" style="color: #163563; font-size: 13px; letter-spacing: 2px;">Leadership</span>
                    <h2 class="font-weight-bold mb-2 text-dark" style="font-size: 34px;">Founders & Management Team</h2>
                    <p class="text-muted">Dedicated hands-on leadership with on-ground technical expertise in Raisen & Madhya Pradesh.</p>
                </div>
            </div>

            <div class="row justify-content-center g-4">
                <% company.contacts.forEach((contact, idx) => { %>
                    <div class="col-md-5">
                        <div class="card h-100 p-4 border-0 shadow-sm text-center bg-white" style="border-radius: 16px; transition: transform 0.3s ease;">
                            <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 75px; height: 75px; background: #163563; color: #fff; font-size: 28px; font-weight: bold;">
                                <%= contact.name.charAt(0) %>
                            </div>
                            <h4 class="font-weight-bold text-dark mb-1"><%= contact.name %></h4>
                            <span class="badge bg-light text-primary border mb-3 py-2 px-3"><%= contact.role %></span>
                            <p class="text-muted small mb-4">
                                Available for direct technical consultation, rooftop feasibility inspection in Raisen and surrounding districts, and project guidance.
                            </p>
                            <div class="d-flex gap-2 justify-content-center mt-auto">
                                <a href="tel:<%= contact.mobile %>" class="btn btn-outline-dark btn-sm px-3" style="border-radius: 20px;">
                                    <i class="icofont-phone me-1"></i> <%= contact.mobile %>
                                </a>
                                <a href="<%= contact.whatsapp %>" target="_blank" class="btn btn-success btn-sm px-3 text-white" style="border-radius: 20px;">
                                    <i class="fa-brands fa-whatsapp me-1"></i> WhatsApp
                                </a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonials" class="py-5 bg-white">
        <div class="container py-4">
            <div class="row justify-content-center text-center mb-4">
                <div class="col-lg-8">
                    <span class="text-uppercase font-weight-bold" style="color: #163563; font-size: 13px; letter-spacing: 2px;">Testimonials</span>
                    <h2 class="font-weight-bold mb-2 text-dark" style="font-size: 34px;">What Our Customers Say</h2>
                    <p class="text-muted">Real experiences from residential and commercial clients across Madhya Pradesh.</p>
                </div>
            </div>

            <div class="row g-4">
                <% data.testimonials.forEach(t => { %>
                    <div class="col-lg-6">
                        <div class="card h-100 p-4 border-0 shadow-sm bg-light" style="border-radius: 14px; border-left: 4px solid var(--primary-color) !important;">
                            <div class="text-warning mb-2">★★★★★</div>
                            <p class="text-secondary small mb-3">"<%= t.review %>"</p>
                            <div class="d-flex align-items-center mt-auto">
                                <div>
                                    <h6 class="mb-0 font-weight-bold text-dark"><%= t.name %></h6>
                                    <small class="text-muted"><%= t.location %> • <span class="text-primary font-weight-bold"><%= t.system %></span></small>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>
</div>

<%- include('partials/footer') %>
