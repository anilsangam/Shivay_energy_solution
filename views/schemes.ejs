<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <!-- Subheader -->
    <section id="subheader" class="bg-dark text-light relative" style="background: linear-gradient(rgba(22, 53, 99, 0.85), rgba(15, 38, 71, 0.9)), url('/images/background/2.webp') center/cover no-repeat; padding: 110px 0 60px 0;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1 class="text-white font-weight-bold mt-2 mb-2" style="font-size: 44px; line-height: 1.2;">PM Surya Ghar: Muft Bijli Yojana</h1>
                    <p class="text-white-50 mb-0" style="font-size: 17px;">Direct DBT Subsidy up to ₹78,000 for Residential Rooftop Solar across Madhya Pradesh.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Scheme Overview -->
    <section class="py-5 bg-white">
        <div class="container py-4">
            <div class="row align-items-center g-5 mb-5">
                <div class="col-lg-7">
                    <div class="badge bg-warning text-dark px-3 py-2 font-weight-bold mb-3" style="font-size: 13px;">MINISTRY OF NEW & RENEWABLE ENERGY (MNRE)</div>
                    <h2 class="font-weight-bold mb-3">Power Your Home For Free With Solar Subsidy</h2>
                    <p class="text-muted" style="line-height: 1.8;">
                        Under the <strong>PM Surya Ghar: Muft Bijli Yojana</strong> launched by Prime Minister Narendra Modi, the Central Government provides financial assistance (subsidy) directly into the bank accounts of residential households to install rooftop solar panels.
                    </p>
                    <p class="text-muted" style="line-height: 1.8;">
                        As an authorized solar installation partner in Raisen and Madhya Pradesh, <strong><%= company.name %></strong> handles the entire process end-to-end: DISCOM registration on the national portal, site feasibility approval, supply of DCR compliant panels, bi-directional net-meter installation, and final subsidy disbursement.
                    </p>

                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="https://pmsuryaghar.gov.in/" target="_blank" class="btn btn-outline-dark px-4 py-2 font-weight-bold">
                            <i class="icofont-external-link me-1"></i> Official Portal (pmsuryaghar.gov.in)
                        </a>
                        <a href="https://wa.me/917000575496?text=Namaste%20Deepak%20ji,%20I%20want%20to%20apply%20for%20PM%20Surya%20Ghar%20Subsidy%20in%20Raisen/MP." target="_blank" class="btn btn-success px-4 py-2 text-white font-weight-bold">
                            <i class="fa-brands fa-whatsapp me-1"></i> Apply Through Shivay Energy
                        </a>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="card p-4 border-0 shadow rounded-3 text-white" style="background: #163563;">
                        <h4 class="font-weight-bold mb-3" style="color: var(--primary-color);">Official Subsidy Slabs</h4>
                        <div class="d-flex flex-column gap-3">
                            <% data.schemes.pmSuryaGhar.subsidySlabs.forEach(slab => { %>
                                <div class="p-3 rounded-2" style="background: rgba(255, 255, 255, 0.08); border-left: 3px solid var(--primary-color);">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h5 class="mb-0 text-white font-weight-bold"><%= slab.capacity %></h5>
                                        <span class="badge" style="background: var(--primary-color); color: #000; font-size: 15px;"><%= slab.subsidy %></span>
                                    </div>
                                    <small class="text-white-50 d-block"><%= slab.suitableFor %></small>
                                    <div class="mt-2 pt-2 border-top border-secondary small text-white-50 d-flex justify-content-between">
                                        <span>Estimated Net Cost:</span>
                                        <strong class="text-white"><%= slab.netCost %></strong>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Eligibility & Documents -->
            <div class="row g-4 mb-5">
                <div class="col-lg-6">
                    <div class="card h-100 p-4 border-0 bg-light rounded-3">
                        <h4 class="font-weight-bold text-dark mb-3"><i class="icofont-check-circled text-success me-2"></i> Who is Eligible?</h4>
                        <ul class="list-unstyled mb-0" style="line-height: 1.9;">
                            <% data.schemes.pmSuryaGhar.eligibility.forEach(e => { %>
                                <li class="text-secondary mb-2"><i class="icofont-arrow-right text-success me-2"></i> <%= e %></li>
                            <% }); %>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card h-100 p-4 border-0 bg-light rounded-3">
                        <h4 class="font-weight-bold text-dark mb-3"><i class="icofont-document-folder text-primary me-2"></i> Required Documents</h4>
                        <ul class="list-unstyled mb-0" style="line-height: 1.9;">
                            <% data.schemes.pmSuryaGhar.requiredDocuments.forEach(doc => { %>
                                <li class="text-secondary mb-2"><i class="icofont-verification-check text-primary me-2"></i> <%= doc %></li>
                            <% }); %>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Step by Step Process -->
            <div class="py-4">
                <h3 class="text-center font-weight-bold mb-4">5 Easy Steps to Get Your Subsidy</h3>
                <div class="row g-3">
                    <% data.schemes.pmSuryaGhar.applicationSteps.forEach(step => { %>
                        <div class="col-lg col-md-4 col-sm-6">
                            <div class="card h-100 p-3 border-0 shadow-sm text-center bg-white rounded-3">
                                <div class="rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: #163563; color: var(--primary-color); font-weight: bold; font-size: 18px;">
                                    <%= step.step %>
                                </div>
                                <h6 class="font-weight-bold text-dark mb-1"><%= step.title %></h6>
                                <p class="text-muted small mb-0"><%= step.desc %></p>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>

            <div class="alert alert-warning mt-5 p-3 rounded-2 small text-dark">
                <strong>Important Notice:</strong> <%= data.schemes.pmSuryaGhar.disclaimer %>
            </div>
        </div>
    </section>
</div>

<style>
/* Page-specific responsive rules */
@media (min-width: 768px) {
    #content #subheader > .container { margin-top: 36px; }
}
@media (max-width: 767.98px) {
    #content { width: 100%; max-width: 100%; overflow-x: clip; }
    #content .container, #content .container-fluid { max-width: 100%; }
    #content .row > [class*="col-"] { min-width: 0; }
    #content .card, #content .card-body { min-width: 0; max-width: 100%; box-sizing: border-box; }
    #content h1, #content h2, #content h3, #content h4, #content p,
    #content small, #content strong, #content a, #content label { overflow-wrap: anywhere; }
    #content img, #content video, #content iframe { max-width: 100%; }
    #content input, #content select, #content textarea, #content button { max-width: 100%; min-width: 0; }
    #content .table-responsive { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    #content table { min-width: 620px; }
    #content .btn-main, #content .btn { white-space: normal; text-align: center; }
}
</style>
<%- include('partials/footer') %>
