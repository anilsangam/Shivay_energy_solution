<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <section id="subheader" class="bg-dark text-light relative py-4" style="background: #163563;">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <span class="badge" style="background: var(--primary-color); color: #000;">STAFF WORKSPACE</span>
                    <h3 class="text-white font-weight-bold mb-0 mt-1">Welcome, <%= user ? user.name : 'Staff Member' %></h3>
                    <small class="text-white-50"><%= company.name %> • Role: <%= user ? user.role : 'EMPLOYEE' %> | ID: <%= user ? user.employeeId : 'N/A' %></small>
                </div>
                <div class="d-flex gap-2 mt-3 mt-md-0">
                    <a href="/employee/attendance" class="btn btn-sm btn-warning font-weight-bold text-dark"><i class="icofont-location-pin"></i> Field Attendance</a>
                    <a href="/employee/quotations" class="btn btn-sm btn-outline-light"><i class="icofont-paper"></i> Create Quote</a>
                    <a href="/employee/profile" class="btn btn-sm btn-outline-light"><i class="icofont-ui-user"></i> Profile</a>
                    <a href="/auth/logout" class="btn btn-sm btn-danger"><i class="icofont-logout"></i> Sign Out</a>
                </div>
            </div>
        </div>
    </section>

    <section class="py-4 bg-light">
        <div class="container">
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card p-4 border-0 shadow-sm rounded-3 bg-white text-center">
                        <i class="icofont-check-circled text-success fs-36 mb-2"></i>
                        <h6 class="font-weight-bold text-dark mb-1">Today's Attendance</h6>
                        <p class="text-muted small mb-3">Status: <%= userAttendance && userAttendance.length > 0 ? 'Punched In' : 'Not Punched' %></p>
                        <a href="/employee/attendance" class="btn btn-sm btn-outline-primary">Punch Now</a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card p-4 border-0 shadow-sm rounded-3 bg-white text-center">
                        <i class="icofont-calculator-alt-2 text-primary fs-36 mb-2"></i>
                        <h6 class="font-weight-bold text-dark mb-1">Quotation Engine</h6>
                        <p class="text-muted small mb-3">Generate proposals for prospective rooftop clients</p>
                        <a href="/employee/quotations" class="btn btn-sm btn-outline-primary">New Quotation</a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card p-4 border-0 shadow-sm rounded-3 bg-white text-center">
                        <i class="icofont-shield-alt text-dark fs-36 mb-2"></i>
                        <h6 class="font-weight-bold text-dark mb-1">Account & Security</h6>
                        <p class="text-muted small mb-3">Update your password & contact details</p>
                        <a href="/employee/profile" class="btn btn-sm btn-outline-dark">Manage Profile</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<%- include('../partials/footer') %>
