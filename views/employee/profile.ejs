<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <section id="subheader" class="bg-dark text-light relative py-4" style="background: #163563;">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge" style="background: var(--primary-color); color: #000;">STAFF SETTINGS</span>
                    <h3 class="text-white font-weight-bold mb-0 mt-1">My Profile & Security</h3>
                    <small class="text-white-50"><%= company.name %> • <%= user ? user.name : 'User' %></small>
                </div>
                <a href="/employee/dashboard" class="btn btn-sm btn-outline-light">← Dashboard</a>
            </div>
        </div>
    </section>

    <section class="py-5 bg-light">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-7 col-lg-6">
                    <div class="card p-4 border-0 shadow-sm rounded-3 bg-white mb-4">
                        <h5 class="font-weight-bold text-dark mb-3">Staff Identity Details</h5>
                        <table class="table table-bordered small">
                            <tr>
                                <th class="w-35 bg-light">Full Name</th>
                                <td><%= user ? user.name : '' %></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Employee ID</th>
                                <td><code><%= user ? user.employeeId : '' %></code></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Email</th>
                                <td><%= user ? user.email : '' %></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Role</th>
                                <td><span class="badge bg-dark"><%= user ? user.role : '' %></span></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Account Status</th>
                                <td><span class="badge bg-success"><%= user ? user.status : '' %></span></td>
                            </tr>
                        </table>
                    </div>

                    <!-- Change Password Card -->
                    <div class="card p-4 border-0 shadow-sm rounded-3 bg-white">
                        <h5 class="font-weight-bold text-dark mb-3">Change Account Password</h5>
                        
                        <div id="pwdAlert" class="alert d-none small"></div>

                        <form onsubmit="handlePasswordChange(event)">
                            <div class="mb-3">
                                <label class="form-label small font-weight-bold">Current Password *</label>
                                <input type="password" id="curPass" class="form-control" required placeholder="••••••••">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small font-weight-bold">New Password (min 8 chars) *</label>
                                <input type="password" id="newPass" class="form-control" required minlength="8" placeholder="••••••••">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small font-weight-bold">Confirm New Password *</label>
                                <input type="password" id="confPass" class="form-control" required minlength="8" placeholder="••••••••">
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 font-weight-bold" style="background: #163563;">
                                Update Password Securely
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
function handlePasswordChange(e) {
    e.preventDefault();
    const cur = document.getElementById('curPass').value;
    const np = document.getElementById('newPass').value;
    const cp = document.getElementById('confPass').value;
    const box = document.getElementById('pwdAlert');

    if (np !== cp) {
        box.className = 'alert alert-danger small';
        box.innerText = 'New passwords do not match.';
        box.classList.remove('d-none');
        return;
    }

    fetch('/api/auth/change-password', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
        },
        body: JSON.stringify({ currentPassword: cur, newPassword: np, confirmPassword: cp })
    })
    .then(r => r.json())
    .then(res => {
        if (res.success) {
            box.className = 'alert alert-success small';
            box.innerText = res.message;
            box.classList.remove('d-none');
            document.getElementById('curPass').value = '';
            document.getElementById('newPass').value = '';
            document.getElementById('confPass').value = '';
        } else {
            box.className = 'alert alert-danger small';
            box.innerText = res.message || 'Error changing password.';
            box.classList.remove('d-none');
        }
    })
    .catch(err => {
        box.className = 'alert alert-danger small';
        box.innerText = err.message;
        box.classList.remove('d-none');
    });
}
</script>

<%- include('../partials/footer') %>
