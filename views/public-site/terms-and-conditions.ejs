<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <!-- Subheader Banner -->
    <section id="subheader" class="bg-dark text-light relative legal-hero" style="background: linear-gradient(135deg, rgba(22, 53, 99, 0.94) 0%, rgba(15, 23, 42, 0.96) 100%), url('/images/background/2.webp') center/cover no-repeat;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-9">
                    <h1 class="text-white font-weight-bold mb-2">Terms &amp; Conditions</h1>
                    <p class="legal-hero-subtitle mb-0">
                        <%= company.name %> • Turnkey Solar EPC &amp; PM Surya Ghar Subsidies (Raisen, M.P.)
                    </p>
                    <div class="small text-white-50 mt-2">
                        <i class="icofont-clock-time me-1 text-warning"></i>
                        Last Updated: <strong><%= new Date(lastUpdated).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %></strong>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content Section -->
    <section class="py-4 py-md-5 bg-light legal-main-section">
        <div class="container">
            <div class="row gy-4">
                
                <!-- Left Quick Navigation Sidebar (Desktop) -->
                <div class="col-lg-3 d-none d-lg-block">
                    <div class="bg-white p-4 rounded-3 shadow-sm border sticky-top" style="top: 100px;">
                        <h6 class="font-weight-bold text-dark text-uppercase small mb-3">
                            <i class="icofont-list me-1 text-primary"></i> Agreement Sections
                        </h6>
                        <ul class="list-unstyled small mb-4" style="line-height: 2;">
                            <li><i class="icofont-check-circled text-success me-1"></i> Turnkey EPC Scope</li>
                            <li><i class="icofont-check-circled text-success me-1"></i> Site Survey &amp; Feasibility</li>
                            <li><i class="icofont-check-circled text-success me-1"></i> Milestones (20/60/20)</li>
                            <li><i class="icofont-check-circled text-success me-1"></i> PM Surya Ghar Subsidy</li>
                            <li><i class="icofont-check-circled text-success me-1"></i> 25-Year Panel Warranty</li>
                            <li><i class="icofont-check-circled text-success me-1"></i> MPPKVVCL Net-Metering</li>
                            <li><i class="icofont-check-circled text-success me-1"></i> Jurisdiction (Raisen, MP)</li>
                        </ul>

                        <div class="p-3 rounded-3 bg-light border">
                            <span class="font-weight-bold text-dark d-block small mb-1">
                                <i class="icofont-support text-warning me-1"></i> Need Clarification?
                            </span>
                            <small class="text-muted d-block mb-2">Speak directly with our technical support team in Raisen.</small>
                            <a href="tel:<%= company.contact.phone.replace(/[^0-9+]/g, '') %>" class="btn btn-sm btn-primary w-100 font-weight-bold" style="background: var(--admin-navy-primary, #163563); border-radius: 6px;">
                                <i class="icofont-phone me-1"></i> Call Support
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Right Terms Document Content -->
                <div class="col-lg-9">
                    <div class="bg-white p-3 p-sm-4 p-md-5 rounded-3 shadow-sm border legal-content-card">
                        
                        <!-- Trust Highlight Banner -->
                        <div class="legal-highlight-box legal-highlight-primary p-3 rounded-3 mb-4">
                            <div class="legal-highlight-icon flex-shrink-0">
                                <i class="icofont-certificate-alt-1"></i>
                            </div>
                            <div class="legal-highlight-copy">
                                <strong class="d-block mb-1">Turnkey Rooftop EPC Standards &amp; Central Subsidy Compliance</strong>
                                <p class="legal-highlight-text mb-0">
                                    All installations conform to MNRE DCR standards, MPPKVVCL bidirectional net-metering norms, and national electrical codes. Formal quotation pricing includes statutory liaisoning and Tier-1 manufacturer warranties.
                                </p>
                            </div>
                        </div>

                        <!-- Dynamic / Formatted Terms Content -->
                        <div class="legal-body-text">
                            <% if (termsContent && (termsContent.includes('<p>') || termsContent.includes('<h3>') || termsContent.includes('<div>'))) { %>
                                <%- termsContent %>
                            <% } else { %>
                                <% 
                                    const paragraphs = (termsContent || '').split(/\n\s*\n/);
                                    paragraphs.forEach(p => {
                                        if (p.trim()) { 
                                %>
                                    <p><%= p.trim() %></p>
                                <% 
                                        }
                                    }); 
                                %>
                            <% } %>
                        </div>

                        <!-- Footer Legal Notice Box -->
                        <div class="mt-5 pt-4 border-top">
                            <div class="row align-items-center">
                                <div class="col-md-7">
                                    <span class="small font-weight-bold text-dark d-block mb-1">
                                        <%= company.name %> — Official Terms of Service
                                    </span>
                                    <small class="text-muted">
                                        <%= company.address.full %>
                                    </small>
                                </div>
                                <div class="col-md-5 text-md-end mt-3 mt-md-0">
                                    <a href="/privacy-policy" class="btn btn-outline-secondary btn-sm font-weight-bold" style="border-radius: 6px;">
                                        <i class="icofont-shield-alt me-1"></i> View Privacy Policy
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>
</div>

<style>
#content #subheader.legal-hero {
    min-height: 250px !important;
    padding: 155px 0 46px !important;
}
#content #subheader.legal-hero > .container {
    margin-top: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
}
#content #subheader.legal-hero h1 {
    margin: 6px 0 8px !important;
    font-size: clamp(28px, 4.5vw, 46px) !important;
    line-height: 1.15 !important;
    text-transform: none !important;
    color: #ffffff !important;
}
.legal-hero-subtitle {
    color: rgba(255, 255, 255, 0.84) !important;
    font-size: clamp(14px, 2vw, 16px);
    line-height: 1.55;
}
.legal-main-section .row > [class*="col-"] {
    min-width: 0;
    max-width: 100%;
}
.legal-highlight-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    overflow: hidden;
}
@media (min-width: 576px) {
    .legal-highlight-box {
        flex-direction: row;
        align-items: flex-start;
        gap: 14px;
    }
}
.legal-highlight-primary {
    background: #eff6ff !important;
    border: 1px solid #bfdbfe !important;
    border-left: 4px solid #1d4ed8 !important;
    color: #1e293b;
}
.legal-highlight-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: #dbeafe;
    color: #1d4ed8;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex: 0 0 38px;
}
.legal-highlight-copy {
    flex: 1 1 auto;
    min-width: 0 !important;
    width: 100%;
    max-width: 100%;
}
.legal-highlight-copy strong {
    color: #0f2a4a;
    font-size: 14px;
    line-height: 1.35;
    white-space: normal !important;
    overflow-wrap: break-word;
}
.legal-highlight-copy .legal-highlight-text,
.legal-highlight-copy span {
    color: #334155 !important;
    font-size: 13px !important;
    line-height: 1.6 !important;
    display: block;
    width: 100%;
    max-width: 100%;
    white-space: normal !important;
    word-break: normal !important;
    overflow-wrap: break-word !important;
}
.legal-content-card {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: break-word;
}
.legal-content-card h3 {
    color: #163563;
    font-size: 20px;
    font-weight: 700;
    margin-top: 32px;
    margin-bottom: 14px;
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 8px;
}
.legal-content-card h4 {
    color: #334155;
    font-size: 16px;
    font-weight: 700;
    margin-top: 20px;
    margin-bottom: 10px;
}
.legal-content-card p {
    color: #475569;
    font-size: 15px;
    line-height: 1.8;
    margin-bottom: 16px;
}
.legal-content-card ul, .legal-content-card ol {
    color: #475569;
    font-size: 15px;
    line-height: 1.8;
    margin-bottom: 20px;
    padding-left: 24px;
}
.legal-content-card li {
    margin-bottom: 8px;
}
.legal-content-card strong {
    color: #0f172a;
}
.legal-content-card a {
    color: #2563eb;
    text-decoration: underline;
}
@media (max-width: 999px) {
    #content #subheader.legal-hero {
        min-height: auto !important;
        padding: 112px 0 34px !important;
    }
    .legal-main-section {
        padding-top: 20px !important;
        padding-bottom: 28px !important;
    }
    .legal-content-card h3 {
        font-size: 17px;
        margin-top: 22px;
    }
    .legal-content-card p,
    .legal-content-card ul,
    .legal-content-card ol {
        font-size: 14px;
        line-height: 1.65;
    }
}
</style>

<%- include('partials/footer') %>
