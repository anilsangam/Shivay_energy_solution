        <% const navActivePage = typeof activePage !== 'undefined' ? activePage : ''; %>
        <!-- header begin -->
        <header class="header-light site-header-fixed">
            <div id="topbar">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="d-flex justify-content-between xs-hide align-items-center">
                                <div class="d-flex align-items-center">
                                    <div class="topbar-widget me-4">
                                        <a href="/contact" title="Visit us in <%= company.address.city %>, <%= company.address.state %>">
                                            <i class="icofont-location-pin"></i><%= company.address.line1 %>, <%= company.address.city %> (<%= company.address.state %>)
                                        </a>
                                    </div>
                                    <div class="topbar-widget me-4">
                                        <a href="tel:<%= company.contact.phone.replace(/[^0-9+]/g, '') %>" title="Call <%= company.name %>">
                                            <i class="icofont-phone"></i><%= company.contact.phone %>
                                        </a>
                                    </div>
                                    <div class="topbar-widget">
                                        <a href="mailto:<%= company.email %>" title="Email Shivay Energy">
                                            <i class="icofont-envelope"></i><%= company.email %>
                                        </a>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center">
                                    <%
                                        const isValidSocialUrl = (url) => {
                                            const cleaned = String(url || '').trim();
                                            return Boolean(cleaned && cleaned !== '#' && cleaned.toLowerCase() !== 'null' && cleaned.toLowerCase() !== 'undefined');
                                        };
                                        const topSocial = (company && company.social) ? company.social : {};
                                        const hasTopSocial = isValidSocialUrl(topSocial.whatsapp) || isValidSocialUrl(topSocial.facebook) || isValidSocialUrl(topSocial.instagram) || isValidSocialUrl(topSocial.youtube);
                                    %>
                                    <% if (hasTopSocial) { %>
                                        <div class="social-icons">
                                            <% if (isValidSocialUrl(topSocial.whatsapp)) { %>
                                                <a href="<%= topSocial.whatsapp %>" target="_blank" rel="noopener noreferrer" title="Chat on WhatsApp" class="text-success"><i class="fa-brands fa-whatsapp fa-lg"></i></a>
                                            <% } %>
                                            <% if (isValidSocialUrl(topSocial.facebook)) { %>
                                                <a href="<%= topSocial.facebook %>" target="_blank" rel="noopener noreferrer" title="Facebook"><i class="fa-brands fa-facebook fa-lg"></i></a>
                                            <% } %>
                                            <% if (isValidSocialUrl(topSocial.instagram)) { %>
                                                <a href="<%= topSocial.instagram %>" target="_blank" rel="noopener noreferrer" title="Instagram"><i class="fa-brands fa-instagram fa-lg"></i></a>
                                            <% } %>
                                            <% if (isValidSocialUrl(topSocial.youtube)) { %>
                                                <a href="<%= topSocial.youtube %>" target="_blank" rel="noopener noreferrer" title="YouTube"><i class="fa-brands fa-youtube fa-lg"></i></a>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>

            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="de-flex sm-pt10 align-items-center">
                            <div class="de-flex-col">
                                <!-- logo begin -->
                                <div id="logo">
                                    <a href="/" class="d-flex align-items-center text-decoration-none">
                                        <img class="logo-main" src="/images/brandlogo_leftlgoog_rightname_trans.png" alt="Shivay Energy Solutions" style="display: inline-block !important; width: auto !important; max-width: min(230px, 58vw) !important; height: 54px !important; object-fit: contain;">
                                    </a>
                                </div>
                                <!-- logo end -->
                            </div>
                            <div class="de-flex-col header-col-mid">
                                <!-- mainmenu begin -->
                                <ul id="mainmenu">
                                    <li><a class="menu-item <%= navActivePage === 'home' ? 'active' : '' %>" href="/">Home</a></li>
                                    <li class="menu-item-has-children nav-services-menu">
                                        <span class="menu-item nav-services-label <%= ['services', 'products', 'careers'].includes(navActivePage) ? 'active' : '' %>">Services</span>
                                        <ul>
                                            <li><a class="menu-item <%= navActivePage === 'services' ? 'active' : '' %>" href="/services">Services</a></li>
                                            <li><a class="menu-item <%= navActivePage === 'products' ? 'active' : '' %>" href="/products">Products</a></li>
                                            <li><a class="menu-item <%= navActivePage === 'careers' ? 'active' : '' %>" href="/careers">Careers &amp; Opportunities</a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-mobile-only"><a class="menu-item <%= navActivePage === 'services' ? 'active' : '' %>" href="/services">Services</a></li>
                                    <li class="nav-mobile-only"><a class="menu-item <%= navActivePage === 'products' ? 'active' : '' %>" href="/products">Products</a></li>
                                    <li><a class="menu-item <%= navActivePage === 'projects' ? 'active' : '' %>" href="/projects">Recent Projects</a></li>
                                    <li><a class="menu-item <%= navActivePage === 'about' ? 'active' : '' %>" href="/about">About Us</a></li>
                                    <li><a class="menu-item <%= navActivePage === 'contact' ? 'active' : '' %>" href="/contact">Contact</a></li>
                                    <li><a class="menu-item <%= navActivePage === 'franchise' ? 'active' : '' %>" href="/franchise">Channel Partner</a></li>
                                    <li class="nav-mobile-only"><a class="menu-item <%= navActivePage === 'careers' ? 'active' : '' %>" href="/careers">Careers &amp; Opportunities</a></li>
                                    <li class="nav-mobile-only nav-mobile-actions">
                                        <a class="mobile-nav-cta mobile-nav-cta-primary" href="/calculator#solar-calculator">Solar Calculator</a>
                                        <a class="mobile-nav-cta mobile-nav-cta-outline" href="/contact#enquiry-form">Enquiry</a>
                                    </li>
                                </ul>
                                <!-- mainmenu end -->
                            </div>
                            <div class="de-flex-col">
                                <div class="menu_side_area d-flex align-items-center">
                                    <a href="/calculator#solar-calculator" class="btn-main btn-line fx-slide navbar-quote-btn"><span>Solar Calculator</span></a>
                                    <a href="/contact#enquiry-form" class="btn-main btn-line fx-slide hover-white ms-2 navbar-enquiry-btn"><span>Enquiry</span></a>

                                    <button id="menu-btn" type="button" aria-label="Open navigation menu" aria-controls="mainmenu" aria-expanded="false"></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <a href="/calculator#solar-calculator" class="mobile-floating-calculator" aria-label="Open Solar Calculator">
            <i class="icofont-sun" aria-hidden="true"></i><span>Solar Calculator</span>
        </a>
        <style>
            header.site-header-fixed > .container {
                width: 100% !important;
                max-width: 1300px !important;
                margin-right: auto !important;
                margin-left: auto !important;
            }
            @media (min-width: 1280px) {
                header.site-header-fixed #logo img.logo-main {
                    height: 62px !important;
                    max-width: 265px !important;
                }
            }
            @media (min-width: 1000px) and (max-width: 1279px) {
                header.site-header-fixed #topbar > .container,
                header.site-header-fixed > .container {
                    max-width: 100% !important;
                    min-width: 0 !important;
                    padding-left: 16px !important;
                    padding-right: 16px !important;
                }
                header.site-header-fixed #topbar .topbar-widget {
                    font-size: 11.5px !important;
                    margin-right: 12px !important;
                    white-space: nowrap;
                }
                header.site-header-fixed #topbar .topbar-widget i {
                    font-size: 13px !important;
                    margin-right: 5px !important;
                }
                header.site-header-fixed #topbar .social-icons a {
                    padding: 4px 8px !important;
                    font-size: 12px !important;
                }
                header.site-header-fixed .de-flex {
                    display: flex !important;
                    flex-wrap: nowrap !important;
                    align-items: center !important;
                    justify-content: space-between !important;
                    gap: 10px !important;
                    row-gap: 0;
                }
                header.site-header-fixed .de-flex > .de-flex-col:first-child {
                    flex: 0 0 auto;
                    position: relative;
                    z-index: 2;
                }
                header.site-header-fixed .de-flex > .header-col-mid {
                    flex: 1 1 auto;
                    min-width: 0;
                    display: flex !important;
                    justify-content: center;
                    padding: 0 !important;
                }
                header.site-header-fixed .de-flex > .de-flex-col:last-child {
                    flex: 0 0 auto;
                    margin-left: auto;
                    position: relative;
                    z-index: 2;
                }
                header.site-header-fixed #mainmenu {
                    display: flex !important;
                    flex-wrap: nowrap !important;
                    align-items: center;
                    justify-content: center;
                    width: auto;
                    margin: 0;
                    white-space: nowrap;
                }
                header.site-header-fixed #mainmenu > li:not(.nav-mobile-only) {
                    float: none !important;
                    display: inline-block !important;
                    flex-shrink: 0;
                    margin-right: 12px !important;
                }
                header.site-header-fixed #mainmenu > li.nav-mobile-only {
                    display: none !important;
                }
                header.site-header-fixed #mainmenu > li:last-child,
                header.site-header-fixed #mainmenu > li:nth-last-child(3) {
                    margin-right: 0 !important;
                }
                header.site-header-fixed #mainmenu li a:after {
                    margin-left: 0 !important;
                }
                header.site-header-fixed #mainmenu > li > a.menu-item,
                header.site-header-fixed #mainmenu > li > span.nav-services-label {
                    font-size: 12.5px !important;
                    padding: 18px 2px !important;
                    white-space: nowrap !important;
                }
                header.site-header-fixed .menu_side_area {
                    display: flex !important;
                    align-items: center !important;
                    flex-wrap: nowrap !important;
                    gap: 6px;
                    white-space: nowrap !important;
                }
                header.site-header-fixed .menu_side_area .navbar-quote-btn,
                header.site-header-fixed .menu_side_area .navbar-enquiry-btn {
                    margin-left: 0 !important;
                    padding: 7px 10px !important;
                    font-size: 11.5px !important;
                    letter-spacing: 0 !important;
                    white-space: nowrap !important;
                }
                header.site-header-fixed #logo img.logo-main {
                    height: 36px !important;
                    max-width: 155px !important;
                }
            }
            @media (max-width: 999px) {
                header.site-header-fixed #topbar {
                    display: none !important;
                }
                header.site-header-fixed #logo img.logo-main {
                    width: auto !important;
                    max-width: min(220px, 64vw) !important;
                    height: 46px !important;
                    transform: none !important;
                }
                .mobile-floating-calculator {
                    display: none !important;
                }
            }
        </style>
        <script>
            (() => {
                const header = document.querySelector('header.site-header-fixed');
                const menuButton = header && header.querySelector('#menu-btn');
                const menu = header && header.querySelector('#mainmenu');

                if (!header || !menuButton || !menu) return;

                const setMenuOpen = (isOpen) => {
                    header.classList.toggle('menu-open', isOpen);
                    menuButton.classList.toggle('menu-open', isOpen);
                    menuButton.setAttribute('aria-expanded', String(isOpen));
                    menuButton.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
                };

                menuButton.addEventListener('click', () => {
                    setMenuOpen(!header.classList.contains('menu-open'));
                });

                menu.addEventListener('click', (event) => {
                    if (event.target.closest('a')) setMenuOpen(false);
                });

                document.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape' && header.classList.contains('menu-open')) {
                        setMenuOpen(false);
                        menuButton.focus();
                    }
                });

                window.addEventListener('resize', () => {
                    if (window.innerWidth > 999) setMenuOpen(false);
                });
            })();
        </script>
        <!-- header end -->
