<div class="solar-input-card contact-enquiry-card text-dark">
    <div class="text-center mb-2">
        <h4 class="solar-input-heading mb-1">Request a Free Solar Site Survey</h4>
        <p class="text-muted small mb-2">Avail up to ₹78,000 PM Surya Ghar Govt Subsidy in Madhya Pradesh</p>
    </div>

    <form id="solarEnquiryForm" onsubmit="handleEnquirySubmit(event)">
        <div class="row g-2">
            <div class="col-12 col-sm-6">
                <label class="form-label small font-weight-bold mb-1">Full Name *</label>
                <input type="text" name="name" class="form-control form-control-sm" placeholder="e.g. Ramesh Kumar" required>
            </div>
            <div class="col-12 col-sm-6">
                <label class="form-label small font-weight-bold mb-1">Mobile Number *</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light enquiry-phone-prefix">+91</span>
                    <input type="tel" name="mobile" pattern="[6-9][0-9]{9}" maxlength="10" class="form-control form-control-sm" placeholder="10-digit mobile" required>
                </div>
            </div>

            <div class="col-12 col-sm-6">
                <label class="form-label small font-weight-bold mb-1">Email Address</label>
                <input type="email" name="email" class="form-control form-control-sm" placeholder="name@example.com">
            </div>

            <div class="col-6 col-md-6">
                <label class="form-label small font-weight-bold mb-1">State *</label>
                <select name="state" id="enquiryState" class="form-select form-select-sm" required>
                    <% data.regions.states.forEach(st => { %>
                        <option value="<%= st %>" <%= st === 'Madhya Pradesh' ? 'selected' : '' %>><%= st %></option>
                    <% }); %>
                </select>
            </div>

            <div class="col-6 col-md-6">
                <label class="form-label small font-weight-bold mb-1">District *</label>
                <select name="district" id="enquiryMpDistrict" class="form-select form-select-sm" required>
                    <% data.regions.mpDistricts.forEach(dst => { %>
                        <option value="<%= dst %>" <%= dst === 'Raisen' ? 'selected' : '' %>><%= dst %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-6 col-md-6" id="enquiryOtherDistrictField" hidden>
                <label class="form-label small font-weight-bold mb-1" for="enquiryOtherDistrict">District *</label>
                <input type="text" name="district" id="enquiryOtherDistrict" class="form-control form-control-sm" placeholder="Enter your district" disabled>
            </div>

            <div class="col-6 col-md-6">
                <label class="form-label small font-weight-bold mb-1">PIN Code *</label>
                <input type="text" name="pincode" pattern="[0-9]{6}" maxlength="6" class="form-control form-control-sm" placeholder="464551" required>
            </div>

            <div class="col-6 col-md-6">
                <label class="form-label small font-weight-bold mb-1">Monthly Bill (₹) *</label>
                <select name="monthlyBill" class="form-select form-select-sm" required>
                    <option value="1500">Below ₹1,500 (1-2 kW)</option>
                    <option value="3000" selected>₹1,500 - ₹3,500 (2-3 kW)</option>
                    <option value="6000">₹3,500 - ₹8,000 (3-5 kW)</option>
                    <option value="15000">₹8,000 - ₹20,000 (5-10 kW)</option>
                    <option value="50000">Above ₹20,000 (15kW+)</option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label small font-weight-bold mb-1">Solar Requirement *</label>
                <select name="solarRequirement" class="form-select form-select-sm" required>
                    <option value="Residential Rooftop (PM Surya Ghar Subsidy)">Residential Rooftop (PM Surya Ghar Subsidy)</option>
                    <option value="Commercial & Industrial On-Grid Plant">Commercial & Industrial On-Grid Plant</option>
                    <option value="Agricultural Solar Pump (KUSUM)">Agricultural Solar Pump (KUSUM)</option>
                    <option value="Hybrid / Battery Storage System">Hybrid / Battery Storage System</option>
                    <option value="Solar Maintenance & AMC">Solar Maintenance & AMC</option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label small font-weight-bold mb-1">Site Address or Note</label>
                <textarea name="message" class="form-control form-control-sm" rows="2" placeholder="Rooftop area, village/colony or query..."></textarea>
            </div>

            <div class="col-12 text-center mt-2">
                <button type="submit" id="enquirySubmitBtn" class="btn-main w-100 py-2 font-weight-bold" style="background: var(--primary-color); color: #000; border: none; font-size: 14.5px;">
                    <span>⚡ Get Free Consultation & Solar Quote</span>
                </button>
            </div>
        </div>
        <div id="enquiryAlert" class="mt-2" style="display: none;"></div>
    </form>
</div>
<style>
.contact-enquiry-card { padding: 18px 20px !important; }
.contact-enquiry-card .solar-input-heading { font-size: 18px; }
.contact-enquiry-card .form-label { font-size: 12px; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
.contact-enquiry-card .form-control,
.contact-enquiry-card .form-select { min-height: 38px !important; height: 38px; font-size: 13.5px; }
.contact-enquiry-card textarea.form-control { height: auto !important; min-height: 64px !important; }
.contact-enquiry-card .input-group { display: flex; flex-wrap: nowrap !important; width: 100%; align-items: stretch; }
.contact-enquiry-card .input-group > .enquiry-phone-prefix { flex: 0 0 auto !important; width: auto !important; min-width: 48px !important; white-space: nowrap !important; display: inline-flex !important; align-items: center; justify-content: center; padding: 0 10px !important; height: 38px !important; min-height: 38px !important; font-size: 13px; }
.contact-enquiry-card .input-group > .form-control { flex: 1 1 auto !important; width: 1% !important; min-width: 0 !important; }
.contact-enquiry-card #enquirySubmitBtn { min-height: 42px; padding: 10px 14px !important; }
@media (max-width: 767.98px) {
    .contact-enquiry-card { padding: 14px !important; }
    .contact-enquiry-card .form-control,
    .contact-enquiry-card .form-select { min-height: 36px !important; height: 36px; font-size: 13.5px; }
    .contact-enquiry-card .input-group > .enquiry-phone-prefix { height: 36px !important; min-height: 36px !important; min-width: 46px !important; }
}
</style>

<script>
(() => {
    const state = document.getElementById('enquiryState');
    const mpDistrict = document.getElementById('enquiryMpDistrict');
    const otherField = document.getElementById('enquiryOtherDistrictField');
    const otherDistrict = document.getElementById('enquiryOtherDistrict');
    if (!state || !mpDistrict || !otherField || !otherDistrict) return;

    const syncDistrictField = () => {
        const isMp = state.value === 'Madhya Pradesh';
        mpDistrict.disabled = !isMp;
        mpDistrict.required = isMp;
        mpDistrict.closest('.col-md-6').hidden = !isMp;
        otherField.hidden = isMp;
        otherDistrict.disabled = isMp;
        otherDistrict.required = !isMp;
    };
    state.addEventListener('change', syncDistrictField);
    syncDistrictField();
})();

function handleEnquirySubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('enquirySubmitBtn');
    const alertBox = document.getElementById('enquiryAlert');
    btn.disabled = true;
    btn.innerHTML = '<span>Submitting enquiry...</span>';

    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    fetch('/api/enquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(r => r.json())
    .then(res => {
        alertBox.style.display = 'block';
        if (res.success) {
            alertBox.className = 'alert alert-success p-3 small';
            alertBox.innerHTML = `<strong>Dhanyawad!</strong> ${res.message} <br><a href="${res.whatsappRedirect}" target="_blank" class="btn btn-sm btn-success mt-2 text-white"><i class="fa-brands fa-whatsapp me-1"></i> Connect on WhatsApp Now</a>`;
            e.target.reset();
        } else {
            alertBox.className = 'alert alert-danger p-3 small';
            alertBox.innerText = res.message || 'Please check your inputs.';
        }
        btn.disabled = false;
        btn.innerHTML = '<span>⚡ Get Free Consultation & Solar Quote</span>';
    })
    .catch(err => {
        alertBox.style.display = 'block';
        alertBox.className = 'alert alert-danger p-3 small';
        alertBox.innerText = 'Network issue. Please call Deepak Kushwaha directly at +91 70005 75496.';
        btn.disabled = false;
        btn.innerHTML = '<span>⚡ Get Free Consultation & Solar Quote</span>';
    });
}
</script>
