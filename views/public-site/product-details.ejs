<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="catalog-page" id="content">
    <section class="catalog-hero" style="--hero-image: url('/images/background/w1.webp'); padding: 90px 0 50px;">
        <div class="container">
            <div class="d-flex align-items-center gap-2 mb-2">
                <a href="/products" class="text-white-50 text-decoration-none small hover-white">
                    <i class="icofont-arrow-left me-1"></i> All Products
                </a>
                <span class="text-white-50 small">/</span>
                <span class="text-warning small font-weight-bold"><%= product.category %></span>
            </div>
            <h1 class="text-white font-weight-bold mb-2"><%= product.name %></h1>
            <p class="text-white-50 mb-0"><%= product.description %></p>
        </div>
    </section>

    <section class="catalog-section py-5">
        <div class="container">
            <div class="row g-5 align-items-start">
                <!-- Product Image & Badges Column -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                        <div style="height: 340px; position: relative; background: #f8fafc; display: flex; align-items: center; justify-content: center;">
                            <img src="<%= (product.image && (product.image.startsWith('http') || product.image.startsWith('/'))) ? product.image : '/' + (product.image || 'images/slider/slider1.webp') %>" 
                                 alt="<%= product.name %>" 
                                 style="max-width: 90%; max-height: 90%; object-fit: contain;"
                                 onerror="this.src='/images/slider/slider1.webp'">
                            <span class="badge position-absolute top-0 start-0 m-3 px-3 py-2 bg-warning text-dark font-weight-bold shadow-sm" style="border-radius: 20px;">
                                <%= product.category %>
                            </span>
                        </div>
                        <div class="card-body p-4 bg-light border-top">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-muted small font-weight-bold">Warranty</span>
                                <span class="text-dark fw-bold small"><i class="icofont-shield-alt text-success me-1"></i><%= product.warranty %></span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="text-muted small font-weight-bold">Starting Price</span>
                                <span class="text-primary fw-bold fs-6"><%= product.startingPrice %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Specifications & Details Column -->
                <div class="col-lg-7">
                    <div class="ps-lg-2">
                        <span class="badge bg-light text-muted border mb-2 font-monospace">SKU / Model: <%= product.productId %></span>
                        <h2 class="text-dark font-weight-bold mb-3"><%= product.name %></h2>
                        <p class="text-secondary mb-4" style="line-height: 1.7; font-size: 15px;">
                            <%= product.description %>
                        </p>

                        <!-- Key Specifications Matrix -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
                                    <small class="text-muted d-block text-uppercase font-weight-bold" style="font-size: 11px;">Capacity Range</small>
                                    <strong class="text-dark fs-5 mt-1 d-block"><%= product.capacityRange %></strong>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 bg-white border rounded-3 shadow-sm h-100">
                                    <small class="text-muted d-block text-uppercase font-weight-bold" style="font-size: 11px;">Efficiency Rating</small>
                                    <strong class="text-success fs-5 mt-1 d-block"><%= product.efficiency %></strong>
                                </div>
                            </div>
                        </div>

                        <% if (product.bestFor) { %>
                            <div class="alert alert-info border-0 rounded-3 p-3 mb-4 d-flex align-items-start gap-2 bg-info bg-opacity-10 text-dark">
                                <i class="icofont-info-circle text-info fs-5 mt-1 flex-shrink-0"></i>
                                <div>
                                    <strong class="d-block mb-1 text-dark">Recommended Usage / Best For:</strong>
                                    <span class="small text-secondary"><%= product.bestFor %></span>
                                </div>
                            </div>
                        <% } %>

                        <!-- Highlights & Features -->
                        <% if (product.features && product.features.length > 0) { %>
                            <div class="mb-4">
                                <h5 class="font-weight-bold text-dark mb-3">Key Features &amp; Performance Highlights</h5>
                                <div class="row g-2">
                                    <% product.features.forEach(feat => { %>
                                        <div class="col-md-6">
                                            <div class="p-2 d-flex align-items-center gap-2">
                                                <i class="icofont-check-circled text-success fs-5 flex-shrink-0"></i>
                                                <span class="text-secondary small font-weight-semibold"><%= feat %></span>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        <% } %>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-wrap gap-3 pt-3 border-top mt-4">
                            <a href="/contact#enquiry-form" class="btn btn-warning font-weight-bold text-dark px-4 py-2 shadow-sm" style="border-radius: 8px;">
                                <i class="icofont-envelope me-1"></i> Request a Quote for this Product
                            </a>
                            <a href="/calculator#solar-calculator" class="btn btn-outline-primary font-weight-bold px-4 py-2" style="border-radius: 8px;">
                                <i class="icofont-calculator me-1"></i> Calculate Rooftop Savings
                            </a>
                            <a href="/products" class="btn btn-outline-secondary px-3 py-2" style="border-radius: 8px;">
                                All Products
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
